# CuBit Stage 2 Init
(startup v1
  (start "logstore.svc")
  (start "clock.svc")
  # Approves timesync's declared scope: outbound UDP port 123 and DNS.
  (start "timesync.svc" (network approve-declared))
  # Approves tls.svc's declared scope: outbound TCP with DNS. Clients still
  # need their own tls-scope names.
  (start "tls.svc" (network approve-declared))
  (start "display.svc")
  # Dictionary, thesaurus and spelling for the apps and CCL (docs/lexicon.md).
  (start "lexicon.svc")
  (start "shell.app")
)
