--  CuAlloc for CuBit: the process heap (CuAlloc_Native over the kernel's
--  owned memory) and its proved cores. The same objects go into libc.a and
--  libgnat-user.a (kernel/Makefile, user_runtime); Rust programs that link
--  neither link this library. Like libc's Ada, it needs no run-time library
--  and no elaboration, wherever it is linked.
library project Allocator_Native is
   for Source_Dirs use ("src", "process");
   for Object_Dir use "build/native-objects";
   for Library_Dir use "build/native-lib";
   for Library_Name use "cubit_allocator";
   for Library_Kind use "static";
   for Runtime ("Ada") use "../runtime";
   package Builder is
      for Global_Configuration_Pragmas use "../libc/libc-ada.adc";
   end Builder;
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatp", "-gnatn2", "-O2", "-g", "-mno-red-zone",
         "-fno-pic", "-ffunction-sections", "-I-");
   end Compiler;
end Allocator_Native;
