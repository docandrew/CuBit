library project Allocator_Runtime_Host is
   for Source_Dirs use ("src", "runtime");
   for Object_Dir use "build/runtime-host-objects";
   for Library_Dir use "build/runtime-host-lib";
   for Library_Name use "cubit_allocator";
   for Library_Kind use "static";
   package Compiler is
      -- Checked adapter tests, not the release benchmark configuration.
      for Default_Switches ("Ada") use ("-gnat2022", "-gnato", "-gnatn2", "-O2", "-g");
   end Compiler;
end Allocator_Runtime_Host;
