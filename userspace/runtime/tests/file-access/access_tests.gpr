project Access_Tests is
   for Languages use ("Ada");
   for Source_Dirs use (".", "../../gnat");
   for Source_Files use
     ("main.adb", "cubit.ads", "cubit-file_access.ads", "cubit-file_access.adb");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnatwa", "-gnatwe", "-gnata");
   end Compiler;
   package Prove is
      for Proof_Switches ("Ada") use ("--no-loop-unrolling");
   end Prove;
end Access_Tests;
