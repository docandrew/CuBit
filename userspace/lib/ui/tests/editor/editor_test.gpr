project Editor_Test is
   for Languages use ("Ada");
   for Source_Dirs use (".", "../..", "../../../theme");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("main.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnatwa", "-gnatwJ", "-gnatwe", "-gnata");
   end Compiler;
end Editor_Test;
