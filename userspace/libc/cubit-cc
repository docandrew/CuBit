#!/usr/bin/env bash
# Compile and link a C program for CuBit against the CuBit libc.
#   cubit-cc [gcc options] -o prog.app sources... [--manifest manifest.o]
# Links statically with the CuBit start code, musl and libgcc, using the
# libc link script (headers loaded, TLS sections) and a 1 MiB stack
# contract (override with CUBIT_STACK_SIZE).
set -euo pipefail
# Nix's gcc wrapper adds hardening flags (stack protector, fortify, PIE).
# The libc's start code runs before the thread pointer (and so the stack
# canary at %fs:0x28) exists; CuBit programs are static and non-PIE.
export NIX_HARDENING_ENABLE=""
here=$(cd "$(dirname "$0")" && pwd)
sysroot=$here/build/sysroot
manifest=()
args=()
while [ $# -gt 0 ]; do
    case $1 in
        --manifest) manifest=("$2"); shift 2 ;;
        *) args+=("$1"); shift ;;
    esac
done
link=1
for a in "${args[@]}"; do case $a in -c|-S|-E) link=0 ;; esac; done
common=(-nostdinc -isystem "$sysroot/include"
        -isystem "$(gcc -print-file-name=include)"
        -fno-pie -no-pie -mno-red-zone -fno-stack-protector)
if [ $link = 0 ]; then
    exec gcc "${common[@]}" "${args[@]}"
fi
# gcc's static-link frame (crti, crtbeginT ... crtend, crtn) from the musl
# cross toolchain, as cubit-c++ uses: it defines __dso_handle and the
# init/fini frame, which C++ objects in a mixed link (e.g. Rust programs with
# SpiderMonkey) need.
crt() { "$(cat "$here/build/cross-gcc")/bin/x86_64-unknown-linux-musl-gcc" -print-file-name="$1"; }
exec gcc "${common[@]}" -nostdlib -static -L"$sysroot/lib" \
    -Wl,-T,"$sysroot/lib/cubit.ld" -Wl,-z,stack-size="${CUBIT_STACK_SIZE:-1048576}" \
    -Wl,-z,noexecstack -Wl,-z,noseparate-code \
    "$sysroot/lib/cubit-crt1.o" "$sysroot/lib/crti.o" "$(crt crtbeginT.o)" \
    "${args[@]}" "${manifest[@]}" \
    -Wl,--start-group "$sysroot/lib/libc.a" "$(gcc -print-libgcc-file-name)" -Wl,--end-group \
    "$(crt crtend.o)" "$sysroot/lib/crtn.o"
