       and Get_Length (Ctx) = Get_Length (Ctx)'Old
       and Field_First (Ctx, F_Shift_Cnt) = Field_First (Ctx, F_Shift_Cnt)'Old
       and (for all F in Field range F_Kind .. F_SACK_Blocks =>
               Context_Cursors_Index (Context_Cursors (Ctx), F) = Context_Cursors_Index (Context_Cursors (Ctx)'Old, F));

   procedure Set_TSval (Ctx : in out Context; Val : Net.TCP.TSval)
   with
     Inline_Always,
     Pre =>
       not Ctx'Constrained
       and then Net.TCP.Option.Has_Buffer (Ctx)
       and then Net.TCP.Option.Valid_Next (Ctx, Net.TCP.Option.F_TSval)
       and then Net.TCP.Valid_TSval (Net.TCP.To_Base_Integer (Val))
       and then Net.TCP.Option.Available_Space (Ctx, Net.TCP.Option.F_TSval) >= Net.TCP.Option.Field_Size (Ctx, Net.TCP.Option.F_TSval)
       and then Net.TCP.Option.Field_Condition (Ctx, Net.TCP.Option.F_TSval, Net.TCP.To_Base_Integer (Val)),
     Post =>
       Has_Buffer (Ctx)
       and Valid (Ctx, F_TSval)
       and Get_TSval (Ctx) = Val
       and Invalid (Ctx, F_TSecr)
       and Valid_Next (Ctx, F_TSecr)
       and Ctx.Buffer_First = Ctx.Buffer_First'Old
       and Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and Ctx.First = Ctx.First'Old
       and Ctx.Last = Ctx.Last'Old
       and Valid_Next (Ctx, F_TSval) = Valid_Next (Ctx, F_TSval)'Old
       and Get_Kind (Ctx) = Get_Kind (Ctx)'Old
       and Get_Length (Ctx) = Get_Length (Ctx)'Old
       and Field_First (Ctx, F_TSval) = Field_First (Ctx, F_TSval)'Old
       and (for all F in Field range F_Kind .. F_Shift_Cnt =>
               Context_Cursors_Index (Context_Cursors (Ctx), F) = Context_Cursors_Index (Context_Cursors (Ctx)'Old, F));

   procedure Set_TSecr (Ctx : in out Context; Val : Net.TCP.TSecr)
   with
     Inline_Always,
     Pre =>
       not Ctx'Constrained
       and then Net.TCP.Option.Has_Buffer (Ctx)
       and then Net.TCP.Option.Valid_Next (Ctx, Net.TCP.Option.F_TSecr)
       and then Net.TCP.Valid_TSecr (Net.TCP.To_Base_Integer (Val))
       and then Net.TCP.Option.Available_Space (Ctx, Net.TCP.Option.F_TSecr) >= Net.TCP.Option.Field_Size (Ctx, Net.TCP.Option.F_TSecr)
       and then Net.TCP.Option.Field_Condition (Ctx, Net.TCP.Option.F_TSecr, Net.TCP.To_Base_Integer (Val)),
     Post =>
       Has_Buffer (Ctx)
       and Valid (Ctx, F_TSecr)
       and Get_TSecr (Ctx) = Val
       and (if Well_Formed_Message (Ctx) then Message_Last (Ctx) = Field_Last (Ctx, F_TSecr))
       and Ctx.Buffer_First = Ctx.Buffer_First'Old
       and Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and Ctx.First = Ctx.First'Old
       and Ctx.Last = Ctx.Last'Old
       and Valid_Next (Ctx, F_TSecr) = Valid_Next (Ctx, F_TSecr)'Old
       and Get_Kind (Ctx) = Get_Kind (Ctx)'Old
       and Get_Length (Ctx) = Get_Length (Ctx)'Old
       and Get_TSval (Ctx) = Get_TSval (Ctx)'Old
       and Field_First (Ctx, F_TSecr) = Field_First (Ctx, F_TSecr)'Old
       and (for all F in Field range F_Kind .. F_TSval =>
               Context_Cursors_Index (Context_Cursors (Ctx), F) = Context_Cursors_Index (Context_Cursors (Ctx)'Old, F));

   pragma Warnings (On, "aspect ""*"" not enforced on inlined subprogram ""*""");

   procedure Set_SACK_Blocks_Empty (Ctx : in out Context)
   with
     Pre =>
       not Ctx'Constrained
       and then Net.TCP.Option.Has_Buffer (Ctx)
       and then Net.TCP.Option.Valid_Next (Ctx, Net.TCP.Option.F_SACK_Blocks)
       and then Net.TCP.Option.Available_Space (Ctx, Net.TCP.Option.F_SACK_Blocks) >= Net.TCP.Option.Field_Size (Ctx, Net.TCP.Option.F_SACK_Blocks)
       and then Net.TCP.Option.Field_Condition (Ctx, Net.TCP.Option.F_SACK_Blocks, 0)
       and then Net.TCP.Option.Field_Size (Ctx, Net.TCP.Option.F_SACK_Blocks) = 0,
     Post =>
       Has_Buffer (Ctx)
       and Well_Formed (Ctx, F_SACK_Blocks)
       and (if Well_Formed_Message (Ctx) then Message_Last (Ctx) = Field_Last (Ctx, F_SACK_Blocks))
       and Invalid (Ctx, F_Shift_Cnt)
       and Invalid (Ctx, F_TSval)
       and Invalid (Ctx, F_TSecr)
       and Ctx.Buffer_First = Ctx.Buffer_First'Old
       and Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and Ctx.First = Ctx.First'Old
       and Ctx.Last = Ctx.Last'Old
       and Valid_Next (Ctx, F_SACK_Blocks) = Valid_Next (Ctx, F_SACK_Blocks)'Old
       and Get_Kind (Ctx) = Get_Kind (Ctx)'Old
       and Get_Length (Ctx) = Get_Length (Ctx)'Old
       and Field_First (Ctx, F_SACK_Blocks) = Field_First (Ctx, F_SACK_Blocks)'Old;

   procedure Set_SACK_Blocks (Ctx : in out Context; Seq_Ctx : Net.TCP.SACK_Blocks.Context)
   with
     Pre =>
       not Ctx'Constrained
       and then Net.TCP.Option.Has_Buffer (Ctx)
       and then Net.TCP.Option.Valid_Next (Ctx, Net.TCP.Option.F_SACK_Blocks)
       and then Net.TCP.Option.Available_Space (Ctx, Net.TCP.Option.F_SACK_Blocks) >= Net.TCP.Option.Field_Size (Ctx, Net.TCP.Option.F_SACK_Blocks)
       and then Net.TCP.Option.Field_Condition (Ctx, Net.TCP.Option.F_SACK_Blocks, 0)
       and then Net.TCP.Option.Valid_Length (Ctx, Net.TCP.Option.F_SACK_Blocks, Net.TCP.SACK_Blocks.Byte_Size (Seq_Ctx))
       and then Net.TCP.SACK_Blocks.Has_Buffer (Seq_Ctx)
       and then Net.TCP.SACK_Blocks.Valid (Seq_Ctx),
     Post =>
       Has_Buffer (Ctx)
       and Well_Formed (Ctx, F_SACK_Blocks)
       and (if Well_Formed_Message (Ctx) then Message_Last (Ctx) = Field_Last (Ctx, F_SACK_Blocks))
       and Invalid (Ctx, F_Shift_Cnt)
       and Invalid (Ctx, F_TSval)
       and Invalid (Ctx, F_TSecr)
       and Ctx.Buffer_First = Ctx.Buffer_First'Old
       and Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and Ctx.First = Ctx.First'Old
       and Ctx.Last = Ctx.Last'Old
       and Valid_Next (Ctx, F_SACK_Blocks) = Valid_Next (Ctx, F_SACK_Blocks)'Old
       and Get_Kind (Ctx) = Get_Kind (Ctx)'Old
       and Get_Length (Ctx) = Get_Length (Ctx)'Old
       and Field_First (Ctx, F_SACK_Blocks) = Field_First (Ctx, F_SACK_Blocks)'Old
       and (if Field_Size (Ctx, F_SACK_Blocks) > 0 then Present (Ctx, F_SACK_Blocks));

   procedure Initialize_SACK_Blocks (Ctx : in out Context)
   with
     Pre =>
       not Ctx'Constrained
       and then Net.TCP.Option.Has_Buffer (Ctx)
       and then Net.TCP.Option.Valid_Next (Ctx, Net.TCP.Option.F_SACK_Blocks)
       and then Net.TCP.Option.Available_Space (Ctx, Net.TCP.Option.F_SACK_Blocks) >= Net.TCP.Option.Field_Size (Ctx, Net.TCP.Option.F_SACK_Blocks),
     Post =>
       Has_Buffer (Ctx)
       and then Well_Formed (Ctx, F_SACK_Blocks)
       and then (if Well_Formed_Message (Ctx) then Message_Last (Ctx) = Field_Last (Ctx, F_SACK_Blocks))
       and then Invalid (Ctx, F_Shift_Cnt)
       and then Invalid (Ctx, F_TSval)
       and then Invalid (Ctx, F_TSecr)
       and then Ctx.Buffer_First = Ctx.Buffer_First'Old
       and then Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and then Ctx.First = Ctx.First'Old
       and then Ctx.Last = Ctx.Last'Old
       and then Valid_Next (Ctx, F_SACK_Blocks) = Valid_Next (Ctx, F_SACK_Blocks)'Old
       and then Get_Kind (Ctx) = Get_Kind (Ctx)'Old
       and then Get_Length (Ctx) = Get_Length (Ctx)'Old
       and then Field_First (Ctx, F_SACK_Blocks) = Field_First (Ctx, F_SACK_Blocks)'Old;

   procedure Switch_To_SACK_Blocks (Ctx : in out Context; Seq_Ctx : out Net.TCP.SACK_Blocks.Context)
   with
     Pre =>
       not Ctx'Constrained
       and then not Seq_Ctx'Constrained
       and then Net.TCP.Option.Has_Buffer (Ctx)
       and then Net.TCP.Option.Valid_Next (Ctx, Net.TCP.Option.F_SACK_Blocks)
       and then Net.TCP.Option.Field_Size (Ctx, Net.TCP.Option.F_SACK_Blocks) > 0
       and then Net.TCP.Option.Field_First (Ctx, Net.TCP.Option.F_SACK_Blocks) rem RFLX_Types.Byte'Size = 1
       and then Net.TCP.Option.Available_Space (Ctx, Net.TCP.Option.F_SACK_Blocks) >= Net.TCP.Option.Field_Size (Ctx, Net.TCP.Option.F_SACK_Blocks)
       and then Net.TCP.Option.Field_Condition (Ctx, Net.TCP.Option.F_SACK_Blocks, 0),
     Post =>
       not Net.TCP.Option.Has_Buffer (Ctx)
       and Net.TCP.SACK_Blocks.Has_Buffer (Seq_Ctx)
       and Ctx.Buffer_First = Seq_Ctx.Buffer_First
       and Ctx.Buffer_Last = Seq_Ctx.Buffer_Last
       and Seq_Ctx.First = Field_First (Ctx, F_SACK_Blocks)
       and Seq_Ctx.Last = Field_Last (Ctx, F_SACK_Blocks)
       and Net.TCP.SACK_Blocks.Valid (Seq_Ctx)
       and Net.TCP.SACK_Blocks.Sequence_Last (Seq_Ctx) = Seq_Ctx.First - 1
       and Present (Ctx, F_SACK_Blocks)
       and Ctx.Buffer_First = Ctx.Buffer_First'Old
       and Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and Ctx.First = Ctx.First'Old
       and Ctx.Last = Ctx.Last'Old
       and Field_Last (Ctx, F_SACK_Blocks) = Field_Last (Ctx, F_SACK_Blocks)'Old
       and (for all F in Field range F_Kind .. F_Max_Seg_Size =>
               Context_Cursors_Index (Context_Cursors (Ctx), F) = Context_Cursors_Index (Context_Cursors (Ctx)'Old, F)),
     Contract_Cases =>
       (Well_Formed (Ctx, F_SACK_Blocks) =>
           (for all F in Field range F_Shift_Cnt .. F_TSecr =>
               Context_Cursors_Index (Context_Cursors (Ctx), F) = Context_Cursors_Index (Context_Cursors (Ctx)'Old, F)),
        others =>
           Invalid (Ctx, F_Shift_Cnt)
           and Invalid (Ctx, F_TSval)
           and Invalid (Ctx, F_TSecr));

   function Complete_SACK_Blocks (Ctx : Context; Seq_Ctx : Net.TCP.SACK_Blocks.Context) return Boolean
   with
     Pre =>
       Net.TCP.Option.Valid_Next (Ctx, Net.TCP.Option.F_SACK_Blocks);

   procedure Update_SACK_Blocks (Ctx : in out Context; Seq_Ctx : in out Net.TCP.SACK_Blocks.Context)
   with
     Pre =>
       Net.TCP.Option.Present (Ctx, Net.TCP.Option.F_SACK_Blocks)
       and then not Net.TCP.Option.Has_Buffer (Ctx)
       and then Net.TCP.SACK_Blocks.Has_Buffer (Seq_Ctx)
       and then Ctx.Buffer_First = Seq_Ctx.Buffer_First
       and then Ctx.Buffer_Last = Seq_Ctx.Buffer_Last
       and then Seq_Ctx.First = Field_First (Ctx, F_SACK_Blocks)
       and then Seq_Ctx.Last = Field_Last (Ctx, F_SACK_Blocks),
     Post =>
       (if
           Net.TCP.Option.Complete_SACK_Blocks (Ctx, Seq_Ctx)
        then
           Present (Ctx, F_SACK_Blocks)
           and Context_Cursor (Ctx, F_Shift_Cnt) = Context_Cursor (Ctx, F_Shift_Cnt)'Old
           and Context_Cursor (Ctx, F_TSval) = Context_Cursor (Ctx, F_TSval)'Old
           and Context_Cursor (Ctx, F_TSecr) = Context_Cursor (Ctx, F_TSecr)'Old
        else
           Invalid (Ctx, F_SACK_Blocks)
           and Invalid (Ctx, F_Shift_Cnt)
           and Invalid (Ctx, F_TSval)
           and Invalid (Ctx, F_TSecr))
       and Has_Buffer (Ctx)
       and not Net.TCP.SACK_Blocks.Has_Buffer (Seq_Ctx)
       and Ctx.Buffer_First = Ctx.Buffer_First'Old
       and Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and Ctx.First = Ctx.First'Old
       and Ctx.Last = Ctx.Last'Old
       and Seq_Ctx.First = Seq_Ctx.First'Old
       and Seq_Ctx.Last = Seq_Ctx.Last'Old
       and Net.TCP.SACK_Blocks.Valid (Seq_Ctx) = Net.TCP.SACK_Blocks.Valid (Seq_Ctx)'Old
       and Net.TCP.SACK_Blocks.Size (Seq_Ctx) = Net.TCP.SACK_Blocks.Size (Seq_Ctx)'Old
       and Field_First (Ctx, F_SACK_Blocks) = Field_First (Ctx, F_SACK_Blocks)'Old
       and Field_Size (Ctx, F_SACK_Blocks) = Field_Size (Ctx, F_SACK_Blocks)'Old
       and Context_Cursor (Ctx, F_Kind) = Context_Cursor (Ctx, F_Kind)'Old
       and Context_Cursor (Ctx, F_Length) = Context_Cursor (Ctx, F_Length)'Old
       and Context_Cursor (Ctx, F_Max_Seg_Size) = Context_Cursor (Ctx, F_Max_Seg_Size)'Old,
     Depends =>
       (Ctx => (Ctx, Seq_Ctx), Seq_Ctx => Seq_Ctx);

   function Context_Cursor (Ctx : Context; Fld : Field) return Field_Cursor
   with
     Annotate =>
       (GNATprove, Inline_For_Proof),
     Ghost;

   function Context_Cursors (Ctx : Context) return Field_Cursors
   with
     Annotate =>
       (GNATprove, Inline_For_Proof),
     Ghost;

   function Context_Cursors_Index (Cursors : Field_Cursors; Fld : Field) return Field_Cursor
   with
     Annotate =>
       (GNATprove, Inline_For_Proof),
     Ghost;

private

   type Cursor_State is (S_Valid, S_Well_Formed, S_Invalid, S_Incomplete);

   type Field_Cursor is
      record
         State : Cursor_State := S_Invalid;
         First : RFLX_Types.Bit_Index := RFLX_Types.Bit_Index'First;
         Last : RFLX_Types.Bit_Length := RFLX_Types.Bit_Length'First;
         Value : RFLX_Types.Base_Integer := 0;
      end record;

   type Field_Cursors is array (Virtual_Field) of Field_Cursor;

   function Well_Formed (Cursor : Field_Cursor) return Boolean is
     (Cursor.State = S_Valid
      or Cursor.State = S_Well_Formed);

   function Valid (Cursor : Field_Cursor) return Boolean is
     (Cursor.State = S_Valid);

   function Invalid (Cursor : Field_Cursor) return Boolean is
     (Cursor.State = S_Invalid
      or Cursor.State = S_Incomplete);

   pragma Warnings (Off, "postcondition does not mention function result");

   function Cursors_Invariant (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length) return Boolean is
     ((for all F in Field =>
          (if
              Well_Formed (Cursors (F))
           then
              Cursors (F).First >= First
              and Cursors (F).Last <= Verified_Last
              and Cursors (F).First <= Cursors (F).Last + 1
              and Valid_Value (F, Cursors (F).Value))))
   with
     Post =>
       True;

   pragma Warnings (On, "postcondition does not mention function result");

   pragma Warnings (Off, "formal parameter ""*"" is not referenced");

   pragma Warnings (Off, "postcondition does not mention function result");

   pragma Warnings (Off, "unused variable ""*""");

   function Valid_Predecessors_Invariant (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length) return Boolean is
     ((if Well_Formed (Cursors (F_Kind)) then True)
      and then (if
                   Well_Formed (Cursors (F_Length))
                then
                   (Valid (Cursors (F_Kind))
                    and then (RFLX_Types.Base_Integer (Cursors (F_Kind).Value) = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.Timestamps))
                              or else RFLX_Types.Base_Integer (Cursors (F_Kind).Value) = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.SACK))
                              or else RFLX_Types.Base_Integer (Cursors (F_Kind).Value) = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.SACK_Permitted))
                              or else RFLX_Types.Base_Integer (Cursors (F_Kind).Value) = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.Maximum_Segment_Size))
                              or else RFLX_Types.Base_Integer (Cursors (F_Kind).Value) = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.Window_Scale)))))
      and then (if
                   Well_Formed (Cursors (F_Max_Seg_Size))
                then
                   (Valid (Cursors (F_Length))
                    and then RFLX_Types.Base_Integer (Cursors (F_Kind).Value) = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.Maximum_Segment_Size))
                    and then RFLX_Types.Base_Integer (Cursors (F_Length).Value) = (TCP.Max_Seg_Size'Size + TCP.Kind'Size + TCP.Length'Size) / 8))
      and then (if
                   Well_Formed (Cursors (F_SACK_Blocks))
                then
                   (Valid (Cursors (F_Length))
                    and then RFLX_Types.Base_Integer (Cursors (F_Kind).Value) = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.SACK))))
      and then (if
                   Well_Formed (Cursors (F_Shift_Cnt))
                then
                   (Valid (Cursors (F_Length))
                    and then RFLX_Types.Base_Integer (Cursors (F_Kind).Value) = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.Window_Scale))
                    and then RFLX_Types.Base_Integer (Cursors (F_Length).Value) = (TCP.Shift_Cnt'Size + TCP.Kind'Size + TCP.Length'Size) / 8))
      and then (if
                   Well_Formed (Cursors (F_TSval))
                then
                   (Valid (Cursors (F_Length))
                    and then RFLX_Types.Base_Integer (Cursors (F_Kind).Value) = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.Timestamps))
                    and then RFLX_Types.Base_Integer (Cursors (F_Length).Value) = (TCP.TSecr'Size + TCP.TSval'Size + TCP.Kind'Size + TCP.Length'Size) / 8))
      and then (if Well_Formed (Cursors (F_TSecr)) then Valid (Cursors (F_TSval))))
   with
     Pre =>
       Cursors_Invariant (Cursors, First, Verified_Last),
     Post =>
       True;

   pragma Warnings (On, "unused variable ""*""");

   pragma Warnings (On, "postcondition does not mention function result");

   pragma Warnings (On, "formal parameter ""*"" is not referenced");

   pragma Warnings (Off, "postcondition does not mention function result");

   function Valid_Next_Internal (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length; Fld : Field) return Boolean is
     (case Fld is
          when F_Kind =>
             True,
          when F_Length =>
             (Valid (Cursors (F_Kind))
              and then (RFLX_Types.Base_Integer (Cursors (F_Kind).Value) = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.Timestamps))
                        or else RFLX_Types.Base_Integer (Cursors (F_Kind).Value) = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.SACK))
                        or else RFLX_Types.Base_Integer (Cursors (F_Kind).Value) = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.SACK_Permitted))
                        or else RFLX_Types.Base_Integer (Cursors (F_Kind).Value) = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.Maximum_Segment_Size))
                        or else RFLX_Types.Base_Integer (Cursors (F_Kind).Value) = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.Window_Scale)))),
          when F_Max_Seg_Size =>
             (Valid (Cursors (F_Length))
              and then (RFLX_Types.Base_Integer (Cursors (F_Kind).Value) = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.Maximum_Segment_Size))
                        and then RFLX_Types.Base_Integer (Cursors (F_Length).Value) = (TCP.Max_Seg_Size'Size + TCP.Kind'Size + TCP.Length'Size) / 8)),
          when F_SACK_Blocks =>
             (Valid (Cursors (F_Length))
              and then RFLX_Types.Base_Integer (Cursors (F_Kind).Value) = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.SACK))),
          when F_Shift_Cnt =>
             (Valid (Cursors (F_Length))
              and then (RFLX_Types.Base_Integer (Cursors (F_Kind).Value) = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.Window_Scale))
                        and then RFLX_Types.Base_Integer (Cursors (F_Length).Value) = (TCP.Shift_Cnt'Size + TCP.Kind'Size + TCP.Length'Size) / 8)),
          when F_TSval =>
             (Valid (Cursors (F_Length))
              and then (RFLX_Types.Base_Integer (Cursors (F_Kind).Value) = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.Timestamps))
                        and then RFLX_Types.Base_Integer (Cursors (F_Length).Value) = (TCP.TSecr'Size + TCP.TSval'Size + TCP.Kind'Size + TCP.Length'Size) / 8)),
          when F_TSecr =>
             (Valid (Cursors (F_TSval))
              and then True))
   with
     Pre =>
       Cursors_Invariant (Cursors, First, Verified_Last)
       and then Valid_Predecessors_Invariant (Cursors, First, Verified_Last, Written_Last),
     Post =>
       True;

   pragma Warnings (On, "postcondition does not mention function result");

   pragma Warnings (Off, "unused variable ""*""");

   pragma Warnings (Off, "formal parameter ""*"" is not referenced");

   function Field_Size_Internal (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length; Fld : Field) return RFLX_Types.Bit_Length'Base is
     (case Fld is
          when F_Kind | F_Length =>
             8,
          when F_Max_Seg_Size =>
             16,
          when F_SACK_Blocks =>
             RFLX_Types.Bit_Length (Cursors (F_Length).Value) * 8 - RFLX_Types.Bit_Length (Cursors (F_Kind).Last - Cursors (F_Kind).First + 1) - RFLX_Types.Bit_Length (Cursors (F_Length).Last - Cursors (F_Length).First + 1),
          when F_Shift_Cnt =>
             8,
          when F_TSval | F_TSecr =>
             32)
   with
     Pre =>
       Cursors_Invariant (Cursors, First, Verified_Last)
       and then Valid_Predecessors_Invariant (Cursors, First, Verified_Last, Written_Last)
       and then Valid_Next_Internal (Cursors, First, Verified_Last, Written_Last, Fld);

   pragma Warnings (On, "formal parameter ""*"" is not referenced");

   pragma Warnings (On, "unused variable ""*""");

   pragma Warnings (Off, "postcondition does not mention function result");

   pragma Warnings (Off, "unused variable ""*""");

   pragma Warnings (Off, "no recursive call visible");

   pragma Warnings (Off, "formal parameter ""*"" is not referenced");

   function Field_First_Kind (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length) return RFLX_Types.Bit_Index'Base is
     (First)
   with
     Pre =>
       Cursors_Invariant (Cursors, First, Verified_Last)
       and then Valid_Predecessors_Invariant (Cursors, First, Verified_Last, Written_Last)
       and then Valid_Next_Internal (Cursors, First, Verified_Last, Written_Last, F_Kind);

   function Field_First_Length (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length) return RFLX_Types.Bit_Index'Base is
     (First + 8)
   with
     Pre =>
       Cursors_Invariant (Cursors, First, Verified_Last)
       and then Valid_Predecessors_Invariant (Cursors, First, Verified_Last, Written_Last)
       and then Valid_Next_Internal (Cursors, First, Verified_Last, Written_Last, F_Length);

   function Field_First_Max_Seg_Size (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length) return RFLX_Types.Bit_Index'Base is
     (First + 16)
   with
     Pre =>
       Cursors_Invariant (Cursors, First, Verified_Last)
       and then Valid_Predecessors_Invariant (Cursors, First, Verified_Last, Written_Last)
       and then Valid_Next_Internal (Cursors, First, Verified_Last, Written_Last, F_Max_Seg_Size);

   function Field_First_SACK_Blocks (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length) return RFLX_Types.Bit_Index'Base is
     (First + 16)
   with
     Pre =>
       Cursors_Invariant (Cursors, First, Verified_Last)
       and then Valid_Predecessors_Invariant (Cursors, First, Verified_Last, Written_Last)
       and then Valid_Next_Internal (Cursors, First, Verified_Last, Written_Last, F_SACK_Blocks);

   function Field_First_Shift_Cnt (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length) return RFLX_Types.Bit_Index'Base is
     (First + 16)
   with
     Pre =>
       Cursors_Invariant (Cursors, First, Verified_Last)
       and then Valid_Predecessors_Invariant (Cursors, First, Verified_Last, Written_Last)
       and then Valid_Next_Internal (Cursors, First, Verified_Last, Written_Last, F_Shift_Cnt);

   function Field_First_TSval (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length) return RFLX_Types.Bit_Index'Base is
     (First + 16)
   with
     Pre =>
       Cursors_Invariant (Cursors, First, Verified_Last)
       and then Valid_Predecessors_Invariant (Cursors, First, Verified_Last, Written_Last)
       and then Valid_Next_Internal (Cursors, First, Verified_Last, Written_Last, F_TSval);

   function Field_First_TSecr (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length) return RFLX_Types.Bit_Index'Base is
     (First + 48)
   with
     Pre =>
       Cursors_Invariant (Cursors, First, Verified_Last)
       and then Valid_Predecessors_Invariant (Cursors, First, Verified_Last, Written_Last)
       and then Valid_Next_Internal (Cursors, First, Verified_Last, Written_Last, F_TSecr);

   function Field_First_Internal (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length; Fld : Field) return RFLX_Types.Bit_Index'Base is
     (case Fld is
          when F_Kind =>
             Field_First_Kind (Cursors, First, Verified_Last, Written_Last),
          when F_Length =>
             Field_First_Length (Cursors, First, Verified_Last, Written_Last),
          when F_Max_Seg_Size =>
             Field_First_Max_Seg_Size (Cursors, First, Verified_Last, Written_Last),
          when F_SACK_Blocks =>
             Field_First_SACK_Blocks (Cursors, First, Verified_Last, Written_Last),
          when F_Shift_Cnt =>
             Field_First_Shift_Cnt (Cursors, First, Verified_Last, Written_Last),
          when F_TSval =>
             Field_First_TSval (Cursors, First, Verified_Last, Written_Last),
          when F_TSecr =>
             Field_First_TSecr (Cursors, First, Verified_Last, Written_Last))
   with
     Pre =>
       Cursors_Invariant (Cursors, First, Verified_Last)
       and then Valid_Predecessors_Invariant (Cursors, First, Verified_Last, Written_Last)
       and then Valid_Next_Internal (Cursors, First, Verified_Last, Written_Last, Fld),
     Post =>
       True;

   pragma Warnings (On, "formal parameter ""*"" is not referenced");

   pragma Warnings (On, "no recursive call visible");

   pragma Warnings (On, "unused variable ""*""");

   pragma Warnings (On, "postcondition does not mention function result");

   pragma Warnings (Off, """Buffer"" is not modified, could be of access constant type");

   pragma Warnings (Off, "postcondition does not mention function result");

   function Valid_Context (Buffer_First, Buffer_Last : RFLX_Types.Index; First : RFLX_Types.Bit_Index; Last : RFLX_Types.Bit_Length; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length; Buffer : RFLX_Types.Bytes_Ptr; Cursors : Field_Cursors) return Boolean is
     ((if
          Buffer /= null
       then
          Buffer'Length > 0
          and Buffer'First = Buffer_First
          and Buffer'Last = Buffer_Last)
      and then (RFLX_Types.To_Index (First) >= Buffer_First
                and RFLX_Types.To_Index (Last) <= Buffer_Last
                and Buffer_Last < RFLX_Types.Index'Last
                and First <= Last + 1
                and Last < RFLX_Types.Bit_Index'Last
                and First rem RFLX_Types.Byte'Size = 1
                and Last rem RFLX_Types.Byte'Size = 0)
      and then First - 1 <= Verified_Last
      and then First - 1 <= Written_Last
      and then Verified_Last <= Written_Last
      and then Written_Last <= Last
      and then First rem RFLX_Types.Byte'Size = 1
      and then Last rem RFLX_Types.Byte'Size = 0
      and then Verified_Last rem RFLX_Types.Byte'Size = 0
      and then Written_Last rem RFLX_Types.Byte'Size = 0
      and then Cursors_Invariant (Cursors, First, Verified_Last)
      and then Valid_Predecessors_Invariant (Cursors, First, Verified_Last, Written_Last)
      and then ((if
                    Well_Formed (Cursors (F_Kind))
                 then
                    (Cursors (F_Kind).Last - Cursors (F_Kind).First + 1 = 8
                     and then Cursors (F_Kind).First = First))
                and then (if
                             Well_Formed (Cursors (F_Length))
                          then
                             (Cursors (F_Length).Last - Cursors (F_Length).First + 1 = 8
                              and then Cursors (F_Length).First = Cursors (F_Kind).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_Max_Seg_Size))
                          then
                             (Cursors (F_Max_Seg_Size).Last - Cursors (F_Max_Seg_Size).First + 1 = 16
                              and then Cursors (F_Max_Seg_Size).First = Cursors (F_Length).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_SACK_Blocks))
                          then
                             (Cursors (F_SACK_Blocks).Last - Cursors (F_SACK_Blocks).First + 1 = RFLX_Types.Bit_Length (Cursors (F_Length).Value) * 8 - RFLX_Types.Bit_Length (Cursors (F_Kind).Last - Cursors (F_Kind).First + 1) - RFLX_Types.Bit_Length (Cursors (F_Length).Last - Cursors (F_Length).First + 1)
                              and then Cursors (F_SACK_Blocks).First = Cursors (F_Length).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_Shift_Cnt))
                          then
                             (Cursors (F_Shift_Cnt).Last - Cursors (F_Shift_Cnt).First + 1 = 8
                              and then Cursors (F_Shift_Cnt).First = Cursors (F_Length).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_TSval))
                          then
                             (Cursors (F_TSval).Last - Cursors (F_TSval).First + 1 = 32
                              and then Cursors (F_TSval).First = Cursors (F_Length).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_TSecr))
                          then
                             (Cursors (F_TSecr).Last - Cursors (F_TSecr).First + 1 = 32
                              and then Cursors (F_TSecr).First = Cursors (F_TSval).Last + 1))))
   with
     Post =>
       True;

   pragma Warnings (On, """Buffer"" is not modified, could be of access constant type");

   pragma Warnings (On, "postcondition does not mention function result");

   type Context (Buffer_First, Buffer_Last : RFLX_Types.Index := RFLX_Types.Index'First; First : RFLX_Types.Bit_Index := RFLX_Types.Bit_Index'First; Last : RFLX_Types.Bit_Length := RFLX_Types.Bit_Length'First) is
      record
         Verified_Last : RFLX_Types.Bit_Length := First - 1;
         Written_Last : RFLX_Types.Bit_Length := First - 1;
         Buffer : RFLX_Types.Bytes_Ptr := null;
         Cursors : Field_Cursors := (others => <>);
      end record
   with
     Dynamic_Predicate =>
       Valid_Context (Context.Buffer_First, Context.Buffer_Last, Context.First, Context.Last, Context.Verified_Last, Context.Written_Last, Context.Buffer, Context.Cursors);

   function Initialized (Ctx : Context) return Boolean is
     (Ctx.Verified_Last = Ctx.First - 1
      and then Valid_Next (Ctx, F_Kind)
      and then Net.TCP.Option.Field_First (Ctx, Net.TCP.Option.F_Kind) rem RFLX_Types.Byte'Size = 1
      and then Available_Space (Ctx, F_Kind) = Ctx.Last - Ctx.First + 1
      and then (for all F in Field =>
                   Invalid (Ctx, F)));

   function Read (Ctx : Context) return RFLX_Types.Bytes is
     (Ctx.Buffer.all (RFLX_Types.To_Index (Ctx.First) .. RFLX_Types.To_Index (Ctx.Verified_Last)));

   function Has_Buffer (Ctx : Context) return Boolean is
     (Ctx.Buffer /= null);

   function Buffer_Length (Ctx : Context) return RFLX_Types.Length is
     (Ctx.Buffer'Length);

   function Buffer_Size (Ctx : Context) return RFLX_Types.Bit_Length is
     (Ctx.Buffer'Length * RFLX_Types.Byte'Size);

   function Size (Ctx : Context) return RFLX_Types.Bit_Length is
     (Ctx.Verified_Last - Ctx.First + 1);

   function Byte_Size (Ctx : Context) return RFLX_Types.Length is
     (RFLX_Types.To_Length (Size (Ctx)));

   function Message_Last (Ctx : Context) return RFLX_Types.Bit_Length is
     (Ctx.Verified_Last);

   function Written_Last (Ctx : Context) return RFLX_Types.Bit_Length is
     (Ctx.Written_Last);

   function Valid_Value (Fld : Field; Val : RFLX_Types.Base_Integer) return Boolean is
     (case Fld is
          when F_Kind =>
             Net.TCP.Valid_Kind (Val),
          when F_Length =>
             Net.TCP.Valid_Length (Val),
          when F_Max_Seg_Size =>
             Net.TCP.Valid_Max_Seg_Size (Val),
          when F_SACK_Blocks =>
             True,
          when F_Shift_Cnt =>
             Net.TCP.Valid_Shift_Cnt (Val),
          when F_TSval =>
             Net.TCP.Valid_TSval (Val),
          when F_TSecr =>
             Net.TCP.Valid_TSecr (Val));

   function Field_Condition (Ctx : Context; Fld : Field; Val : RFLX_Types.Base_Integer) return Boolean is
     (case Fld is
          when F_Kind =>
             Val = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.End_Of_Option_List))
             or else Val = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.No_Operation))
             or else Val = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.Timestamps))
             or else Val = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.SACK))
             or else Val = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.SACK_Permitted))
             or else Val = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.Maximum_Segment_Size))
             or else Val = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.Window_Scale)),
          when F_Length =>
             (RFLX_Types.Base_Integer (Ctx.Cursors (F_Kind).Value) = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.SACK_Permitted))
              and then Val = (TCP.Kind'Size + TCP.Length'Size) / 8)
             or else (RFLX_Types.Base_Integer (Ctx.Cursors (F_Kind).Value) = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.Maximum_Segment_Size))
                      and then Val = (TCP.Max_Seg_Size'Size + TCP.Kind'Size + TCP.Length'Size) / 8)
             or else RFLX_Types.Base_Integer (Ctx.Cursors (F_Kind).Value) = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.SACK))
             or else (RFLX_Types.Base_Integer (Ctx.Cursors (F_Kind).Value) = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.Window_Scale))
                      and then Val = (TCP.Shift_Cnt'Size + TCP.Kind'Size + TCP.Length'Size) / 8)
             or else (RFLX_Types.Base_Integer (Ctx.Cursors (F_Kind).Value) = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.Timestamps))
                      and then Val = (TCP.TSecr'Size + TCP.TSval'Size + TCP.Kind'Size + TCP.Length'Size) / 8),
          when F_Max_Seg_Size | F_SACK_Blocks | F_Shift_Cnt | F_TSval | F_TSecr =>
             True);

   function Field_Size (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Length is
     (Field_Size_Internal (Ctx.Cursors, Ctx.First, Ctx.Verified_Last, Ctx.Written_Last, Fld));

   function Field_First (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Index is
     (Field_First_Internal (Ctx.Cursors, Ctx.First, Ctx.Verified_Last, Ctx.Written_Last, Fld));

   function Field_Last (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Length is
     (Field_First (Ctx, Fld) + Field_Size (Ctx, Fld) - 1);

   function Valid_Next (Ctx : Context; Fld : Field) return Boolean is
     (Valid_Next_Internal (Ctx.Cursors, Ctx.First, Ctx.Verified_Last, Ctx.Written_Last, Fld));

   function Available_Space (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Length is
     (Ctx.Last - Field_First (Ctx, Fld) + 1);

   function Sufficient_Space (Ctx : Context; Fld : Field) return Boolean is
     (Available_Space (Ctx, Fld) >= Field_Size (Ctx, Fld));

   function Present (Ctx : Context; Fld : Field) return Boolean is
     (Well_Formed (Ctx.Cursors (Fld))
      and then Ctx.Cursors (Fld).First < Ctx.Cursors (Fld).Last + 1);

   function Well_Formed (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Valid
      or Ctx.Cursors (Fld).State = S_Well_Formed);

   function Valid (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Valid
      and then Ctx.Cursors (Fld).First < Ctx.Cursors (Fld).Last + 1);

   function Incomplete (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Incomplete);

   function Invalid (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Invalid
      or Ctx.Cursors (Fld).State = S_Incomplete);

   function Well_Formed_Message (Ctx : Context) return Boolean is
     ((Valid (Ctx, F_Kind)
       and then (RFLX_Types.Base_Integer (Ctx.Cursors (F_Kind).Value) = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.End_Of_Option_List))
                 or else RFLX_Types.Base_Integer (Ctx.Cursors (F_Kind).Value) = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.No_Operation))))
      or else (Valid (Ctx, F_Length)
               and then RFLX_Types.Base_Integer (Ctx.Cursors (F_Kind).Value) = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.SACK_Permitted))
               and then RFLX_Types.Base_Integer (Ctx.Cursors (F_Length).Value) = (TCP.Kind'Size + TCP.Length'Size) / 8)
      or else Valid (Ctx, F_Max_Seg_Size)
      or else Well_Formed (Ctx, F_SACK_Blocks)
      or else Valid (Ctx, F_Shift_Cnt)
      or else Valid (Ctx, F_TSecr));

   function Valid_Message (Ctx : Context) return Boolean is
     ((Valid (Ctx, F_Kind)
       and then (RFLX_Types.Base_Integer (Ctx.Cursors (F_Kind).Value) = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.End_Of_Option_List))
                 or else RFLX_Types.Base_Integer (Ctx.Cursors (F_Kind).Value) = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.No_Operation))))
      or else (Valid (Ctx, F_Length)
               and then RFLX_Types.Base_Integer (Ctx.Cursors (F_Kind).Value) = RFLX_Types.Base_Integer (To_Base_Integer (Net.TCP.SACK_Permitted))
               and then RFLX_Types.Base_Integer (Ctx.Cursors (F_Length).Value) = (TCP.Kind'Size + TCP.Length'Size) / 8)
      or else Valid (Ctx, F_Max_Seg_Size)
      or else Valid (Ctx, F_SACK_Blocks)
      or else Valid (Ctx, F_Shift_Cnt)
      or else Valid (Ctx, F_TSecr));

   function Incomplete_Message (Ctx : Context) return Boolean is
     ((for some F in Field =>
          Incomplete (Ctx, F)));

   function Get_Kind (Ctx : Context) return Net.TCP.Kind is
     (To_Actual (Ctx.Cursors (F_Kind).Value));

   function Get_Length (Ctx : Context) return Net.TCP.Length is
     (To_Actual (Ctx.Cursors (F_Length).Value));

   function Get_Max_Seg_Size (Ctx : Context) return Net.TCP.Max_Seg_Size is
     (To_Actual (Ctx.Cursors (F_Max_Seg_Size).Value));

   function Get_Shift_Cnt (Ctx : Context) return Net.TCP.Shift_Cnt is
     (To_Actual (Ctx.Cursors (F_Shift_Cnt).Value));

   function Get_TSval (Ctx : Context) return Net.TCP.TSval is
     (To_Actual (Ctx.Cursors (F_TSval).Value));

   function Get_TSecr (Ctx : Context) return Net.TCP.TSecr is
     (To_Actual (Ctx.Cursors (F_TSecr).Value));

   function Valid_Size (Ctx : Context; Fld : Field; Size : RFLX_Types.Bit_Length) return Boolean is
     (Size = Field_Size (Ctx, Fld))
   with
     Pre =>
       Net.TCP.Option.Valid_Next (Ctx, Fld);

   function Valid_Length (Ctx : Context; Fld : Field; Length : RFLX_Types.Length) return Boolean is
     (Valid_Size (Ctx, Fld, RFLX_Types.To_Bit_Length (Length)));

   function Complete_SACK_Blocks (Ctx : Context; Seq_Ctx : Net.TCP.SACK_Blocks.Context) return Boolean is
     (Net.TCP.SACK_Blocks.Valid (Seq_Ctx)
      and Net.TCP.SACK_Blocks.Size (Seq_Ctx) = Field_Size (Ctx, F_SACK_Blocks));

   function Context_Cursor (Ctx : Context; Fld : Field) return Field_Cursor is
     (Ctx.Cursors (Fld));

   function Context_Cursors (Ctx : Context) return Field_Cursors is
     (Ctx.Cursors);

   function Context_Cursors_Index (Cursors : Field_Cursors; Fld : Field) return Field_Cursor is
     (Cursors (Fld));

end Net.TCP.Option;
