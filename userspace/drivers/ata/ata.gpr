project ATA is

    for Languages use ("Ada");

    for Object_Dir use "build";

    for Source_Dirs use (".");

    for Main use ("main.adb");

    for Runtime ("Ada") use "../../runtime";

    for Library_Dir use "";

    -- For gprbuild
    package Builder is

        for Executable ("main.adb") use "ata.drv";

        for Default_Switches ("Ada") use
        (
            "-g",
            "-gnatwa",
            "-gnatw.X",
            "-s",
            "-v",
            "-nostdlib"
        );
    end Builder;

    -- For compiler & assembler
    package Compiler is
        for Default_Switches ("Ada") use
        (
            "-O2",
            "-fstack-usage",
            "-fomit-frame-pointer",
            "-mno-red-zone",
            "-fno-pic",
            "-mno-sse",
            "-mno-sse2"
        );
    end Compiler;

    -- For binder
    package Binder is
        for Default_Switches ("Ada") use
        (
            "-d_C"
        );
    end Binder;

end ATA;
