project Filesystem is

    for Languages use ("Ada");

    for Object_Dir use "build";

    for Source_Dirs use (".");

    for Main use ("main.adb");

    for Runtime ("Ada") use "../../runtime";

    for Library_Dir use "";

    -- For gprbuild
    package Builder is

        for Executable ("main.adb") use "filesystem.svc";

        for Default_Switches ("Ada") use
        (
            "-g",
            "-gnatwa",
            "-gnatw.X",
            "-s",
            "-v",
            "-nostdlib"
        );
    end Builder;

    -- For compiler & assembler
    package Compiler is
        for Default_Switches ("Ada") use
        (
            "-O2",
            --  Link-time optimization: inlining across the service's units
            --  (ext2 and the server are split by concern; CODE-002), as
            --  when each was one unit.
            "-flto=auto",
            "-gnat2022",
            "-fstack-usage",
            "-fomit-frame-pointer",
            "-mno-red-zone",
            "-fno-pic"
        );
    end Compiler;

    -- For binder
    package Binder is
        for Default_Switches ("Ada") use
        (
            "-d_C"
        );
    end Binder;

    -- For linker (uses C runtime crt0 + linker script for _start entry)
    package Linker is
        for Default_Switches ("Ada") use
        (
            --  Code is generated at link time: the compiler's code-generation
            --  options again.
            "-flto=auto",
            "-O2",
            "-fomit-frame-pointer",
            "-mno-red-zone",
            "-fno-pic",
            "-nostdlib",
            "-static",
            "-no-pie",
            --  Must equal Process_Layout.Initial_Stack_Bytes: the user runtime
            --  places the secondary stack at Stack_Top - Initial_Stack_Bytes, so a
            --  smaller main stack leaves it unmapped (filesystem.svc faulted at
            --  0x7FFFFF000008, 2026-10-11).
            "-Wl,-z,stack-size=16777216",
            "-lgnat-user",
            "-T", "../../c/link.ld",
            "../../c/build/crt0.o"
        );
    end Linker;

end Filesystem;
