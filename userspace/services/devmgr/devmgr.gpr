project Devmgr is

    for Languages use ("Ada");

    for Object_Dir use "build";

    for Source_Dirs use (".", "../filesystem", "../xhci", "../../ccl/src", "../../lib/time");

    for Main use ("main.adb");

    --  Explicit list excludes other service mains and hardware adapters.
    for Source_Files use ("main.adb", "cpio.ads", "cpio.adb", "ccl.ads",
       "boot_rtc.ads", "boot_rtc.adb", "civil_time.ads", "civil_time.adb",
       "xhci_dma_layout.ads", "xhci_dma_layout.adb",
       "xhci_capabilities.ads", "xhci_capabilities.adb",
       "ccl-bounded_stacks.ads", "ccl-bounded_stacks.adb",
       "ccl-checked_arithmetic.ads", "ccl-checked_arithmetic.adb",
       "ccl-execution_budgets.ads", "ccl-execution_budgets.adb",
       "ccl-ownership.ads", "ccl-ownership.adb",
       "ccl-imports.ads", "ccl-imports.adb",
       "ccl-ownership-bytecode.ads", "ccl-ownership-bytecode.adb",
       "ccl-secondary_stacks.ads", "ccl-secondary_stacks.adb",
       "ccl-vm.ads", "ccl-vm.adb",
       "ccl-host_values.ads", "ccl-host_values.adb",
       "ccl-catalog.ads", "ccl-catalog.adb",
       "ccl-language.ads", "ccl-language.adb",
       "ccl-declarations.ads", "ccl-declarations.adb",
       "ccl-configurations.ads", "ccl-configurations.adb");

    for Runtime ("Ada") use "../../runtime";

    for Library_Dir use "";

    -- For gprbuild
    package Builder is

        for Executable ("main.adb") use "devmgr.svc";

        for Default_Switches ("Ada") use
        (
            "-g",
            "-gnatwa",
            "-gnatw.X",
            "-s",
            "-v",
            "-nostdlib"
        );
    end Builder;

    -- For compiler & assembler
    package Compiler is
        for Default_Switches ("Ada") use
        (
            "-O2", "-gnat2022",
            "-fstack-usage",
            "-fomit-frame-pointer",
            "-mno-red-zone",
            "-fno-pic",
            "-mno-sse",
            "-mno-sse2"
        );
    end Compiler;

    -- For binder
    package Binder is
        for Default_Switches ("Ada") use
        (
            "-d_C"
        );
    end Binder;

    -- For linker (uses C runtime crt0 + linker script for _start entry)
    package Linker is
        for Default_Switches ("Ada") use
        (
            "-nostdlib",
            "-static",
            "-no-pie",
            "-Wl,-z,stack-size=16777216",
            "-lgnat-user",
            "-T", "../../c/link.ld",
            "../../c/build/crt0.o"
        );
    end Linker;

end Devmgr;
