project Devmgr is

    for Languages use ("Ada");

    for Object_Dir use "build";

    for Source_Dirs use (".", "../filesystem", "../xhci", "../intel-gpu", "../../ccl/src", "../../lib/time", "../../mesa/anv", "../../lib/display", "../../lib/logging");

    for Main use ("main.adb");

    --  Explicit list excludes other service mains and hardware adapters.
    for Source_Files use ("main.adb", "cpio.ads", "cpio.adb", "ccl.ads",
       --  Warnings kept until logstore runs (CAP-001 diagnostics).
       "deferred_warnings.ads", "deferred_warnings.adb",
       --  Children by name, for their exit lines.
       "devmgr_children.ads", "devmgr_children.adb",
       --  Message-signaled interrupts (docs/msi-interrupts.md).
       "pci_message_interrupts.ads", "pci_message_interrupts.adb",
       "pci_message_functions.ads", "pci_message_functions.adb",
       "driver_manifests.ads", "driver_manifests.adb",
       --  Launching children by handle (CAP-002).
       "devmgr_launches.ads", "devmgr_launches.adb",
       "devmgr_authority.ads", "devmgr_authority.adb",
       "fs_attachments.ads",
       "ccl-resource_sections.ads", "ccl-resource_sections.adb",
       "boot_rtc.ads", "boot_rtc.adb", "rtc_decode.ads", "rtc_decode.adb", "rtc_sampling.ads", "rtc_sampling.adb", "civil_time.ads", "civil_time.adb",
       "intel_gpu_probe.ads", "intel_gpu_probe.adb",
       "intel_gpu_broker_request.ads", "intel_gpu_broker_request.adb",
       "intel_gpu_broker_launches.ads", "intel_gpu_broker_launches.adb",
       "intel_gpu_render_sessions.ads", "intel_gpu_render_sessions.adb",
       "intel_render_admission.ads", "intel_render_admission.adb",
       "intel_render_admission_native.ads", "intel_render_admission_native.adb",
       "intel_render_admission_dispatch.ads", "intel_render_admission_dispatch.adb",
       "intel_render_broker.ads", "intel_render_broker.adb",
       "native_gpu_probe_protocol.ads", "native_gpu_probe_protocol.adb",
       "intel_gpu_resources.ads", "intel_gpu_resources.adb",
       "intel_gpu_reset_pages.ads",
       "intel_gpu_display_pages.ads",
       "intel_gpu_pipe_pages.ads", "intel_gpu_modeset_pages.ads",
       "intel_gpu_phy_pages.ads", "intel_gpu_phy_pages.adb",
       "intel_gpu_phy_registers.ads",
       "intel_gpu_combo_phy.ads", "intel_gpu_combo_phy.adb",
       "intel_gpu_ads_backing.ads",
       "intel_gpu_buffer_backing.ads",
       "intel_gpu_extent_allocator.ads", "intel_gpu_extent_allocator.adb",
       "intel_gpu_extent_growth.ads", "intel_gpu_extent_growth.adb",
       "intel_gpu_extent_directory.ads", "intel_gpu_extent_directory.adb",
       "intel_gpu_record_store.ads", "intel_gpu_record_store.adb",
       "intel_gpu_record_growth.ads", "intel_gpu_record_growth.adb",
       "intel_gpu_allocation_growth.ads", "intel_gpu_allocation_growth.adb",
       "intel_gpu_metadata_arena.ads", "intel_gpu_metadata_arena.adb",
       "intel_gpu_metadata_initialize.ads", "intel_gpu_metadata_initialize.adb",
       "intel_gpu_metadata_platform.ads", "intel_gpu_metadata_platform.adb",
       "intel_gpu_va_placement.ads", "intel_gpu_va_placement.adb",
       "intel_gpu_physical_extents.ads", "intel_gpu_physical_extents.adb",
       "intel_gpu_buffer_reply.ads", "intel_gpu_buffer_reply.adb",
       "intel_gpu_display_claim.ads", "intel_gpu_display_claim.adb",
       "intel_gpu_boot.ads", "intel_gpu_boot.adb",
       "intel_gpu_pci_power.ads", "intel_gpu_pci_power.adb",
       "intel_gpu_pci_interrupts.ads", "intel_gpu_pci_interrupts.adb",
       "intel_gpu_pci_irq_disable.ads", "intel_gpu_pci_irq_disable.adb",
       "intel_gpu_ggtt_access.ads", "intel_gpu_ggtt_access.adb",
       "intel_gpu_ggtt.ads", "intel_gpu_ggtt.adb",
       "xhci_dma_layout.ads", "xhci_dma_layout.adb",
       "xhci_capabilities.ads", "xhci_capabilities.adb",
       "ccl-bounded_stacks.ads", "ccl-bounded_stacks.adb",
       "ccl-checked_arithmetic.ads", "ccl-checked_arithmetic.adb",
       "ccl-execution_budgets.ads", "ccl-execution_budgets.adb",
       "ccl-ownership.ads", "ccl-ownership.adb",
       "ccl-imports.ads", "ccl-imports.adb",
       "ccl-ownership-bytecode.ads", "ccl-ownership-bytecode.adb",
       "ccl-secondary_stacks.ads", "ccl-secondary_stacks.adb",
       "ccl-secondary_arrays.ads", "ccl-secondary_arrays.adb",
       "ccl-vm.ads", "ccl-vm.adb",
       "ccl-vm-machine.ads", "ccl-vm-machine.adb", "ccl-vm-operations.ads", "ccl-vm-operations.adb", "ccl-vm-scalar_ops.ads", "ccl-vm-scalar_ops.adb", "ccl-vm-text_ops.ads", "ccl-vm-text_ops.adb",
       "ccl-vm-data_ops.ads", "ccl-vm-data_ops.adb", "ccl-vm-list_ops.ads", "ccl-vm-list_ops.adb", "ccl-vm-call_ops.ads", "ccl-vm-call_ops.adb", "ccl-vm-local_ops.ads", "ccl-vm-local_ops.adb",
       "ccl-vm-results.ads", "ccl-vm-results.adb", "ccl-vm-verifier_state.ads", "ccl-vm-verifier_state.adb", "ccl-vm-verifier_values.ads", "ccl-vm-verifier_values.adb", "ccl-vm-verifier_texts.ads", "ccl-vm-verifier_texts.adb",
       "ccl-vm-verifier_flow.ads", "ccl-vm-verifier_flow.adb", "ccl-vm-verifier_tables.ads", "ccl-vm-verifier_tables.adb", "ccl-vm-verifier_sweep.ads", "ccl-vm-verifier_sweep.adb",
       "ccl-streams.ads", "ccl-types-shapes.ads", "ccl-types-shapes.adb",
       "ccl-text_operations.ads", "ccl-text_operations.adb",
       "ccl-list_operations.ads", "ccl-list_operations.adb",
       "ccl-resources.ads", "ccl-resources.adb",
       "ccl-resource_policies.ads", "ccl-resource_policies.adb",
      "ccl-host_values.ads", "ccl-host_values.adb",
      "ccl-handler_references.ads", "ccl-handler_references.adb",
       "ccl-catalog.ads", "ccl-catalog.adb",
       "ccl-language.ads", "ccl-language.adb",
       "ccl-types.ads", "ccl-types.adb",
       "ccl-types-correspondence.ads", "ccl-types-correspondence.adb",
       "ccl-objects.ads", "ccl-objects.adb",
       "ccl-objects-catalog.ads", "ccl-objects-catalog.adb",
       "ccl-objects-values.ads", "ccl-objects-values.adb",
       "ccl-objects-views.ads", "ccl-objects-views.adb",
       "ccl-declarations.ads", "ccl-declarations.adb",
       --  Declarations are evaluated compiled, on the VM (CCL.Evaluation).
       "ccl-evaluation.ads", "ccl-evaluation.adb",
       "ccl-compiler.ads", "ccl-compiler.adb",
       "ccl-debug_maps.ads", "ccl-debug_maps.adb",
       "ccl-vm-native_objects.ads", "ccl-vm-native_objects.adb",
       "ccl-vm-resource_values.ads", "ccl-vm-resource_values.adb",
       "ccl-scheduling_limits.ads",
       "ccl-configurations.ads", "ccl-configurations.adb",
       "ccl-typed_settings.ads", "ccl-typed_settings.adb", "ccl-setting_kinds.ads", "ccl-interfaces-desktop_input.ads", "ccl-interfaces-gpu_power.ads", "ccl-interfaces-desktop_display.ads", "ccl-interfaces.ads",
       "ccl-interfaces-desktop_launch.ads", "ccl-interfaces-desktop_launch-icons.ads",
       "ccl-interfaces-calc_types.ads");

    for Runtime ("Ada") use "../../runtime";

    for Library_Dir use "";

    -- For gprbuild
    package Builder is

        for Executable ("main.adb") use "devmgr.svc";

        for Default_Switches ("Ada") use
        (
            "-g",
            "-gnatwa",
            "-gnatw.X",
            "-s",
            "-v",
            "-nostdlib"
        );
    end Builder;

    -- For compiler & assembler
    package Compiler is
        for Default_Switches ("Ada") use
        (
            "-O2", "-gnat2022",
            "-fstack-usage",
            "-fomit-frame-pointer",
            "-mno-red-zone",
            "-fno-pic"
        );
    end Compiler;

    -- For binder
    package Binder is
        for Default_Switches ("Ada") use
        (
            "-d_C"
        );
    end Binder;

    -- For linker (uses C runtime crt0 + linker script for _start entry)
    package Linker is
        for Default_Switches ("Ada") use
        (
            "-nostdlib",
            "-static",
            "-no-pie",
            "-Wl,-z,stack-size=16777216",
            "-lgnat-user",
            "-T", "../../c/link.ld",
            "../../c/build/crt0.o"
        );
    end Linker;

end Devmgr;
