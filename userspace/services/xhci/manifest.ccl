# xhci.drv's authority (docs/ccl-driver-manifests.md, CAP-002). devmgr
# answers every binding when it launches the driver: the register window,
# the interrupter's vector (MSI-X, else MSI), the keyboard and mouse
# publications and its endpoint to devmgr. Sizes are upper bounds; devmgr
# grants what the device reports.
(Executable_Manifest
  identity => "com.cubit.xhci"
  version => "0.1.0"
  device => (Device_Match.PCI_Class (PCI_Class 12 3 48))
  requests => [
    (device-memory "registers" 0 65536 Access.Read_Write)
    # Interrupter 0. MSI-X when the controller has it, else one MSI.
    (interrupt "events" Interrupt_Mode.MSI_X 1)
    (dma "rings" 4194304)
    (notification "mouse" Notify_Access.Publish "mouse-events")
    (notification "keyboard" Notify_Access.Publish "keyboard-events")
    (service "device-manager" "ready")])
