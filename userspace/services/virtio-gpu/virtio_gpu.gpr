project Virtio_GPU is

    for Languages use ("Ada");
    type Test_Mode_Type is ("production", "delayed");
    Test_Mode : Test_Mode_Type := external ("CUBIT_GPU_TEST_MODE", "production");
    case Test_Mode is
        when "production" =>
            for Object_Dir use "build";
            for Source_Dirs use (".", "production");
        when "delayed" =>
            for Object_Dir use "build-delayed";
            for Source_Dirs use (".", "test-delayed");
    end case;
    for Main use ("main.adb");
    for Runtime ("Ada") use "../../runtime";
    for Library_Dir use "";

    package Builder is
        for Executable ("main.adb") use "virtio-gpu.drv";
        for Default_Switches ("Ada") use
        (
            "-g",
            "-gnatwa",
            "-gnatw.X",
            "-s",
            "-v",
            "-nostdlib"
        );
    end Builder;

    package Compiler is
        for Default_Switches ("Ada") use
        (
            "-O2",
            "-fstack-usage",
            "-fomit-frame-pointer",
            "-mno-red-zone",
            "-fno-pic",
            "-mno-sse",
            "-mno-sse2"
        );
    end Compiler;

    package Binder is
        for Default_Switches ("Ada") use ("-d_C");
    end Binder;

    package Linker is
        for Default_Switches ("Ada") use
        (
            "-nostdlib",
            "-static",
            "-no-pie",
            "-Wl,-z,stack-size=16777216",
            "-lgnat-user",
            "-T", "../../c/link.ld",
            "../../c/build/crt0.o"
        );
    end Linker;

end Virtio_GPU;
