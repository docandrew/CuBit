# hda.drv's authority (docs/ccl-driver-manifests.md, CAP-002). devmgr
# answers every binding when it launches the driver: the register window,
# the interrupt (an allocated vector, or the legacy line), its registration,
# the mixer's endpoint and its endpoint to devmgr. devmgr starts one driver
# per controller; only the mixer's output gets the HDA role's registration.
(Executable_Manifest
  identity => "com.cubit.hda"
  version => "0.1.0"
  # HD Audio, and the same controller in DSP-capable mode (Intel 0x80).
  drives => [(Device_Match.PCI_Class (PCI_Class 0x04 0x03 0x00))
             (Device_Match.PCI_Class (PCI_Class 0x04 0x03 0x80))]
  requests => [
    (device-memory "registers" 0 16384 Access.Read_Write)
    (interrupt "controller" Interrupt_Mode.MSI 1)
    (dma "streams" 8388608)
    (notification "hda" Notify_Access.Manage "registration")
    (service "mixer" "mixer")
    (service "device-manager" "ready")]
  optional => ["registration"])
