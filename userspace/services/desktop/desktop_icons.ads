------------------------------------------------------------------------------
--  CuBit
--  Generated by tools/generate_desktop_icons.py; do not edit by hand.
--  Sources: assets/desktop-icons (CuBit originals, make.py) and
--  assets/penny (Penny's own artwork). The pixels are the atlas
--  Assets/cubit-icons/4/applications.qoi (tools/build_icon_assets.py),
--  one column per exported edge (Edges, left to right at Columns), each
--  holding one square per Icon_ID, top to bottom in this order.
------------------------------------------------------------------------------
package Desktop_Icons with Pure is
   --  The design edge: the icon's size at 1x (Deskbar, Apps menu).
   ICON_SIZE : constant := 24;
   --  Every exported edge, ascending; drawn 1:1, never scaled.
   type Edge_Index is range 1 .. 5;
   type Edge_Table is array (Edge_Index) of Positive;
   Edges : constant Edge_Table := [16, 24, 32, 48, 64];
   --  Each edge's column in the atlas: its left pixel.
   type Column_Table is array (Edge_Index) of Natural;
   Columns : constant Column_Table := [0, 16, 40, 72, 120];
   --  ICON_SIZE's place in Edges.
   Design_Edge : constant Edge_Index := 2;
   MAX_EDGE : constant := 64;
   ATLAS_WIDTH : constant := 184;
   type Icon_ID is (
      Start,  --  CuBit logo: purple cube, one teal face
      Workbench,  --  CCL Workbench
      Console,  --  CCL Console
      Logs,  --  Logs
      Trace,  --  Desktop trace
      Doom,  --  DOOM
      Devices,  --  Devices
      Penny,  --  Penny (her own artwork)
      Files,  --  Files
      Gameboy,  --  SameBoy
      Settings,  --  Settings
      Inspector,  --  Config Inspector
      Mesa,  --  Mesa demos
      Boot,  --  Boot Diagnostics
      Power,  --  Power
      Category_System,  --  System category
      Category_Development,  --  Development category
      Category_Web,  --  Web category
      Category_Games,  --  Games category
      Category_Media,  --  Media category
      Category_Tools,  --  Tools category
      Clipboard,  --  Clipboard manager
      Clip_Text,  --  Clipboard text entry
      Clip_Value,  --  Clipboard typed CCL value
      Clip_Mask,  --  Clipboard secret (paste once)
      Clip_Pin,  --  Pinned clipboard entry
      Text,  --  Text editor
      Teapots,  --  Teapots
      Calculator,  --  Calculator
      Dictionary,  --  Dictionary
      Thesaurus,  --  Thesaurus
      Agent,  --  An agent (CTX-001 task entries)
      Archive,  --  An archive
      Status_Wifi,  --  Deskbar status: Wi-Fi
      Status_Battery,  --  Deskbar status: battery
      Status_Volume,  --  Deskbar status: volume
      Status_Muted  --  Deskbar status: volume muted
   );
   ATLAS_HEIGHT : constant := MAX_EDGE * Icon_ID'Range_Length;
   --  Each icon's name, as a Launch_Entry's icon spells it
   --  (CCL.Interfaces.Desktop_Launch.Icons; 'Image is numeric natively).
   function Name_Of (Icon : Icon_ID) return String is
     (case Icon is
         when Start => "Start",
         when Workbench => "Workbench",
         when Console => "Console",
         when Logs => "Logs",
         when Trace => "Trace",
         when Doom => "Doom",
         when Devices => "Devices",
         when Penny => "Penny",
         when Files => "Files",
         when Gameboy => "Gameboy",
         when Settings => "Settings",
         when Inspector => "Inspector",
         when Mesa => "Mesa",
         when Boot => "Boot",
         when Power => "Power",
         when Category_System => "Category_System",
         when Category_Development => "Category_Development",
         when Category_Web => "Category_Web",
         when Category_Games => "Category_Games",
         when Category_Media => "Category_Media",
         when Category_Tools => "Category_Tools",
         when Clipboard => "Clipboard",
         when Clip_Text => "Clip_Text",
         when Clip_Value => "Clip_Value",
         when Clip_Mask => "Clip_Mask",
         when Clip_Pin => "Clip_Pin",
         when Text => "Text",
         when Teapots => "Teapots",
         when Calculator => "Calculator",
         when Dictionary => "Dictionary",
         when Thesaurus => "Thesaurus",
         when Agent => "Agent",
         when Archive => "Archive",
         when Status_Wifi => "Status_Wifi",
         when Status_Battery => "Status_Battery",
         when Status_Volume => "Status_Volume",
         when Status_Muted => "Status_Muted");
end Desktop_Icons;
