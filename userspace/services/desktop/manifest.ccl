# Generated ELF metadata is tied to this executable; requests are not grants.
(executable-manifest v1
  (identity "com.cubit.desktop")
  (version "0.1.0")
  (request-render-optional read-write render)
  (request-service logstore read-write logstore)
  # The bootstrap screen shows recent Warning records (Desktop_Bootstrap_Logs).
  (request-service log-observer read-write log-observer)
  (request-service config read-write config)
  (config-scope (rights read write) "desktop.appearance.")
  # The Apps menu entries (Desktop_Launch).
  (config-scope (rights read) "desktop.launch.")
  # Opt-in detailed tracing; Desktop only reads this operator setting.
  (config-scope (rights read) "desktop.metrics.")
  # Keyboard settings (desktop.input.key-repeat: Desktop_Key_Repeat_Settings).
  (config-scope (rights read) "desktop.input.")
  # Settings > Date & Time (Desktop_Time_Zone_Setting).
  (config-scope (rights read write) "clock.time-zone")
  # Settings > Displays and Monitor: the display scale and each monitor's
  # chosen mode (Desktop_Display_Scale_Settings, Desktop_Display_Mode_Settings);
  # the modeset soak gate is the operator's (read only).
  (config-scope (rights read write) "desktop.display.scale")
  (config-scope (rights read write) "desktop.display.mode.")
  (config-scope (rights read) "desktop.display.modeset")
  (request-service-optional mixer-control read-write mixer-control)
  # The status bar's time; minimal profiles start Desktop without clock.
  (request-service-optional clock read-write clock)
  (request-service display read-write display)
  (request-service process-manager read-write process-manager)
  # Wallpapers and icons (docs/assets.md): read-only, exactly the wallpaper
  # and icon packages on each image's system volume; system.assets.root
  # names the asset root.
  (request-service filesystem read-write filesystem)
  (filesystem-scope (rights read) "@nvme:0/Assets/cubit-wallpapers/")
  (filesystem-scope (rights read) "@cd:0/Assets/cubit-wallpapers/")
  (filesystem-scope (rights read) "@nvme:0/Assets/cubit-icons/")
  (filesystem-scope (rights read) "@cd:0/Assets/cubit-icons/")
  (config-scope (rights read) "system.assets.")
  (request-notification keyboard manage keyboard)
  (request-notification mouse manage mouse)
  (request-notification desktop manage registration))
