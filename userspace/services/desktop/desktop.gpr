with "../../lib/ui/fonts_native.gpr";
project Desktop is

    for Languages use ("Ada");

    type Backend_Type is ("legacy", "mesa");
    Backend : Backend_Type := external ("CUBIT_COMPOSITOR", "legacy");
    Backend_Directory := "backend-" & Backend;
    Backend_Suffix := "";
    case Backend is
        when "legacy" => null;
        when "mesa" => Backend_Suffix := "-mesa";
    end case;

    type Timing_Type is ("off", "on");
    Timing : Timing_Type := external ("CUBIT_COMPOSITOR_TIMING", "off");
    Timing_Directory := "timing-" & Timing;
    case Timing is
        when "off" => null;
        when "on" => Backend_Suffix := Backend_Suffix & "-timing";
    end case;

    type Test_Mode_Type is ("production", "delayed");
    Test_Mode : Test_Mode_Type := external ("CUBIT_DISPLAY_TEST_MODE", "production");
    case Test_Mode is
        when "production" =>
            for Object_Dir use "build" & Backend_Suffix;
            for Source_Dirs use ("../../lib/display", "../../lib/compositor", Backend_Directory, Timing_Directory, ".", "../../lib/theme", "../../lib/ui", "../../ccl/src", "../display/production");
        when "delayed" =>
            for Object_Dir use "build-delayed" & Backend_Suffix;
            for Source_Dirs use ("../../lib/display", "../../lib/compositor", Backend_Directory, Timing_Directory, ".", "../../lib/theme", "../../lib/ui", "../../ccl/src", "../display/test-delayed");
    end case;

    for Main use ("main.adb");

    for Runtime ("Ada") use "../../runtime";

    for Library_Dir use "";

    package Builder is
        for Executable ("main.adb") use "desktop.svc";

        for Default_Switches ("Ada") use
        (
            "-g",
            "-gnatwa",
            "-gnatw.X",
            "-s",
            "-v",
            "-nostdlib"
        );
    end Builder;

    package Compiler is
        for Default_Switches ("Ada") use
        (
            "-O2",
            "-gnat2022",
            "-fstack-usage",
            "-fomit-frame-pointer",
            "-mno-red-zone",
            "-fno-pic",
            "-mno-sse",
            "-mno-sse2"
        );
    end Compiler;

    package Binder is
        for Default_Switches ("Ada") use
        (
            "-d_C"
        );
    end Binder;

    package Linker is
        for Default_Switches ("Ada") use
        (
            "-nostdlib",
            "-static",
            "-no-pie",
            "-Wl,-z,stack-size=16777216",
            "-lgnat-user",
            "-T", "../../c/link.ld",
            "../../c/build/crt0.o",
            "build/manifest.o",
            "build/wallpaper.o",
            "build/wallpaper_cubie.o"
        );
    end Linker;

end Desktop;
