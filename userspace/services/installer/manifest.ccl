# installer.svc (SYS-001): system.disks and system.install. It alone holds
# disk-install (startup-approved); clients reach it through the installer
# role, which is startup-approved too. It reads the install payload (esp/
# and root/) from the live medium's install/ directory.
(Executable_Manifest
  identity => "com.cubit.installer"
  version => "0.1.0"
  requests => [
    (service "disk-install" "disk-install")
    (service "filesystem" "filesystem")
    (service "clock" "clock")
    (service "logstore" "logstore")
    # Registers the "installer" role; clients request the service by name.
    (notification "installer" Notify_Access.Manage "registration")]
  optional => ["logstore"]
  scopes => [
    (filesystem [File_Right.Read] "@cd:0/install")
    (filesystem [File_Right.Read] "@nvme:0/install")])
