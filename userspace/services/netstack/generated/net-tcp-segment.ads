      and then Cursors_Invariant (Cursors, First, Verified_Last)
      and then Valid_Predecessors_Invariant (Cursors, First, Verified_Last, Written_Last, Segment_Length)
      and then ((if
                    Well_Formed (Cursors (F_Source_Port))
                 then
                    (Cursors (F_Source_Port).Last - Cursors (F_Source_Port).First + 1 = 16
                     and then Cursors (F_Source_Port).First = First))
                and then (if
                             Well_Formed (Cursors (F_Destination_Port))
                          then
                             (Cursors (F_Destination_Port).Last - Cursors (F_Destination_Port).First + 1 = 16
                              and then Cursors (F_Destination_Port).First = Cursors (F_Source_Port).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_Sequence_Number))
                          then
                             (Cursors (F_Sequence_Number).Last - Cursors (F_Sequence_Number).First + 1 = 32
                              and then Cursors (F_Sequence_Number).First = Cursors (F_Destination_Port).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_Acknowledgment_Number))
                          then
                             (Cursors (F_Acknowledgment_Number).Last - Cursors (F_Acknowledgment_Number).First + 1 = 32
                              and then Cursors (F_Acknowledgment_Number).First = Cursors (F_Sequence_Number).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_Data_Offset))
                          then
                             (Cursors (F_Data_Offset).Last - Cursors (F_Data_Offset).First + 1 = 4
                              and then Cursors (F_Data_Offset).First = Cursors (F_Acknowledgment_Number).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_Reserved))
                          then
                             (Cursors (F_Reserved).Last - Cursors (F_Reserved).First + 1 = 1
                              and then Cursors (F_Reserved).First = Cursors (F_Data_Offset).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_Reserved_2))
                          then
                             (Cursors (F_Reserved_2).Last - Cursors (F_Reserved_2).First + 1 = 1
                              and then Cursors (F_Reserved_2).First = Cursors (F_Reserved).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_Reserved_3))
                          then
                             (Cursors (F_Reserved_3).Last - Cursors (F_Reserved_3).First + 1 = 1
                              and then Cursors (F_Reserved_3).First = Cursors (F_Reserved_2).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_NS))
                          then
                             (Cursors (F_NS).Last - Cursors (F_NS).First + 1 = 1
                              and then Cursors (F_NS).First = Cursors (F_Reserved_3).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_CWR))
                          then
                             (Cursors (F_CWR).Last - Cursors (F_CWR).First + 1 = 1
                              and then Cursors (F_CWR).First = Cursors (F_NS).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_ECN))
                          then
                             (Cursors (F_ECN).Last - Cursors (F_ECN).First + 1 = 1
                              and then Cursors (F_ECN).First = Cursors (F_CWR).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_URG))
                          then
                             (Cursors (F_URG).Last - Cursors (F_URG).First + 1 = 1
                              and then Cursors (F_URG).First = Cursors (F_ECN).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_ACK))
                          then
                             (Cursors (F_ACK).Last - Cursors (F_ACK).First + 1 = 1
                              and then Cursors (F_ACK).First = Cursors (F_URG).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_PSH))
                          then
                             (Cursors (F_PSH).Last - Cursors (F_PSH).First + 1 = 1
                              and then Cursors (F_PSH).First = Cursors (F_ACK).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_RST))
                          then
                             (Cursors (F_RST).Last - Cursors (F_RST).First + 1 = 1
                              and then Cursors (F_RST).First = Cursors (F_PSH).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_SYN))
                          then
                             (Cursors (F_SYN).Last - Cursors (F_SYN).First + 1 = 1
                              and then Cursors (F_SYN).First = Cursors (F_RST).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_FIN))
                          then
                             (Cursors (F_FIN).Last - Cursors (F_FIN).First + 1 = 1
                              and then Cursors (F_FIN).First = Cursors (F_SYN).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_Window))
                          then
                             (Cursors (F_Window).Last - Cursors (F_Window).First + 1 = 16
                              and then Cursors (F_Window).First = Cursors (F_FIN).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_Checksum))
                          then
                             (Cursors (F_Checksum).Last - Cursors (F_Checksum).First + 1 = 16
                              and then Cursors (F_Checksum).First = Cursors (F_Window).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_Urgent_Pointer))
                          then
                             (Cursors (F_Urgent_Pointer).Last - Cursors (F_Urgent_Pointer).First + 1 = 16
                              and then Cursors (F_Urgent_Pointer).First = Cursors (F_Checksum).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_Options))
                          then
                             (Cursors (F_Options).Last - Cursors (F_Options).First + 1 = RFLX_Types.Bit_Length (Cursors (F_Data_Offset).Value) * 32 + (-RFLX_Types.Bit_Length (Cursors (F_Urgent_Pointer).Last) + RFLX_Types.Bit_Length (Cursors (F_Source_Port).First) - 1)
                              and then Cursors (F_Options).First = Cursors (F_Urgent_Pointer).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_Data))
                          then
                             (Cursors (F_Data).Last - Cursors (F_Data).First + 1 = RFLX_Types.Bit_Length (Segment_Length) * 8 + RFLX_Types.Bit_Length (Cursors (F_Data_Offset).Value) * (-32)
                              and then Cursors (F_Data).First = Cursors (F_Options).Last + 1))))
   with
     Post =>
       True;

   pragma Warnings (On, """Buffer"" is not modified, could be of access constant type");

   pragma Warnings (On, "postcondition does not mention function result");

   type Context (Buffer_First, Buffer_Last : RFLX_Types.Index := RFLX_Types.Index'First; First : RFLX_Types.Bit_Index := RFLX_Types.Bit_Index'First; Last : RFLX_Types.Bit_Length := RFLX_Types.Bit_Length'First; Segment_Length : TCP.Segment_Length := TCP.Segment_Length'First) is
      record
         Verified_Last : RFLX_Types.Bit_Length := First - 1;
         Written_Last : RFLX_Types.Bit_Length := First - 1;
         Buffer : RFLX_Types.Bytes_Ptr := null;
         Cursors : Field_Cursors := (others => <>);
      end record
   with
     Dynamic_Predicate =>
       Valid_Context (Context.Buffer_First, Context.Buffer_Last, Context.First, Context.Last, Context.Verified_Last, Context.Written_Last, Context.Buffer, Context.Cursors, Context.Segment_Length);

   function Initialized (Ctx : Context) return Boolean is
     (Ctx.Verified_Last = Ctx.First - 1
      and then Valid_Next (Ctx, F_Source_Port)
      and then Net.TCP.Segment.Field_First (Ctx, Net.TCP.Segment.F_Source_Port) rem RFLX_Types.Byte'Size = 1
      and then Available_Space (Ctx, F_Source_Port) = Ctx.Last - Ctx.First + 1
      and then (for all F in Field =>
                   Invalid (Ctx, F)));

   function Read (Ctx : Context) return RFLX_Types.Bytes is
     (Ctx.Buffer.all (RFLX_Types.To_Index (Ctx.First) .. RFLX_Types.To_Index (Ctx.Verified_Last)));

   function Has_Buffer (Ctx : Context) return Boolean is
     (Ctx.Buffer /= null);

   function Buffer_Length (Ctx : Context) return RFLX_Types.Length is
     (Ctx.Buffer'Length);

   function Buffer_Size (Ctx : Context) return RFLX_Types.Bit_Length is
     (Ctx.Buffer'Length * RFLX_Types.Byte'Size);

   function Size (Ctx : Context) return RFLX_Types.Bit_Length is
     (Ctx.Verified_Last - Ctx.First + 1);

   function Byte_Size (Ctx : Context) return RFLX_Types.Length is
     (RFLX_Types.To_Length (Size (Ctx)));

   function Message_Last (Ctx : Context) return RFLX_Types.Bit_Length is
     (Ctx.Verified_Last);

   function Written_Last (Ctx : Context) return RFLX_Types.Bit_Length is
     (Ctx.Written_Last);

   function Valid_Value (Fld : Field; Val : RFLX_Types.Base_Integer) return Boolean is
     (case Fld is
          when F_Source_Port | F_Destination_Port =>
             Net.TCP.Valid_Port (Val),
          when F_Sequence_Number =>
             Net.TCP.Valid_Sequence_Number (Val),
          when F_Acknowledgment_Number =>
             Net.TCP.Valid_Acknowledgment_Number (Val),
          when F_Data_Offset =>
             Net.TCP.Valid_Data_Offset (Val),
          when F_Reserved | F_Reserved_2 | F_Reserved_3 | F_NS | F_CWR | F_ECN | F_URG | F_ACK | F_PSH | F_RST | F_SYN | F_FIN =>
             Valid_Boolean (Val),
          when F_Window =>
             Net.TCP.Valid_Window (Val),
          when F_Checksum =>
             Net.TCP.Valid_Checksum (Val),
          when F_Urgent_Pointer =>
             Net.TCP.Valid_Urgent_Pointer (Val),
          when F_Options | F_Data =>
             True);

   function Field_Condition (Ctx : Context; Fld : Field) return Boolean is
     (case Fld is
          when F_Source_Port | F_Destination_Port | F_Sequence_Number | F_Acknowledgment_Number | F_Data_Offset | F_Reserved | F_Reserved_2 | F_Reserved_3 | F_NS | F_CWR | F_ECN | F_URG | F_ACK | F_PSH | F_RST | F_SYN | F_FIN | F_Window | F_Checksum | F_Urgent_Pointer =>
             True,
          when F_Options =>
             RFLX_Types.Base_Integer (Ctx.Segment_Length) >= RFLX_Types.Base_Integer (Ctx.Cursors (F_Data_Offset).Value) * 4,
          when F_Data =>
             True);

   function Field_Size (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Length is
     (Field_Size_Internal (Ctx.Cursors, Ctx.First, Ctx.Verified_Last, Ctx.Written_Last, Ctx.Segment_Length, Fld));

   function Field_First (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Index is
     (Field_First_Internal (Ctx.Cursors, Ctx.First, Ctx.Verified_Last, Ctx.Written_Last, Ctx.Segment_Length, Fld));

   function Field_Last (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Length is
     (Field_First (Ctx, Fld) + Field_Size (Ctx, Fld) - 1);

   function Valid_Next (Ctx : Context; Fld : Field) return Boolean is
     (Valid_Next_Internal (Ctx.Cursors, Ctx.First, Ctx.Verified_Last, Ctx.Written_Last, Ctx.Segment_Length, Fld));

   function Available_Space (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Length is
     (Ctx.Last - Field_First (Ctx, Fld) + 1);

   function Sufficient_Space (Ctx : Context; Fld : Field) return Boolean is
     (Available_Space (Ctx, Fld) >= Field_Size (Ctx, Fld));

   function Present (Ctx : Context; Fld : Field) return Boolean is
     (Well_Formed (Ctx.Cursors (Fld))
      and then Ctx.Cursors (Fld).First < Ctx.Cursors (Fld).Last + 1);

   function Well_Formed (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Valid
      or Ctx.Cursors (Fld).State = S_Well_Formed);

   function Valid (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Valid
      and then Ctx.Cursors (Fld).First < Ctx.Cursors (Fld).Last + 1);

   function Incomplete (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Incomplete);

   function Invalid (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Invalid
      or Ctx.Cursors (Fld).State = S_Incomplete);

   function Well_Formed_Message (Ctx : Context) return Boolean is
     (Well_Formed (Ctx, F_Data));

   function Valid_Message (Ctx : Context) return Boolean is
     (Valid (Ctx, F_Data));

   function Incomplete_Message (Ctx : Context) return Boolean is
     ((for some F in Field =>
          Incomplete (Ctx, F)));

   function Get_Source_Port (Ctx : Context) return Net.TCP.Port is
     (To_Actual (Ctx.Cursors (F_Source_Port).Value));

   function Get_Destination_Port (Ctx : Context) return Net.TCP.Port is
     (To_Actual (Ctx.Cursors (F_Destination_Port).Value));

   function Get_Sequence_Number (Ctx : Context) return Net.TCP.Sequence_Number is
     (To_Actual (Ctx.Cursors (F_Sequence_Number).Value));

   function Get_Acknowledgment_Number (Ctx : Context) return Net.TCP.Acknowledgment_Number is
     (To_Actual (Ctx.Cursors (F_Acknowledgment_Number).Value));

   function Get_Data_Offset (Ctx : Context) return Net.TCP.Data_Offset is
     (To_Actual (Ctx.Cursors (F_Data_Offset).Value));

   function Get_Reserved (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_Reserved).Value));

   function Get_Reserved_2 (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_Reserved_2).Value));

   function Get_Reserved_3 (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_Reserved_3).Value));

   function Get_NS (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_NS).Value));

   function Get_CWR (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_CWR).Value));

   function Get_ECN (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_ECN).Value));

   function Get_URG (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_URG).Value));

   function Get_ACK (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_ACK).Value));

   function Get_PSH (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_PSH).Value));

   function Get_RST (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_RST).Value));

   function Get_SYN (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_SYN).Value));

   function Get_FIN (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_FIN).Value));

   function Get_Window (Ctx : Context) return Net.TCP.Window is
     (To_Actual (Ctx.Cursors (F_Window).Value));

   function Get_Checksum (Ctx : Context) return Net.TCP.Checksum is
     (To_Actual (Ctx.Cursors (F_Checksum).Value));

   function Get_Urgent_Pointer (Ctx : Context) return Net.TCP.Urgent_Pointer is
     (To_Actual (Ctx.Cursors (F_Urgent_Pointer).Value));

   function Valid_Size (Ctx : Context; Fld : Field; Size : RFLX_Types.Bit_Length) return Boolean is
     (Size = Field_Size (Ctx, Fld))
   with
     Pre =>
       Net.TCP.Segment.Valid_Next (Ctx, Fld);

   function Valid_Length (Ctx : Context; Fld : Field; Length : RFLX_Types.Length) return Boolean is
     (Valid_Size (Ctx, Fld, RFLX_Types.To_Bit_Length (Length)));

   function Context_Cursor (Ctx : Context; Fld : Field) return Field_Cursor is
     (Ctx.Cursors (Fld));

   function Context_Cursors (Ctx : Context) return Field_Cursors is
     (Ctx.Cursors);

   function Context_Cursors_Index (Cursors : Field_Cursors; Fld : Field) return Field_Cursor is
     (Cursors (Fld));

end Net.TCP.Segment;
