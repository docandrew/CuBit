# secrets.svc v0 (SEC-022): named secrets in memory only, used through
# grants (CuBit.Secrets_Protocol). Its use grants come from its typed
# startup parameters, so only the trusted startup plan grants them: a
# secret's name and the registered service role allowed to use it.
# Encryption at rest (TPM-sealed on the laptop) is a later slice.
(type Secret_Holder (enum Llm_Service))
(type Secret_Grant (record (secret String) (holder Secret_Holder)))
(type Secrets_Parameters (record (grant Secret_Grant)))
(Executable_Manifest
  identity => "com.cubit.secrets"
  version => "0.1.0"
  requests => [
    (service "logstore" "logstore")
    # Registers the "secrets" role; clients request the service by name.
    (notification "secrets" Notify_Access.Manage "registration")]
  parameters => (Parameter_Signature.Declared "Secrets_Parameters"))
