# nvme.drv's authority (docs/ccl-driver-manifests.md, CAP-002). devmgr
# answers every binding when it launches the driver: the register window,
# the completion interrupt (an allocated vector block), its registration and
# its endpoint to devmgr. The DMA region is devmgr's (launch configuration).
(Executable_Manifest
  identity => "com.cubit.nvme"
  version => "0.1.0"
  device => (Device_Match.PCI_Class (PCI_Class 1 8 2))
  requests => [
    (device-memory "registers" 0 16384 Access.Read_Write)
    # One completion vector; per-queue MSI-X is the next step.
    (interrupt "completion" Interrupt_Mode.MSI_X 1)
    (dma "queues" 1048576)
    (notification "nvme" Notify_Access.Manage "registration")
    (service "device-manager" "ready")])
