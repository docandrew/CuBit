(Executable_Manifest identity => "com.cubit-os.gpio" version => "0.1.0"
  drives => [(Device_Match.ACPI_ID "INTC1057")]
  requests => [
    (device-memory "community0" 0 65536 Access.Read_Write)
    (device-memory "community1" 1 65536 Access.Read_Write)
    (device-memory "community4" 2 65536 Access.Read_Write)
    (device-memory "community5" 3 65536 Access.Read_Write)
    (platform-interrupt "parent" 0)
    (notification "gpio" Notify_Access.Manage "registration")
    (service "device-manager" "ready") (service "logstore" "logstore")]
  optional => ["parent" "logstore"])
