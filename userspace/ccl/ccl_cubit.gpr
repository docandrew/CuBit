library project CCL_CuBit is
   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "build/cubit";
   for Library_Dir use "build/cubit-lib";
   for Library_Name use "ccl_cubit";
   for Library_Kind use "static";
   for Runtime ("Ada") use "../runtime";

   package Builder is
      for Default_Switches ("Ada") use
        ("-gnatwa", "-gnatw.X", "-nostdlib");
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2",
         "-gnat2022",
         "-fstack-usage",
         "-fomit-frame-pointer",
         "-mno-red-zone",
         "-fno-pic",
         "-mno-sse",
         "-mno-sse2",
         "-I-");
   end Compiler;
end CCL_CuBit;
