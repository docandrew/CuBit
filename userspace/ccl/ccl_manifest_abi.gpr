--  Host-build only the pure wire-ABI units (and CuBit.Failures), not the
--  CuBit GNAT runtime.
project CCL_Manifest_ABI is
   for Source_Dirs use ("../runtime/gnat");
   for Source_Files use
     ("cubit.ads", "cubit-render_authority.ads", "cubit-firmware_snapshot_authority.ads",
      "cubit-network_authority.ads", "cubit-network_authority.adb",
      "cubit-tls_scopes.ads", "cubit-tls_scopes.adb",
      "cubit-failures.ads", "cubit-failures.adb",
      --  The canonical-source readers the generated decoders use.
      "cubit-canonical_readers.ads", "cubit-canonical_readers.adb",
      --  The typed-parameter descriptor (.cubit.parameters).
      "cubit-parameter_signatures.ads", "cubit-parameter_signatures.adb",
      "cubit-launch_authority.ads", "cubit-launch_authority.adb",
      "cubit-file_access.ads", "cubit-file_access.adb",
      "cubit-launch_arguments.ads", "cubit-launch_arguments.adb",
      "cubit-launch_grants.ads", "cubit-launch_grants.adb",
      "cubit-program_descriptions.ads", "cubit-program_descriptions.adb",
      "cubit-startup_tables.ads", "cubit-startup_tables.adb",
      "cubit-channel_limits.ads", "cubit-channel_declarations.ads", "cubit-channel_declarations.adb",
      --  Config scopes against the setting catalog (CAP-003).
      "cubit-config_inspection.ads", "cubit-config_inspection.adb");
   for Object_Dir use "build/manifest-abi";
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnatwa", "-gnatwe", "-gnata", "-I-");
   end Compiler;
end CCL_Manifest_ABI;
