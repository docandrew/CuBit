# Build-supplied bindings to today's procmgr registered-service ABI.
# These are compatibility data, NOT compiler builtins, authenticated identities,
# policy approvals, or evidence that an arbitrary runtime provider is trusted.
# Numbers must match the services admitted by the system image composition.
(service-catalog 1
  # Slots below 24 are used by bootstrap/runtime conventions; 63 is reply-only.
  (application-slots 24 62)
  (service filesystem 6 read-write)
  (service desktop 15 read-write)
  (service ccl-test-host 18 read-write)
  (service clock 19 read-write))
