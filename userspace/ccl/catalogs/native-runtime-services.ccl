# Transitional shared-runtime ABI bindings. No policy approval is implied.
# Alternative clients may share a slot; requesting both in one ELF is rejected.
(service-catalog v1
  (application-slots 24 62)
  (service network-stack 3 read-write)
  (service process-manager 4 read-write)
  (service filesystem 6 read-write)
  (service device-manager 7 read-write)
  (service mixer 9 read-write)
  (service config 11 read-write)
  (service logstore 13 read-write)
  (service ipc-test 14 read-write)
  (service desktop 15 read-write)
  (service display 16 read-write)
  (service gpu 17 read-write)
  (service ccl-test-host 18 read-write)
  (service clock 19 read-write)
  (service mixer-control 20 read-write)
  (service log-observer 21 read-write)
  (notification keyboard 1 publish-and-manage)
  (notification mouse 10 publish-and-manage)
  (notification ipc-test-registration 14 publish-and-manage)
  (fixed-binding framebuffer 4)
  (fixed-binding gpu 9)
  (fixed-binding network 11)
  (fixed-binding process-manager 12)
  (fixed-binding keyboard 13)
  (fixed-binding mouse 16)
  (fixed-binding config 20)
  (fixed-binding logstore 23)
  (fixed-binding device-manager 22)
  (fixed-binding test-connect 30)
  (fixed-binding test-listen 31)
  (fixed-binding mixer 14)
  (fixed-binding ipc-test 18)
  (fixed-binding filesystem 1)
  (fixed-binding desktop 21)
  (fixed-binding display 22)
  (fixed-binding files-filesystem 22)
  (fixed-binding clock 25)
  (fixed-binding mixer-control 26)
  (fixed-binding log-observer 27))
