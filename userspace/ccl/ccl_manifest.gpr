project CCL_Manifest is
   for Languages use ("Ada");
   for Source_Dirs use ("src", "tools/ccl-manifest");
   for Object_Dir use "build/manifest";
   for Exec_Dir use "build/manifest";
   for Main use ("main.adb");
   package Builder is
      for Executable ("main.adb") use "ccl-manifest";
   end Builder;
   package Compiler is
      -- Linux host only: assertions/checks stay enabled for this build tool.
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnatwa", "-gnatwe", "-gnata");
   end Compiler;
end CCL_Manifest;
