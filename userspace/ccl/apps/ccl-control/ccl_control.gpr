project CCL_Control is
   for Languages use ("Ada");
   for Source_Dirs use (".", "../../src");
   for Object_Dir use "build";
   for Main use ("main.adb");
   for Runtime ("Ada") use "../../../runtime";
   package Builder is
      for Executable ("main.adb") use "ccl-control.app";
   end Builder;
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnatwa", "-gnatw.X", "-fstack-usage",
         "-fomit-frame-pointer", "-mno-red-zone", "-fno-pic", "-mno-sse", "-mno-sse2");
   end Compiler;
   package Binder is
      for Default_Switches ("Ada") use ("-d_C");
   end Binder;
   package Linker is
      for Default_Switches ("Ada") use
        ("-nostdlib", "-static", "-no-pie", "-Wl,-z,stack-size=16777216",
         "-lgnat-user", "-T", "../../../c/link.ld", "../../../c/build/crt0.o", "build/manifest.o");
   end Linker;
end CCL_Control;
