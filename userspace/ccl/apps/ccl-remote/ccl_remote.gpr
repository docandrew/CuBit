with "../../../lib/ui/fonts_native.gpr";
with "../../../lib/ui/toolkit_flags.gpr";
with "../../../lib/tls/sparktls_cubit.gpr";
project CCL_Remote is
   for Languages use ("Ada");
   for Source_Dirs use
     (".", "build/generated", "../../src", "../../native", "../../remote",
      "../../../lib/ui", "../../../lib/theme", "../../../lib/config", "../../../lib/compositor",
      "../../../lib/display", "../../../allocator/src");
   for Object_Dir use "build";
   for Main use ("main.adb");
   for Runtime ("Ada") use "../../../runtime";
   package Builder is
      for Executable ("main.adb") use "ccl-remote.app";
      for Default_Switches ("Ada") use ("-nostdlib");
   end Builder;
   package Compiler extends Toolkit_Flags.Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnatwa", "-gnatw.X", "-fstack-usage",
         "-fomit-frame-pointer", "-mno-red-zone", "-fno-pic");
      --  Proved (make -C kernel prove-ccl-remote-wire): no run-time checks.
      for Switches ("remote_wire.adb") use
        ("-O3", "-gnatp", "-gnat2022", "-gnatwa", "-fstack-usage",
         "-fomit-frame-pointer", "-mno-red-zone", "-fno-pic", "-fno-tree-vrp");
   end Compiler;
   package Binder is
      for Default_Switches ("Ada") use ("-d_C");
   end Binder;
   package Linker is
      for Default_Switches ("Ada") use
        ("-nostdlib", "-static", "-no-pie", "-Wl,-z,stack-size=16777216",
         "-lgnat-user", "-T", "../../../c/link.ld", "../../../c/build/crt0.o", "build/manifest.o");
   end Linker;
end CCL_Remote;
