# Requested authority only; the existing launch path remains in control.
(Executable_Manifest
  identity => "com.cubit.ccl-workbench"
  version => "0.1.0"
  # Its name for people: the task button's label (UI-061).
  app => (App_Declaration.Declared (App_Presentation name => "CCL Workbench"))
  requests => [
    # One "started" record (CuBit.Logging.Announce).
    (service "logstore" "logstore")
    (service "desktop" "desktop")
    # CCL's time built-ins; without clock.svc they report no wall time.
    (service "clock" "clock")
    # The REPL's (logs.recent "service"): read-only log observation.
    (service "log-observer" "log-observer")
    # (logs.set-minimum ...) / the Logs "Keep" box: what logstore keeps.
    (service "log-control" "log-control")
    # (proc.list): see what runs, through procmgr's observer role.
    (service "process-observer" "process-observer")
    # Development inspector: global non-secret Config read, never write/admin.
    (service "config" "config")
    # (dict ..), (synonym ..), (thesaurus ..), (spell-check ..): lexicon.svc.
    (service "lexicon" "lexicon")
    # (wifi.scan): what the radios heard, through netstack's inspection
    # operations (no network authority).
    (service "network-stack" "network-stack")
    (service "filesystem" "filesystem")]
  optional => ["clock" "lexicon" "network-stack"]
  scopes => [
    (config-all [File_Right.Read])
    # Typed Config playground: never write outside Workbench's own demo namespace.
    (config [File_Right.Read File_Right.Write] "com.cubit.ccl-workbench.demo")
    (filesystem [File_Right.Read File_Right.Write File_Right.Create] "@nvme:0/work")
    (filesystem [File_Right.Read File_Right.Write File_Right.Create] "@mem:0/work")
    # bible.*: the Bible's translations (APP-005), read only.
    (filesystem [File_Right.Read] "@nvme:0/Assets/cubit-bible/")
    (filesystem [File_Right.Read] "@cd:0/Assets/cubit-bible/")])
