# Requested authority only; the existing launch path remains in control.
(executable-manifest v1
  (identity "com.cubit.ccl-workbench")
  (version "0.1.0")
  (request-service desktop read-write desktop)
  (request-service clock read-write clock)
  # The REPL's (logs.recent "service"): read-only log observation.
  (request-service log-observer read-write log-observer)
  # Development inspector: global non-secret Config read, never write/admin.
  (request-service config read-write config)
  (config-scope (rights read) all)
  # Typed Config playground: never write outside Workbench's own demo namespace.
  (config-scope (rights read write) "com.cubit.ccl-workbench.demo")
  (request-service filesystem read-write filesystem)
  (filesystem-scope (rights read write create) "@nvme:0/work")
  (filesystem-scope (rights read write create) "@mem:0/work"))
