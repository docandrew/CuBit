project CCL_Native is
   for Languages use ("Ada");
   for Source_Dirs use ("src", "tests/native");
   for Object_Dir use "build/native";
   for Exec_Dir use "build/native";
   for Main use ("main.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnatwa", "-gnatwe", "-gnata");
   end Compiler;
end CCL_Native;
