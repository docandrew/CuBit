project CCL_Image is
   for Languages use ("Ada");
   for Source_Dirs use ("src", "tools/ccl-image");
   for Object_Dir use "build/image";
   for Exec_Dir use "build/image";
   for Main use ("main.adb");
   package Builder is
      for Executable ("main.adb") use "ccl-image";
   end Builder;
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnatwa", "-gnatwe", "-gnata");
   end Compiler;
end CCL_Image;
