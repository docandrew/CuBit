project CCL_Config_Review is
   for Languages use ("Ada");
   for Source_Dirs use ("src", "tools/ccl-config-review");
   for Object_Dir use "build/config-review";
   for Exec_Dir use "build/config-review";
   for Main use ("main.adb");
   package Builder is
      for Executable ("main.adb") use "ccl-config-review";
   end Builder;
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnatwa", "-gnatwe", "-gnata");
   end Compiler;
end CCL_Config_Review;
