# CCL build declarations (docs/ccl-build.md). Three documents use them:
# - build-params.ccl, one Parameters value: toolchain pins, the runtime,
#   the manifest tool and catalogs, and what every native link shares;
# - build-catalog.ccl, one Build_Catalog value: named code profiles and the
#   libraries components may use;
# - each component's component.ccl, one Component value that names only
#   what differs from them. Its directory is where its component.ccl is.
# Paths are relative to the source tree's root, with no "." or "..".

# A toolchain tree, pinned by its identity (64 lowercase hex digits), and
# the prefix of its program names (x86_64-unknown-linux-musl-gcc). The first
# build on a machine is given the host directory once (--import NAME=PATH);
# Nix store trees are recorded in place, others copied into the store.
(type Toolchain (record (name String) (identity String) (prefix String)))

# One link argument: literal text (no file names), a file from the tree,
# or the component's manifest object (left out when it has no manifest).
(type Link_Argument (variant (Text String) (File String) (Manifest_Object)))

# How Ada code is compiled, by intent; ccl-build turns this into switches.
# Ada_2012 is GNAT's default language version.
(type Ada_Language (enum Ada_2012 Ada_2022))
# Normal is -O2; Maximum is -O3, for proved hot paths.
(type Optimization (enum Normal Maximum))
# Suppressed (-gnatp) only for units whose absence of run-time errors is
# proved.
(type Checks (enum Enabled Suppressed))
(type Frame_Pointer (enum Omitted Kept))
# value_range_propagation false is SPARKNaCl's -fno-tree-vrp workaround.
(type Ada_Code (record
  (language Ada_Language Ada_Language.Ada_2012) (optimization Optimization Optimization.Normal)
  (checks Checks Checks.Enabled) (frame_pointer Frame_Pointer Frame_Pointer.Omitted)
  (value_range_propagation Boolean true)))

# A named code profile (build-catalog.ccl) and units compiled with one.
(type Code_Profile (record (name String) (code Ada_Code)))
(type Unit_Code (record (files (List String)) (profile String)))

# A library components name: source directories compiled into each user,
# units with their own code profile, and archives built elsewhere, linked
# after the component's objects (the font library).
(type Library (record
  (name String) (sources (List String) []) (units (List Unit_Code) []) (archives (List String) [])))

(type Parameters (record
  (toolchain Toolchain) (binutils Toolchain) (runtime String)
  (manifest_tool String) (manifest_schema String)
  (process_manager_catalog String) (device_manager_catalog String)
  (target (List String)) (binder (List String)) (linker (List Link_Argument))))

(type Build_Catalog (record (profiles (List Code_Profile)) (libraries (List Library))))

# Who launches a service: its manifest is checked against that launcher's
# catalog; one the kernel starts has no manifest.
(type Launcher (enum Process_Manager Device_Manager Kernel))

# What a component is. The executable is its name with the kind's suffix
# (.app, .svc, .drv; a tool has none); applications and tools are launched
# by the process manager, drivers by the device manager.
(type Kind (variant (Application) (Service Launcher) (Driver) (Tool)))

# A program's main unit: main.adb, or another file.
(type Main (variant (Conventional) (File String)))

# An Ada program, built per compilation unit: gcc -c for each unit reached
# from main through its .ali files, gnatbind, the binder unit, and the link
# (D5: no gnatlink, gnatmake or gprbuild). Its sources are the Ada files in
# its directory, then in sources, then its libraries' sources, then the
# generated startup bindings; objects go to its directory's build/.
(type Ada_Source (record
  (main Main Main.Conventional) (sources (List String) []) (libraries (List String) [])
  (language Ada_Language Ada_Language.Ada_2012) (optimization Optimization Optimization.Normal)
  (checks Checks Checks.Enabled) (frame_pointer Frame_Pointer Frame_Pointer.Omitted)
  (value_range_propagation Boolean true) (debug_info Boolean true)
  (units (List Unit_Code) []) (link_extra (List Link_Argument) [])))

(type Source (variant (Ada Ada_Source)))

(type Component (record (name String) (kind Kind) (source Source)))
