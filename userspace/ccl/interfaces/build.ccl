# CCL build declarations (docs/ccl-build.md). build-params.ccl at the root
# is one Parameters value: the toolchain pins and the native profile every
# program shares. A component's build.ccl is one Component value that names
# only what differs from the profile. ccl-build reads both by field and
# alternative name and expands the component with its kind's rule family.
# Paths are relative to the source tree's root, with no "." or "..".

# A toolchain tree, pinned by its identity (64 lowercase hex digits), and
# the prefix of its program names (x86_64-unknown-linux-musl-gcc). The first
# build on a machine is given the host directory once (--import NAME=PATH);
# Nix store trees are recorded in place, others copied into the store.
(type Toolchain (record (name String) (identity String) (prefix String)))

# One link argument: literal text (no file names), a file from the tree,
# or the program's manifest object.
(type Link_Argument (variant (Text String) (File String) (Manifest_Object)))

# Switches: the profile's, exactly these, or none (an empty list literal
# needs a type the checker cannot infer yet).
(type Switches (variant (Profile) (Exactly (List String)) (No_Switches)))
(type Linking (variant (Profile) (Exactly (List Link_Argument))))

# A program's main unit: main.adb, or another file.
(type Main (variant (Conventional) (File String)))

# Switches for some units instead of the program's compiler switches (the
# whole list, as gprbuild's per-file Switches replace Default_Switches).
(type Unit_Switches (record (files (List String)) (switches (List String))))

# A library the build parameters name and programs use: per-unit switches
# its units always get (the UI toolkit's pixel loops), after the program's
# builder switches, and archives built elsewhere that programs link after
# their objects (the font library).
(type Library (record (name String) (units (List Unit_Switches) []) (archives (List String) [])))

# Which service catalog a program's manifest is checked against, or none
# for a program without a typed manifest (procmgr).
(type Catalog (enum Native_Runtime Driver No_Manifest))

(type Parameters (record
  (toolchain Toolchain) (binutils Toolchain) (runtime String)
  (manifest_tool String) (manifest_schema String)
  (native_catalog String) (driver_catalog String)
  (compiler (List String)) (binder (List String)) (binder_unit (List String))
  (linker (List Link_Argument)) (builder (List String))))

# build-libraries.ccl: the libraries programs may name.
(type Library_Catalog (record (libraries (List Library))))

# An Ada program, built per compilation unit: gcc -c for each unit reached
# from main through its .ali files, gnatbind, the binder unit, and the link
# (D5: no gnatlink, gnatmake or gprbuild). Its sources are the Ada files in
# directory, then in sources, then the generated startup bindings; objects
# go to directory/build.
(type Ada_Program (record
  (executable String) (directory String) (main Main Main.Conventional)
  (sources (List String) []) (catalog Catalog Catalog.Native_Runtime)
  (compiler Switches Switches.Profile) (binder Switches Switches.Profile)
  (binder_unit Switches Switches.Profile) (linker Linking Linking.Profile)
  (libraries (List String) []) (units (List Unit_Switches) [])
  (builder Switches Switches.Profile)))

(type Component (variant (Ada_Program Ada_Program)))
