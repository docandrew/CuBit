# The other services' settings: tls.svc's host addresses, the least severe
# record logstore keeps, and the Config storage worker's database.
(Setting_Catalog settings => [
  (Setting "tls.hosts" Shape.Key Value.Text Class.Declaration_Managed "")
  (Setting "logs.minimum-level" Shape.Key Value.Text Class.Declaration_Managed "")
  (Setting "cubit.config.storage.database" Shape.Key Value.Text Class.Declaration_Managed "")])
