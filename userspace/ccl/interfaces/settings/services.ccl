# The other services' settings: tls.svc's host addresses, the least severe
# record logstore keeps and how many it retains (Log_Retention), the Config
# storage worker's database, and the installed system's root volume
# (storage.system-volume, "ufs:0"), which devmgr lets the filesystem write
# and logstore persists to.
(Setting_Catalog settings => [
  (Setting "tls.hosts" Shape.Key Value.Text Class.Declaration_Managed "")
  (Setting "logs.minimum-level" Shape.Key Value.Text Class.Declaration_Managed "")
  (Setting "logs.retention" Shape.Key
    (Value.Typed (CCL_Type "CCL.Interfaces.Log_Retention.TYPE_SOURCE" "Log_Retention"))
    Class.Declaration_Managed "Logstore_Retention_Settings")
  (Setting "cubit.config.storage.database" Shape.Key Value.Text Class.Declaration_Managed "")
  (Setting "storage.system-volume" Shape.Key Value.Text Class.Declaration_Managed "")])
