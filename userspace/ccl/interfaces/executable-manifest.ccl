# The executable manifest as CCL types (docs/ccl-typed-manifests.md).
# A manifest.ccl is one expression of type Executable_Manifest, checked
# against these declarations. The manifest tool reads the checked value by
# field and alternative name, then writes the ELF sections. The functions at
# the end are ordinary definitions (smart constructors), not keywords.

(type Access (enum Read Write Read_Write))
(type Notify_Access (enum Publish Manage Publish_And_Manage))
(type Service_Request (record (service String) (binding String) (access Access Access.Read_Write)))
(type Notification_Request (record (notification String) (access Notify_Access) (binding String)))
(type Framebuffer_Request (record (binding String) (access Access Access.Read_Write)))
(type Network_Action (enum TCP_Connect TCP_Listen UDP_Connect))
(type Network_Request (record
  (action Network_Action) (address String) (prefix Integer)
  (first_port Integer) (last_port Integer) (resolve_names Boolean)
  (connections Integer) (binding String)))
(type Device_Memory_Request (record
  (binding String) (index Integer) (max_bytes Integer) (access Access Access.Read_Write)))
(type IO_Port_Request (record (binding String) (index Integer) (count Integer)))
(type Interrupt_Mode (enum MSI_X MSI Line Platform_Line))
(type Interrupt_Request (record
  (binding String) (mode Interrupt_Mode) (vectors Integer 1) (index Integer 0)))
(type DMA_Request (record (binding String) (bytes Integer)))
(type Scheduling_Request (record (binding String) (budget_us Integer) (period_us Integer)))
(type Request (variant
  (Service Service_Request) (Notification Notification_Request) (Network Network_Request)
  (Framebuffer Framebuffer_Request) (Render String) (Optional_Render String) (Device_Memory Device_Memory_Request)
  (IO_Ports IO_Port_Request) (Interrupt Interrupt_Request) (DMA DMA_Request)
  (Scheduling Scheduling_Request)))
(type File_Right (enum Read Write Execute Create))
(type Scope_Place (variant (Everything) (Under String)))
(type Access_Scope (record (rights (List File_Right)) (place Scope_Place)))
(type Scope (variant (Filesystem Access_Scope) (Config Access_Scope) (TLS String)))
# A program's inlets and outlets (docs/ccl-launch-parameters.md, "Inlets and
# outlets, not stdio"): any number, each with a fully qualified name
# (unix.stderr, com.cubit.stdlog), an element type, a signal kind and its
# ring's size. A ported Unix program maps its file descriptors onto them
# (porting glue).
(type Element (enum Text Raw_Bytes Integers Log_Records))
(type Signal (enum Stream Level Edge))
(type Outlet (record (name String) (element Element) (signal Signal Signal.Stream) (pages Integer 1)))
(type Inlet (record (name String) (element Element) (signal Signal Signal.Stream) (pages Integer 1)))
(type Descriptor (record (number Integer) (name String)))
(type PCI_Class (record (class Integer) (subclass Integer) (interface Integer)))
(type PCI_ID (record (vendor Integer) (device Integer)))
(type Platform_Device (enum PS2_Controller ATA_Primary CMOS_RTC))
(type Device_Match (variant (No_Device) (PCI_Class PCI_Class) (PCI_ID PCI_ID) (Platform Platform_Device)))
(type Launch (record (program String) (invoked_as (List String) [])))
# A ported tool's typed parameters and how they render into its argv
# (docs/ccl-launch-parameters.md); file values become delegated places.
# Pieces are written with the variant's constructors: helper functions would
# exceed the CCL program's 16-function limit.
(type Parameter_Kind (enum Input_File Output_File Input_Directory Output_Directory Flag Text))
# in_arguments false: a file or directory delegated as a place only, never
# rendered into argv (a work directory, a toolchain).
(type Parameter (record (name String) (kind Parameter_Kind) (many Boolean false) (required Boolean true) (in_arguments Boolean true)))
(type Conditional_Literal (record (parameter String) (text String)))
(type Argument_Piece (variant (Literal String) (Value String) (When_Set Conditional_Literal)))
(type Executable_Manifest (record
  (identity String) (version String)
  (requests (List Request) []) (scopes (List Scope) [])
  (device Device_Match Device_Match.No_Device) (requests_none Boolean false)
  (may_launch (List Launch) [])
  (parameters (List Parameter) []) (arguments (List Argument_Piece) [])
  (outlets (List Outlet) []) (inlets (List Inlet) []) (descriptors (List Descriptor) [])))

(define (service (name String) (binding String)) Request
  (Request.Service (Service_Request name binding)))
(define (notification (name String) (rights Notify_Access) (binding String)) Request
  (Request.Notification (Notification_Request name rights binding)))
(define (network (action Network_Action) (address String) (prefix Integer) (first-port Integer)
                 (last-port Integer) (dns Boolean) (connections Integer) (binding String)) Request
  (Request.Network (Network_Request action address prefix first-port last-port dns connections binding)))
(define (framebuffer (binding String)) Request (Request.Framebuffer (Framebuffer_Request binding)))
(define (render (binding String)) Request (Request.Render binding))
(define (device-memory (binding String) (bar Integer) (max-bytes Integer) (rights Access)) Request
  (Request.Device_Memory (Device_Memory_Request binding bar max-bytes rights)))
(define (io-ports (binding String) (bar Integer) (ports Integer)) Request
  (Request.IO_Ports (IO_Port_Request binding bar ports)))
(define (interrupt (binding String) (mode Interrupt_Mode) (vectors Integer)) Request
  (Request.Interrupt (Interrupt_Request binding mode vectors)))
(define (platform-interrupt (binding String) (resource Integer)) Request
  (Request.Interrupt (Interrupt_Request binding Interrupt_Mode.Platform_Line index => resource)))
(define (dma (binding String) (bytes Integer)) Request (Request.DMA (DMA_Request binding bytes)))
(define (scheduling (binding String) (budget-us Integer) (period-us Integer)) Request
  (Request.Scheduling (Scheduling_Request binding budget-us period-us)))
(define (filesystem (rights (List File_Right)) (path String)) Scope
  (Scope.Filesystem (Access_Scope rights (Scope_Place.Under path))))
(define (filesystem-all (rights (List File_Right))) Scope
  (Scope.Filesystem (Access_Scope rights Scope_Place.Everything)))
(define (config (rights (List File_Right)) (prefix String)) Scope
  (Scope.Config (Access_Scope rights (Scope_Place.Under prefix))))
(define (config-all (rights (List File_Right))) Scope
  (Scope.Config (Access_Scope rights Scope_Place.Everything)))
(define (tls (pattern String)) Scope (Scope.TLS pattern))

