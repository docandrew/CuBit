project CCL_Secondary_Stacks_Test is
   for Languages use ("Ada");
   for Source_Dirs use ("src", "tests/secondary-stacks");
   for Object_Dir use "build/secondary-stacks";
   for Exec_Dir use "build/secondary-stacks";
   for Main use ("secondary_stacks_test.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnatwa", "-gnatwe", "-gnata");
   end Compiler;
end CCL_Secondary_Stacks_Test;
