--  HOSTED/LINUX Workbench adapter.  SDL is not part of the CuBit runtime.
project CCL_UI_Preview is
   for Languages use ("Ada", "C");
   for Source_Dirs use
     ("src", "tools/ccl-ui-preview", "tools/ccl-ui-preview/host",
      "../lib/ui", "../lib/theme");
   for Object_Dir use "build/ccl-ui-preview";
   for Exec_Dir use "build/ccl-ui-preview";
   for Main use ("main.adb");

   package Builder is
      for Executable ("main.adb") use "ccl-ui-preview";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnatwa", "-gnatwJ", "-gnata");
      for Default_Switches ("C") use ("-O2", "-Wall", "-Wextra", "-Werror");
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use ("-lSDL2");
   end Linker;
end CCL_UI_Preview;
