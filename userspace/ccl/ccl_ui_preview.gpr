--  HOSTED/LINUX Workbench adapter.  SDL is not part of the CuBit runtime.
with "../lib/ui/fonts_host.gpr";
with "ccl_window_host.gpr";
with "cubit_shared.gpr";
project CCL_UI_Preview is
   for Languages use ("Ada");
   for Source_Dirs use ("src", "tools/ccl-ui-preview", "tools/ccl-ui-preview/host",
      "../lib/ui", "../lib/theme", "../lib/compositor", "../lib/display", "../allocator/src");
   --  The root package CuBit comes with cubit_shared.gpr (the runtime's).
   for Excluded_Source_Files use ("cubit.ads");
   for Object_Dir use "build/ccl-ui-preview";
   for Exec_Dir use "build/ccl-ui-preview";
   for Main use ("main.adb", "console_main.adb");

   package Builder is
      for Executable ("main.adb") use "ccl-ui-preview";
      for Executable ("console_main.adb") use "ccl-console-preview";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnatwa", "-gnatwJ", "-gnata");
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use ("-lSDL2");
   end Linker;
end CCL_UI_Preview;
