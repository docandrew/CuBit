library project CCL_Core is
   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "build/core";
   for Library_Dir use "build/lib";
   for Library_Name use "ccl_core";
   for Library_Kind use "static";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnatwa", "-gnatwe");
   end Compiler;
end CCL_Core;
