project CCL_Run is
   for Languages use ("Ada");
   for Source_Dirs use ("src", "tools/ccl-run");
   for Object_Dir use "build/ccl-run";
   for Exec_Dir use "build/ccl-run";
   for Main use ("main.adb");

   package Builder is
      for Executable ("main.adb") use "ccl-run";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnatwa", "-gnatwe", "-gnata");
   end Compiler;
end CCL_Run;

