# GNU ld on CuBit (userspace/ports/binutils): typed parameters over argv
# (docs/ccl-launch-parameters.md). It touches exactly the files a call
# names: each file value is a place the launcher delegates.
(Executable_Manifest
  identity => "org.gnu.binutils.ld"
  version => "2.46"
  requests => [(service "filesystem" "filesystem")]
  outlets => [
    (Outlet "unix.stdout" Element.Text pages => 4)
    (Outlet "unix.stderr" Element.Text pages => 4)]
  descriptors => [(Descriptor 1 "unix.stdout") (Descriptor 2 "unix.stderr")]
  argv => (Argv.Mapped (Argv_Mapping
    parameters => [
      (Argv_Parameter "output" Argv_Kind.Output_File)
      (Argv_Parameter "inputs" Argv_Kind.Input_File many => true)
      (Argv_Parameter "script" Argv_Kind.Input_File required => false)
      (Argv_Parameter "entry" Argv_Kind.Text required => false)
      (Argv_Parameter "static" Argv_Kind.Flag)]
    pieces => [
      (Argv_Piece.When_Set (Conditional_Literal "static" "-static"))
      (Argv_Piece.When_Set (Conditional_Literal "entry" "-e")) (Argv_Piece.Value "entry")
      (Argv_Piece.When_Set (Conditional_Literal "script" "-T")) (Argv_Piece.Value "script")
      (Argv_Piece.Literal "-o") (Argv_Piece.Value "output")
      (Argv_Piece.Value "inputs")])))
