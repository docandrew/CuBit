# GCC on CuBit (userspace/ports/gcc): the gcc driver, installed as
# @nvme:0/toolchain/bin/gcc (configured --prefix=/toolchain). It starts
# cc1 (C), gnat1 (Ada), as and ld by the exact names its search produces,
# resolved like paths by the libc's posix_spawn, and passes on whole the
# places its launcher delegated to it (decision D2); it has no file scopes
# of its own.
#
# Argv parameters (docs/ccl-launch-parameters.md, "Legacy tools"), for the CCL console:
# sources in, one output out. Two places are delegated without appearing in
# argv (in_arguments => false): work, a directory the output must be in, where -save-temps=obj
# keeps the intermediate files (no TMPDIR, so no temporary place); and the
# toolchain, read-only, which the driver passes on to cc1, as and ld with
# the rest. Launchers that need more (tests/gcc) give a raw argv and places.
(Executable_Manifest
  identity => "org.gnu.gcc"
  version => "15.3.0"
  requests => [(service "process-manager" "process-manager") (service "filesystem" "filesystem")]
  may_launch => [
    (Launch "toolchain/libexec/gcc/x86_64-linux-musl/15.3.0/cc1")
    (Launch "toolchain/libexec/gcc/x86_64-linux-musl/15.3.0/gnat1")
    (Launch "toolchain/x86_64-linux-musl/bin/as")
    (Launch "toolchain/x86_64-linux-musl/bin/ld")]
  outlets => [
    (Outlet "unix.stdout" Element.Text pages => 4)
    (Outlet "unix.stderr" Element.Text pages => 4)]
  descriptors => [(Descriptor 1 "unix.stdout") (Descriptor 2 "unix.stderr")]
  argv => (Argv.Mapped (Argv_Mapping
    parameters => [
      (Argv_Parameter "output" Argv_Kind.Output_File)
      (Argv_Parameter "sources" Argv_Kind.Input_File many => true)
      (Argv_Parameter "work" Argv_Kind.Output_Directory in_arguments => false)
      (Argv_Parameter "toolchain" Argv_Kind.Input_Directory in_arguments => false)
      (Argv_Parameter "compile_only" Argv_Kind.Flag)
      (Argv_Parameter "optimize" Argv_Kind.Flag)]
    pieces => [
      (Argv_Piece.When_Set (Conditional_Literal "optimize" "-O2"))
      (Argv_Piece.When_Set (Conditional_Literal "compile_only" "-c"))
      (Argv_Piece.Literal "-save-temps=obj")
      (Argv_Piece.Literal "-o") (Argv_Piece.Value "output")
      (Argv_Piece.Value "sources")])))
