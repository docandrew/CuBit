# Ordinary clock read access only; it must not be able to adjust time.
(executable-manifest v1
  (identity "com.cubit.timesync-check")
  (version "0.1.0")
  # ABI-002: its debug text (CuBit.Console_Route).
  (request-service-optional logstore read-write logstore)
  (request-service clock read-write clock))
