# Logs: every service's records, live. Reads through the log-observer role
# and names sources through procmgr's process-observer role; publishes
# only its own "started" record, may change the minimum logstore keeps
# (log-control), writes nothing else and reaches no network.
(Executable_Manifest
  identity => "com.cubit.logs"
  version => "0.1.0"
  # Its name for people: the task button's label (UI-061).
  app => (App_Declaration.Declared (App_Presentation name => "Logs"))
  requests => [
    # One "started" record (CuBit.Logging.Announce).
    (service "logstore" "logstore")
    (service "desktop" "desktop")
    (service "log-observer" "log-observer")
    # (logs.set-minimum ...) / the Logs "Keep" box: what logstore keeps.
    (service "log-control" "log-control")
    (service "process-observer" "process-observer")])
