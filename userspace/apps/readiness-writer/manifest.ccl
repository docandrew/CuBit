# KERN-013 regression: stores to its own readiness page, which the kernel
# maps read-only. The store must fault and end the program.
(executable-manifest v1
  (identity "com.cubit.readiness-writer")
  (version "0.1.0")
  # ABI-002: its debug text (CuBit.Console_Route).
  (request-service-optional logstore read-write logstore))
