# LOG-004: recurses until its stack reservation runs out, so the kernel
# stops it with a typed fault report ("page fault ... (stack overflow)")
# under its own identity (tests/headless/run.sh, CCL_CONSOLE_DEMO=kernel-log).
# No authority.
(executable-manifest v1
  (identity "com.cubit.stack-probe")
  (version "0.1.0"))
