# Native glyph masks, hashed (tests/headless --test font-masks): the font
# engine's output as CuBit runs it, for comparing builds. No authority.
(executable-manifest v1
  (identity "com.cubit.font-masks")
  (version "0.1.0")
  # ABI-002: its debug text (CuBit.Console_Route).
  (request-service-optional logstore read-write logstore))
