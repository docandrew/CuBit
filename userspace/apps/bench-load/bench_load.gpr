project Bench_Load is
   for Languages use ("Ada");
   for Object_Dir use "build";
   for Source_Dirs use (".", "build/generated");
   for Main use ("main.adb", "input_load.adb", "cpu_control.adb", "heap_load.adb", "sbrk_load.adb", "burn_load.adb",
                 "lock_self.adb", "lock_mutual.adb");
   for Runtime ("Ada") use "../../runtime";
   for Library_Dir use "";

   package Builder is
      for Executable ("main.adb") use "bench-load.app";
      for Executable ("input_load.adb") use "bench-input-load.app";
      for Executable ("cpu_control.adb") use "bench-cpu.app";
      for Executable ("heap_load.adb") use "bench-heap-load.app";
      for Executable ("sbrk_load.adb") use "bench-sbrk-load.app";
      for Executable ("burn_load.adb") use "bench-burn.app";
      for Executable ("lock_self.adb") use "bench-lock-self.app";
      for Executable ("lock_mutual.adb") use "bench-lock-mutual.app";
      for Default_Switches ("Ada") use
        ("-g", "-gnatwa", "-gnatw.X", "-s", "-v", "-nostdlib");
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-fstack-usage", "-fomit-frame-pointer", "-mno-red-zone",
         "-fno-pic");
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-d_C");
   end Binder;

   package Linker is
      for Default_Switches ("Ada") use
        ("-nostdlib", "-static", "-no-pie",
         "-Wl,-z,stack-size=16777216", "-lgnat-user",
         "-T", "../../c/link.ld", "../../c/build/crt0.o",
         "build/manifest.o");
   end Linker;
end Bench_Load;
