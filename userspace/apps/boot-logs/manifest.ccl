(Executable_Manifest
  identity => "com.cubit.boot-logs"
  version => "0.1.0"
  # Its name for people: the task button's label (UI-061).
  app => (App_Declaration.Declared (App_Presentation name => "Boot Diagnostics"))
  requests => [
    (service "desktop" "desktop")
    (service "log-observer" "log-observer")
    # Its own debug text goes into its logstore ring (ABI-002); it never
    # shows its own records back (that would echo them again).
    (service "logstore" "logstore")])
