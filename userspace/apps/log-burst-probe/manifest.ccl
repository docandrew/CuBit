# LOG-005: logs a bring-up's worth of records at startup, then more than its
# ceiling; (logs.recent "log-burst-probe") must return all of them or typed
# gaps with exact counts (tests/headless/run.sh, CCL_CONSOLE_DEMO=log-burst).
(executable-manifest v1
  (identity "com.cubit.log-burst-probe")
  (version "0.1.0")
  (request-service logstore read-write logstore))
