# CuBit Teapots (userspace/apps/teapots): a Vulkan teapot gallery on a GPU
# canvas. The render session is optional: a software start (no Intel GPU,
# QEMU, or no approval) runs with the canvas's placeholder.
(executable-manifest v1
  (identity "com.cubit.teapots")
  (version "0.1.0")
  (request-render-optional read-write render)
  # One "started" record (CuBit.Logging.Announce).
  (request-service logstore read-write logstore)
  (request-service desktop read-write desktop))
