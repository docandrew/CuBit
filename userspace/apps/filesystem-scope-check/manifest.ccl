# Requested authority only; the existing launch path remains in control.
(executable-manifest v1
  (identity "com.cubit.filesystem-scope-check")
  (version "0.1.0")
  (request-service filesystem read-write filesystem)
  (filesystem-scope (rights read) "@nvme:0/scope-allowed")
  (filesystem-scope (rights read write create) "@nvme:0/scope-work"))
