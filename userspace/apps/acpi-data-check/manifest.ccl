# Test-only backend stand-in; broker approval requires the exact validated
# backend identity plus launch-plan hardware and PCI approvals. No policy widening.
(Executable_Manifest
  identity => "com.cubit.acpi-backend"
  version => "0.1.0"
  optional => ["pci-windows"]
  requests => [
    (Request.Firmware_Snapshot "tables")
    (Request.ACPI_Hardware "hardware")
    (service "device-manager" "device-manager")
    (service "acpi-pci-windows" "pci-windows")])
