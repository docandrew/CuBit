# Clipboard regression client (docs/clipboard.md): two text fields, one
# ordinary and one sensitive. Desktop is its only service.
(executable-manifest v1
  (identity "com.cubit.clipboard-check")
  (version "0.1.0")
  # ABI-002: its debug text (CuBit.Console_Route).
  (request-service-optional logstore read-write logstore)
  (request-service desktop read-write desktop))
