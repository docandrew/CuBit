with "../../lib/ui/fonts_native.gpr";
with "../../lib/ui/toolkit_flags.gpr";
--  Dictionary and Thesaurus (docs/lexicon.md): one view, two program images.
project Dictionary is
   for Languages use ("Ada");
   for Object_Dir use "build";
   for Source_Dirs use (".", "build/generated", "../../lib/lexicon", "../../lib/lexicon/channel",
                        "../../lib/ui", "../../lib/theme", "../../lib/compositor", "../../lib/display",
                        "../../allocator/src");
   for Main use ("dictionary_main.adb", "thesaurus_main.adb");
   for Runtime ("Ada") use "../../runtime";
   package Builder is
      for Executable ("dictionary_main.adb") use "dictionary.app";
      for Executable ("thesaurus_main.adb") use "thesaurus.app";
      for Default_Switches ("Ada") use ("-nostdlib");
   end Builder;
   package Compiler extends Toolkit_Flags.Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnatwa", "-fstack-usage",
         "-fomit-frame-pointer", "-mno-red-zone", "-fno-pic");
      --  The lexicon core is proved free of run-time errors (SPARK).
      for Switches ("lexicon_wire.adb") use
        ("-O3", "-gnatp", "-gnat2022", "-gnatwa", "-fomit-frame-pointer", "-mno-red-zone", "-fno-pic",
         "-fno-tree-vrp");
   end Compiler;
   package Binder is
      for Default_Switches ("Ada") use ("-d_C");
   end Binder;
   package Linker is
      for Default_Switches ("Ada") use
        ("-nostdlib", "-static", "-no-pie", "-Wl,-z,stack-size=16777216",
         "-lgnat-user", "-T", "../../c/link.ld", "../../c/build/crt0.o", "build/manifest.o");
   end Linker;
end Dictionary;
