# frame-ticker: a test window that animates every refresh (LAT-002), as
# Teapots does on the laptop, for headless latency tests on a GPU-less VM:
# a bar moves across a small area, which it damages, every 16 ms.
(executable-manifest v1
  (identity "com.cubit.frame-ticker")
  (version "0.1.0")
  # ABI-002: its debug text (CuBit.Console_Route).
  (request-service-optional logstore read-write logstore)
  (request-service desktop read-write desktop))
