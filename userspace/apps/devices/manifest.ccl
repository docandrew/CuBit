# Generated ELF metadata is tied to this executable; requests are not grants.
(Executable_Manifest
  identity => "com.cubit.devices"
  version => "0.1.0"
  # Its name for people: the task button's label (UI-061).
  app => (App_Declaration.Declared (App_Presentation name => "Devices"))
  requests => [
    # One "started" record (CuBit.Logging.Announce).
    (service "logstore" "logstore")
    (service "desktop" "desktop")
    (service "device-manager" "device-manager")])
