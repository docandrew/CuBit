# FIRMWARE_SNAPSHOT regression: a program that declares no firmware snapshot
# reader holds none; the call answers Not_Authorized for any handle.
(executable-manifest v1
  (identity "com.cubit.firmware-undeclared")
  (version "0.1.0")
  # ABI-002: its debug text (CuBit.Console_Route).
  (request-service-optional logstore read-write logstore))
