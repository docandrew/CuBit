with "../../lib/ui/fonts_native.gpr";
project Config_Inspector is
   for Languages use ("Ada");
   for Object_Dir use "build";
   for Source_Dirs use (".", "../../lib/ui", "../../lib/theme");
   for Main use ("main.adb");
   for Runtime ("Ada") use "../../runtime";
   package Builder is
      for Executable ("main.adb") use "config-inspector.app";
      for Default_Switches ("Ada") use ("-nostdlib");
   end Builder;
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnatwa", "-fstack-usage",
         "-fomit-frame-pointer", "-mno-red-zone", "-fno-pic", "-mno-sse", "-mno-sse2");
   end Compiler;
   package Binder is
      for Default_Switches ("Ada") use ("-d_C");
   end Binder;
   package Linker is
      for Default_Switches ("Ada") use
        ("-nostdlib", "-static", "-no-pie", "-Wl,-z,stack-size=16777216",
         "-lgnat-user", "-T", "../../c/link.ld", "../../c/build/crt0.o", "build/manifest.o");
   end Linker;
end Config_Inspector;
