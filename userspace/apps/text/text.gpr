with "../../lib/ui/fonts_native.gpr";
with "../../lib/ui/toolkit_flags.gpr";
project Text is
   for Languages use ("Ada");
   for Object_Dir use "build";
   for Source_Dirs use (".", "native", "../../lib/text", "../../lib/ui", "../../lib/theme", "build/generated", "../../lib/compositor", "../../lib/display", "../../allocator/src");
   for Main use ("main.adb");
   for Runtime ("Ada") use "../../runtime";
   for Library_Dir use "";

   package Builder is
      for Executable ("main.adb") use "text.app";
      for Default_Switches ("Ada") use
        ("-g", "-gnatwa", "-gnatw.X", "-s", "-v", "-nostdlib");
   end Builder;

   package Compiler extends Toolkit_Flags.Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-fstack-usage", "-fomit-frame-pointer",
         "-mno-red-zone", "-fno-pic");
      --  The editor core's proved units (tests/text-editor/run.sh --prove,
      --  level 2, no unproved checks): no runtime checks, -O3.
      Proved := ("-O3", "-gnatp", "-gnat2022", "-fstack-usage", "-fomit-frame-pointer",
                 "-mno-red-zone", "-fno-pic", "-fno-tree-vrp");
      for Switches ("text_utf8.adb") use Proved;
      for Switches ("text_layout.adb") use Proved;
      for Switches ("text_pieces.adb") use Proved;
      for Switches ("text_cursors.adb") use Proved;
      for Switches ("text_marks.adb") use Proved;
      for Switches ("text_history.adb") use Proved;
      for Switches ("text_syntax.adb") use Proved;
      for Switches ("text_search.adb") use Proved;
      for Switches ("text_commands.adb") use Proved;
      for Switches ("text_modal.adb") use Proved;
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-d_C");
   end Binder;

   package Linker is
      for Default_Switches ("Ada") use
        ("-nostdlib", "-static", "-no-pie",
         "-Wl,-z,stack-size=16777216", "-lgnat-user",
         "-T", "../../c/link.ld", "../../c/build/crt0.o",
         "build/manifest.o");
   end Linker;
end Text;
