# CuBit Text (docs/text-editor.md). Requested authority only: it reads the
# volume and writes only under Documents/ (a save writes a sibling there and
# renames it over the file, so it needs create as well as write).
(Executable_Manifest
  identity => "com.cubit.text"
  version => "0.1.0"
  # Its name for people: the task button's label (UI-061).
  app => (App_Declaration.Declared (App_Presentation name => "Text"))
  requests => [
    # One "started" record (CuBit.Logging.Announce).
    (service "logstore" "logstore")
    (service "desktop" "desktop")
    (service "filesystem" "text-filesystem")]
  scopes => [
    (filesystem [File_Right.Read File_Right.Write File_Right.Create] "@nvme:0/Documents/")
    # Recovery copies of unsaved work at shutdown (CuBit.UI.Recovery).
    (filesystem [File_Right.Read File_Right.Write File_Right.Create] "@system/Recovery/com.cubit.text/")
    (filesystem [File_Right.Read] "@nvme:0/")])
