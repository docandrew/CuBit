# Per-CPU times publication checks (KERN-002, CPU_Times_Publication): the
# page granted by its manifest request, read without a system call.
(executable-manifest v1
  (identity "com.cubit.cpu-times-check")
  (version "0.1.0")
  # ABI-002: its debug text (CuBit.Console_Route).
  (request-service-optional logstore read-write logstore)
  (request-publication cpu-times))
