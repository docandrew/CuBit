(Executable_Manifest
  identity => "com.cubit.observatory"
  version => "0.1.0"
  # Its name for people: the task button's label (UI-061).
  app => (App_Declaration.Declared (App_Presentation name => "Observatory"))
  requests => [
    # ABI-002: its debug text (CuBit.Console_Route).
    (service "logstore" "logstore")
    (service "desktop" "desktop")
    (service "metrics-observer" "metrics-observer")]
  optional => ["logstore"])
