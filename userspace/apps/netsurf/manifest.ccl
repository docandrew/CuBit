# Generated ELF metadata is tied to this executable; requests are not grants.
# NetSurf renders pages; the chrome is native CuBit.UI (main.adb).
(executable-manifest v1
  (identity "com.cubit.netsurf")
  (version "0.2.0")
  (request-service desktop read-write desktop)
  # Broad outbound HTTP and HTTPS. Both need independent launch approval
  # for network use; procmgr installs the TLS scope only with it.
  (request-network tcp-connect (ipv4 "0.0.0.0" 0)
    (ports 1 65535) (dns allow)
    (connections 16) network)
  (request-service tls read-write tls)
  (tls-scope "*:1-65535")
  (stream stdout text 4))
