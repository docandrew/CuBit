project checked is
 for Source_Dirs use (".", "../../userspace/services/acpi/lib");
 for Object_Dir use "build-checked/obj";
 for Exec_Dir use "build-checked";
 for Main use ("bulk_ledger_tests.adb", "dense_index_tests.adb", "dynamic_lifecycle_tests.adb", "unavailable_generation_tests.adb");
 package Compiler is
  for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnata", "-gnato");
 end Compiler;
end checked;
