pragma Ada_2022;
with Ada.Text_IO;
with Interfaces;
with AML_Dynamic_Region_Connections;
procedure Dynamic_Lifecycle_Tests is
   package C is new AML_Dynamic_Region_Connections (4);
   use C;
   use type Interfaces.Unsigned_8;
   Run : State;
   Ready : constant Ready_Set := [others => True];
   Accepted, Found : Boolean;
   Item : Region_Identity;
   Space : Interfaces.Unsigned_8;
   Checks : Natural := 0;
   procedure Check (OK : Boolean) is
   begin
      Checks := Checks + 1;
      if not OK then raise Program_Error with "dynamic lifecycle check" & Checks'Image; end if;
   end Check;
begin
   Publish (Run, (1, 7), 3, Accepted);
   Check (Accepted and then Observe (Run, (1, 7)).Current = Pending_Connect);
   Begin_Turn (Run, 1, 1, Accepted); Check (Accepted);
   Take_Next (Run, Ready, Found, Item, Space);
   Check (Found and then Item = Region_Identity'(1, 7) and then Space = 3);
   Finish_Connect (Run, Item, 1, True, Accepted);
   Check (Accepted and then Observe (Run, Item).Current = Connected);
   Retire (Run, Item, Accepted); Check (not Accepted);
   Begin_Disconnect (Run, Item, Accepted); Check (Accepted);
   Finish_Disconnect (Run, Item, True, Accepted);
   Check (Accepted and then Observe (Run, Item).Current = Pending_Connect);
   Begin_Turn (Run, 2, 1, Accepted); Check (Accepted);
   Take_Next (Run, Ready, Found, Item, Space); Check (not Found);
   Begin_Turn (Run, 3, 2, Accepted); Check (Accepted);
   Take_Next (Run, Ready, Found, Item, Space); Check (Found);
   Finish_Connect (Run, Item, 2, False, Accepted);
   Check (Accepted and then Observe (Run, Item).Current = Connect_Failed);
   Begin_Turn (Run, 4, 2, Accepted); Check (Accepted);
   Take_Next (Run, Ready, Found, Item, Space); Check (not Found);
   Begin_Turn (Run, 5, 3, Accepted); Check (Accepted);
   Take_Next (Run, Ready, Found, Item, Space); Check (Found);
   Finish_Connect (Run, Item, 3, True, Accepted);
   Check (Accepted and then Observe (Run, Item).Current = Connected);
   Begin_Disconnect (Run, Item, Accepted); Check (Accepted);
   Finish_Disconnect (Run, Item, False, Accepted);
   Check (Accepted and then Observe (Run, Item).Current = Disconnect_Failed);
   Retire (Run, Item, Accepted); Check (not Accepted);
   Begin_Turn (Run, 6, 4, Accepted); Check (Accepted);
   Take_Next (Run, Ready, Found, Item, Space); Check (not Found);
   Publish (Run, (2, 9), 3, Accepted); Check (Accepted);
   Begin_Turn (Run, 7, 4, Accepted); Check (Accepted);
   Take_Next (Run, Ready, Found, Item, Space);
   Check (Found and then Item = Region_Identity'(2, 9));
   Finish_Connect (Run, Item, 4, True, Accepted); Check (Accepted);
   Retire_Method_Local (Run, Item, Accepted);
   Check (Accepted and then Observe (Run, Item).Current = Absent);
   Publish (Run, (2, 10), 3, Accepted);
   Check (Accepted and then Observe (Run, (2, 9)).Current = Absent);
   Ada.Text_IO.Put_Line ("dynamic lifecycle checks" & Checks'Image);
end Dynamic_Lifecycle_Tests;
