project Slots is
   for Source_Dirs use (".", "../../userspace/services/logstore");
   for Source_Files use ("main.adb", "publisher_slots.ads", "publisher_slots.adb");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-gnato", "-gnatwa", "-gnatwe");
   end Compiler;
end Slots;
