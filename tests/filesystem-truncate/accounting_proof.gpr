project Accounting_Proof is
   for Source_Dirs use ("../../userspace/services/filesystem");
   for Source_Files use ("sector_accounting.ads", "sector_accounting.adb",
                        "ext2_inodes.ads", "inode_mappings.ads", "inode_mappings.adb",
                        "ext2_support.ads", "ext2_support.adb",
                        "block_paths.ads", "block_paths.adb",
                        "block_inventory.ads", "block_inventory.adb",
                        "double_mappings.ads", "double_mappings.adb");
   for Object_Dir use "build/accounting-proof";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-O2", "-I-");
   end Compiler;
end Accounting_Proof;
