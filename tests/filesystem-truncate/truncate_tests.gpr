project Truncate_Tests is
   for Languages use ("Ada");
   for Source_Dirs use
     (".", "fixture", "../../userspace/services/filesystem",
      "../../userspace/runtime/gnat");
   for Source_Files use
     ("main.adb", "open_options_check.adb", "indirect_reads.adb", "path_reads.adb", "admission.adb",
      "overwrites.adb", "allocation_scan.adb", "sector_counts.adb", "object_admission.adb", "inode_slots.adb",
      "resizing.adb", "double_resize.adb", "path_decoding.adb", "volume_admission.ads", "block_paths.ads", "block_paths.adb",
      "sector_accounting.ads", "sector_accounting.adb",
      "block_inventory.ads", "block_inventory.adb",
      "double_mappings.ads", "double_mappings.adb",
      "ext2_inodes.ads", "inode_mappings.ads", "inode_mappings.adb",
      "ext2_support.ads", "ext2_support.adb",
      "ext2.ads", "ext2.adb", "cubit.ads",
      "cubit-messages.ads", "cubit-messages.adb", "cubit-memory_grants.ads",
      "cubit-grant_references.ads",
      "cubit-block_devices.ads", "cubit-block_devices.adb",
      "cubit-filesystems.ads", "cubit-filesystems.adb",
      "cubit-file_access.ads", "cubit-file_access.adb",
      "cubit-directory_paths.ads", "cubit-directory_paths.adb",
      "directory_blocks.ads", "directory_blocks.adb",
      "directory_commit.ads", "directory_commit.adb");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use
     ("main.adb", "open_options_check.adb", "indirect_reads.adb", "path_reads.adb", "admission.adb",
      "overwrites.adb", "allocation_scan.adb", "sector_counts.adb", "object_admission.adb", "inode_slots.adb", "resizing.adb",
      "path_decoding.adb", "double_resize.adb");
   package Compiler is
      --  Never resolve host runtime units from CuBit's source directory.
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-I-");
   end Compiler;
end Truncate_Tests;
