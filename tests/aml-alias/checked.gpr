project Checked is
 for Source_Dirs use (".", "../../userspace/services/acpi/lib", "../../shared/firmware");
 for Object_Dir use "build-checked/obj";
 for Exec_Dir use "build-checked";
 for Main use ("alias_namespace_tests.adb", "alias_runtime_tests.adb", "root_reference_tests.adb");
 package Compiler is
  for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnata", "-gnato");
 end Compiler;
end Checked;
