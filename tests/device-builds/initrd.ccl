# The device-build test (tests/device-builds): the development bootstrap set
# with the device-build settings, whose storage.system-volume makes QEMU's
# UFS disk (the installed laptop's kind of disk) the installed root. The
# filesystem names it @system; programs still come from the development
# disk (@nvme:0).
(system-image v1
  (catalog "cubit-native-v1")
  (layout bootstrap-only)
  (provider "disk")
  (settings "system-device-build")
  (file bootstrap "devmgr" "devmgr.svc")
  (file bootstrap "filesystem" "filesystem.svc")
  (file bootstrap "ramdisk" "ramdisk.drv")
  (file bootstrap "ata" "ata.drv")
  (file bootstrap "nvme" "nvme.drv")
  (file bootstrap "netstack" "netstack.svc")
  (file bootstrap "virtio-net" "virtio-net.drv")
  (file bootstrap "virtio-gpu" "virtio-gpu.drv")
  (file bootstrap "hda" "hda.drv")
  (file bootstrap "rtw89" "rtw89.drv")
  (file bootstrap "mixer" "mixer.svc")
  (file bootstrap "ps2" "ps2.drv")
  (file bootstrap "xhci" "xhci.drv")
  (file bootstrap "virtio-input" "virtio-input.drv")
  (file bootstrap "intel-gpu" "intel-gpu.drv")
  (file bootstrap "ufs" "ufs.drv")
  (file bootstrap "config" "config.svc")
  (file bootstrap "netmgr" "netmgr.svc")
  (file bootstrap "wifi" "wifi.svc")
  (file bootstrap "procmgr" "procmgr.svc")
)
