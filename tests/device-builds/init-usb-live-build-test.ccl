# tests/hardware/init-usb-live-build.ccl as QEMU tests it
# (images/laptop-build-test.ccl): only ccl-remote's pairing display
# differs, the kernel console (serial), so the host side can pair
# (tests/device-builds/run-live.sh checks that nothing else does).
(startup v1
  (start "logstore.svc" (priority 5))
  (start "clock.svc" (priority 5))
  # The agent path (AGENT-002): tls.svc holds the trust store (tls/roots.der)
  # and connects for llm.svc, whose one tls-scope is the Messages API host.
  # timesync keeps the wall clock certificate validation needs.
  (start "tls.svc" (priority 5) (network approve-declared))
  (start "timesync.svc" (priority 5) (network approve-declared))
  (start "config-storage.svc" (priority 5) (role config-storage))
  (start "display.svc" (priority 5))
  # ACPI: the backend holds the FADT I/O windows and serves named
  # registers; acpi.svc (AML, no hardware authority) connects to it.
  # It also gets the read-only PCI segment 0 bus 0 window (ECAM), which
  # serves AML PCI_Config fields and SystemMemory aliases of that window.
  (start "acpi-backend.svc" (priority 5)
    (firmware-snapshot approve-declared) (acpi-hardware approve-declared) (acpi-firmware-data approve-declared)
    (acpi-pci-config approve-declared))
  (start "acpi.svc" (priority 4)
    (firmware-snapshot approve-declared) (acpi-registers approve-declared))
  # Dictionary, thesaurus and spelling (docs/lexicon.md).
  (start "lexicon.svc" (priority 4))
  # GPU rendering is a settings grant (desktop.render.gpu, default on);
  # without a supported GPU devmgr refuses the session and Desktop renders
  # in software. One image for every machine (HW-002).
  # BUG-001: a desktop that fails is started again (procmgr, growing delay).
  (start "desktop.svc" (priority 4) (render setting "desktop.render.gpu")
    (restart on-failure))
  (start "boot-logs.app" (priority 4))
  # tls.svc has registered by now (llm.svc's TLS scope needs it). The API
  # key is the named secret anthropic-api-key, typed into agent.app's
  # masked entry; only llm.svc's registered role may use it (SEC-022).
  (start "secrets.svc" (priority 5)
    (arguments (Secrets_Parameters
      grant => (Secret_Grant secret => "anthropic-api-key" holder => Secret_Holder.Llm_Service))))
  (start "llm.svc" (priority 5) (network approve-declared)
    (arguments (Llm_Service_Parameters
      endpoint => "api.anthropic.com:443" api_key_secret => "anthropic-api-key")))
  # The LAN remote session (tools/cubit-remote) with builds granted
  # (SELF-002): port 8445; the pairing code is shown on the kernel console.
  # Its work root is the system volume's (@system/work: here the live RAM
  # root, @mem:0), where the device-build payload put the workspace
  # (work/remote) beside /toolchain and /storehouse; builds accept no
  # other. An app built here replaces the running one only while the
  # person turns on "Allow app replacement" (the Deskbar's Remote access
  # section, off at boot); screenshots likewise ("Allow screen capture").
  (start "ccl-remote.app" (priority 4) (network approve-declared) (display-capture approve-declared)
    (arguments (Remote_Parameters listen => Remote_Listen.LAN
      display => Pairing_Display.Kernel_Console work => "@system/work"
      files => true builds => true mail => true)))
  # Installing (SYS-001): installer.svc, and the CCL console from this
  # trusted plan, which grants it the installer role: (system.disks) and
  # (system.install ...) are typed there. The install payload
  # (@cd:0/install) carries the image closure and this live RAM root's
  # device-build payload onto the installed root.
  (start "installer.svc" (priority 4))
  (start "ccl-console.app" (priority 3))
)
