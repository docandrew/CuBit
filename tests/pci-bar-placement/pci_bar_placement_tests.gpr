--  Hosted tests and proof of devmgr's BAR placement (PCI-BAR-001, run.sh).
project PCI_BAR_Placement_Tests is
   for Source_Dirs use (".", "../../userspace/services/devmgr");
   for Source_Files use ("main.adb", "pci_bar_placement.ads", "pci_bar_placement.adb");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-O2", "-gnata", "-gnato", "-gnatwa", "-gnatwe");
   end Compiler;
   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--checks-as-errors=on");
   end Prove;
end PCI_BAR_Placement_Tests;
