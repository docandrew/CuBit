project Bench_Runtime is
   --  The CuBit runtime units the filesystem code uses, hosted, with the
   --  benchmark device (fixture) in place of the IPC and kernel units.
   for Languages use ("Ada");
   for Source_Dirs use ("fixture", "../../userspace/runtime/gnat");
   for Source_Files use
     ("cubit.ads", "cubit-messages.ads", "cubit-messages.adb", "cubit-system_facts.ads",
      "cubit-system_facts.adb", "cubit-memory_grants.ads", "cubit-grant_references.ads", "cubit-block_devices.ads",
      "cubit-block_devices.adb", "cubit-filesystems.ads", "cubit-filesystems.adb",
      "cubit-directory_pages.ads", "cubit-directory_pages.adb", "cubit-file_access.ads",
      "cubit-file_access.adb", "cubit-directory_paths.ads", "cubit-directory_paths.adb");
   for Object_Dir use external ("FS_OBJ", "build") & "/runtime";
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-I-");
   end Compiler;
end Bench_Runtime;
