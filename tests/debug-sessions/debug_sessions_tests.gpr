--  DBG-001: hosted test and proof of the debug-session admission and the
--  debug-view page walk (kernel/src/debug_admission, debug_view_walk;
--  shared/capabilities/debug_abi).
project Debug_Sessions_Tests is
   for Source_Dirs use (".", "../../kernel/src", "../../shared/capabilities");
   for Source_Files use ("main.adb", "debug_abi.ads", "debug_admission.ads",
                         "debug_admission.adb", "debug_view_walk.ads",
                         "debug_view_walk.adb", "walk_proof.ads", "walk_proof.adb");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-O2", "-gnata", "-gnato", "-gnatwa", "-gnatwe");
   end Compiler;
end Debug_Sessions_Tests;
