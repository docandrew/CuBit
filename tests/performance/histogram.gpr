project Histogram is
   for Source_Dirs use (".", "build/src");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build";
   for Main use ("histogram_test.adb");
   package Compiler is
      -- Assertions are HOST-TEST ONLY, never kernel/runtime build options.
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-O2");
   end Compiler;
end Histogram;
