project scalar_ledger_count_tests_release is
 for Source_Dirs use ("../../shared/capabilities", "../../shared/firmware", ".", "../aml-scalar-transport", "../../userspace/services/acpi/lib");
 Build_Root := external ("SERVICE_MILESTONE_BUILD", "build-release");
 for Object_Dir use Build_Root & "/obj";
 for Exec_Dir use Build_Root & "/bin";
 for Main use ("scalar_ledger_count_tests.adb");
 package Compiler is
 for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnatp");
 end Compiler;
end scalar_ledger_count_tests_release;
