         6 => ("TEST", AML_Execute.Returned, 16#9ABCDEF0#),
         7 => ("OBS0", AML_Execute.Returned, 16#C#),
         8 => ("FAIL", AML_Execute.Division_By_Zero, 16#0#),
         9 => ("OBS0", AML_Execute.Returned, 16#7B#),
         10 => ("PROB", AML_Execute.Returned, 16#9ABCDEF0#)]];
   function Expected (Item : Case_Number; Step : Step_Number) return Expectation is
     (Goldens (Item, Step));
end Field_Oracle_Data;
