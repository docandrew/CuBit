project Trace_Object_Tests is
   for Source_Dirs use (".", "../../shared/capabilities");
   for Source_Files use ("main.adb", "trace_abi.ads");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--timeout=60");
   end Prove;
end Trace_Object_Tests;
