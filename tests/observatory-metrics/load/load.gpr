project Observatory_Load is
   for Languages use ("Ada");
   for Object_Dir use "build";
   for Source_Dirs use (".", "build/generated");
   for Main use ("main.adb");
   for Runtime ("Ada") use "../../../userspace/runtime";
   package Builder is
      for Executable ("main.adb") use "observatory-load.app";
      for Default_Switches ("Ada") use ("-nostdlib");
   end Builder;
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnatwa", "-fstack-usage",
         "-fomit-frame-pointer", "-mno-red-zone", "-fno-pic",
         "-mno-sse", "-mno-sse2");
   end Compiler;
   package Binder is
      for Default_Switches ("Ada") use ("-d_C");
   end Binder;
   package Linker is
      for Default_Switches ("Ada") use
        ("-nostdlib", "-static", "-no-pie", "-Wl,-z,stack-size=16777216",
         "-lgnat-user", "-T", "../../../userspace/c/link.ld", "../../../userspace/c/build/crt0.o",
         "build/manifest.o");
   end Linker;
end Observatory_Load;
