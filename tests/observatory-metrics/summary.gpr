project Summary is
 for Source_Dirs use (".", "build/source", "../../userspace/lib/observatory",
                      "../../userspace/services/metricsvc");
 for Source_Files use ("main.adb", "observatory_metric_summaries.ads",
   "observatory_metric_summaries.adb", "observatory_metric_queries.ads",
   "observatory_metric_queries.adb", "cubit.ads", "cubit-metric_records.ads",
   "cubit-metric_records.adb", "cubit-metric_protocol.ads",
   "metric_store.ads", "metric_store.adb", "metric_histograms.ads", "metric_histograms.adb");
 for Object_Dir use "build/obj";
 for Exec_Dir use "build";
 for Main use ("main.adb");
 package Compiler is
  for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
 end Compiler;
end Summary;
