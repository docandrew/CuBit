project History is
   for Source_Dirs use ("history", "../../userspace/lib/observatory");
   for Object_Dir use "build/history/obj";
   for Exec_Dir use "build/history";
   for Main use ("history_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-gnato");
   end Compiler;
end History;
