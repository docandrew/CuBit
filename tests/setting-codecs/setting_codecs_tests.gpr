--  Hosted tests of the generated typed-setting decoders against the CCL
--  path (CCL.Typed_Settings).
with "../../userspace/ccl/cubit_shared.gpr";
project Setting_Codecs_Tests is
   for Source_Dirs use (".", "../../userspace/ccl/src");
   for Object_Dir use "build/tests";
   for Exec_Dir use "build/tests";
   for Main use ("setting_codecs_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnatwa", "-g", "-O1");
   end Compiler;
end Setting_Codecs_Tests;
