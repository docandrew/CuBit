# Native CCL Workbench desktop integration profile
(startup v1
  (start "logstore.svc" (test-console approve-declared))
  (start "clock.svc")
  (start "display.svc")
  (start "metrics.svc")
  (start "desktop.svc")
  (start "ccl-workbench.app")
  (start "desktop-metrics-load-observer.app")
  (start "desktop-metrics-load.app")
  (start "desktop-metrics-load.app")
  (start "desktop-metrics-load.app")
  (start "desktop-metrics-load.app")
)
