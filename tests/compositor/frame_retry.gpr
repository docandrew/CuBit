project Frame_Retry is
 for Source_Dirs use (".", "../../userspace/lib/compositor");
 for Source_Files use ("frame_retry_tests.adb", "compositor_damage.ads", "compositor_damage.adb", "compositor_pool.ads", "compositor_pool.adb", "compositor_repaint.ads", "compositor_repaint.adb");
 for Object_Dir use "build/frame-retry/obj";
 for Exec_Dir use "build/frame-retry";
 for Main use ("frame_retry_tests.adb");
 package Compiler is
  for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
 end Compiler;
end Frame_Retry;
