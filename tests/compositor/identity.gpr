project Identity is
   for Source_Dirs use (".", "../../userspace/lib/compositor");
   for Source_Files use ("identity_tests.adb", "compositor_identity.ads");
   for Object_Dir use "build/identity/obj";
   for Exec_Dir use "build/identity";
   for Main use ("identity_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Identity;
