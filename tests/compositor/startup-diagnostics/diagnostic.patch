+with Interfaces; with CuBit.Messages;
+package Desktop_Breadcrumbs is
+ type Stage is (Entered, Init_Before, Init_After, Health_Before, Health_After, Targets_Before, Targets_After, Pipeline_Before, Pipeline_After, Upload_Before, Upload_After, Readback_Before, Readback_After, Selected, Begin_Before, Begin_After, Deferred, Pending, Unsafe, Complete, Submit, Released);
+ procedure Mark (Point : Stage; Sequence : in out Interfaces.Unsigned_64);
+ function Matches (Token : Interfaces.Unsigned_64) return Boolean;
+ procedure Collect (Completion : CuBit.Messages.CompletionEntry);
+end Desktop_Breadcrumbs;
--- /dev/null
+++ b/userspace/services/desktop/desktop_breadcrumbs.adb
@@ -0,0 +1,60 @@
+with CuBit.Logging; with CuBit.Log_Records; with Compositor_Requests;
+package body Desktop_Breadcrumbs is
+ use type Interfaces.Unsigned_64;
+ -- Process-lived one-shot pages. Never recycle, even after a failed receipt.
+ Publishers : array (Stage) of CuBit.Logging.Publisher;
+ Seen : array (Stage) of Boolean := [others => False];
+ Tokens : array (Stage) of Interfaces.Unsigned_64 := [others => 0];
+ function Name (Point : Stage) return String is
+   (case Point is
+      when Entered => "ENTERED",
+      when Init_Before => "INIT_BEFORE",
+      when Init_After => "INIT_AFTER",
+      when Health_Before => "HEALTH_BEFORE",
+      when Health_After => "HEALTH_AFTER",
+      when Targets_Before => "TARGETS_BEFORE",
+      when Targets_After => "TARGETS_AFTER",
+      when Pipeline_Before => "PIPELINE_BEFORE",
+      when Pipeline_After => "PIPELINE_AFTER",
+      when Upload_Before => "UPLOAD_BEFORE",
+      when Upload_After => "UPLOAD_AFTER",
+      when Readback_Before => "READBACK_BEFORE",
+      when Readback_After => "READBACK_AFTER",
+      when Selected => "SELECTED",
+      when Begin_Before => "BEGIN_BEFORE",
+      when Begin_After => "BEGIN_AFTER",
+      when Deferred => "DEFERRED",
+      when Pending => "PENDING",
+      when Unsafe => "UNSAFE",
+      when Complete => "COMPLETE",
+      when Submit => "SUBMIT",
+      when Released => "RELEASED");
+ procedure Mark (Point : Stage; Sequence : in out Interfaces.Unsigned_64) is
+   Token : Interfaces.Unsigned_64;
+   Accepted : Boolean;
+   Value : constant CuBit.Log_Records.Decoded :=
+     CuBit.Log_Records.Make ("DESKTOP-CHECKPOINT: " & Name (Point), CuBit.Log_Records.Information);
+ begin
+   if Seen (Point) then return; end if;
+   Seen (Point) := True;
+   CuBit.Messages.debugPrint ("DESKTOP-CHECKPOINT: " & Name (Point) & ASCII.LF);
+   if not Value.Success then return; end if;
+   Compositor_Requests.Allocate (Sequence, Token);
+   if Token = 0 then return; end if;
+   CuBit.Logging.Emit (Publishers (Point), Value.Value, Token, Accepted);
+   if Accepted then Tokens (Point) := Token; end if;
+ end Mark;
+ function Matches (Token : Interfaces.Unsigned_64) return Boolean is
+   (Token /= 0 and then (for some Point in Stage => Tokens (Point) = Token));
+ procedure Collect (Completion : CuBit.Messages.CompletionEntry) is
+   Handled : Boolean;
+ begin
+   for Point in Stage loop
+     if Tokens (Point) /= 0 and then Tokens (Point) = Completion.Token then
+       CuBit.Logging.Complete (Publishers (Point), Completion, Handled);
+       if Handled then Tokens (Point) := 0; end if;
+       return;
+     end if;
+   end loop;
+ end Collect;
+end Desktop_Breadcrumbs;
