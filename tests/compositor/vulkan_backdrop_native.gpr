project Vulkan_Backdrop_Native is
   for Languages use ("Ada");
   for Source_Dirs use ("../../userspace/lib/compositor", "../../userspace/lib/display");
   for Source_Files use ("compositor_backdrop.ads", "compositor_backdrop.adb",
      "compositor_image_sampling.ads", "compositor_image_sampling.adb", "cubit-display_geometry.ads",
      "cubit-display_geometry.adb", "vulkan_backdrop_binding.ads", "vulkan_backdrop_binding.adb",
      "vulkan_backdrop_ffi.ads", "vulkan_backdrop_ffi.adb");
   for Runtime ("Ada") use "../../userspace/runtime";
   for Object_Dir use "build/vulkan-backdrop-native";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-O2", "-mno-red-zone", "-fno-pic", "-mno-sse", "-mno-sse2");
   end Compiler;
end Vulkan_Backdrop_Native;
