project Source_Loans is
 for Source_Dirs use (".", "../../userspace/lib/compositor");
 for Source_Files use ("compositor_source_loans.ads", "compositor_source_loans.adb", "source_loans_check.ads", "source_loans_tests.adb");
 for Object_Dir use "build/source-loans/obj";
 for Exec_Dir use "build/source-loans";
 for Main use ("source_loans_tests.adb");
 package Compiler is
  for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
 end Compiler;
end Source_Loans;
