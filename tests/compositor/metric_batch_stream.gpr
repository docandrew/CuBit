project Metric_Batch_Stream is
 for Source_Dirs use (".", "../../userspace/lib/compositor", "../../userspace/runtime/gnat");
 for Source_Files use
  ("metric_batch_stream_tests.adb", "compositor_metric_batch_policy.ads", "compositor_metric_batch_policy.adb",
   "compositor_stage_metrics.ads", "compositor_stage_metrics.adb", "compositor_release_metrics.ads", "compositor_release_metrics.adb",
   "compositor_frame_trace.ads", "compositor_frame_trace.adb", "compositor_elapsed.ads",
   "cubit.ads", "cubit-metric_records.ads", "cubit-metric_records.adb", "cubit-metric_batches.ads", "cubit-metric_batches.adb");
 for Object_Dir use "build/metric-batch-stream/obj";
 for Exec_Dir use "build/metric-batch-stream";
 for Main use ("metric_batch_stream_tests.adb");
 package Compiler is
  for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
 end Compiler;
end Metric_Batch_Stream;
