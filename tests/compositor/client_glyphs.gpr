with "../../userspace/lib/ui/fonts_host.gpr";
project Client_Glyphs is
 for Source_Dirs use (".", "../../userspace/lib/ui", "../../userspace/lib/compositor", "../../userspace/lib/display", "../../userspace/allocator/src", "../../userspace/runtime/gnat");
 for Source_Files use ("client_glyphs_tests.adb", "cubit.ads", "cubit-display_geometry.ads", "cubit-display_geometry.adb", "client_glyphs.ads", "client_glyphs.adb", "client_canvas_geometry.ads", "client_canvas_geometry.adb", "compositor_glyph_cache.ads", "compositor_glyph_cache.adb", "compositor_glyph_storage.ads", "compositor_glyph_storage.adb", "compositor_glyph_memory.ads", "compositor_glyph_memory.adb", "compositor_glyph_arena.ads", "compositor_glyph_arena.adb", "compositor_glyph_layout.ads", "compositor_glyph_layout.adb", "compositor_glyph_ffi.ads", "compositor_glyph_ffi.adb", "compositor_glyph_software.ads", "compositor_glyph_software.adb", "compositor_glyph_placement.ads", "compositor_glyph_placement.adb", "compositor_affine.ads", "compositor_affine.adb", "heap_extents.ads", "heap_extents.adb", "compositor_identity.ads");
 for Object_Dir use "build/client-glyphs/obj";
