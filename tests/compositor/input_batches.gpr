project Input_Batches is
   for Source_Dirs use (".", "../../userspace/lib/compositor");
   for Source_Files use ("input_batches_tests.adb",
     "compositor_input_batches.ads", "compositor_input_batches.adb",
     "compositor_input_queue.ads", "compositor_input_queue.adb");
   for Object_Dir use "build/input-batches/obj";
   for Exec_Dir use "build/input-batches";
   for Main use ("input_batches_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Input_Batches;
