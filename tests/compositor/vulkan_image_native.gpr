project Vulkan_Image_Native is
   for Languages use ("Ada");
   for Source_Dirs use ("../../userspace/lib/compositor");
   for Source_Files use ("vulkan_image_owner.ads", "vulkan_image_owner.adb",
      "vulkan_image_ffi.ads", "vulkan_image_ffi.adb",
      "compositor_storage.ads", "compositor_storage.adb");
   for Runtime ("Ada") use "../../userspace/runtime";
   for Object_Dir use "build/vulkan-image-native";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-O2", "-mno-red-zone", "-fno-pic", "-mno-sse", "-mno-sse2");
   end Compiler;
end Vulkan_Image_Native;
