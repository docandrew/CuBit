project Glyph_Layout is
   for Source_Dirs use (".", "../../userspace/lib/compositor", "../../userspace/lib/display", "../../userspace/runtime/gnat");
   for Source_Files use ("glyph_layout_tests.adb", "compositor_glyph_layout.ads", "compositor_glyph_layout.adb", "cubit.ads", "cubit-display_geometry.ads", "cubit-display_geometry.adb");
   for Object_Dir use "build/glyph-layout/obj";
   for Exec_Dir use "build/glyph-layout";
   for Main use ("glyph_layout_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Glyph_Layout;
