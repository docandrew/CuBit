project Damage_Capture is
   for Source_Dirs use (".", "../../userspace/lib/compositor");
   for Source_Files use ("damage_capture_tests.adb", "damage_tests.adb", "compositor_damage.ads", "compositor_damage.adb", "compositor_pool.ads", "compositor_pool.adb");
   for Object_Dir use "build/damage-capture/obj";
   for Exec_Dir use "build/damage-capture";
   for Main use ("damage_capture_tests.adb", "damage_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Damage_Capture;
