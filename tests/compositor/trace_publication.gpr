project Trace_Publication is
 for Source_Dirs use (".", "../../userspace/lib/compositor", "../../userspace/runtime/gnat");
 for Source_Files use ("compositor_elapsed.ads", "compositor_frame_trace.ads", "compositor_frame_trace.adb", "compositor_input_trace.ads", "compositor_input_trace.adb", "compositor_source_trace.ads", "compositor_source_trace.adb", "compositor_render_trace.ads", "compositor_render_trace.adb", "compositor_trace_wire.ads", "compositor_trace_wire.adb", "compositor_trace_publication.ads", "compositor_trace_publication.adb", "compositor_metric_batch_policy.ads", "compositor_metric_batch_policy.adb", "cubit.ads", "cubit-metric_records.ads", "cubit-metric_records.adb", "trace_publication_instances.ads", "trace_publication_check.adb", "metric_batch_policy_tests.adb");
 for Object_Dir use external ("TRACE_PUBLICATION_OUTPUT", "build/trace-publication") & "/obj";
 for Exec_Dir use external ("TRACE_PUBLICATION_OUTPUT", "build/trace-publication");
 for Main use ("trace_publication_check.adb", "metric_batch_policy_tests.adb");
 package Compiler is
 for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato");
 end Compiler;
end Trace_Publication;
