project Close_Request is
 for Source_Dirs use (".", "../../userspace/lib/compositor");
 for Source_Files use ("close_request_tests.adb", "compositor_close_request.ads",
  "compositor_close_request.adb", "compositor_input_queue.ads", "compositor_input_queue.adb");
 for Object_Dir use "build/close-request/obj";
 for Exec_Dir use "build/close-request";
 for Main use ("close_request_tests.adb");
 package Compiler is
  for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
 end Compiler;
end Close_Request;
