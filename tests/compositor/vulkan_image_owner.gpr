project Vulkan_Image_Owner is
   for Languages use ("Ada", "C");
   for Source_Dirs use (".", "../../userspace/lib/compositor");
   for Source_Files use ("vulkan_image_owner_tests.adb", "vulkan_image_owner_mock.c",
     "vulkan_image_owner.ads", "vulkan_image_owner.adb", "vulkan_image_ffi.ads",
     "vulkan_image_ffi.adb", "compositor_storage.ads", "compositor_storage.adb");
   for Object_Dir use "build/vulkan-image-owner/obj";
   for Exec_Dir use "build/vulkan-image-owner";
   for Main use ("vulkan_image_owner_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
      for Default_Switches ("C") use ("-std=c11", "-Wall", "-Wextra", "-Werror", "-O2");
   end Compiler;
end Vulkan_Image_Owner;
