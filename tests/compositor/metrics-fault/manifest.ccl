# Test-only replacement in an isolated headless startup profile.
# Trusted startup grants registration only for this exact service identity.
(executable-manifest v1
  (identity "com.cubit.metrics")
  (version "0.1.0")
  # ABI-002: its debug text (CuBit.Console_Route).
  (request-service-optional logstore read-write logstore)
  (request-notification metrics manage registration))
