project Elapsed is
   for Source_Dirs use (".", "../../userspace/lib/compositor");
   for Source_Files use ("elapsed_tests.adb", "compositor_elapsed.ads");
   for Object_Dir use "build/elapsed/obj";
   for Exec_Dir use "build/elapsed";
   for Main use ("elapsed_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Elapsed;
