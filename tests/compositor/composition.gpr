project Composition is
   for Source_Dirs use (".", "../../userspace/lib/compositor", "../../userspace/lib/display", "../../userspace/runtime/gnat",
                        "../../userspace/services/desktop/backend-mesa", "../../userspace/allocator/src");
   for Languages use ("Ada");
   for Source_Files use
     ("compositor_glyph_software.ads", "compositor_glyph_software.adb", "compositor_glyph_target.ads", "compositor_glyph_target.adb", "compositor_text.ads", "compositor_text.adb", "compositor_glyph_renderer.ads", "compositor_glyph_renderer.adb", "compositor_glyph_storage.ads", "compositor_glyph_storage.adb", "compositor_glyph_placement.ads", "compositor_glyph_placement.adb", "compositor_identity.ads", "compositor_glyph_cache.ads", "compositor_glyph_cache.adb", "compositor_glyph_memory.ads", "compositor_glyph_memory.adb", "compositor_glyph_arena.ads", "compositor_glyph_arena.adb", "heap_extents.ads", "heap_extents.adb", "compositor_glyph_ffi.ads", "compositor_glyph_ffi.adb", "mask_batch_tests.adb", "compositor_mask_batch.ads", "compositor_mask_batch.adb", "damage_tests.adb", "compositor_damage.ads", "compositor_damage.adb", "cache_tests.adb", "composition_tests.adb", "desktop_composition.ads", "desktop_composition.adb",
      "compositor_policy.ads", "compositor_policy.adb", "compositor_formats.ads",
      "compositor_cache.ads", "compositor_cache.adb", "mesa_binding.ads", "mesa_binding.adb",
      "mesa_masks.ads", "mesa_masks.adb", "mesa_binding-masks.ads", "mesa_binding-masks.adb", "mesa_mask_ffi.ads", "mesa_mask_ffi.adb", "compositor_glyph_layout.ads", "compositor_glyph_layout.adb",
      "mesa_binding-affine.ads", "mesa_binding-affine.adb", "mesa_affine_ffi.ads", "mesa_affine_ffi.adb", "compositor_transform.ads", "compositor_transform.adb", "compositor_affine.ads", "compositor_affine.adb", "cubit.ads", "cubit-display_geometry.ads", "cubit-display_geometry.adb", "mesa_ffi.ads", "mesa_cache.ads", "desktop_compositor.ads", "desktop_compositor.adb");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build";
   for Main use ("mask_batch_tests.adb", "composition_tests.adb", "cache_tests.adb", "damage_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Composition;
