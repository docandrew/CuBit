project Frame_Trace is
   for Source_Dirs use (".", "../../userspace/lib/compositor");
   for Source_Files use ("frame_trace_tests.adb", "compositor_frame_trace.ads", "compositor_frame_trace.adb", "compositor_elapsed.ads");
   for Object_Dir use "build/frame-trace/obj";
   for Exec_Dir use "build/frame-trace";
   for Main use ("frame_trace_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Frame_Trace;
