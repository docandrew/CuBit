project Desktop_Backdrop extends "desktop_gpu_scene.gpr" is
   for Source_Dirs use (".", "../../userspace/lib/compositor", "../../userspace/lib/display", "../../userspace/lib/theme", "../../userspace/runtime/gnat", "../../userspace/services/desktop");
   for Source_Files use Desktop_GPU_Scene'Source_Files & ("desktop_gpu_scene-backdrop.ads", "desktop_gpu_scene-backdrop.adb", "desktop_backdrop_owner.ads", "desktop_backdrop_owner.adb", "desktop_backdrop_style.ads", "desktop_backdrop_pixels.ads", "desktop_backdrop_pixels.adb", "desktop_backdrop_upload.ads", "desktop_backdrop_upload.adb", "cubit-appearance.ads", "cubit-appearance.adb", "desktop_gpu_scene-backdrop-tests.adb");
   for Main use ("desktop_gpu_scene-backdrop-tests.adb");
   for Object_Dir use "build/desktop-backdrop/obj";
   for Exec_Dir use "build/desktop-backdrop";
end Desktop_Backdrop;
