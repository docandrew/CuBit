project Pool is
   for Source_Dirs use (".", "../../userspace/lib/compositor");
   for Source_Files use ("pool_tests.adb", "compositor_pool.ads", "compositor_pool.adb");
   for Object_Dir use "build/pool/obj";
   for Exec_Dir use "build/pool";
   for Main use ("pool_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Pool;
