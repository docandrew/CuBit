project Source_Residency is
   for Source_Dirs use (".", "../../userspace/lib/compositor");
   for Source_Files use ("compositor_source_content.ads", "compositor_source_residency.ads",
      "compositor_source_residency.adb", "source_residency_model.ads", "source_residency_tests.adb");
   for Object_Dir use "build/source-residency/obj";
   for Exec_Dir use "build/source-residency";
   for Main use ("source_residency_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Source_Residency;
