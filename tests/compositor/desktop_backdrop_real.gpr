project Desktop_Backdrop_Real extends "vulkan_target_bundle.gpr" is
   for Source_Dirs use (".", "../../userspace/lib/theme", "../../userspace/lib/compositor", "../../userspace/lib/display", "../../userspace/runtime/gnat", "../../userspace/services/desktop", "../../userspace/mesa");
   for Source_Files use Vulkan_Target_Bundle'Source_Files &
      ("compositor_sampling.ads", "compositor_sampling.adb", "desktop_backdrop_style.ads", "desktop_backdrop_owner.ads", "desktop_backdrop_owner.adb", "desktop_backdrop_upload.ads", "desktop_backdrop_upload.adb", "desktop_backdrop_pixels.ads", "desktop_backdrop_pixels.adb", "desktop_gpu_scene-backdrop.ads", "desktop_gpu_scene-backdrop.adb", "desktop_wallpaper.ads", "desktop_wallpaper.adb", "cubit-appearance.ads", "cubit-appearance.adb", "compositor_backdrop_strips.ads", "compositor_backdrop_strips.adb", "desktop_gpu_scene.ads", "desktop_gpu_scene.adb", "desktop_glyph_residency.ads", "desktop_glyph_residency.adb", "desktop_glyph_upload.ads", "desktop_glyph_upload.adb", "compositor_glyph_ffi.ads", "compositor_glyph_ffi.adb", "desktop_vulkan_startup.ads", "desktop_vulkan_startup.adb", "vulkan_device_owner.ads", "vulkan_device_owner.adb",
       "vulkan_device_ffi.ads", "vulkan_device_ffi.adb", "vulkan_device_upload_ffi.ads", "vulkan_device_upload_ffi.adb",
       "mesa_service.ads", "mesa_service.adb", "desktop_backdrop_real_bridge.ads", "desktop_backdrop_real_bridge.adb", "desktop_backdrop_real_host.c", "desktop_backdrop_real_tests.adb");
   for Object_Dir use "build/desktop-backdrop-real/obj";
   for Exec_Dir use "build/desktop-backdrop-real";
   for Main use ("desktop_backdrop_real_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
      for Default_Switches ("C") use ("-std=c11", "-O2", "-Wall", "-Wextra", "-Werror", "-DCUBIT_DESKTOP_REAL_TEST=1");
   end Compiler;
   package Linker is
      for Default_Switches ("Ada") use (External ("CUBIT_FONT_HOST_ARCHIVE"), "-lpthread", "-ldl", "-lm", External ("CUBIT_WALLPAPER_OBJECT", Desktop_Backdrop_Real'Project_Dir & "../../userspace/services/desktop/build/wallpaper.o"), External ("CUBIT_CUBIE_OBJECT", Desktop_Backdrop_Real'Project_Dir & "../../userspace/services/desktop/build/wallpaper_cubie.o"), "-lvulkan", "-Wl,--wrap=cubit_vulkan_device_context_request", "-Wl,--wrap=cubit_vulkan_device_targets_prepare");
   end Linker;
end Desktop_Backdrop_Real;
