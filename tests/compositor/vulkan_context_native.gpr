project Vulkan_Context_Native extends "vulkan_submission_native.gpr" is
   for Source_Dirs use ("../../userspace/lib/compositor", "../../userspace/lib/display");
   for Source_Files use Vulkan_Submission_Native'Source_Files &
     ("vulkan_context_owner.ads", "vulkan_context_owner.adb",
      "vulkan_context_ffi.ads", "vulkan_context_ffi.adb");
   for Object_Dir use "build/vulkan-context-native";
end Vulkan_Context_Native;
