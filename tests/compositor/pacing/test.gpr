project Test is
   for Source_Dirs use (".", "../../../userspace/lib/compositor");
   for Source_Files use ("compositor_pacing.ads", "compositor_pacing.adb", "pacing_tests.adb");
   for Object_Dir use external ("PACING_OBJECT_DIR", "build");
   for Exec_Dir use external ("PACING_OBJECT_DIR", "build");
   for Main use ("pacing_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-gnatwa");
   end Compiler;
end Test;
