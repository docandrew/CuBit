project gpio_release is
 for Source_Dirs use ("../../shared/firmware", "../acpi-resource-data", "../../userspace/services/acpi/resource-data");
 for Source_Files use ("acpi_resource_data-address_spaces-extended_descriptors.adb", "acpi_resource_data-address_spaces-extended_descriptors.ads", "acpi_resource_data-address_spaces-geometry.adb", "acpi_resource_data-address_spaces-geometry.ads", "acpi_resource_data-address_spaces.adb", "acpi_resource_data-address_spaces.ads", "acpi_resource_data-basic_descriptors.adb", "acpi_resource_data-basic_descriptors.ads", "acpi_resource_data-clock_inputs.adb", "acpi_resource_data-clock_inputs.ads", "acpi_resource_data-dependent_groups.adb", "acpi_resource_data-dependent_groups.ads", "acpi_resource_data-dma_descriptors.adb", "acpi_resource_data-dma_descriptors.ads", "acpi_resource_data-extended_interrupts.adb", "acpi_resource_data-extended_interrupts.ads", "acpi_resource_data-generic_registers.adb", "acpi_resource_data-generic_registers.ads", "acpi_resource_data-gpio_connections.adb", "acpi_resource_data-gpio_connections.ads", "acpi_resource_data-memory_ranges.adb", "acpi_resource_data-memory_ranges.ads", "acpi_resource_data-pin_descriptors.adb", "acpi_resource_data-pin_descriptors.ads", "acpi_resource_data-serial_connections.adb", "acpi_resource_data-serial_connections.ads", "acpi_resource_data.adb", "acpi_resource_data.ads", "firmware_tables-catalog.adb", "firmware_tables-catalog.ads", "firmware_tables-copies.adb", "firmware_tables-copies.ads", "firmware_tables-dmar.adb", "firmware_tables-dmar.ads", "firmware_tables-exposure.adb", "firmware_tables-exposure.ads", "firmware_tables-hpet.adb", "firmware_tables-hpet.ads", "firmware_tables-identifiers.adb", "firmware_tables-identifiers.ads", "firmware_tables-madt.adb", "firmware_tables-madt.ads", "firmware_tables-mcfg.adb", "firmware_tables-mcfg.ads", "firmware_tables-provisioning.adb", "firmware_tables-provisioning.ads", "firmware_tables-slit.adb", "firmware_tables-slit.ads", "firmware_tables-snapshots.adb", "firmware_tables-snapshots.ads", "firmware_tables-srat.adb", "firmware_tables-srat.ads", "firmware_tables.adb", "firmware_tables.ads", "pci_routing_tests.adb", "resource_address_tests.adb", "resource_basic_tests.adb", "resource_clock_tests.adb", "resource_dependent_tests.adb", "resource_dma_tests.adb", "resource_extended_address_tests.adb", "resource_extended_tests.adb", "resource_frame_tests.adb", "resource_geometry_tests.adb", "resource_gpio_tests.adb", "resource_memory_register_tests.adb", "resource_oracle.ads", "resource_pin_tests.adb", "resource_serial_tests.adb", "resource_service_tests.adb");
 for Object_Dir use external ("ACPI_HID_BUILD") & "/obj";
 for Exec_Dir use external ("ACPI_HID_BUILD") & "/bin";
 for Main use ("resource_gpio_tests.adb");
 package Compiler is
  for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnatp");
 end Compiler;
end gpio_release;
