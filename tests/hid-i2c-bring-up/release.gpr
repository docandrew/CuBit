project Release is
 for Source_Dirs use (".", "../../userspace/services/acpi/hid-i2c");
 for Main use ("bring_up_tests.adb");
 for Object_Dir use external ("HID_I2C_BRING_UP_BUILD") & "/obj";
 for Exec_Dir use external ("HID_I2C_BRING_UP_BUILD") & "/bin";
 package Compiler is
  for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnatp");
 end Compiler;
end Release;
