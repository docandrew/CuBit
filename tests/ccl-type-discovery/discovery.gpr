project Discovery is
   for Source_Dirs use (".", "../../userspace/ccl/src");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("import_tests.adb", "catalog_tests.adb", "metadata_tests.adb",
                 "function_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnata", "-gnato", "-gnatwa", "-gnatwe");
   end Compiler;
end Discovery;
