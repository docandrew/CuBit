project Layouts is
   for Source_Dirs use (".", "build/source");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("main.adb", "primary_test.adb", "pointer_test.adb", "arrangement_test.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnata", "-gnato", "-gnatwa", "-gnatwe");
   end Compiler;
end Layouts;
