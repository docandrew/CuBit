project Device_Query is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Object_Dir use "build-device-query";
   for Main use ("device_query_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Device_Query;
