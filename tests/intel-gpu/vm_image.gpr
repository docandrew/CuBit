project VM_Image is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Object_Dir use external ("VM_IMAGE_OBJECT_DIR", "build-vm-image");
   for Main use ("vm_image_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end VM_Image;
