project GuC_RSA is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("guc_rsa_tests.adb", "intel_gpu_guc_rsa.ads",
     "intel_gpu_guc_rsa.adb", "intel_gpu_firmware.ads", "intel_gpu_firmware.adb");
   for Object_Dir use "build-guc-rsa";
   for Main use ("guc_rsa_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-gnatwa", "-gnatwe");
   end Compiler;
end GuC_RSA;
