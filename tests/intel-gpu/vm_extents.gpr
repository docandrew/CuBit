project VM_Extents is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Object_Dir use "build-vm-extents";
   for Main use ("vm_extents_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end VM_Extents;
