project Extent_Allocator is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Object_Dir use "build-extent-allocator";
   for Main use ("extent_allocator_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Extent_Allocator;
