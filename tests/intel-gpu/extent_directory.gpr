project Extent_Directory is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Object_Dir use external ("EXTENT_DIRECTORY_OBJECT_DIR", "build-extent-directory");
   for Main use ("extent_directory_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Extent_Directory;
