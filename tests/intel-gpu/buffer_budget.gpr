project Buffer_Budget is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Object_Dir use "build-buffer-budget";
   for Main use ("buffer_budget_tests.adb", "budget_query_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Buffer_Budget;
