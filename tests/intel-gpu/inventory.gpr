project Inventory is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("inventory_tests.adb", "intel_gpu_adln_inventory.ads",
                        "intel_gpu_adln_inventory.adb");
   for Object_Dir use "build-inventory";
   for Main use ("inventory_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-gnatwa", "-gnatwe");
   end Compiler;
end Inventory;
