project GGTT_Search is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("ggtt_search_tests.adb", "intel_gpu_ggtt_search.ads", "intel_gpu_ggtt_search.adb",
     "intel_gpu_ggtt_reservations.ads", "intel_gpu_ggtt_reservations.adb",
     "intel_gpu_va_placement.ads", "intel_gpu_va_placement.adb",
     "intel_gpu_ggtt.ads", "intel_gpu_ggtt.adb");
   for Object_Dir use "build-ggtt-search";
   for Main use ("ggtt_search_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end GGTT_Search;
