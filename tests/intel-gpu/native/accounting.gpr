project Accounting is
   for Languages use ("Ada");
   for Object_Dir use external ("DEMAND_BUILD");
   for Exec_Dir use external ("DEMAND_BUILD");
   for Source_Dirs use (".", "../../../userspace/services/intel-gpu",
     "../../../userspace/services/filesystem", "../../../userspace/mesa/anv");
   for Excluded_Source_Files use ("main.adb");
   for Main use ("accounting_check.adb");
   for Runtime ("Ada") use "../../../userspace/runtime";
   package Builder is
      for Default_Switches ("Ada") use ("-nostdlib");
      for Executable ("accounting_check.adb") use "devmgr.svc";
   end Builder;
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-O2", "-fstack-usage", "-mno-red-zone",
         "-fno-pic", "-mno-sse", "-mno-sse2");
   end Compiler;
   package Binder is
      for Default_Switches ("Ada") use ("-d_C");
   end Binder;
   package Linker is
      for Default_Switches ("Ada") use
        ("-nostdlib", "-static", "-no-pie", "-Wl,-z,stack-size=16777216",
         "-lgnat-user", "-T", Accounting'Project_Dir & "../../../userspace/c/link.ld",
         Accounting'Project_Dir & "../../../userspace/c/build/crt0.o");
   end Linker;
end Accounting;
