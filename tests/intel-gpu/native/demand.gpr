project Demand is
   for Languages use ("Ada");
   for Source_Dirs use (".", "../../../userspace/services/intel-gpu");
   for Object_Dir use external ("DEMAND_BUILD");
   for Exec_Dir use external ("DEMAND_BUILD");
   Main_Source := external ("DEMAND_MAIN", "demand_backing_check.adb");
   for Main use (Main_Source);
   for Runtime ("Ada") use "../../../userspace/runtime";
   package Builder is
      for Default_Switches ("Ada") use ("-nostdlib");
      for Executable ("demand_backing_check.adb") use "devmgr.svc";
      for Executable ("allocation_ipc_check.adb") use "devmgr.svc";
      for Executable ("view_retention_check.adb") use "devmgr.svc";
      for Executable ("mapping_growth_check.adb") use "devmgr.svc";
   end Builder;
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-O2", "-fstack-usage", "-mno-red-zone",
         "-fno-pic", "-mno-sse", "-mno-sse2");
   end Compiler;
   package Binder is
      for Default_Switches ("Ada") use ("-d_C");
   end Binder;
   package Linker is
      for Default_Switches ("Ada") use
        ("-nostdlib", "-static", "-no-pie", "-Wl,-z,stack-size=16777216",
         "-lgnat-user", "-T", Demand'Project_Dir & "../../../userspace/c/link.ld",
         Demand'Project_Dir & "../../../userspace/c/build/crt0.o");
   end Linker;
end Demand;
