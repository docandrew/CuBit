project GGTT_Layout is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("ggtt_layout_tests.adb", "intel_gpu_ggtt_layout.ads", "intel_gpu_ggtt_layout.adb");
   for Object_Dir use "build-ggtt-layout";
   for Main use ("ggtt_layout_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end GGTT_Layout;
