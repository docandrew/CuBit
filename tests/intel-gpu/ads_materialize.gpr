project ADS_Materialize is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Object_Dir use "build-ads-materialize";
   for Main use ("ads_materialize_tests.adb", "ads_publish_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-gnatwa", "-gnatwe");
   end Compiler;
end ADS_Materialize;
