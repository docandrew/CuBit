project Sparse_VM is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Object_Dir use "build-sparse-vm";
   for Main use ("initial_vm_tests.adb", "submission_image_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Sparse_VM;
