project Engine_Stop is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("engine_stop_tests.adb", "intel_gpu_engine_stop.ads",
                        "intel_gpu_engine_stop.adb");
   for Object_Dir use "build-engine-stop";
   for Main use ("engine_stop_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-gnatwa", "-gnatwe");
   end Compiler;
end Engine_Stop;
