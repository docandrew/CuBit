project Plane_Registers is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("plane_registers_tests.adb", "intel_gpu_plane_registers.ads",
     "intel_gpu_plane_registers.adb", "intel_gpu_display_topology.ads",
     "intel_gpu_display_topology.adb");
   for Object_Dir use "build-plane-registers";
   for Main use ("plane_registers_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Plane_Registers;
