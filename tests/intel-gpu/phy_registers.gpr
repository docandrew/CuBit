project PHY_Registers is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("phy_registers_tests.adb", "intel_gpu_phy_registers.ads");
   for Object_Dir use "build-phy-registers";
   for Main use ("phy_registers_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end PHY_Registers;
