project Submission_Buffer is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Object_Dir use external ("SUBMISSION_BUFFER_OBJECT_DIR", "build-submission-buffer");
   for Main use ("submission_buffer_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Submission_Buffer;
