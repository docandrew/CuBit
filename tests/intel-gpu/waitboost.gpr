project Waitboost is
   -- SLPC waitboost state and coalescing (Intel_GPU_Waitboost), hosted tests
   -- and the SPARK proof (gnatprove -P waitboost.gpr).
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("intel_gpu_gt_frequency.ads", "intel_gpu_slpc.ads", "intel_gpu_slpc.adb",
                         "intel_gpu_waitboost.ads", "intel_gpu_waitboost.adb", "waitboost_tests.adb");
   for Object_Dir use "build-waitboost";
   for Main use ("waitboost_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato");
   end Compiler;
end Waitboost;
