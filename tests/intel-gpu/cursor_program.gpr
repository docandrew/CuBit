project Cursor_Program is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("cursor_program_tests.adb",
     "intel_gpu_cursor_program.ads", "intel_gpu_cursor_program.adb",
     "intel_gpu_native_cursor_program.ads", "intel_gpu_native_cursor_program.adb",
     "intel_gpu_display_topology.ads", "intel_gpu_display_topology.adb");
   for Object_Dir use "build-cursor-program";
   for Main use ("cursor_program_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Cursor_Program;
