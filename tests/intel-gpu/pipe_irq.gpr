project Pipe_IRQ is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("pipe_irq_tests.adb", "intel_gpu_pipe_irq.ads",
     "intel_gpu_pipe_irq.adb", "intel_gpu_display_topology.ads",
     "intel_gpu_display_topology.adb");
   for Object_Dir use "build-pipe-irq";
   for Main use ("pipe_irq_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-gnatwa", "-gnatwe");
   end Compiler;
end Pipe_IRQ;
