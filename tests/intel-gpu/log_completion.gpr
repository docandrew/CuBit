project Log_Completion is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("log_completion_tests.adb", "intel_gpu_log_completion.ads");
   for Object_Dir use "build-log-completion";
   for Main use ("log_completion_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Log_Completion;
