project ADLN_Forcewake is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("adln_forcewake_tests.adb", "intel_gpu_adln_forcewake.ads",
     "intel_gpu_adln_forcewake.adb", "intel_gpu_forcewake.ads", "intel_gpu_forcewake.adb",
     "intel_gpu_domain_lease.ads", "intel_gpu_domain_lease.adb",
     "intel_gpu_adln_inventory.ads", "intel_gpu_adln_inventory.adb");
   for Object_Dir use "build-adln-forcewake";
   for Main use ("adln_forcewake_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-gnatwa", "-gnatwe");
   end Compiler;
end ADLN_Forcewake;
