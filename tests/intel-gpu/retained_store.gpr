project Retained_Store is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Object_Dir use "build-retained-store";
   for Main use ("retained_store_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Retained_Store;
