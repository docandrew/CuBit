project Scanout_Range is
   for Languages use ("Ada");
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("scanout_range_tests.adb",
     "intel_gpu_scanout_range.ads", "intel_gpu_scanout_range.adb",
     "intel_gpu_ggtt.ads", "intel_gpu_ggtt.adb");
   for Object_Dir use "build-scanout-range";
   for Exec_Dir use "build-scanout-range";
   for Main use ("scanout_range_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-O2");
   end Compiler;
end Scanout_Range;
