project PHY_Mapping is
   for Source_Dirs use (".", "phy-fixture", "../../userspace/services/intel-gpu");
   for Source_Files use ("phy_mapping_tests.adb", "cubit.ads", "cubit-messages.ads", "cubit-messages.adb", "intel_gpu_phy_mapping.ads", "intel_gpu_phy_mapping.adb", "intel_gpu_phy_pages.ads", "intel_gpu_phy_pages.adb", "intel_gpu_combo_phy.ads", "intel_gpu_combo_phy.adb", "intel_gpu_phy_registers.ads");
   for Object_Dir use "build-phy-mapping";
   for Main use ("phy_mapping_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end PHY_Mapping;
