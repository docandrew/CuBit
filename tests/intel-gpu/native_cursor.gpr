project Native_Cursor is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("intel_gpu_cursor_control.ads", "native_cursor_tests.adb", "intel_gpu_native_cursor.ads",
     "intel_gpu_native_cursor.adb", "intel_gpu_cursor_collect.ads",
     "intel_gpu_cursor_collect.adb", "intel_gpu_cursor_decode.ads",
     "intel_gpu_cursor_decode.adb", "intel_gpu_scanout_range.ads",
     "intel_gpu_scanout_range.adb", "intel_gpu_ggtt.ads", "intel_gpu_ggtt.adb",
     "intel_gpu_display_topology.ads", "intel_gpu_display_topology.adb");
   for Object_Dir use "build-native-cursor";
   for Main use ("native_cursor_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Native_Cursor;
