project GuC_CTB is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("guc_ctb_tests.adb", "intel_gpu_guc_ctb.ads", "intel_gpu_guc_ctb.adb");
   for Object_Dir use "build-guc-ctb";
   for Main use ("guc_ctb_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end GuC_CTB;
