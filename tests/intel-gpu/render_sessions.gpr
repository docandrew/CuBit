project Render_Sessions is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Object_Dir use external ("RENDER_SESSIONS_OBJECT_DIR", "build-render-sessions");
   for Main use ("render_sessions_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Render_Sessions;
