project GGTT_Access is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("ggtt_access_tests.adb", "intel_gpu_ggtt_access.ads",
     "intel_gpu_ggtt_access.adb", "intel_gpu_ggtt.ads", "intel_gpu_ggtt.adb",
     "intel_gpu_pci_power.ads", "intel_gpu_pci_power.adb",
     "intel_gpu_pci_interrupts.ads", "intel_gpu_pci_interrupts.adb",
     "intel_gpu_probe.ads", "intel_gpu_probe.adb",
     "intel_gpu_resources.ads", "intel_gpu_resources.adb");
   for Object_Dir use "build-ggtt-access";
   for Main use ("ggtt_access_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end GGTT_Access;
