project ADS_Capture_Image is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("ads_capture_image_tests.adb",
     "intel_gpu_ads_capture_image.ads", "intel_gpu_ads_capture_image.adb",
     "intel_gpu_adln_capture.ads", "intel_gpu_adln_capture.adb",
     "intel_gpu_capture_list.ads", "intel_gpu_capture_list.adb",
     "intel_gpu_adln_inventory.ads", "intel_gpu_adln_inventory.adb",
     "intel_gpu_adln_steering.ads", "intel_gpu_adln_steering.adb");
   for Object_Dir use "build-ads-capture-image";
   for Main use ("ads_capture_image_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-gnatwa", "-gnatwe");
   end Compiler;
end ADS_Capture_Image;
