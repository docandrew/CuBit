project VA_Placement is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Object_Dir use "build-va-placement";
   for Main use ("va_placement_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end VA_Placement;
