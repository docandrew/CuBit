project ADS_Regset is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("ads_regset_tests.adb", "intel_gpu_ads_regset.ads",
                         "intel_gpu_ads_regset.adb");
   for Object_Dir use "build-ads-regset";
   for Main use ("ads_regset_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-gnatwa", "-gnatwe");
   end Compiler;
end ADS_Regset;
