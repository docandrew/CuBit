project ADLN_Steering is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("adln_steering_tests.adb", "intel_gpu_adln_steering.ads",
                         "intel_gpu_adln_steering.adb");
   for Object_Dir use "build-adln-steering";
   for Main use ("adln_steering_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-gnatwa", "-gnatwe");
   end Compiler;
end ADLN_Steering;
