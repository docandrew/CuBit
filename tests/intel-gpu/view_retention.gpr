project View_Retention is
   for Source_Dirs use (".", "view-retention-fixture",
     "../../userspace/services/intel-gpu", "../../userspace/runtime/gnat");
   for Source_Files use ("view_retention_tests.adb", "cubit.ads",
     "cubit-grant_references.ads", "fixture_messages.ads",
     "fixture_capability_grants.ads", "fixture_memory_grants.ads",
     "fixture_memory_grants.adb", "intel_gpu_buffer_views.ads",
     "intel_gpu_buffer_views.adb", "intel_gpu_buffer_handles.ads",
     "intel_gpu_buffer_handles.adb", "intel_gpu_buffer_reply.ads",
     "intel_gpu_buffer_reply.adb", "intel_gpu_buffer_backing.ads",
     "intel_gpu_physical_extents.ads", "intel_gpu_physical_extents.adb",
     "intel_gpu_extent_directory.ads", "intel_gpu_extent_directory.adb",
     "intel_gpu_record_store.ads", "intel_gpu_record_store.adb");
   for Object_Dir use external ("VIEW_RETENTION_OBJECT_DIR", "build-view-retention");
   for Main use ("view_retention_tests.adb");
   package Naming is
      for Spec ("CuBit.Messages") use "fixture_messages.ads";
      for Spec ("CuBit.Capability_Grants") use "fixture_capability_grants.ads";
      for Spec ("CuBit.Memory_Grants") use "fixture_memory_grants.ads";
      for Body ("CuBit.Memory_Grants") use "fixture_memory_grants.adb";
   end Naming;
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end View_Retention;
