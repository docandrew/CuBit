project Record_Store is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Object_Dir use "build-record-store";
   for Main use ("record_store_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Record_Store;
