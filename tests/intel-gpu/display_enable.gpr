project Display_Enable is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("display_enable_tests.adb",
     "intel_gpu_display_enable.ads", "intel_gpu_display_enable.adb",
     "intel_gpu_display_lease.ads", "intel_gpu_display_lease.adb",
     "intel_gpu_display_topology.ads", "intel_gpu_display_topology.adb");
   for Object_Dir use "build-display-enable";
   for Main use ("display_enable_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-O2", "-gnatwa", "-gnatwe");
   end Compiler;
end Display_Enable;
