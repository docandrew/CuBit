project WOPCM is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("wopcm_tests.adb", "intel_gpu_wopcm.ads",
     "intel_gpu_wopcm.adb", "intel_gpu_firmware.ads", "intel_gpu_firmware.adb");
   for Object_Dir use "build-wopcm";
   for Main use ("wopcm_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-gnatwa", "-gnatwe");
   end Compiler;
end WOPCM;
