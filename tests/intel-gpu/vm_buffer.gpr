project VM_Buffer is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Object_Dir use external ("VM_BUFFER_OBJECT_DIR", "build-vm-buffer");
   for Main use ("vm_buffer_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end VM_Buffer;
