project MOCS_Fields is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Object_Dir use "build-mocs-fields";
   for Main use ("adln_mocs_tests.adb", "mocs_configure_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end MOCS_Fields;
