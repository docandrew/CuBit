project GuC_CT_Receive is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("guc_ct_receive_tests.adb", "intel_gpu_guc_ct_receive.ads",
     "intel_gpu_guc_ct_receive.adb", "intel_gpu_guc_ctb.ads", "intel_gpu_guc_ctb.adb");
   for Object_Dir use "build-guc-ct-receive";
   for Main use ("guc_ct_receive_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end GuC_CT_Receive;
