project ADS_Policies is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("ads_policies_tests.adb", "intel_gpu_ads_policies.ads",
                         "intel_gpu_ads_policies.adb");
   for Object_Dir use "build-ads-policies";
   for Main use ("ads_policies_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-gnatwa", "-gnatwe");
   end Compiler;
end ADS_Policies;
