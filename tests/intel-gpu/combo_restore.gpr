project Combo_Restore is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("combo_restore_tests.adb", "intel_gpu_combo_phy.ads", "intel_gpu_combo_phy.adb", "intel_gpu_phy_registers.ads", "intel_gpu_combo_restore.ads", "intel_gpu_combo_restore.adb");
   for Object_Dir use "build-combo-restore";
   for Main use ("combo_restore_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Combo_Restore;
