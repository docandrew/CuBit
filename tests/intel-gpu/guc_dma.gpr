project GuC_DMA is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("guc_dma_tests.adb", "intel_gpu_guc_dma.ads", "intel_gpu_guc_dma.adb");
   for Object_Dir use "build-guc-dma";
   for Main use ("guc_dma_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-gnatwa", "-gnatwe");
   end Compiler;
end GuC_DMA;
