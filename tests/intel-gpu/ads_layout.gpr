project ADS_Layout is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("ads_layout_tests.adb", "intel_gpu_ads_layout.ads", "intel_gpu_ads_layout.adb",
                         "intel_gpu_ads_backing.ads");
   for Object_Dir use "build-ads-layout";
   for Main use ("ads_layout_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-gnatwa", "-gnatwe");
   end Compiler;
end ADS_Layout;
