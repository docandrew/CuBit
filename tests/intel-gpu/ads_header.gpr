project ADS_Header is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Object_Dir use "build-ads-header";
   for Main use ("ads_header_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-gnatwa", "-gnatwe");
   end Compiler;
end ADS_Header;
