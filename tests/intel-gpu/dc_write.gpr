project DC_Write is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("dc_write_tests.adb", "intel_gpu_dc_write.ads", "intel_gpu_dc_write.adb");
   for Object_Dir use "build-dc-write";
   for Main use ("dc_write_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-O2", "-gnatwa", "-gnatwe");
   end Compiler;
end DC_Write;
