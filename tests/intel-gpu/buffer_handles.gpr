project Buffer_Handles is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Object_Dir use external ("BUFFER_HANDLES_OBJECT_DIR", "build-buffer-handles");
   for Main use ("buffer_handles_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Buffer_Handles;
