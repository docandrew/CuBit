project PCI_IRQ_Disable is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("pci_irq_disable_tests.adb", "pci_irq_executor_tests.adb",
     "intel_gpu_pci_irq_disable.ads", "intel_gpu_pci_irq_disable.adb", "intel_gpu_pci_interrupts.ads",
     "intel_gpu_pci_interrupts.adb", "intel_gpu_pci_power.ads", "intel_gpu_pci_power.adb");
   for Object_Dir use "build-pci-irq-disable";
   for Main use ("pci_irq_disable_tests.adb", "pci_irq_executor_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-gnatwa", "-gnatwe");
   end Compiler;
end PCI_IRQ_Disable;
