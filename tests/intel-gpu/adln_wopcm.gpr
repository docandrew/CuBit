project ADLN_WOPCM is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("adln_wopcm_tests.adb", "intel_gpu_adln_wopcm.ads",
     "intel_gpu_adln_wopcm.adb", "intel_gpu_firmware.ads", "intel_gpu_firmware.adb");
   for Object_Dir use "build-adln-wopcm";
   for Main use ("adln_wopcm_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end ADLN_WOPCM;
