project Native_DC_State is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("native_dc_state_tests.adb", "intel_gpu_native_dc_state.ads",
     "intel_gpu_native_dc_state.adb", "intel_gpu_dc_state.ads", "intel_gpu_dc_state.adb");
   for Object_Dir use "build-native-dc-state";
   for Main use ("native_dc_state_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Native_DC_State;
