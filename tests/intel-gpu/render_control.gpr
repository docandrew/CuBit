project Render_Control is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Object_Dir use "build-render-control";
   for Main use ("render_control_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Render_Control;
