project DC_Exit is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("dc_exit_tests.adb", "intel_gpu_dc_exit.ads",
     "intel_gpu_dc_exit.adb", "intel_gpu_dc_write.ads", "intel_gpu_dc_write.adb");
   for Object_Dir use "build-dc-exit";
   for Main use ("dc_exit_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end DC_Exit;
