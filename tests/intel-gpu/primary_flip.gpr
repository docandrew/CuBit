--  DISP-000a primary-plane flips: hosted tests (Linux) against a register
--  model, and level-2 proofs of the pure units.
--    gprbuild -P tests/intel-gpu/primary_flip.gpr && tests/intel-gpu/build-primary-flip/primary_flip_tests
--    gnatprove -P tests/intel-gpu/primary_flip.gpr -u intel_gpu_flip_state.adb intel_gpu_vblank_clock.adb --level=2
project Primary_Flip is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("primary_flip_tests.adb",
     "intel_gpu_flip_state.ads", "intel_gpu_flip_state.adb",
     "intel_gpu_vblank_clock.ads", "intel_gpu_vblank_clock.adb",
     "intel_gpu_primary_flip.ads", "intel_gpu_primary_flip.adb");
   for Object_Dir use "build-primary-flip";
   for Main use ("primary_flip_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--checks-as-errors=on");
   end Prove;
end Primary_Flip;
