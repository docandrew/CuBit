project Buffer_Memory is
   for Source_Dirs use (".", "buffer-memory-fixture", "../../userspace/services/intel-gpu");
   for Source_Files use ("buffer_memory_tests.adb", "cubit.ads",
     "cubit-messages.ads", "cubit-messages.adb", "intel_gpu_diagnostics.ads",
     "intel_gpu_diagnostics.adb", "intel_gpu_buffer_memory.ads",
     "intel_gpu_buffer_memory.adb", "intel_gpu_buffer_reply.ads",
     "intel_gpu_physical_extents.ads", "intel_gpu_physical_extents.adb",
     "intel_gpu_extent_replies.ads", "intel_gpu_extent_replies.adb",
     "intel_gpu_buffer_reply.adb", "intel_gpu_buffer_backing.ads",
     "intel_gpu_dma_cache.ads", "intel_gpu_dma_cache.adb");
   for Object_Dir use external ("BUFFER_MEMORY_OBJECT_DIR", "build-buffer-memory");
   for Main use ("buffer_memory_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Buffer_Memory;
