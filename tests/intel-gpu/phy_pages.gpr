project PHY_Pages is
   for Source_Dirs use (".", "../../userspace/services/intel-gpu");
   for Source_Files use ("phy_pages_tests.adb", "intel_gpu_phy_pages.ads", "intel_gpu_phy_pages.adb", "intel_gpu_combo_phy.ads", "intel_gpu_combo_phy.adb", "intel_gpu_phy_registers.ads", "intel_gpu_display_pages.ads", "intel_gpu_reset_pages.ads");
   for Object_Dir use "build-phy-pages";
   for Main use ("phy_pages_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end PHY_Pages;
