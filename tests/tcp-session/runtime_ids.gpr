--  The CuBit runtime units netstack's channel handles and TCP slots depend on.
--  An explicit list: the runtime directory also holds target-only
--  predefined Ada units that must not shadow the host's.
project Runtime_IDs is
   for Source_Dirs use ("../../userspace/runtime/gnat");
   for Source_Files use ("cubit.ads", "cubit-process_ids.ads", "cubit-process_ids.adb",
                         "cubit-net_link.ads", "cubit-net_link.adb", "cubit-frame_rings.ads",
                         "cubit-slot_rings.ads", "cubit-slot_rings.adb",
                         "cubit-channel_rings.ads", "cubit-channel_rings.adb");
   for Object_Dir use "build/runtime-ids";
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-gnatwa", "-I-");
   end Compiler;
end Runtime_IDs;
