project Increment_checked is
 for Source_Dirs use (".", "../aml-core", "../../userspace/services/acpi/lib", "../../userspace/services/acpi", "../../shared/firmware", "../../userspace/services/acpi/resource-consumer");
 for Object_Dir use "build-increment-checked";
 for Main use ("increment_tests.adb", "debug_target_tests.adb", "debug_owned_tests.adb", "debug_oracle_runner.adb");
 package Compiler is
 for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnata", "-gnato");
 end Compiler;
end Increment_checked;
