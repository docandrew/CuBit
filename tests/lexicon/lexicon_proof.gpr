--  SPARK proof of the lexicon core (docs/lexicon.md): run.sh --prove
--  (memory-capped, -j2, level 2).
project Lexicon_Proof is
   for Source_Dirs use ("../../userspace/lib/lexicon");
   for Object_Dir use "build/proof";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022");
   end Compiler;
   package Prove is
      for Proof_Switches ("Ada") use ("--timeout=60");
   end Prove;
end Lexicon_Proof;
