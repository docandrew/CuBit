project Rates is
   for Source_Dirs use (".", "../../kernel/src");
   for Source_Files use ("main.adb", "boot_timer_rates.ads", "boot_timer_rates.adb");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnata", "-gnato", "-gnatwa", "-gnatwe");
   end Compiler;
end Rates;
