--  SPARK proof of the toolkit's key vocabulary, keymap and modifier reveal
--  (UI-049, UI-052): tests/ui-keys/run.sh --prove (level 2, every check).
project Prove is
   for Source_Dirs use (".", "../../userspace/lib/ui", "../../userspace/lib/theme",
                        "../../userspace/lib/display", "../../userspace/lib/compositor",
                        "../../userspace/ccl/tools/ccl-ui-preview/host");
   for Object_Dir use "build/prove";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022");
   end Compiler;
   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--checks-as-errors=on", "--report=fail");
   end Prove;
end Prove;
