with "../../userspace/lib/ui/fonts_host.gpr";
project Polish is
   for Source_Dirs use (".", "../../userspace/lib/ui", "../../userspace/lib/theme",
     "../../userspace/ccl/tools/ccl-ui-preview/host", "../../userspace/lib/compositor",
     "../../userspace/lib/display", "../../userspace/allocator/src");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build";
   for Main use ("polish_preview.adb", "polish_tests.adb", "menu_options_preview.adb", "combo_tests.adb", "tree_preview.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-gnato");
   end Compiler;
end Polish;
