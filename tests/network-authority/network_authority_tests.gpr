project Network_Authority_Tests is
   for Source_Dirs use (".", "../../userspace/runtime/gnat", "../../userspace/services/netstack");
   for Source_Files use ("main.adb", "cubit.ads", "cubit-network_authority.ads",
                        "cubit-network_authority.adb", "network_grants.ads", "network_grants.adb",
                        "cubit-launch_policy.ads", "cubit-launch_policy.adb");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      --  Do not implicitly search the compiled unit's directory: the CuBit
      --  runtime directory also contains target-only predefined Ada units.
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-gnatwa", "-I-");
   end Compiler;
end Network_Authority_Tests;
