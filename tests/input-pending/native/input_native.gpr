project Input_Native is
   for Languages use ("Ada");
   for Source_Dirs use (".", "../../../userspace/lib/input");
   for Object_Dir use external ("INPUT_NATIVE_BUILD");
   for Exec_Dir use external ("INPUT_NATIVE_BUILD");
   for Main use ("input_native_check.adb");
   for Runtime ("Ada") use "../../../userspace/runtime";
   package Builder is
      for Default_Switches ("Ada") use ("-nostdlib");
      for Executable ("input_native_check.adb") use "devmgr.svc";
   end Builder;
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-O2", "-fstack-usage", "-mno-red-zone",
         "-fno-pic", "-mno-sse", "-mno-sse2");
   end Compiler;
   package Binder is
      for Default_Switches ("Ada") use ("-d_C");
   end Binder;
   package Linker is
      for Default_Switches ("Ada") use
        ("-nostdlib", "-static", "-no-pie", "-Wl,-z,stack-size=16777216",
         "-lgnat-user", "-T", Input_Native'Project_Dir & "../../../userspace/c/link.ld",
         Input_Native'Project_Dir & "../../../userspace/c/build/crt0.o");
   end Linker;
end Input_Native;
