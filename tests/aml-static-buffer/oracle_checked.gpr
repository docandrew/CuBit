project Oracle_checked is
 for Source_Dirs use (".", "../../userspace/lib/acpi", "../../userspace/services/acpi", "../../shared/firmware");
 for Object_Dir use "oracle-checked/obj";
 for Exec_Dir use "oracle-checked";
 for Main use ("static_buffer_oracle_runner.adb");
 package Compiler is
 for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnata", "-gnato");
 end Compiler;
end Oracle_checked;
