# The Ladybird js test launcher (tests/ladybird/check): runs ladybird-js.app
# on check.js, with the ladybird place delegated read-only, and shows what
# it writes on the kernel console.
(Executable_Manifest
  identity => "com.cubit.ladybird-js-check"
  version => "0.1.0"
  requests => [(service "process-manager" "process-manager") (service "launch" "launch") (service "filesystem" "filesystem")
    (service "logstore" "logstore")]
  optional => ["logstore"]
  scopes => [(filesystem [File_Right.Read] "@nvme:0/ladybird")]
  may_launch => [(Launch "ladybird-js.app")])
