--  Hosted tests for the toolkit's layout containers (UI-033): run.sh.
with "../../userspace/allocator/allocator_runtime_host.gpr";
with "../../userspace/lib/ui/fonts_host.gpr";
project Layout_Tests is
   for Source_Dirs use (".", "../../userspace/lib/ui", "../../userspace/lib/theme", "../../userspace/lib/display",
     "../../userspace/lib/compositor", "../../userspace/ccl/tools/ccl-ui-preview/host");
   for Source_Files use ("layout_tests.adb", "box_distribution.ads", "box_distribution.adb",
     "cubit-ui-boxes.ads", "cubit-ui-boxes.adb", "cubit-ui-text_views.ads", "cubit-ui-text_views.adb",
     "cubit.ads", "cubit-ui.ads", "cubit-ui.adb", "cubit-ui_masking.ads", "cubit-reading_faces.ads",
     "cubit-reading_faces.adb", "icon_edge_choice.ads", "icon_edge_choice.adb", "text_fit.ads", "text_fit.adb",
     "font8x16.ads", "cubit-fonts.ads", "glyph_pen.ads", "cubit-fonts.adb", "cubit-theme.ads",
     "cubit-appearance.ads", "cubit-appearance.adb", "cubit-display_geometry.ads", "cubit-display_geometry.adb", "client_raster.ads", "client_raster.adb",
     "client_glyph_blend.ads", "client_glyph_blend.adb", "client_glyphs.ads", "client_glyphs.adb",
     "client_canvas_geometry.ads", "client_canvas_geometry.adb", "compositor_glyph_cache.ads",
     "compositor_glyph_cache.adb", "compositor_glyph_storage.ads", "compositor_glyph_storage.adb",
     "compositor_glyph_memory.ads", "compositor_glyph_memory.adb", "compositor_glyph_layout.ads",
     "cubit-ui_metrics.ads", "compositor_glyph_layout.adb", "compositor_glyph_ffi.ads", "compositor_glyph_ffi.adb",
     "compositor_glyph_software.ads", "glyph_gamma.ads", "compositor_glyph_software.adb",
     "compositor_glyph_placement.ads", "compositor_glyph_placement.adb", "compositor_affine.ads",
     "compositor_affine.adb", "compositor_identity.ads");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build";
   for Main use ("layout_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-gnato");
   end Compiler;
end Layout_Tests;
