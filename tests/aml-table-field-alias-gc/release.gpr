project release is
 for Source_Dirs use (".", "../../userspace/services/acpi/lib", "../../shared/firmware");
 for Object_Dir use "build-release/obj";
 for Exec_Dir use "build-release";
 for Main use ("table_field_alias_gc_tests.adb");
 package Compiler is
  for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnatp", "-gnatwF");
 end Compiler;
end release;
