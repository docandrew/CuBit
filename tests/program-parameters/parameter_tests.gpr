--  Hosted tests of a generated typed-parameter binding (package Parameters,
--  generated by ccl-manifest from acpi-sample.ccl into build/generated)
--  against the launcher's CCL check (CCL.Typed_Values).
with "../../userspace/ccl/cubit_shared.gpr";
project Parameter_Tests is
   for Source_Dirs use (".", "host", "build/generated", "../../userspace/ccl/src");
   --  Only the binding: the generated Startup package is native.
   for Excluded_Source_Files use ("startup.ads", "startup.adb");
   for Object_Dir use "build/tests";
   for Exec_Dir use "build/tests";
   for Main use ("parameter_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnatwa", "-g", "-O1");
   end Compiler;
end Parameter_Tests;
