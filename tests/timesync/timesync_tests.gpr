project Timesync_Tests is
   for Source_Dirs use (".", "fixture", "../../userspace/runtime/gnat",
                        "../../userspace/services/timesync", "../../userspace/services/clock");
   for Source_Files use ("main.adb", "cubit.ads", "cubit-clocks.ads", "cubit-clocks.adb",
                        "cubit-clock_control.ads", "cubit-clock_control.adb",
                        "clock_discipline.ads", "clock_discipline.adb",
                        "sntp.ads", "sntp.adb", "server_list.ads", "server_list.adb", "clock_floor.ads");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      --  Do not implicitly search the compiled unit's directory: the CuBit
      --  runtime directory also contains target-only predefined Ada units.
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-gnatwa", "-I-");
   end Compiler;
end Timesync_Tests;
