# Headless timesync regression: system.ccl with time.servers pointed at the
# loopback fixture (tests/timesync/fixture.py). Keep other settings in sync.
# CuBit System Configuration
# Loaded by devmgr at boot, seeded into config.svc
# This CCL profile is authoritative at boot; runtime edits are volatile.
# Scheme registry: scheme.<name>.driver=<driver_id>
#                  scheme.<name>.slot=<cap_slot>
#
# driver = the DRIVER_* ID (for PID lookup via sysinfo)
# slot   = the cap slot clients use to capCall the service
# Filesystem (bare paths and @fs: prefix)
# ATA/NVMe disk files — routed through FS server
# Config store
# Network (TCP/UDP via netstack)
# Audio mixer
# Process manager
# Desktop compositor/session service
# Display scanout service
# Network interface configuration
(system-config v1
  (setting "desktop.appearance.theme.light" "(theme v1 (base alloy-light))")
  (setting "desktop.appearance.theme.dark" "(theme v1 (base alloy-dark))")
  (setting "clock.time-zone" "UTC")
  # SNTP servers for timesync.svc (host or host:port). A majority of at least
  # two must agree before the clock is adjusted.
  (setting "time.servers" "10.0.2.2:18123 10.0.2.2:18124 10.0.2.2:18125")
  (setting "scheme.fs.driver" 6)
  (setting "scheme.ata.driver" 6)
  (setting "scheme.nvme.driver" 6)
  (setting "scheme.config.driver" 11)
  (setting "scheme.net.driver" 3)
  (setting "scheme.mixer.driver" 9)
  (setting "scheme.proc.driver" 4)
  (setting "scheme.desktop.driver" 15)
  (setting "scheme.display.driver" 16)
  (setting "net.if0.method" "static")
  (setting "net.if0.address" "10.0.2.15")
  (setting "net.if0.netmask" "255.255.255.0")
  (setting "net.if0.gateway" "10.0.2.2")
  (setting "net.dns.primary" "10.0.2.3")
)
