--  SELF-003 step 2: hosted tests of the clone writer (userspace/lib/git,
--  Git_Clones) over the Linux host's directories.
with "../../userspace/lib/tls/sparktls_host.gpr";
project Git_Clone_Tests is
   for Source_Dirs use (".", "../../userspace/lib/git", "../../userspace/lib/compress");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build";
   for Main use ("clone_tool.adb", "session_tool.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-O2", "-fno-tree-vrp", "-gnata", "-gnato", "-gnatwa", "-gnatwe");
   end Compiler;
end Git_Clone_Tests;
