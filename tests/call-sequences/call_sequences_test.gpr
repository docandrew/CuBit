--  Hosted tests and proof for Call_Sequences (docs/ipc-fastpath.md).
project Call_Sequences_Test is
   for Source_Dirs use (".", "../../kernel/src");
   for Source_Files use ("call_sequences.ads", "call_sequences.adb", "main.adb");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnata", "-gnato", "-gnatwa", "-gnatwJ");
   end Compiler;
end Call_Sequences_Test;
