project Policies is
   --  Isolate portable units: the complete CuBit runtime shadows hosted GNAT.
   for Source_Dirs use (".", "build/source");
   for Source_Files use ("main.adb", "proof_cases.ads", "proof_cases.adb",
                        "cubit.ads", "cubit-protocols.ads",
                        "cubit-protocols-stream_policies.ads");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnata", "-gnato", "-gnatwa", "-gnatwe");
   end Compiler;
end Policies;
