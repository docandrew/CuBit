project Fat_Driver is
   --  The production FAT32 driver (Fat32 and its SPARK core) with only its
   --  block IPC and grant replaced by Linux-hosted file I/O (the
   --  tests/filesystem-interop fixture): fat_tool runs scripted operations
   --  on an image that host tools made and check (run.py).
   --  FS_SRC/FS_OBJ are overridden only by mutate.sh (private copies).
   Fs_Src := external ("FS_SRC", "../../userspace/services/filesystem");
   Fs_Obj := external ("FS_OBJ", "build/driver");
   for Languages use ("Ada");
   for Source_Dirs use
     (".", "../filesystem-interop/fixture", Fs_Src, "../../userspace/runtime/gnat", "../../shared/capabilities");
   for Source_Files use
     ("fat_tool.adb", "fat32.ads", "fat32.adb", "fat_format.ads", "fat_format.adb",
      "fat_names.ads", "fat_names.adb", "fat_chains.ads", "fat_chains.adb",
      "ext2_inodes.ads", "volume_admission.ads",
      "cubit-handles.ads", "capability_abi.ads", "capability_abi.adb",
      "cubit-handles-fixture.ads", "cubit-handles-fixture.adb",
      "cubit-messages.ads", "cubit-messages.adb", "cubit-monotonic.ads", "cubit-monotonic.adb",
      "cubit-system_facts.ads", "cubit-system_facts.adb", "cubit.ads",
      "cubit-memory_grants.ads", "cubit-grant_references.ads",
      "cubit-block_devices.ads", "cubit-block_devices.adb",
      "cubit-directory_pages.ads", "cubit-directory_pages.adb",
      "cubit-file_access.ads", "cubit-file_access.adb",
      "cubit-directory_paths.ads", "cubit-directory_paths.adb");
   for Object_Dir use Fs_Obj;
   for Exec_Dir use Fs_Obj;
   for Main use ("fat_tool.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-gnatwa", "-I-");
   end Compiler;
end Fat_Driver;
