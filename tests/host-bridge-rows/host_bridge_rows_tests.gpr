--  Hosted tests of devmgr's host-bridge window rows (PCI-BAR-001, run.sh).
project Host_Bridge_Rows_Tests is
   for Source_Dirs use (".", "../../userspace/services/devmgr", "../../userspace/lib/acpi-windows");
   for Source_Files use ("main.adb", "host_bridge_rows.ads", "host_bridge_rows.adb",
                         "pci_bar_placement.ads", "pci_bar_placement.adb", "acpi_host_bridge_wire.ads");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-O2", "-gnata", "-gnato", "-gnatwa", "-gnatwe");
   end Compiler;
   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--checks-as-errors=on");
   end Prove;
end Host_Bridge_Rows_Tests;
