   procedure Check (Good : Boolean; Detail : String) is
   begin
      Checks := Checks + 1;
      if not Good then raise Program_Error with Detail; end if;
   end Check;
   procedure Exercise (Code, Target : Bytes; Width : Integer_Width;
                       Case_ID : Positive; Success : Boolean) is
      OK : Boolean;
      Loaded_Status : Load_Status;
      Result : Execution_Result;
      procedure Call (Name : String; Value : out Execution_Result) is
         Node : constant Node_ID := Child (Snapshot (A), Root, Name);
      begin
         Check (Node /= Root, "find " & Name);
         Invoke (A, Input, Node, [others => (Integer_Datum, 0, Ordinary_Integer)], 0, 1000, Value);
         Check (Frame_Root_Count (A) = 0, "region frame cleanup");
      end Call;
      procedure Scalar (Name : String; Expected : Integer_Value) is
         Value : Execution_Result;
      begin
         Call (Name, Value);
         Check (Value.Status = Returned and then Value.Value = Expected,
           Case_ID'Image & Width'Image & Name & Value.Status'Image);
      end Scalar;
   begin
      Reset (A, OK); Check (OK, "isolated region reset");
      Input.Count := 1;
      Input.Tables (1) := (Offset => 0, Extent => Target'Length);
      Input.Data.Bytes := [others => 0];
      Input.Data.Bytes (1 .. Target'Length) := Target;
      Check (AML_Table_Backing.Valid_Span (Input, 1), "owned target span");
      Load (A, Code, Width, Loaded_Status); Check (Loaded_Status = Loaded, "exact region AML load");
      Scalar ("CTRL", 16#A5#);
      Scalar ("WIDT", (if Width = Bits_32 then 16#FFFF_FFFF# else Integer_Value'Last));
      for Iteration in 1 .. 2 loop
         Call ("TEST", Result);
         if Success then
            Check (Result.Status = Returned and then Result.Value = (if Width = Bits_32 then 1 else 2),
              "selected target revision" & Case_ID'Image & Result.Status'Image);
         else
            -- ACPICA AE_NOT_FOUND maps to the existing owner Unknown_Name result.
            Check (Result.Status = Unknown_Name, "selection failure" & Case_ID'Image & Result.Status'Image);
         end if;
         Scalar ("SRCV", (if Width = Bits_32 then 16#2222_0000# else 16#2222_0000_0000_0000#));
         Scalar ("MRKV", (if Success then 3 else 2));
      end loop;
   end Exercise;
begin
   Exercise (Case_1, Target_1, Bits_32, 1, true);
   Exercise (Case_2, Target_1, Bits_32, 2, true);
   Exercise (Case_3, Target_1, Bits_32, 3, false);
   Exercise (Case_4, Target_1, Bits_32, 4, false);
   Exercise (Case_5, Target_1, Bits_32, 5, false);
   Exercise (Case_6, Target_2, Bits_64, 6, true);
   Exercise (Case_7, Target_2, Bits_64, 7, true);
   Exercise (Case_8, Target_2, Bits_64, 8, false);
   Exercise (Case_9, Target_2, Bits_64, 9, false);
   Exercise (Case_10, Target_2, Bits_64, 10, false);
   Ada.Text_IO.Put_Line ("AML-REGION-SELECTOR-TIMING: PASS" & Checks'Image);
end Region_Selector_Timing_Tests;
