   procedure Check (Good : Boolean; Detail : String) is
   begin
      Checks := Checks + 1;
      if not Good then raise Program_Error with Detail; end if;
   end Check;
   procedure Exercise (Data : Bytes; Width : Integer_Width; Case_ID : Positive; Expected : Bytes; Source_Expected : Bytes; Marker : Integer_Value; Kind : Source_Kind; Source_Number : Integer_Value) is
      OK : Boolean;
      Loaded_Status : Load_Status;
      procedure Call (Name : String; Result : out Execution_Result) is
         Node : constant Node_ID := Child (Snapshot (A), Root, Name);
      begin
         Check (Node /= Root, "find " & Name);
         Invoke (A, Input, Node, [others => (Integer_Datum, 0, Ordinary_Integer)], 0, 1000, Result);
         Check (Frame_Root_Count (A) = 0, "concat frame cleanup");
      end Call;
      procedure Scalar (Name : String; Expected_Value : Integer_Value) is
         Result : Execution_Result;
      begin
         Call (Name, Result);
         Check (Result.Status = Returned and then Result.Value = Expected_Value,
           Case_ID'Image & Width'Image & Name & Result.Status'Image);
      end Scalar;
      procedure Buffer_Value (Name : String; Bytes_Expected : Bytes; Type_Code : Natural := Buffer_Type_Code) is
         Result : Execution_Result;
         Ref : Reference;
         Status : Execution_Status;
         Value : Byte;
         Read_OK : Boolean;
      begin
         Call (Name, Result);
         Check (Result.Status = Object_Returned, "buffer result" & Case_ID'Image & Width'Image & Name);
         if Result.Status /= Object_Returned then return; end if;
         Check (Result.Object.Type_Code = Type_Code and then Result.Object.Size = Bytes_Expected'Length,
           "full buffer type/length");
         -- No allocating callback between return and these authenticated reads.
         for I in Bytes_Expected'Range loop
            Make_Index (A, Result.Object.Source, Integer_Value (I - Bytes_Expected'First), Ref, Status);
            Check (Status = Returned, "authenticate buffer byte");
            Read (A, Ref, Value, Read_OK);
            Check (Read_OK and then Natural (Value) = Natural (Bytes_Expected (I)),
              "full concat byte" & Case_ID'Image & Width'Image & Name & I'Image);
         end loop;
      end Buffer_Value;
   begin
      Reset (A, OK); Check (OK, "isolated concat reset");
      Load (A, Data, Width, Loaded_Status); Check (Loaded_Status = Loaded, "exact concat AML load");
      Scalar ("CTRL", 16#A5#);
      Scalar ("WIDT", (if Width = Bits_32 then 16#FFFF_FFFF# else Integer_Value'Last));
      Buffer_Value ("TEST", Expected); case Kind is
         when Integer_Source => Scalar ("SRCV", Source_Number);
         when String_Source => Buffer_Value ("SRCV", Source_Expected, String_Type_Code);
         when Buffer_Source => Buffer_Value ("SRCV", Source_Expected);
      end case;
      Buffer_Value ("TVAL", Expected); Scalar ("MRKV", Marker);
      Buffer_Value ("TEST", Expected); case Kind is
         when Integer_Source => Scalar ("SRCV", Source_Number);
         when String_Source => Buffer_Value ("SRCV", Source_Expected, String_Type_Code);
         when Buffer_Source => Buffer_Value ("SRCV", Source_Expected);
      end case;
      Buffer_Value ("TVAL", Expected); Scalar ("MRKV", Marker);
   end Exercise;
