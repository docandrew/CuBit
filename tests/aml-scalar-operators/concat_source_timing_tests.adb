   end Check;
   procedure Exercise (Data : Bytes; Width : Integer_Width; Case_ID : Positive; Expected : Bytes) is
      OK : Boolean;
      Loaded_Status : Load_Status;
      procedure Call (Name : String; Result : out Execution_Result) is
         Node : constant Node_ID := Child (Snapshot (A), Root, Name);
      begin
         Check (Node /= Root, "find " & Name);
         Invoke (A, Input, Node, [others => (Integer_Datum, 0, Ordinary_Integer)], 0, 1000, Result);
         Check (Frame_Root_Count (A) = 0, "concat frame cleanup");
      end Call;
      procedure Scalar (Name : String; Expected_Value : Integer_Value) is
         Result : Execution_Result;
      begin
         Call (Name, Result);
         Check (Result.Status = Returned and then Result.Value = Expected_Value,
           Case_ID'Image & Width'Image & Name & Result.Status'Image);
      end Scalar;
      procedure Buffer_Value (Name : String) is
         Result : Execution_Result;
         Ref : Reference;
         Status : Execution_Status;
         Value : Byte;
         Read_OK : Boolean;
      begin
         Call (Name, Result);
         Check (Result.Status = Object_Returned, "buffer result" & Case_ID'Image & Width'Image & Name);
         if Result.Status /= Object_Returned then return; end if;
         Check (Result.Object.Type_Code = Buffer_Type_Code and then Result.Object.Size = Expected'Length,
           "full buffer type/length");
         -- No allocating callback between return and these authenticated reads.
         for I in Expected'Range loop
            Make_Index (A, Result.Object.Source, Integer_Value (I - Expected'First), Ref, Status);
            Check (Status = Returned, "authenticate buffer byte");
            Read (A, Ref, Value, Read_OK);
            Check (Read_OK and then Natural (Value) = Natural (Expected (I)),
              "full concat byte" & Case_ID'Image & Width'Image & Name & I'Image);
         end loop;
      end Buffer_Value;
