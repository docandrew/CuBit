   procedure Check (Good : Boolean; Detail : String) is
   begin
      Checks := Checks + 1;
      if not Good then raise Program_Error with Detail; end if;
   end Check;
   procedure Exercise (Data : Bytes; Width : Integer_Width; Case_ID : Positive;
                       Expected, Source_Value, Remainder_Value, Quotient_Value, Marker_Value : Integer_Value) is
      OK : Boolean;
      Loaded_Status : Load_Status;
      procedure Observe (Name : String; Expected_Value : Integer_Value) is
         Node : constant Node_ID := Child (Snapshot (A), Root, Name);
         Result : Execution_Result;
      begin
         Check (Node /= Root, "find " & Name);
         Invoke (A, Input, Node, [others => (Integer_Datum, 0, Ordinary_Integer)],
           0, 1000, Result);
         Check (Result.Status = Returned, Case_ID'Image & Width'Image & Name & Result.Status'Image);
         Check (Result.Status = Returned and then Result.Value = Expected_Value,
           "divide timing" & Case_ID'Image & Width'Image & Name &
           " actual" & (if Result.Status = Returned then Result.Value'Image else " unavailable") &
           " expected" & Expected_Value'Image);
         Check (Frame_Root_Count (A) = 0, "divide frame cleanup");
      end Observe;
   begin
      Reset (A, OK); Check (OK, "isolated divide timing reset");
      Load (A, Data, Width, Loaded_Status); Check (Loaded_Status = Loaded, "exact divide AML load");
      Observe ("CTRL", 16#A5#);
      Observe ("WIDT", (if Width = Bits_32 then 16#FFFF_FFFF# else Integer_Value'Last));
      Observe ("TEST", Expected);
      Observe ("SRCV", Source_Value);
      Observe ("RVAL", Remainder_Value);
      Observe ("QVAL", Quotient_Value);
      Observe ("MRKV", Marker_Value);
      -- The second invocation reuses the same arena and TEST resets its inputs.
      Observe ("TEST", Expected);
      Observe ("SRCV", Source_Value);
      Observe ("RVAL", Remainder_Value);
      Observe ("QVAL", Quotient_Value);
      Observe ("MRKV", Marker_Value);
