   procedure Start (Code : Bytes; Width : Integer_Width) is
      Status : C.Access_Status;
      Loaded : N.Load_Status;
      Report : N.Initialization_Report;
   begin
      C.Reset (A, Status); Check (Status = C.Available, "reset");
      C.Load (A, Code, Width, Loaded, Status);
      Check (Status = C.Available and then Loaded = N.Loaded, "load exact oracle body");
      C.Seal (A, Report, Status); Check (Status = C.Available, "seal");
   end Start;
   procedure Observe (Name, Context : String; Kind : C.Value_Kind;
                      Number : Integer_Value := 0; Expected : Bytes := []) is
      Node : N.Node_ID;
      Status : C.Access_Status;
      Outcome : C.Result;
      Description : C.Value_Description;
      Data : Bytes (1 .. 8);
      Copied : Natural;
   begin
      C.Find_Child (A, N.Root, Name, Node, Status);
      Check (Status = C.Available and then Node /= N.Root, Context & " find " & Name);
      C.Invoke (A, Input, Node, Args, 0, 1000, Outcome, Status);
      Check (Status = C.Available, Context & " access " & Name & Status'Image);
      if Kind = C.Integer_Description then
         Check (Outcome.Status = AML_Execute.Returned and then Outcome.Number = Number,
           Context & " integer " & Name & Outcome.Status'Image);
      else
         Check (Outcome.Status = AML_Execute.Object_Returned,
           Context & " object " & Name & Outcome.Status'Image);
         declare Handle : C.Value_Handle := Outcome.Handle; begin
            C.Describe (A, Handle, Description, Status);
            Check (Status = C.Available and then Description.Kind = Kind
              and then Description.Length = Expected'Length, Context & " exact type/extent " & Name);
            C.Read_Bytes (A, Handle, 0, Data, Copied, Status);
            Check (Status = C.Available and then Copied = Expected'Length, Context & " byte extent " & Name);
            Check (Data (1 .. Copied) = Expected, Context & " complete bytes " & Name);
            Check ((for all I in Copied + 1 .. Data'Last => Data (I) = 0), Context & " zero read tail");
            C.Release (A, Handle, Status); Check (Status = C.Available, Context & " release");
         end;
      end if;
      Check (C.Retained_Count (A) = 0, Context & " no retained output");
      pragma Assert (C.Module_Transient_Free (A));
   end Observe;
