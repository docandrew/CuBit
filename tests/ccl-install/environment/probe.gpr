with "../../../userspace/allocator/allocator_runtime_host.gpr";
with "../../../userspace/lib/tls/sparktls_host.gpr";
with "../../../userspace/ccl/cubit_shared.gpr";
--  Hosted tests of the CCL console view: events in, results and frames out.
project Environment_Probe is
   for Source_Dirs use ("../../../userspace/lib/lexicon", ".", "../../../userspace/ccl/src", "../../../userspace/ccl/tools/ccl-ui-preview", "../../../userspace/ccl/tools/ccl-ui-preview/host",
                        "../../../userspace/lib/ui", "../../../userspace/lib/theme", "../../../userspace/lib/calc",
                        "../../../userspace/lib/compositor", "../../../userspace/lib/display");
   --  The root package CuBit comes with cubit_shared.gpr (the runtime\'s).
   for Excluded_Source_Files use ("cubit.ads");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("probe.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-gnatwa", "-gnatwJ");
      
   end Compiler;
end Environment_Probe;
