--  Hosted tests and proof for Grant_Windows (docs/process-objects.md).
project Grant_Windows_Test is
   for Source_Dirs use (".", "../../kernel/src");
   for Source_Files use ("grant_windows.ads", "grant_windows.adb", "main.adb");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnata", "-gnato", "-gnatwa", "-gnatwJ");
   end Compiler;
end Grant_Windows_Test;
