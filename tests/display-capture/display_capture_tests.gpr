--  Hosted tests (and proofs, run.sh --prove) for remote screenshots
--  (REMOTE-001): Desktop's capture policy state machine (the person's
--  switch, the rate limit, the Deskbar mark; Desktop_Capture_Policy) and
--  the display-capture wire (CuBit.Display_Capture).
project Display_Capture_Tests is
   Runtime := "../../userspace/runtime/gnat";
   Desktop := "../../userspace/services/desktop";
   for Languages use ("Ada");
   for Source_Dirs use (".", Desktop, Runtime);
   for Source_Files use
     ("main.adb",
      "desktop_capture_policy.ads", "desktop_capture_policy.adb",
      "cubit.ads", "cubit-display_capture.ads");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-O1", "-gnata", "-gnato", "-gnatwa", "-gnatw.X", "-I-");
   end Compiler;
   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--checks-as-errors=on", "--report=fail");
   end Prove;
end Display_Capture_Tests;
