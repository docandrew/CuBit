project Worker is
   CBOR_Source := external ("CBOR_ADA_SRC");
   for Source_Dirs use (".", "../../userspace/lib/config", "../../userspace/ccl/src",
                        "../../userspace/ccl/persistence", CBOR_Source & "/src");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("protocol_tests.adb", "execution_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-O2", "-gnata", "-gnato", "-gnatwa", "-gnatwe");
      -- Pinned third-party CBOR has a known always-true-condition warning.
      -- Keep it visible without making upstream warnings fatal to our tests.
      for Switches ("cbor-decoding.adb") use
        ("-gnat2022", "-O2", "-gnata", "-gnato", "-gnatwa");
      for Switches ("cbor-encoding.adb") use
        ("-gnat2022", "-O2", "-gnata", "-gnato", "-gnatwa");
   end Compiler;
end Worker;
