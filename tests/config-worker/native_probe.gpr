library project Native_Probe is
   CBOR_Source := external ("CBOR_ADA_SRC");
   for Source_Dirs use (".", "../../userspace/lib/config", "../../userspace/ccl/src",
      "../../userspace/ccl/persistence", "../../userspace/services/config",
      "../../userspace/lib/storage", "../../userspace/lib/storage/native",
      "../config-turso/native", CBOR_Source & "/src");
   for Source_Files use
     ("ccl-types-correspondence.ads", "ccl-types-correspondence.adb") &
     ("config_native_probe.ads", "config_native_probe.adb",
      "native_storage.ads", "native_storage.adb", "storage_channel.ads", "storage_channel.adb",
      "probe_clock.ads", "probe_clock.adb",
      "config_objects.ads", "config_objects.adb",
      "config_worker_protocol.ads", "config_worker_protocol.adb",
      "config_worker.ads", "config_worker.adb", "config_worker_storage.ads",
      "config_database.ads", "config_database.adb",
      "config_database-schemas.ads", "config_database-schemas.adb",
      "config_schema_protocol.ads", "config_schema_protocol.adb",
      "ccl-objects-schemas.ads", "ccl-objects-schemas.adb",
      "ccl-objects-schemas-persistence.ads", "ccl-objects-schemas-persistence.adb",
      "ccl-objects-persistence.ads", "ccl-objects-persistence.adb",
      "cbor.ads", "cbor-model.ads", "cbor-decoding.ads", "cbor-decoding.adb",
      "cbor-encoding.ads", "cbor-encoding.adb",
      "ccl.ads", "ccl-types.ads", "ccl-types.adb",
      "ccl-bounded_stacks.ads", "ccl-bounded_stacks.adb",
      "ccl-objects.ads", "ccl-objects.adb");
   for Object_Dir use "build/native-probe";
   for Library_Dir use "build/native-probe-lib";
   for Library_Name use "config_worker_probe";
   for Library_Kind use "static";
   for Library_Interface use ("config_native_probe", "native_storage", "probe_clock");
   for Library_Standalone use "standard";
   for Library_Auto_Init use "false";
   for Runtime ("Ada") use "../../userspace/runtime";
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-O2", "-g", "-mno-red-zone", "-fno-pic", "-mno-sse", "-mno-sse2");
   end Compiler;
end Native_Probe;
