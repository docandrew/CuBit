project Lifetime_release is
 for Source_Dirs use (".","../../userspace/services/acpi/lib","../../shared/firmware","../../shared/capabilities","../../userspace/services/acpi","../../userspace/services/acpi/resource-consumer");
 Build_Root := external ("ACPI_LIFETIME_BUILD", "build-release");
 for Object_Dir use Build_Root & "/obj";for Exec_Dir use Build_Root & "/bin";
 for Main use ("membership_tests.adb","bounds_tests.adb","cleanup_tests.adb","container_lifetime_tests.adb");
 package Compiler is for Default_Switches("Ada") use ("-O3","-gnat2022","-gnatp");end Compiler;
end Lifetime_release;
