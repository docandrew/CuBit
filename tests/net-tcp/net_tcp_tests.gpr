project Net_TCP_Tests is
   Net_Src := external ("NET_SRC", "../../userspace/net/src");
   for Source_Dirs use (".", Net_Src);
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--timeout=60");
   end Prove;
end Net_TCP_Tests;
