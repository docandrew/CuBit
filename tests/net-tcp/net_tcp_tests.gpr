project Net_TCP_Tests is
   Net_Src := external ("NET_SRC", "../../userspace/net/src");
   for Source_Dirs use (".", Net_Src);
   for Object_Dir use external ("NET_OBJ", "build");
   for Exec_Dir use external ("NET_OBJ", "build");
   for Main use ("main.adb", "tcp_scenarios.adb", "tcp_endpoint_sim.adb", "tcp_flow_sim.adb", "tcp_flag_storm.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
   package Prove is
      for Proof_Switches ("Ada") use ("--level=1");
      --  Level 1's provers, with more time where a check is marginal: it
      --  proves alone but can miss level 1's 1 s budget in a saturated
      --  -j0 run (SPARKTLS gives its units --timeout=60 --memlimit=4000).
      for Proof_Switches ("slaac_table.adb") use
        ("--level=1", "--timeout=60", "--memlimit=4000");
      for Proof_Switches ("endpoint_small.ads") use
        ("--level=1", "--timeout=60", "--memlimit=4000");
      for Proof_Switches ("table_netstack.ads") use
        ("--level=1", "--timeout=60", "--memlimit=4000");
   end Prove;
end Net_TCP_Tests;
