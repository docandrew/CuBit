--  Hosted tests and proof: server-side copy slices
--  (docs/filesystem-protocol-v2.md step 5). COPY_SRC: the unit's directory.
project Copy is
   Copy_Src := external ("COPY_SRC", "../../userspace/services/filesystem");
   for Source_Dirs use (".", Copy_Src);
   for Source_Files use ("main.adb", "copy_slices.ads", "copy_slices.adb");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnato", "-gnatwa", "-gnatwe", "-O2");
   end Compiler;
end Copy;
