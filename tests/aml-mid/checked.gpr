project Checked is
 for Source_Dirs use (".", "../acpi-integration", "../acpi-integration/mocks", "../aml-core", "../../userspace/lib/acpi", "../../userspace/services/acpi", "../../userspace/services/acpi/native", "../../shared/firmware");
 for Object_Dir use "build-checked/obj";
 for Exec_Dir use "build-checked";
 for Main use ("mid_runner.adb", "mid_collecting_tests.adb", "mid_owner_tests.adb", "slices_tests.adb");
 package Compiler is
 for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnata", "-gnato");
 end Compiler;
end Checked;
