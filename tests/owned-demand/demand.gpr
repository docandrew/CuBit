project Demand is
   for Source_Dirs use (".", "../../kernel/src");
   for Object_Dir use external ("DEMAND_OBJECT_DIR", "build");
   for Main use ("demand_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatwe", "-gnato", "-O2");
   end Compiler;
end Demand;
