project Pages is
   for Source_Dirs use (".", "../../kernel/src");
   for Object_Dir use "build-pages";
   for Main use ("pages_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2012", "-gnata", "-gnatwa", "-gnatwe", "-gnato", "-O2");
   end Compiler;
end Pages;
