project Volumes is
   for Source_Dirs use (".", "../../userspace/services/filesystem");
   for Source_Files use
     ("main.adb", "volume_list.ads", "volume_list.adb",
      "shared_objects.ads", "shared_objects.adb");
   for Object_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnata", "-gnato", "-I-");
   end Compiler;
end Volumes;
