# The GNAT test launcher (tests/gnat/check): has the gcc driver compile an
# Ada program, gnatbind bind it and the driver link it, all on CuBit, then
# runs it, and has binutils-compare check each output against the same
# GNAT on Linux. The driver and gnatbind get the work and toolchain places
# from it (delegated); a launcher passes on only what it holds.
(Executable_Manifest
  identity => "com.cubit.gnat-check"
  version => "0.1.0"
  requests => [(service "process-manager" "process-manager") (service "filesystem" "filesystem")]
  scopes => [
    (filesystem [File_Right.Read File_Right.Write File_Right.Create] "@nvme:0/work")
    (filesystem [File_Right.Read] "@nvme:0/toolchain")]
  may_launch => [
    (Launch "toolchain/bin/gcc")
    (Launch "toolchain/bin/gnatbind")
    (Launch "work/hello")
    (Launch "binutils-compare.app")])
