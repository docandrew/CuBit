project GPU_Timeline is
   -- GPU-001 step 3, Linux-hosted: Mesa's GPU timeline logic
   -- (Native_GPU_Timeline, Native_GPU_Job_Rules) driven through the
   -- production queue client against the step 2 queue service and its
   -- modelled GPU (tests/intel-gpu/gpu_queue_model). MESA_SRC points at a
   -- mutated copy of the Mesa glue sources (test-gpu-timeline-mutations.sh).
   Mesa_Src := external ("MESA_SRC", "../../../userspace/mesa/anv");
   for Source_Dirs use (".", "../../intel-gpu", Mesa_Src,
                        "../../../userspace/services/intel-gpu", "../../../userspace/runtime/gnat");
   for Source_Files use
     ("cubit.ads", "cubit-protocols.ads", "cubit-channel_contracts.ads", "cubit-channel_contracts.adb",
      "cubit-channel_rings.ads", "cubit-channel_rings.adb",
      "cubit-slot_rings.ads", "cubit-slot_rings.adb",
      "cubit-submission_queues.ads", "cubit-submission_queues.adb",
      "cubit-gpu_queues.ads", "cubit-gpu_queues-kinds.ads", "cubit-gpu_queue_clients.ads", "cubit-gpu_queue_clients.adb",
      "intel_gpu_ring_reservation.ads", "intel_gpu_ring_reservation.adb",
      "intel_gpu_segment_window.ads", "intel_gpu_segment_window.adb",
      "intel_gpu_timeline.ads", "intel_gpu_timeline.adb",
      "intel_gpu_context_ledger.ads", "intel_gpu_context_ledger.adb",
      "intel_gpu_queue_admission.ads", "intel_gpu_queue_admission.adb",
      "intel_gpu_queue_wakes.ads", "intel_gpu_queue_wakes.adb",
      "intel_gpu_session_queue.ads", "intel_gpu_session_queue.adb",
      "intel_gpu_guc_context_lifecycle.ads", "intel_gpu_guc_context_lifecycle.adb",
      "intel_gpu_guc_submission_policy.ads",
      "intel_gpu_queue_service.ads", "intel_gpu_queue_service.adb",
      "gpu_queue_model.ads", "gpu_queue_model.adb",
      "native_gpu_timeline.ads", "native_gpu_timeline.adb",
      "native_gpu_job_rules.ads",
      "gpu_timeline_tests.adb");
   for Object_Dir use external ("TIMELINE_OBJ", "build");
   for Main use ("gpu_timeline_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2", "-I-");
   end Compiler;
   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--checks-as-errors=on");
   end Prove;
end GPU_Timeline;
