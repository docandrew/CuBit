+bool
+anv_drm_probe_timestamp(struct anv_physical_device *device)
+{
+   uint64_t ignored;
+   return intel_gem_read_render_timestamp(device->local_fd, device->info.kmd_type, &ignored);
+}
+
+VkResult
+anv_drm_init_engine_info(struct anv_physical_device *device)
+{
+   device->engine_info = intel_engine_get_info(device->local_fd, device->info.kmd_type);
+   intel_common_update_device_info(device->local_fd, &device->info);
+   /* Legacy Linux without engine queries uses the existing queue fallback. */
+   return VK_SUCCESS;
+}
+
+VkResult
+anv_drm_init_sync_types(struct anv_physical_device *device)
+{
+   if (device->info.is_virtio) {
+      struct util_sync_provider *sync = intel_virtio_sync_provider(device->local_fd);
+      device->sync_syncobj_type = vk_drm_syncobj_get_type_from_provider(sync);
+   } else {
+      device->sync_syncobj_type = vk_drm_syncobj_get_type(device->local_fd);
+   }
+
+   const unsigned required = VK_SYNC_FEATURE_TIMELINE | VK_SYNC_FEATURE_CPU_WAIT;
+   if (!vk_sync_type_is_drm_syncobj(&device->sync_syncobj_type) ||
+       (device->sync_syncobj_type.features & required) != required)
+      return VK_ERROR_INITIALIZATION_FAILED;
+
+   device->sync_types[0] = &device->sync_syncobj_type;
+   device->sync_types[1] = NULL;
+   device->vk.supported_sync_types = device->sync_types;
+   return VK_SUCCESS;
+}
