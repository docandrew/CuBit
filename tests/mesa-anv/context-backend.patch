+                                  uint64_t *cpu_delta)
+{
+   return intel_gem_read_correlate_cpu_gpu_timestamp(
+      device->fd, device->info->kmd_type, INTEL_ENGINE_CLASS_RENDER,
+      0, cpu_clock, cpu, gpu, cpu_delta);
+}
+
+void
+anv_drm_close_device(struct anv_device *device)
+{
+   close(device->fd);
+   device->fd = -1;
+}
+
+void
+anv_drm_abort_device(struct anv_device *device)
+{
+   intel_virtio_unref_fd(device->fd);
+   anv_drm_close_device(device);
+}
+
+VkResult
+anv_drm_open_device(struct anv_device *device)
+{
+   device->fd = open(device->physical->path, O_RDWR | O_CLOEXEC);
+   if (device->fd == -1)
+      return vk_error(device, VK_ERROR_INITIALIZATION_FAILED);
+
+   if (intel_virtio_init_fd(device->fd) < 0) {
+      anv_drm_abort_device(device);
+      return VK_ERROR_INCOMPATIBLE_DRIVER;
+   }
+
+   device->vk.copy_sync_payloads = vk_drm_syncobj_copy_payloads;
+   if (device->info->is_virtio)
+      device->vk.sync = intel_virtio_sync_provider(device->fd);
+   else
+      vk_device_set_drm_fd(&device->vk, device->fd);
+   return VK_SUCCESS;
+}
 
