project Admission_Native is
   for Source_Dirs use (".", "../../../userspace/lib/display",
     "../../../userspace/runtime/gnat", "../../../userspace/services/intel-gpu");
   for Source_Files use ("admission_native_tests.adb", "cubit.ads",
     "messages_mock.ads", "messages_mock.adb",
     "cubit-capability_grants.ads", "cubit-capability_grants.adb",
     "cubit-async_requests.ads", "cubit-async_requests.adb",
     "intel_gpu_render_sessions.ads", "intel_gpu_render_sessions.adb",
     "intel_render_admission.ads", "intel_render_admission.adb",
     "intel_render_admission_native.ads", "intel_render_admission_native.adb");
   for Object_Dir use "build-admission-native";
   for Main use ("admission_native_tests.adb");
   package Naming is
      for Spec ("CuBit.Messages") use "messages_mock.ads";
      for Body ("CuBit.Messages") use "messages_mock.adb";
   end Naming;
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato");
   end Compiler;
end Admission_Native;
