project Probe_Export extends "views.gpr" is
   for Source_Dirs use (".", "../../../userspace/services/intel-gpu",
     "../../../userspace/runtime/gnat", "../../../userspace/mesa/anv");
   for Source_Files use
     ("probe_export_tests.adb", "messages_mock.ads", "messages_mock.adb",
      "memory_mock.ads", "memory_mock.adb", "cubit.ads",
      "cubit-capability_grants.ads", "cubit-capability_grants.adb",
      "cubit-grant_references.ads", "intel_gpu_buffer_views.ads",
      "intel_gpu_buffer_views.adb", "intel_gpu_buffer_handles.ads",
     "intel_gpu_name_index.ads", "intel_gpu_name_index.adb",
      "intel_gpu_buffer_handles.adb", "intel_gpu_physical_extents.ads",
      "intel_gpu_physical_extents.adb", "intel_gpu_buffer_reply.ads",
      "intel_gpu_buffer_reply.adb", "intel_gpu_buffer_backing.ads",
      "intel_gpu_probe_export.ads", "intel_gpu_probe_export.adb",
      "native_gpu_probe_protocol.ads", "native_gpu_probe_protocol.adb");
   for Object_Dir use "build-probe-export";
   for Main use ("probe_export_tests.adb");
end Probe_Export;
