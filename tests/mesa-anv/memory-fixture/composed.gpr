project Composed extends "sharing.gpr" is
   for Source_Dirs use (".", "../../../userspace/services/intel-gpu",
     "../../../userspace/runtime/gnat", "../../../userspace/mesa/anv");
   for Source_Files use ("composed_tests.adb", "messages_composed.ads", "messages_composed.adb",
     "memory_mock.ads", "memory_mock.adb", "cubit.ads", "cubit-grant_references.ads",
     "cubit-process_ids.ads", "cubit-process_ids.adb",
     "cubit-capability_grants.ads", "cubit-capability_grants.adb",
     "intel_gpu_buffer_views.ads", "intel_gpu_buffer_views.adb",
     "intel_gpu_buffer_handles.ads", "intel_gpu_buffer_handles.adb",
     "intel_gpu_name_index.ads", "intel_gpu_name_index.adb",
     "intel_gpu_client_budgets.ads", "intel_gpu_client_budgets.adb",
     "intel_gpu_client_budget_policy.ads", "intel_gpu_client_budget_policy.adb",
     "intel_gpu_record_store.ads", "intel_gpu_record_store.adb",
     "intel_gpu_extent_directory.ads", "intel_gpu_extent_directory.adb",
     "intel_gpu_physical_extents.ads", "intel_gpu_physical_extents.adb",
     "intel_gpu_buffer_reply.ads", "intel_gpu_buffer_reply.adb",
     "intel_gpu_buffer_backing.ads", "intel_gpu_buffer_requests.ads",
     "intel_gpu_buffer_requests.adb", "intel_gpu_buffer_requests-sharing.ads",
     "intel_gpu_buffer_requests-sharing.adb", "native_gpu_calls.ads", "native_gpu_calls.adb", "native_gpu_buffers.ads", "native_gpu_buffers.adb",
     "native_gpu_memory.ads", "native_gpu_memory.adb",
     "native_gpu_mapping.c", "composed_mapping_c.c");
   for Object_Dir use "../target/buffer-composed-host";
   for Main use ("composed_tests.adb");
   package Naming is
      for Spec ("CuBit.Messages") use "messages_composed.ads";
      for Body ("CuBit.Messages") use "messages_composed.adb";
      for Spec ("CuBit.Memory_Grants") use "memory_mock.ads";
      for Body ("CuBit.Memory_Grants") use "memory_mock.adb";
   end Naming;
end Composed;
