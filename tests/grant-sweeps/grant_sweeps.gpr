--  Hosted tests for Grant_Sweeps (allocation-free grant list walks).
project Grant_Sweeps is
   for Source_Dirs use (".", "../../kernel/src");
   for Source_Files use ("grant_sweeps.ads", "grant_sweeps.adb", "main.adb");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnata", "-gnato", "-gnatwa", "-gnatwJ");
   end Compiler;
end Grant_Sweeps;
