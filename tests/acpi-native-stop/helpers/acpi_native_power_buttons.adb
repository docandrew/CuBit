with Admission_Probe; package body ACPI_Native_Power_Buttons is procedure Dispatch (Request : CuBit.Messages.Message; Quiet : Boolean; Reply : out CuBit.Messages.Message; Handled, Reply_Now : out Boolean) is pragma Unreferenced (Request); begin Admission_Probe.Seen(1):=True;Admission_Probe.Gates(1):=Quiet;Reply:=CuBit.Messages.NULL_MESSAGE;Handled:=Admission_Probe.Handle_At=1;Reply_Now:=not Handled;end Dispatch;procedure Begin_Stop is begin Admission_Probe.Button_Stops:=Admission_Probe.Button_Stops+1;end Begin_Stop;end ACPI_Native_Power_Buttons;