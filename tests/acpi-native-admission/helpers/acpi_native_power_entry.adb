with Admission_Probe; package body ACPI_Native_Power_Entry is procedure Dispatch (Server : in out ACPI_Requests.State; Request : CuBit.Messages.Message; Runtime_Selected : Boolean; Reply : out CuBit.Messages.Message; Handled, Reply_Now : out Boolean) is pragma Unreferenced (Server, Request); begin Admission_Probe.Seen(2):=True;Admission_Probe.Gates(2):=Runtime_Selected;Reply:=CuBit.Messages.NULL_MESSAGE;Handled:=Admission_Probe.Handle_At=2;Reply_Now:=not Handled;end Dispatch;procedure Begin_Stop is begin Admission_Probe.Entry_Stops:=Admission_Probe.Entry_Stops+1;end Begin_Stop;function Blocks_Runtime return Boolean is (Admission_Probe.Blocked);end ACPI_Native_Power_Entry;