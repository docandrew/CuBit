--  Hosted test and proof of the xHCI pass-through-until-handoff state
--  machine (kernel/src/handoff_contexts).
project Handoff_Contexts_Tests is
   for Source_Dirs use (".", "../../kernel/src");
   for Source_Files use ("main.adb", "handoff_contexts.ads", "handoff_contexts.adb");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-O2", "-gnata", "-gnato", "-gnatwa", "-gnatwe");
   end Compiler;
end Handoff_Contexts_Tests;
