# supervision-check (headless supervision, SUP-001): a supervisor. Its
# start-children scope is its may_launch list: supervision-child.app only.
(Executable_Manifest
  identity => "com.cubit.test.supervision-check"
  version => "1"
  requests => [(service "process-manager" "process-manager")
    # ABI-002: its debug text (CuBit.Console_Route).
    (service "logstore" "logstore")]
  optional => ["logstore"]
  may_launch => [(Launch "supervision-child.app")])
