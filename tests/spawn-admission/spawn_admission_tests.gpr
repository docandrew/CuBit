--  Hosted tests and proof of the kernel's SPAWN admission rules
--  (kernel/src/spawn_admission.ads, CAP-012).
project Spawn_Admission_Tests is
   for Source_Dirs use (".", "../../kernel/src");
   for Source_Files use
     ("main.adb", "capabilities.ads", "spawn_admission.ads", "spawn_admission.adb");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnato", "-O2", "-gnatwa", "-gnatwJ");
   end Compiler;
   package Prove is
      for Proof_Switches ("Ada") use ("--counterexamples=off");
   end Prove;
end Spawn_Admission_Tests;
