project Test_Console_Tests is
   for Source_Dirs use (".", "../../shared/capabilities", "../../userspace/runtime/gnat");
   for Source_Files use ("main.adb", "test_console_abi.ads", "cubit.ads", "cubit-protocols.ads",
                         "cubit-log_records.ads", "cubit-log_records.adb",
                         "cubit-log_records-texts.ads", "cubit-log_records-texts.adb",
                         "cubit-console_lines.ads", "cubit-console_lines.adb");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--timeout=60");
   end Prove;
end Test_Console_Tests;
