project Splice_Tests is
   for Source_Dirs use (".", "../../kernel/src");
   for Source_Files use ("main.adb", "test_splices.ads", "address_splices.ads",
     "intrusive_list_splices.ads", "intrusive_list_splices.adb",
     "buddy_blocks.ads", "buddy_blocks.adb",
     "buddy_list_refinement.ads", "buddy_list_refinement.adb",
     "refinement_checks.ads", "refinement_checks.adb");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2", "-g");
   end Compiler;
end Splice_Tests;
