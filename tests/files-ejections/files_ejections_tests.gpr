project Files_Ejections_Tests is
   for Source_Dirs use (".", "../../userspace/apps/files");
   for Source_Files use ("main.adb", "files_ejections.ads");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnatwa", "-gnatwe");
   end Compiler;
end Files_Ejections_Tests;
