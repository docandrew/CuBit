project Checked is
 for Source_Dirs use (".", "../acpi-integration", "../acpi-integration/mocks", "../aml-core", "../../userspace/services/acpi/lib", "../../userspace/services/acpi", "../acpi-table-import-model", "../../shared/firmware", "../../userspace/services/acpi/resource-consumer");
 for Object_Dir use "build-checked/obj";
 for Exec_Dir use "build-checked";
 for Main use ("to_buffer_runner.adb", "to_buffer_owner_tests.adb", "to_buffer_collecting_tests.adb");
 package Compiler is
 for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnata", "-gnato");
 end Compiler;
end Checked;
