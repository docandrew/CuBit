project adapter_acpi_integration_checked is
 for Source_Dirs use ("../acpi-integration", "../aml-core", "../acpi-integration/mocks", "../../userspace/lib/acpi", "../../userspace/services/acpi", "../../userspace/services/acpi/native", "../../shared/firmware");
 for Object_Dir use "adapter_acpi_integration_checked-obj";
 package Compiler is
 for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnata", "-gnato");
 end Compiler;
end adapter_acpi_integration_checked;
