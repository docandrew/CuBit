# CuBit live-system configuration
#
# Authoritative live-boot CCL profile. Config has no filesystem authority and
# cannot load overrides or write to an internal disk behind this declaration.
(system-config v1
  (setting "desktop.appearance.theme.light" "(theme v1 (base alloy-light))")
  (setting "desktop.appearance.theme.dark" "(theme v1 (base alloy-dark))")
  # Asset packages on the live disc (docs/assets.md). The all-in-initrd
  # laptop image has none; Desktop then draws the flat theme colour.
  (setting "system.assets.root" "@cd:0/Assets/")
  # Keyboard auto-repeat (Desktop, docs/development-backlog.md UI-022): the
  # delay before a held key's first repeat and the repeats per second. The
  # CCL type Key_Repeat (CCL.Interfaces.Desktop_Input) bounds both.
  # GPU waitboost (docs/gpu-async-submission.md "SLPC waitboost"): RP0
  # while clients wait on the GPU or Desktop takes input. Set false to A/B.
  (setting "gpu.power.waitboost" (GPU_Waitboost enabled => true))
  # Native mode on Intel outputs (docs/display-modesetting.md, DISP-006):
  # switch to the monitor's best admitted mode from EDID instead of the
  # firmware's. Off until the modeset passes its hardware soak (DISP-013).
  (setting "desktop.display.modeset" (Display_Modeset enabled => false))
  (setting "desktop.input.key-repeat"
    (Key_Repeat enabled => true delay_ms => 500 rate_hz => 30))
  # The NUC live disc: the user's zone (Settings > Date & Time changes it).
  (setting "clock.time-zone" "America/Denver")
  (setting "logs.minimum-level" "Severity.Information")
  # Explicitly volatile Turso; no writes to the machine's internal disks.
  (setting "cubit.config.storage.database" ":memory:")
  (setting "desktop.launch.10-workbench"
    (Launch_Entry label => "CCL Workbench" action => (Launch_Action.Program "ccl-workbench.app") icon => (Launch_Icon "Workbench") category => App_Category.Development
      color => (App_Color.RGB (RGB_Color red => 47 green => 79 blue => 158))))
  (setting "desktop.launch.12-console"
    (Launch_Entry label => "CCL Console" action => (Launch_Action.Program "ccl-console.app") icon => (Launch_Icon "Console") category => App_Category.Development
      color => (App_Color.RGB (RGB_Color red => 43 green => 122 blue => 70))))
  (setting "desktop.launch.20-doom"
    (Launch_Entry label => "DOOM" action => (Launch_Action.Program "doom.elf") icon => (Launch_Icon "Doom") category => App_Category.Games single_instance => true
      color => (App_Color.RGB (RGB_Color red => 179 green => 38 blue => 26))))
  (setting "desktop.launch.30-devices"
    (Launch_Entry label => "Devices" action => (Launch_Action.Program "devices.app") icon => (Launch_Icon "Devices") category => App_Category.System
      color => (App_Color.RGB (RGB_Color red => 95 green => 184 blue => 72))))
  (setting "desktop.launch.40-servo"
    (Launch_Entry label => "Penny" action => (Launch_Action.Program "cubitshell.app") icon => (Launch_Icon "Penny") category => App_Category.Web
      color => (App_Color.RGB (RGB_Color red => 184 green => 106 blue => 58))))
  (setting "desktop.launch.50-files"
    (Launch_Entry label => "Files" action => (Launch_Action.Program "files.app") icon => (Launch_Icon "Files") category => App_Category.Tools
      color => (App_Color.RGB (RGB_Color red => 224 green => 162 blue => 31))))
  (setting "desktop.launch.54-calculator"
    (Launch_Entry label => "Calculator" action => (Launch_Action.Program "calculator.app") icon => (Launch_Icon "Calculator") category => App_Category.Tools
      color => (App_Color.RGB (RGB_Color red => 18 green => 165 blue => 143))))
  (setting "desktop.launch.56-dictionary"
    (Launch_Entry label => "Dictionary" action => (Launch_Action.Program "dictionary.app") icon => (Launch_Icon "Dictionary") category => App_Category.Tools
      color => (App_Color.RGB (RGB_Color red => 196 green => 40 blue => 62))))
  (setting "desktop.launch.60-sameboy"
    (Launch_Entry label => "SameBoy" action => (Launch_Action.Program "sameboy.app") icon => (Launch_Icon "Gameboy") category => App_Category.Games
      color => (App_Color.RGB (RGB_Color red => 116 green => 116 blue => 154))))
  (setting "desktop.launch.70-config-inspector"
    (Launch_Entry label => "Config Inspector" action => (Launch_Action.Program "config-inspector.app") icon => (Launch_Icon "Inspector") category => App_Category.System
      color => (App_Color.RGB (RGB_Color red => 123 green => 63 blue => 214))))
  (setting "desktop.launch.80-settings"
    (Launch_Entry label => "Settings" action => Launch_Action.Settings icon => (Launch_Icon "Settings") category => App_Category.System
      color => (App_Color.RGB (RGB_Color red => 61 green => 124 blue => 201))))
  (setting "desktop.launch.90-teapots"
    (Launch_Entry label => "Teapots" action => (Launch_Action.Program "teapots.app") icon => (Launch_Icon "Teapots") category => App_Category.Media
      color => (App_Color.RGB (RGB_Color red => 207 green => 76 blue => 156))))
  (setting "desktop.launch.95-boot-logs"
    (Launch_Entry label => "Boot Diagnostics" action => (Launch_Action.Program "boot-logs.app") icon => (Launch_Icon "Boot") category => App_Category.System
      color => (App_Color.RGB (RGB_Color red => 122 green => 74 blue => 34))))
  (setting "desktop.launch.96-logs"
    (Launch_Entry label => "Logs" action => (Launch_Action.Program "logs.app") icon => (Launch_Icon "Logs") category => App_Category.System
      color => (App_Color.RGB (RGB_Color red => 133 green => 147 blue => 170))))
  (setting "scheme.fs.driver" 6)
  (setting "scheme.ata.driver" 6)
  (setting "scheme.nvme.driver" 6)
  (setting "scheme.config.driver" 11)
  (setting "scheme.net.driver" 3)
  (setting "scheme.mixer.driver" 9)
  (setting "scheme.proc.driver" 4)
  (setting "scheme.desktop.driver" 15)
  (setting "scheme.display.driver" 16)
  (setting "net.if0.method" "static")
  (setting "net.if0.address" "10.0.2.15")
  (setting "net.if0.netmask" "255.255.255.0")
  (setting "net.if0.gateway" "10.0.2.2")
  (setting "net.dns.primary" "10.0.2.3")
)
