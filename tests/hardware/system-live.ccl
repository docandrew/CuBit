# CuBit live-system configuration
#
# Deliberately omit config.store: a live boot must not persist configuration
# or write to an internal disk merely because a block driver recognizes it.
(system-config v1
  (set "clock.time-zone" "UTC")
  (set "scheme.fs.driver" 6)
  (set "scheme.fs.slot" 1)
  (set "scheme.ata.driver" 6)
  (set "scheme.ata.slot" 1)
  (set "scheme.nvme.driver" 6)
  (set "scheme.nvme.slot" 1)
  (set "scheme.config.driver" 11)
  (set "scheme.config.slot" 20)
  (set "scheme.net.driver" 3)
  (set "scheme.net.slot" 11)
  (set "scheme.mixer.driver" 9)
  (set "scheme.mixer.slot" 14)
  (set "scheme.proc.driver" 4)
  (set "scheme.proc.slot" 12)
  (set "scheme.desktop.driver" 15)
  (set "scheme.desktop.slot" 21)
  (set "scheme.display.driver" 16)
  (set "scheme.display.slot" 22)
  (set "net.if0.method" "static")
  (set "net.if0.address" "10.0.2.15")
  (set "net.if0.netmask" "255.255.255.0")
  (set "net.if0.gateway" "10.0.2.2")
  (set "net.dns.primary" "10.0.2.3")
)
