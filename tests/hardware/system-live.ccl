# CuBit live-system configuration
#
# Deliberately omit config.store: a live boot must not persist configuration
# or write to an internal disk merely because a block driver recognizes it.
(system-config v1
  (setting "desktop.appearance.theme.light" "(theme v1 (base alloy-light))")
  (setting "desktop.appearance.theme.dark" "(theme v1 (base alloy-dark))")
  (setting "clock.time-zone" "UTC")
  (setting "scheme.fs.driver" 6)
  (setting "scheme.fs.slot" 1)
  (setting "scheme.ata.driver" 6)
  (setting "scheme.ata.slot" 1)
  (setting "scheme.nvme.driver" 6)
  (setting "scheme.nvme.slot" 1)
  (setting "scheme.config.driver" 11)
  (setting "scheme.config.slot" 20)
  (setting "scheme.net.driver" 3)
  (setting "scheme.net.slot" 11)
  (setting "scheme.mixer.driver" 9)
  (setting "scheme.mixer.slot" 14)
  (setting "scheme.proc.driver" 4)
  (setting "scheme.proc.slot" 12)
  (setting "scheme.desktop.driver" 15)
  (setting "scheme.desktop.slot" 21)
  (setting "scheme.display.driver" 16)
  (setting "scheme.display.slot" 22)
  (setting "net.if0.method" "static")
  (setting "net.if0.address" "10.0.2.15")
  (setting "net.if0.netmask" "255.255.255.0")
  (setting "net.if0.gateway" "10.0.2.2")
  (setting "net.dns.primary" "10.0.2.3")
)
