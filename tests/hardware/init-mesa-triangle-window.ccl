# Opt-in real Mesa draw and synchronous Desktop presentation diagnostic.
(startup v1
  (start "logstore.svc")
  (start "clock.svc")
  (start "config-storage.svc" (role config-storage))
  (start "display.svc")
  (start "desktop.svc")
  (start "boot-logs.app")
  (start "mesa-triangle-window.app" (render approve-declared)))
