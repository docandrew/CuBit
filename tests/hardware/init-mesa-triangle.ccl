# Opt-in actual Mesa shader/draw/readback on Intel; no window presentation.
(startup v1
  (start "logstore.svc")
  (start "clock.svc")
  (start "config-storage.svc" (role config-storage))
  (start "display.svc")
  (start "desktop.svc")
  (start "boot-logs.app")
  (start "mesa-triangle.app" (render approve-declared)))
