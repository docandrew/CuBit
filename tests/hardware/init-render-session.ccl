# Opt-in Intel hardware fixture. Image must contain render-session.app.
# This is not selected by the normal live image.
(startup v1
  (start "logstore.svc")
  (start "clock.svc")
  (start "config-storage.svc" (role config-storage))
  (start "display.svc")
  (start "desktop.svc")
  (start "boot-logs.app")
  (start "render-session.app" (render approve-declared)))
