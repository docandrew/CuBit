# Frozen startup-v1 hardware fixture, not new production manifest syntax.
# Pair with the optional-render Mesa-linked Desktop candidate. Normal Desktop
# and the existing triangle-window profile remain unchanged.
(startup v1
  (start "logstore.svc")
  (start "clock.svc")
  (start "config-storage.svc" (role config-storage))
  (start "display.svc")
  (start "desktop.svc" (render approve-declared))
  (start "boot-logs.app")
  (start "mesa-triangle-window.app" (render approve-declared)))
