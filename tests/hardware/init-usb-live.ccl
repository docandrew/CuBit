# Services and applications below are on ISO9660, not the bootstrap archive.
(startup v1
  (start "logstore.svc" (priority 5))
  (start "clock.svc" (priority 5))
  (start "config-storage.svc" (priority 5) (role config-storage))
  (start "display.svc" (priority 5))
  # ACPI: the backend holds the FADT I/O windows and serves named
  # registers; acpi.svc (AML, no hardware authority) connects to it.
  # It also gets the read-only PCI segment 0 bus 0 window (ECAM), which
  # serves AML PCI_Config fields and SystemMemory aliases of that window.
  (start "acpi-backend.svc" (priority 5)
    (firmware-snapshot approve-declared) (acpi-hardware approve-declared)
    (acpi-pci-config approve-declared))
  (start "acpi.svc" (priority 4)
    (firmware-snapshot approve-declared) (acpi-registers approve-declared))
  # Dictionary, thesaurus and spelling (docs/lexicon.md).
  (start "lexicon.svc" (priority 4))
  # GPU rendering is a settings grant (desktop.render.gpu, default on);
  # without a supported GPU devmgr refuses the session and Desktop renders
  # in software. One image for every machine (HW-002).
  (start "desktop.svc" (priority 4) (render setting "desktop.render.gpu"))
  (start "boot-logs.app" (priority 4))
)
