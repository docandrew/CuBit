# The installed system of the device-build live medium (SYS-001,
# SELF-002; build-live.sh --device-build installs it as init.ccl):
# tests/hardware/init-installed.ccl with ccl-remote listening on the LAN
# and builds granted. Services and applications below are on the
# installed root (@ufs:0, @system), which devmgr attaches before procmgr;
# so are the toolchain, the Storehouse and the workspace.
(startup v1
  (start "logstore.svc" (priority 5))
  (start "clock.svc" (priority 5))
  # The agent path (AGENT-002): tls.svc holds the trust store (tls/roots.der)
  # and connects for llm.svc, whose one tls-scope is the Messages API host.
  # timesync keeps the wall clock certificate validation needs.
  (start "tls.svc" (priority 5) (network approve-declared))
  (start "timesync.svc" (priority 5) (network approve-declared))
  (start "config-storage.svc" (priority 5) (role config-storage))
  (start "display.svc" (priority 5))
  # Dictionary, thesaurus and spelling (docs/lexicon.md).
  (start "lexicon.svc" (priority 4))
  # GPU rendering is a settings grant (desktop.render.gpu, default on);
  # without a supported GPU devmgr refuses the session and Desktop renders
  # in software. One image for every machine (HW-002).
  # BUG-001: a desktop that fails is started again (procmgr, growing delay).
  (start "desktop.svc" (priority 4) (render setting "desktop.render.gpu")
    (restart on-failure))
  (start "boot-logs.app" (priority 4))
  # tls.svc has registered by now (llm.svc's TLS scope needs it). The API
  # key is the named secret anthropic-api-key, typed into agent.app's
  # masked entry; only llm.svc's registered role may use it (SEC-022).
  (start "secrets.svc" (priority 5)
    (arguments (Secrets_Parameters
      grant => (Secret_Grant secret => "anthropic-api-key" holder => Secret_Holder.Llm_Service))))
  (start "llm.svc" (priority 5) (network approve-declared)
    (arguments (Llm_Service_Parameters
      endpoint => "api.anthropic.com:443" api_key_secret => "anthropic-api-key")))
  # The LAN remote session (tools/cubit-remote) with builds granted
  # (SELF-002): port 8445; the pairing code is shown in a window.
  # Its work root is the system volume's (@system/work: the installed
  # root), where the installer put the device-build payload's workspace
  # beside /toolchain and /storehouse. Replacing a running app with its
  # build needs the person's "Allow app replacement" (the Deskbar's
  # Remote access section, off at boot).
  (start "ccl-remote.app" (priority 4) (network approve-declared) (display-capture approve-declared)
    (arguments (Remote_Parameters listen => Remote_Listen.LAN
      display => Pairing_Display.Window work => "@system/work"
      files => true builds => true mail => true)))
)
