# CuBit laptop live session
#
# Every executable in this profile is loaded from the read-only CPIO initrd.
# No block device is required to reach the desktop.
(startup v1
  (start "storage-check.app" (priority 5))
  (start "logstore.svc" (priority 5))
  (start "clock.svc" (priority 5))
  (start "display.svc" (priority 5))
  (start "desktop.svc" (priority 4))
)
