# Opt-in real Mesa/ANV device lifecycle on Intel hardware.
# Device creation may submit internal setup batches; no application drawing.
(startup v1
  (start "logstore.svc")
  (start "clock.svc")
  (start "config-storage.svc" (role config-storage))
  (start "display.svc")
  (start "desktop.svc")
  (start "boot-logs.app")
  (start "mesa-logical-device.app" (render approve-declared)))
