project manifest_policy_checked is
 Build := external ("PROVIDER_NATIVE_BUILD", "build/manifest_policy-checked");
 for Source_Dirs use ("../../shared/firmware", "fixtures/manifest-policy", "../../userspace/services/acpi/snapshot-manifest");
 for Source_Files use ("acpi_snapshot_manifest.adb", "acpi_snapshot_manifest.ads", "firmware_tables-catalog.adb", "firmware_tables-catalog.ads", "firmware_tables-copies.adb", "firmware_tables-copies.ads", "firmware_tables-dmar.adb", "firmware_tables-dmar.ads", "firmware_tables-exposure.adb", "firmware_tables-exposure.ads", "firmware_tables-hpet.adb", "firmware_tables-hpet.ads", "firmware_tables-identifiers.adb", "firmware_tables-identifiers.ads", "firmware_tables-madt.adb", "firmware_tables-madt.ads", "firmware_tables-mcfg.adb", "firmware_tables-mcfg.ads", "firmware_tables-provisioning.adb", "firmware_tables-provisioning.ads", "firmware_tables-slit.adb", "firmware_tables-slit.ads", "firmware_tables-snapshots.adb", "firmware_tables-snapshots.ads", "firmware_tables-srat.adb", "firmware_tables-srat.ads", "firmware_tables.adb", "firmware_tables.ads", "manifest_tests.adb");
 for Object_Dir use Build & "/obj";
 for Exec_Dir use Build & "/bin";
 for Main use ("manifest_tests.adb");
 package Compiler is
  for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnata", "-gnato");
 end Compiler;
end manifest_policy_checked;
