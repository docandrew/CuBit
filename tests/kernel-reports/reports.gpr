--  Hosted tests and proof for Kernel_Reports (docs/ipc-delivery.md).
project Reports is
   for Source_Dirs use (".", "../../kernel/src");
   for Source_Files use ("kernel_reports.ads", "kernel_reports.adb", "main.adb");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnata", "-gnato", "-gnatwa", "-gnatwJ");
   end Compiler;
end Reports;
