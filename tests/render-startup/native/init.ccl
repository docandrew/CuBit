# No Intel rendering provider is present in this QEMU fixture.
(startup v1
  (start "display.svc")
  (start "desktop.svc")
  (start "render-denied.app")
  (start "render-unavailable.app" (render approve-declared))
  (start "render-software.app")
  (start "render-fallback.app" (render approve-declared))
  (start "render-occupied.app")
  (start "render-invalid.app")
  (start "devices.app"))
