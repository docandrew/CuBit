(startup v1
  (start "display.svc" (priority 5))
  (start "desktop.svc" (priority 4))
  (start "render-denied.app" (priority 3))
  (start "render-unavailable.app" (priority 3) (render approve-declared))
  (start "render-software.app" (priority 3))
  (start "render-fallback.app" (priority 3) (render approve-declared))
  (start "render-occupied.app" (priority 3))
  (start "render-invalid.app" (priority 3))
  (start "devices.app" (priority 3)))
