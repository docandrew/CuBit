project Control is
   for Source_Dirs use (".", "../../userspace/services/mixer");
   for Source_Files use ("main.adb", "mixer_control.ads", "mixer_control.adb");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Control;
