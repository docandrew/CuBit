project adapter_8_release is
 for Source_Dirs use ("../aml-notify", "../../userspace/services/acpi/lib", "../../shared/firmware");
 for Object_Dir use "build-8-release";
 package Compiler is
  for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnatp", "-gnatwF");
 end Compiler;
end adapter_8_release;
