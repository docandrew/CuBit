project adapter_7_release is
 for Source_Dirs use ("../aml-metadata-execute", "../../userspace/lib/acpi", "../../shared/firmware");
 for Object_Dir use "build-7-release";
 package Compiler is
  for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnatp", "-gnatwF");
 end Compiler;
end adapter_7_release;
