project adapter_6_release is
 for Source_Dirs use ("../aml-debug", "../../userspace/services/acpi/lib", "../../shared/firmware");
 for Object_Dir use "build-6-release";
 package Compiler is
  for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnatp", "-gnatwF");
 end Compiler;
end adapter_6_release;
