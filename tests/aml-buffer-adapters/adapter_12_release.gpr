project adapter_12_release is
 for Source_Dirs use ("../aml-retention", "../../userspace/lib/acpi", "../../shared/firmware");
 for Object_Dir use "build-12-release";
 package Compiler is
  for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnatp", "-gnatwF");
 end Compiler;
end adapter_12_release;
