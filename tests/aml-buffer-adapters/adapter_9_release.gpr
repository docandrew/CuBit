project adapter_9_release is
 for Source_Dirs use ("../aml-references", "../../userspace/lib/acpi", "../../shared/firmware");
 for Object_Dir use "build-9-release";
 package Compiler is
  for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnatp", "-gnatwF");
 end Compiler;
end adapter_9_release;
