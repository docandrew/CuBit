project Deadlines is
   for Source_Dirs use (".", "../../kernel/src");
   for Source_Files use ("main.adb", "proof_driver.ads", "proof_driver.adb",
                        "deadline_ownership.ads", "deadline_ownership.adb");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Deadlines;
