project Loans is
   for Source_Dirs use
     (".", "../../kernel/src", "../../userspace/runtime/gnat");
   for Source_Files use
     ("main.adb", "parent_lifetime_test.adb", "output_lifetime_test.adb",
      "loan_proof.ads", "cubit.ads",
      "cubit-presentation_state.ads", "cubit-presentation_state.adb",
      "memory_grants.ads", "memory_grants.adb",
      "memory_grants-loans.ads", "memory_grants-loans.adb");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use
     ("main.adb", "parent_lifetime_test.adb", "output_lifetime_test.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnato", "-gnatwa", "-gnatwe", "-O2");
   end Compiler;
end Loans;
