--  gnatprove (level 2) over procmgr's late-introduction ledger
--  (CuBit.Introduction_Ledgers): an introduction is always a kept decision of that
--  very holder and index (Find, Next_For), a decision is used at most once
--  (Remove), a holder's decisions go when it exits (Forget), and Keep only
--  adds the one decision it was given.
project Prove is
   for Source_Dirs use ("build/links", "../../userspace/ccl/runtime-shared");
   for Source_Files use
     ("cubit.ads", "cubit-late_introduction.ads", "cubit-introduction_ledgers.ads", "cubit-introduction_ledgers.adb");
   for Object_Dir use "build/prove";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022");
   end Compiler;
   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--checks-as-errors=on");
   end Prove;
end Prove;
