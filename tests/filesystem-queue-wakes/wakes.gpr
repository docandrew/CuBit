project Wakes is
   for Source_Dirs use (".", "../../userspace/services/filesystem");
   for Source_Files use ("main.adb", "queue_wakes.ads", "queue_wakes.adb");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnato", "-gnatwa", "-gnatwe", "-O2");
   end Compiler;
   package Prove is
      for Proof_Switches ("Ada") use ("--level=2");
   end Prove;
end Wakes;
