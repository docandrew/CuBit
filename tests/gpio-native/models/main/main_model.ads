pragma Ada_2022;
with Interfaces;
with Ada.Strings.Unbounded;
with CuBit.Handles;
with CuBit.Process_IDs;
with GPIO_Control_Wire;
with Intel_ADLN_GPIO;
with Intel_GPIO_IRQ;
package Main_Model is
   package G renames Intel_ADLN_GPIO;
   package I renames Intel_GPIO_IRQ;
   package W renames GPIO_Control_Wire;
   package P renames CuBit.Process_IDs;
   package U renames Ada.Strings.Unbounded;
   type Scenario is (Happy, Invalid_Launcher, Clock_Loss, Map_Refused, Role_Refused,
      Readiness_Refused, Early_Stop, Parking_Unknown, Wait_Failure, Stop_During_Admission, Missing_Community);
   Current : Scenario := Happy;
   Driver_ID : constant P.Process_ID := P.From_Word (16#F123_4567_0000_0011#);
   Launcher_ID : constant P.Process_ID := P.From_Word (16#F234_5678_0000_0022#);
   Client_ID : constant P.Process_ID := P.From_Word (16#F345_6789_0000_0033#);
   Badge : constant W.Word := 16#4750_1000_0001_00A0#; -- GPv1 pin160 level low
   Clock : Interfaces.Unsigned_64 := 1;
   type Register_Array is array (Natural range 0 .. 2047) of I.Word;
   type Register_Bank is array (G.Memory_Resource_Ordinal) of Register_Array;
   Memory, Initial_Memory : Register_Bank := [others => [others => 0]];
   Metadata_Inspections, Binds, Probes, Register_Reads, Register_Writes : Natural := 0;
   Role_Attempts, Ready_Reports, Decline_Reports, Saved_Answers, Control_Answers : Natural := 0;
   Sink_Closes, Sink_Discards, Event_Deliveries, Waits, Yields, Post_Decline_Waits : Natural := 0;
   Writes_At_Decline, Reads_At_Decline : Natural := 0;
   Last_Admin : W.Completion_Status := W.Refused;
   Last_Control : W.Completion := (W.Arm, W.Refused, 0, 0);
   Last_Event : W.Event := (1, 1);
   Ready_ACK, Stop_Queued, Offered, Saved, Sink_Closed : Boolean := False;
   Request_Stage : Natural := 0;
   Logs : U.Unbounded_String;
   Test_Complete : exception;
   procedure Check (OK : Boolean; Why : String);
   Checks : Natural := 0;
   procedure Initialize;
   function Authorized (Caller : P.Process_ID) return Boolean;
   procedure Take_Offer (Caller : P.Process_ID; Receipt : out Natural; Owned : out Boolean);
   procedure Inspect (Receipt : Natural; Sink : out Natural; Owner : out P.Process_ID; Value : out W.Word; Valid : out Boolean);
   procedure Discard (Receipt : Natural; Closed : out Boolean);
   procedure Save (Reply : out CuBit.Handles.Reply; Accepted : out Boolean);
   procedure Answer_Saved (Reply : CuBit.Handles.Reply; Label : W.Operation;
      Status : W.Completion_Status; Delivered : out Boolean);
   procedure Answer_Current (Caller : P.Process_ID; Label : W.Operation;
      Status : W.Completion_Status; Delivered : out Boolean);
   procedure Answer_Control (Reply : CuBit.Handles.Reply; Value : W.Completion; Delivered : out Boolean);
   procedure Try_Event (Sink : Natural; Value : W.Event; Accepted : out Boolean);
   procedure Close_Sink (Sink : Natural; Closed : out Boolean);
end Main_Model;
