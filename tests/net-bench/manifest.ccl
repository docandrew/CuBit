# Network benchmark client (tests/net-bench): TCP to the host fixture's
# ports only, and a listener for the host to connect in; the libc routes
# each to its scope. Needs network=declared launch approval. The kernel
# trace object (Trace_ABI) brackets each round-trip run (reset before,
# summary after) and needs (trace approve-declared).
(Executable_Manifest
  identity => "com.cubit.net-bench"
  version => "0.1.0"
  optional => ["logstore"]
  requests => [
    # Its diagnostics (cubit_debug_write, the libc's records: CuBit.Libc_Log).
    (service "logstore" "logstore")
    (network Network_Action.TCP_Connect "10.0.2.2" 32 18480 18484 false 8 "network")
               # The serve workload: the host connects in (QEMU forwards to port 8080).
               (network Network_Action.TCP_Listen "10.0.2.15" 32 8080 8080 false 8 "listen")
               (Request.Kernel_Object (Kernel_Object_Request Kernel_Object.Trace "trace"))])
