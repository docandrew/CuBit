# Filesystem benchmark (tests/fs-bench): fs-bench.app on the NVMe ext2
# volume, the same program the Linux reference runs (linux.sh). It starts
# itself again (posix_spawn) as the other process of the parked-handle
# coherence checks.
(startup v1
  (start "logstore.svc" (priority 5))
  (start "fs-bench.app" (priority 3))
)
