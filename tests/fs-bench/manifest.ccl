# Filesystem benchmark (tests/fs-bench): files under @nvme:0/fs-bench only,
# through filesystem.svc (the libc's file layer).
(executable-manifest v1
  (identity "com.cubit.fs-bench")
  (version "0.1.0")
  (request-service filesystem read-write filesystem)
  (filesystem-scope (rights read write create) "@nvme:0/fs-bench"))
