project Interop is
   --  Overridden only to build a private copy of the filesystem sources.
   Fs_Src := external ("FS_SRC", "../../userspace/services/filesystem");
   Fs_Obj := external ("FS_OBJ", "build");
   for Languages use ("Ada");
   for Source_Dirs use
     (".", "fixture", Fs_Src, "../../userspace/runtime/gnat", "../../shared/capabilities");
   for Source_Files use
     ("cubit-handles.ads", "capability_abi.ads", "capability_abi.adb", "cubit-handles-fixture.ads", "cubit-handles-fixture.adb", "main.adb", "cubit-messages.ads", "cubit-messages.adb", "cubit-system_facts.ads", "cubit-system_facts.adb", "cubit.ads",
      "ext2.ads", "ext2.adb", "ext2_format.ads", "ext2_format.adb", "ext2_geometry.ads", "ext2_geometry.adb", "ext2_bitmaps.ads", "ext2_bitmaps.adb", "ext2-admission.adb","ext2-admission.ads","ext2-allocation.adb","ext2-allocation.ads","ext2-block_cache.adb","ext2-block_cache.ads","ext2-device_io.adb","ext2-device_io.ads","ext2-directories.adb","ext2-directories.ads","ext2-files.adb","ext2-files.ads","ext2-journal.adb","ext2-journal.ads","ext2-lookup.adb","ext2-lookup.ads","ext2-mapping.adb","ext2-mapping.ads","ext2-metadata.adb","ext2-metadata.ads","ext2-removal.adb","ext2-removal.ads","ext2-rename.adb","ext2-rename.ads","ext2-resize.adb","ext2-resize.ads", "ext2_inodes.ads", "ext2_support.ads", "ext2_support.adb",
      "sector_accounting.ads", "sector_accounting.adb", "inode_mappings.ads", "inode_mappings.adb",
      "volume_admission.ads", "block_paths.ads", "block_paths.adb",
      "block_inventory.ads", "block_inventory.adb",
      "double_mappings.ads", "double_mappings.adb",
      "triple_mappings.ads", "triple_mappings.adb",
      "block_cache_index.ads", "block_cache_index.adb", "dentry_cache.ads", "dentry_cache.adb",
      "jbd2_format.ads", "jbd2_format.adb", "jbd2_revokes.ads", "jbd2_revokes.adb",
      "jbd2_recovery.ads", "jbd2_recovery.adb",
      "directory_blocks.ads", "directory_blocks.adb",
      "directory_commit.ads", "directory_commit.adb", "cubit-memory_grants.ads",
      "cubit-grant_references.ads", "cubit-block_devices.ads", "cubit-block_devices.adb",
      "cubit-filesystems.ads", "cubit-filesystems.adb", "cubit-directory_pages.ads", "cubit-directory_pages.adb", "cubit-file_access.ads", "cubit-file_access.adb",
      "cubit-directory_paths.ads", "cubit-directory_paths.adb");
   for Object_Dir use Fs_Obj;
   for Exec_Dir use Fs_Obj;
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-I-");
   end Compiler;
end Interop;
