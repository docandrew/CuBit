project Persistence is
   CBOR_Source := external ("CBOR_ADA_SRC");
   for Source_Dirs use (".", "../../userspace/ccl/src",
      "../../userspace/ccl/persistence", CBOR_Source & "/src");
   for Object_Dir use "build/persistence";
   for Exec_Dir use "build/persistence";
   for Main use ("persistence_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnata", "-gnato", "-gnatwa", "-I-");
   end Compiler;
end Persistence;
