# Scheduler latency benchmark (tests/sched-latency). The probe and its IPC
# echo peer run at priority 3, what the desktop gives a launched app, with
# no scheduling authority or pinning. The server starts first so the
# client's ipc-test binding resolves.
(startup v1
  (start "logstore.svc" (priority 5))
  (start "bench-ipc-server.app" (priority 3))
  (start "sched-latency.app" (priority 3))
)
