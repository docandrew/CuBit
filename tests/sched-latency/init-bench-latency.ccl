# Scheduler latency benchmark (tests/sched-latency). The probe and its IPC
# echo peer run in the ordinary class, as a launched app does, with
# no scheduling authority or pinning. The server starts first so the
# client's ipc-test binding resolves.
(startup v1
  (start "logstore.svc" (test-console approve-declared))
  (start "bench-ipc-server.app")
  (start "sched-latency.app")
)
