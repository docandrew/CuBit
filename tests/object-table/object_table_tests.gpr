with "fixture.gpr";
project Object_Table_Tests is
   for Source_Dirs use (".", "../../kernel/src");
   for Source_Files use ("main.adb", "test_table.ads", "test_table.adb",
                         "object_table.ads", "object_table.adb",
                         "id_ledger.ads", "id_ledger.adb",
                         "quiescent_reclamation.ads", "quiescent_reclamation.adb");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2", "-g");
   end Compiler;
end Object_Table_Tests;
