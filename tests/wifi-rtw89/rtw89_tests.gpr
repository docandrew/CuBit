--  Hosted tests and proofs for the RTL8852BE driver's SPARK parsers
--  (efuse logical map, firmware container). run.sh builds and runs them.
project RTW89_Tests is
   for Source_Dirs use (".", "../../userspace/services/rtw89/spark");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-O2", "-gnata", "-gnato", "-gnatwa", "-gnatwe");
   end Compiler;
   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--checks-as-errors=on");
   end Prove;
end RTW89_Tests;
