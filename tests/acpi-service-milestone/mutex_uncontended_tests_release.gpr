project mutex_uncontended_tests_release is
 for Source_Dirs use ("../../tests/aml-mutex-oracle", "../../userspace/lib/acpi", "../../shared/firmware", "../../userspace/services/acpi");
 Build_Root := external ("SERVICE_MILESTONE_BUILD", "build-mutex_uncontended_tests-release");
 for Object_Dir use Build_Root & "/obj";
 for Exec_Dir use Build_Root & "/bin";
 for Main use ("mutex_uncontended_tests.adb");
 package Compiler is
 for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnatp");
 end Compiler;
end mutex_uncontended_tests_release;
