project mutex_invocation_lifetime_tests_checked is
 for Source_Dirs use ("../../shared/firmware", "../aml-mutex", "../../userspace/services/acpi/lib", "../../userspace/services/acpi/resource-consumer");
 Build_Root := external ("SERVICE_MILESTONE_BUILD", "build-mutex_invocation_lifetime_tests-checked");
 for Object_Dir use Build_Root & "/obj";
 for Exec_Dir use Build_Root & "/bin";
 for Main use ("mutex_invocation_lifetime_tests.adb");
 package Compiler is
 for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnata", "-gnato");
 end Compiler;
end mutex_invocation_lifetime_tests_checked;
