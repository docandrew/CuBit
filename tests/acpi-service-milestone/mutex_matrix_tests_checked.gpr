project mutex_matrix_tests_checked is
 for Source_Dirs use ("../../tests/aml-mutex-matrix", "../../userspace/lib/acpi", "../../shared/firmware", "../../userspace/services/acpi");
 Build_Root := external ("SERVICE_MILESTONE_BUILD", "build-mutex_matrix_tests-checked");
 for Object_Dir use Build_Root & "/obj";
 for Exec_Dir use Build_Root & "/bin";
 for Main use ("mutex_matrix_tests.adb");
 package Compiler is
 for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnata", "-gnato");
 end Compiler;
end mutex_matrix_tests_checked;
