project bootstrap_catalog_tests_release is
 for Source_Dirs use ("../../shared/firmware", "../acpi-bootstrap-devices", "../../userspace/services/acpi", "../../userspace/services/acpi/lib");
 Build_Root := external ("SERVICE_MILESTONE_BUILD", "build-bootstrap_catalog_tests-release");
 for Object_Dir use Build_Root & "/obj";
 for Exec_Dir use Build_Root & "/bin";
 for Main use ("bootstrap_catalog_tests.adb");
 package Compiler is
 for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnatp");
 end Compiler;
end bootstrap_catalog_tests_release;
