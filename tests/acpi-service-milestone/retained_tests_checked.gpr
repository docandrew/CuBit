project retained_tests_checked is
 for Source_Dirs use ("../../tests/aml-retention", "../../userspace/lib/acpi", "../../userspace/services/acpi", "../../shared/firmware");
 Build_Root := external ("SERVICE_MILESTONE_BUILD", "build-retained_tests-checked");
 for Object_Dir use Build_Root & "/obj";
 for Exec_Dir use Build_Root & "/bin";
 for Main use ("retained_tests.adb");
 package Compiler is
 for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnata", "-gnato");
 end Compiler;
end retained_tests_checked;
