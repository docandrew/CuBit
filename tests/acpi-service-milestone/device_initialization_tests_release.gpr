project device_initialization_tests_release is
 for Source_Dirs use ("../../shared/firmware", "../aml-device-initialization", "../../userspace/services/acpi", "../../userspace/services/acpi/lib", "../../userspace/services/acpi/resource-consumer");
 Build_Root := external ("SERVICE_MILESTONE_BUILD", "build-device_initialization_tests-release");
 for Object_Dir use Build_Root & "/obj";
 for Exec_Dir use Build_Root & "/bin";
 for Main use ("device_initialization_tests.adb");
 package Compiler is
 for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnatp");
 end Compiler;
end device_initialization_tests_release;
