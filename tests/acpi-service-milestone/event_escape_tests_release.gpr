project event_escape_tests_release is
 for Source_Dirs use ("../../tests/aml-runtime-event", "../../userspace/lib/acpi", "../../userspace/services/acpi", "../../shared/firmware");
 Build_Root := external ("SERVICE_MILESTONE_BUILD", "build-event_escape_tests-release");
 for Object_Dir use Build_Root & "/obj";
 for Exec_Dir use Build_Root & "/bin";
 for Main use ("event_escape_tests.adb");
 package Compiler is
 for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnatp");
 end Compiler;
end event_escape_tests_release;
