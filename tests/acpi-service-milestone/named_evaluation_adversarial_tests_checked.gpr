project named_evaluation_adversarial_tests_checked is
 for Source_Dirs use ("../../tests/aml-device-initialization", "../../userspace/lib/acpi", "../../userspace/services/acpi", "../../shared/firmware");
 Build_Root := external ("SERVICE_MILESTONE_BUILD", "build-named_evaluation_adversarial_tests-checked");
 for Object_Dir use Build_Root & "/obj";
 for Exec_Dir use Build_Root & "/bin";
 for Main use ("named_evaluation_adversarial_tests.adb");
 package Compiler is
 for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnata", "-gnato");
 end Compiler;
end named_evaluation_adversarial_tests_checked;
