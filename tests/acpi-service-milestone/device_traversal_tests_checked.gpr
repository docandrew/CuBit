project device_traversal_tests_checked is
 for Source_Dirs use ("../../shared/firmware", "../aml-device-initialization", "../../userspace/services/acpi", "../../userspace/services/acpi/lib");
 Build_Root := external ("SERVICE_MILESTONE_BUILD", "build-device_traversal_tests-checked");
 for Object_Dir use Build_Root & "/obj";
 for Exec_Dir use Build_Root & "/bin";
 for Main use ("device_traversal_tests.adb");
 package Compiler is
 for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnata", "-gnato");
 end Compiler;
end device_traversal_tests_checked;
