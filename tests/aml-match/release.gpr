project Release is
 for Source_Dirs use (".", "../acpi-integration", "../acpi-integration/mocks", "../aml-core", "../aml-explicit-format", "../aml-tostring", "../aml-tobuffer", "../aml-tointeger", "../../userspace/lib/acpi", "../../userspace/services/acpi", "../../userspace/services/acpi/native", "../../shared/firmware");
 for Object_Dir use "build-release/obj";
 for Exec_Dir use "build-release";
 for Main use ("match_owner_tests.adb", "match_collecting_tests.adb", "match_core_tests.adb", "match_runner.adb", "format_collecting_tests.adb", "format_capture_tests.adb");
 package Compiler is
 for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnatp", "-gnatwF");
 end Compiler;
end Release;
