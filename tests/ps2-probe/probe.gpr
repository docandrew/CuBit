project Probe is
   for Source_Dirs use (".", "../../userspace/services/ps2");
   for Source_Files use ("probe_tests.adb", "ps2_boot_probe.ads", "ps2_boot_probe.adb");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build";
   for Main use ("probe_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnata", "-gnato", "-gnatwa", "-gnatwe");
   end Compiler;
end Probe;
