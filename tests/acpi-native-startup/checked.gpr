project Checked is
 for Source_Dirs use ("models", "boundary", "../../userspace/services/acpi", "../../userspace/services/acpi/lib", "../../userspace/services/acpi/snapshot", "../../userspace/services/acpi/request-driver", "../../userspace/services/acpi/region-init", "../../shared/firmware", "../../shared/acpi");
 for Main use ("owner_tests.adb");
 for Object_Dir use external ("OWNER_BUILD") & "/obj";
 for Exec_Dir use external ("OWNER_BUILD") & "/bin";
 package Compiler is
  for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnata", "-gnato");
 end Compiler;
end Checked;
