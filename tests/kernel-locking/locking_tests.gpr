with "fixture.gpr";
project Locking_Tests is
    for Source_Dirs use (".", "fixture", "../../kernel/src");
    for Source_Files use ("main.adb", "spinlocks.ads", "spinlocks.adb",
                         "locks.ads", "locks.adb",
                         "process_lifetime.ads", "process_lifetime.adb",
                         "process.ads", "process.adb",
                         "process-queues.ads", "process-queues.adb",
                         "scheduler_timing.ads", "scheduler_timing.adb",
                         "work_stealing.ads", "work_stealing.adb", "time.ads",
                         "virtual_deadlines.ads", "virtual_deadlines.adb",
                         "textio.ads");
    for Object_Dir use "build";
    for Exec_Dir use "build";
    for Main use ("main.adb");
    package Compiler is
        -- Linux-hosted executable only. Never imported by cubit.gpr.
        for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-O2", "-g");
    end Compiler;
end Locking_Tests;
