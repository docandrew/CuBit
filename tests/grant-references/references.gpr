project References is
   for Source_Dirs use (".", "../../userspace/runtime/gnat");
   for Source_Files use
     ("main.adb", "codec_proof.ads", "codec_proof.adb",
      "cubit.ads", "cubit-grant_references.ads");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnato", "-gnatwa", "-gnatwe", "-O2");
   end Compiler;
end References;
