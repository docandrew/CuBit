--  Hosted tests of the typed net.interface.<name> setting: the CCL schema,
--  netmgr's decoder (Net_Interface_Settings) and interface names.
--  build/protocol holds hosted copies of the runtime units it needs (run.sh).
with "../../userspace/ccl/cubit_shared.gpr";
project Settings is
   for Source_Dirs use (".", "../../userspace/services/netmgr/", "../../userspace/ccl/src", "build/protocol");
   --  netmgr's main and the DHCP test's are native or another program.
   for Excluded_Source_Files use ("main.adb");
   for Object_Dir use "build/settings";
   for Exec_Dir use "build/settings";
   for Main use ("settings_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnatwa", "-g", "-O1");
   end Compiler;
end Settings;
