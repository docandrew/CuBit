--  Hosted charts core (userspace/lib/charts, MET-002's app) and its tests,
--  on Linux. CHARTS_MODE: checked (assertions and contracts on), release
--  (-O3 -gnatp, as the native app builds proved units).
project Charts_Core is
   type Build_Mode is ("checked", "release");
   Mode : Build_Mode := external ("CHARTS_MODE", "checked");
   for Languages use ("Ada");
   for Source_Dirs use (".", "../../userspace/lib/charts");
   for Main use ("charts_core_tests.adb");
   for Exec_Dir use "build";
   case Mode is
      when "checked" => for Object_Dir use "build/checked";
      when "release" => for Object_Dir use "build/release";
   end case;
   package Compiler is
      case Mode is
         when "checked" =>
            for Default_Switches ("Ada") use
              ("-O1", "-g", "-gnat2022", "-gnata", "-gnatwa", "-gnatwJ", "-gnatVa", "-gnatyM120");
         when "release" =>
            for Default_Switches ("Ada") use ("-O3", "-g", "-gnat2022", "-gnatp", "-gnatwa", "-gnatwJ");
      end case;
   end Compiler;
end Charts_Core;
