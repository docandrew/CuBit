#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, std430) buffer OutputPixels { uint pixels[]; };
void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= 32 || p.y >= 32) return;
    // Packed RGBA: varying coordinates ensure every invocation is checked.
    pixels[p.y * 32 + p.x] = 0xff000000u | ((p.x ^ p.y) << 16)
                           | (p.y << 8) | p.x;
}
