with "../../userspace/ccl/cubit_shared.gpr";
with "../../userspace/lib/ui/fonts_host.gpr";
project Appearance is
   for Source_Dirs use (".", "../../userspace/lib/ui",
     "../../userspace/lib/theme", "../../userspace/ccl/src",
     "../../userspace/ccl/tools/ccl-ui-preview/host", "../../userspace/lib/compositor", "../../userspace/lib/display", "../../userspace/allocator/src");
   --  The root package CuBit comes with cubit_shared.gpr (the runtime's).
   for Excluded_Source_Files use ("cubit.ads");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-gnato", "-gnatwa");
   end Compiler;
end Appearance;
