project Release is
 for Source_Dirs use (".", "../../userspace/lib/acpi", "../../shared/firmware");
 for Main use ("source_buffer_replay.adb", "source_buffer_gc_tests.adb");
 for Object_Dir use "obj-release"; for Exec_Dir use "bin-release";
 package Compiler is
  for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnatp");
 end Compiler;
end Release;
