project Tail_checked is
 for Source_Dirs use (".", "../../userspace/lib/acpi", "../../shared/firmware");
 for Object_Dir use "build-checked/obj";
 for Exec_Dir use "build-checked";
 for Main use ("tail_tests.adb", "tail_boundaries.adb");
 package Compiler is
 for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnata", "-gnato");
 end Compiler;
end Tail_checked;
