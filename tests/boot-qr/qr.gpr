project QR is
   for Source_Dirs use (".", "../../kernel/src");
   for Source_Files use
     ("main.adb", "boot_qr.ads", "boot_qr.adb", "boot_qr_capsule.ads",
      "boot_qr_capsule.adb", "boot_panel.ads", "boot_panel.adb");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnata", "-gnato", "-gnatwa", "-gnatwe");
   end Compiler;
end QR;
