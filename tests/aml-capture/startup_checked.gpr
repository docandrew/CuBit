project startup_checked is
 Build_Root := external ("CAPTURE_BUILD", "build-startup_checked");
 for Source_Dirs use ("../../shared/firmware", "../acpi-bootstrap-ordered", "../aml-core", "../aml-module-core", "../../userspace/lib/acpi", "../../userspace/services/acpi");
 for Object_Dir use Build_Root & "/obj";
 for Exec_Dir use Build_Root & "/bin";
 for Main use ("bootstrap_migration_tests.adb", "bootstrap_catalog_tests.adb", "request_migration_tests.adb", "request_boundary_tests.adb", "module_core_tests.adb");
 package Compiler is
 for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-fstack-usage", "-gnata", "-gnato");
 end Compiler;
end startup_checked;
