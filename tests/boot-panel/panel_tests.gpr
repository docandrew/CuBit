project Panel_Tests is
   for Source_Dirs use (".", "../../kernel/src");
   for Source_Files use ("main.adb", "boot_panel.ads", "boot_panel.adb",
                         "boot_font.ads", "boot_font.adb");
   for Object_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2", "-g");
   end Compiler;
end Panel_Tests;
