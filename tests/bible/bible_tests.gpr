--  Hosted tests of the Bible core (userspace/lib/bible, APP-005).
--  BIBLE_MODE: checked (assertions and contracts on: the tests), release
--  (-O3 -gnatp, as the app builds the core: the benchmark).
project Bible_Tests is
   type Build_Mode is ("checked", "release");
   Mode : Build_Mode := external ("BIBLE_MODE", "checked");
   for Languages use ("Ada");
   for Source_Dirs use (".", "../../userspace/lib/bible");
   for Object_Dir use "build/" & Mode;
   for Exec_Dir use "build";
   for Main use ("bible_tests.adb", "bible_bench.adb");
   Checked := ("-O1", "-g", "-gnat2022", "-gnata", "-gnatwa", "-gnatwJ", "-gnatVa");
   Release := ("-O3", "-g", "-gnat2022", "-gnatp", "-gnatwa", "-gnatwJ");
   package Compiler is
      case Mode is
         when "checked" => for Default_Switches ("Ada") use Checked;
         when "release" => for Default_Switches ("Ada") use Release;
      end case;
   end Compiler;
   package Builder is
      for Executable ("bible_tests.adb") use "bible_tests-" & Mode;
      for Executable ("bible_bench.adb") use "bible_bench-" & Mode;
   end Builder;
end Bible_Tests;
