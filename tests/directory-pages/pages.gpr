project Pages is
   for Source_Dirs use (".", "../../userspace/runtime/gnat");
   for Source_Files use ("main.adb", "cubit.ads", "cubit-directory_pages.ads", "cubit-directory_pages.adb");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnato", "-gnatwa", "-gnatwe", "-O2");
   end Compiler;
end Pages;
