project Access_Tests is
   for Source_Dirs use (".", "fixture", "../../kernel/src",
     "../../shared/publications", "../../shared/time");
   for Source_Files use ("access_checks.adb", "config.ads", "capabilities.ads",
     "device_memory_admission.ads", "device_memory_publication.ads",
     "clock_publication.ads", "clock_publication.adb", "physical_ranges.ads", "physical_ranges.adb",
     "device_memory_authority.ads", "device_memory_authority.adb");
   for Object_Dir use "build-access";
   for Main use ("access_checks.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Access_Tests;
