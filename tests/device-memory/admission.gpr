project Admission is
   for Source_Dirs use (".", "../../kernel/src");
   for Source_Files use ("main.adb", "device_memory_admission.ads", "device_memory_admission.adb");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnatwa", "-gnatwe", "-O2");
   end Compiler;
end Admission;
