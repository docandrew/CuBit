project Authority_Wire is
   for Source_Dirs use (".", "../../userspace/services/config",
                        "../../userspace/runtime/gnat");
   for Source_Files use ("authority_wire_tests.adb", "config_authority_wire.ads",
     "config_authority_wire.adb", "config_authority.ads", "config_authority.adb",
     "cubit.ads", "cubit-config_inspection.ads", "cubit-config_inspection.adb");
   for Object_Dir use "build/authority-wire";
   for Exec_Dir use "build/authority-wire";
   for Main use ("authority_wire_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnata", "-gnato", "-gnatwa", "-gnatwe");
   end Compiler;
end Authority_Wire;
