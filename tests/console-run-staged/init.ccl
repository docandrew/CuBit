# The console-run-staged test (tests/console-run-staged/console_run.py
# drives it): the device-build test's machine (tests/device-builds/init.ccl:
# the LAN remote session with builds granted, its work root on the system
# volume, a desktop for the person's "Allow app replacement" switch) and
# the CCL console, which runs what ccl-build stages beneath
# @system/work/remote/out/ as typed CCL calls.
(startup v1
  (start "logstore.svc" (priority 5))
  (start "clock.svc" (priority 5))
  (start "display.svc" (priority 5))
  (start "desktop.svc" (priority 4))
  (start "ccl-remote.app" (priority 4) (network approve-declared) (display-capture approve-declared)
    (arguments (Remote_Parameters listen => Remote_Listen.LAN
      display => Pairing_Display.Kernel_Console work => "@system/work"
      files => true builds => true mail => true)))
  (start "ccl-console.app" (priority 3))
)
