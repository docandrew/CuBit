project Periods is
 for Source_Dirs use (".", "build/source");
 for Source_Files use ("main.adb", "cubit.ads", "cubit-audio_periods.ads", "cubit-audio_periods.adb");
 for Object_Dir use "build";
 for Exec_Dir use "build";
 for Main use ("main.adb");
 package Compiler is
  for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
 end Compiler;
end Periods;
