--  Known-answer tests for the Wi-Fi driver's crypto units (WiFi_Crypto,
--  userspace/lib/wifi/crypto; docs/wifi.md, W2): HMAC_G instances,
--  PBKDF2 / Legacy_WPA2, AES key wrap, AES-CMAC, AES-CCM and the P-256
--  field helpers and SSWU. Linux-hosted; run.sh. The WiFi_Crypto units
--  are compiled here with checks on (-gnata -gnato); the crates come from
--  sparktls_host.gpr, as pinned by the flake. -gnatwJ: the moved units
--  keep the crate's () array aggregates.
with "../../userspace/lib/tls/sparktls_host.gpr";
project Wifi_Crypto_Tests is
   for Languages use ("Ada");
   for Source_Dirs use (".", "../../userspace/lib/wifi/crypto");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build";
   for Main use ("wifi_crypto_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-O2", "-gnata", "-gnato", "-gnatwa", "-gnatwJ", "-gnatwe");
   end Compiler;
end Wifi_Crypto_Tests;
