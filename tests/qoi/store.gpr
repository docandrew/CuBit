--  Proof scope for Desktop_Wallpaper_Store (make -C kernel prove-qoi): the
--  store's SPARK body over its audited CuAlloc bridge (Rasters, SPARK_Mode
--  Off, whose contracts are assumed).
project Store is
   for Source_Dirs use ("../../userspace/lib/image", "../../userspace/services/desktop",
     "../../userspace/runtime/gnat");
   for Source_Files use ("cubit.ads", "cubit-qoi.ads", "cubit-qoi.adb",
     "desktop_heap_objects.ads", "desktop_heap_objects.adb",
     "desktop_wallpaper_store.ads", "desktop_wallpaper_store.adb",
     "desktop_wallpaper_store-rasters.ads", "desktop_wallpaper_store-rasters.adb");
   for Object_Dir use "build/store";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022");
   end Compiler;
end Store;
