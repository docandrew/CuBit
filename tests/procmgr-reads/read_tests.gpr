project Read_Tests is
   for Source_Dirs use (".", "../../userspace/services/procmgr");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("read_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnata", "-gnato", "-gnatwa", "-gnatwe");
   end Compiler;
end Read_Tests;
