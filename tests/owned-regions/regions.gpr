--  ABI-002 owned regions: the policy's SPARK proof (Owned_Reservation_Policy)
--  and the hosted model test of the kernel's run bookkeeping (run.sh).
project Regions is
   for Languages use ("Ada");
   for Source_Dirs use (".", "../../kernel/src");
   for Source_Files use ("region_tests.adb", "owned_reservation_policy.ads",
                         "owned_reservation_policy.adb", "release_walk_tests.adb",
                         "owned_release_walk.ads", "owned_release_walk.adb");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("region_tests.adb", "release_walk_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--timeout=60");
   end Prove;
end Regions;
