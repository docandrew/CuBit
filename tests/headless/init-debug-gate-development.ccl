# DBG-001: the image's debugging gate, Development (headless --test debug-gate-development).
(startup v1
  (policy (System_Policy debugging => Debugging.Development))
  # ABI-002: services' debug text reaches serial only through logstore's mirror.
  (start "logstore.svc" (priority 5) (test-console approve-declared))
  (start "clock.svc" (priority 5))
  (start "debug-gate-check.app" (priority 5))
)
