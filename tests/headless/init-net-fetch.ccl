# net-fetch regression (SELF-003 step 1): the console fetches over HTTPS
# from the host-side fixture (tests/net-fetch/server.py) through tls.svc,
# into @system/work, and unpacks a tar there. The installed ccl-console.app
# is the ccl-console-fetch-test variant: only its tls scope differs from
# production's "*:443" (the fixture's name and port), approved here.
(startup v1
  (start "logstore.svc" (test-console approve-declared))
  (start "clock.svc")
  (start "tls.svc" (network approve-declared))
  # tls.svc must have registered before the console launches, or procmgr
  # installs no TLS scope for it: the display and desktop start between.
  (start "display.svc")
  (start "desktop.svc")
  (start "ccl-console.app" (network approve-declared))
)
