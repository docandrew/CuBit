# LAT-002 input-to-photon fixture: Desktop and the Calculator on virtio-vga,
# key presses at swept refresh phases (tests/headless/run.sh --test
# display-latency --accel kvm).
(startup v1
  (start "logstore.svc" (priority 5) (test-console approve-declared))
  (start "display.svc" (priority 5))
  (start "desktop.svc" (priority 4))
  (start "calculator.app" (priority 3))
)
