# timesync regression: the test variant of timesync.svc (loopback fixture
# scope), approved like the default image, then an ordinary clock client.
(startup v1
  (start "logstore.svc" (test-console approve-declared))
  (start "clock.svc")
  (start "timesync.svc" (network approve-declared))
  (start "timesync-check.app")
)
