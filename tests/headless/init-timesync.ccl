# timesync regression: the test variant of timesync.svc (loopback fixture
# scope), approved like the default image, then an ordinary clock client.
(startup v1
  (start "logstore.svc" (priority 5))
  (start "clock.svc" (priority 5))
  (start "timesync.svc" (priority 5) (network approve-declared))
  (start "timesync-check.app" (priority 5))
)
