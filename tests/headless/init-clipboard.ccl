# Desktop clipboard regression profile (docs/clipboard.md): copy and paste
# between Files, Logs and the clipboard-check client, by keyboard.
(startup v1
  (start "logstore.svc" (test-console approve-declared))
  (start "display.svc")
  (start "desktop.svc")
  (start "files.app")
  (start "logs.app")
  (start "clipboard-check.app")
)
