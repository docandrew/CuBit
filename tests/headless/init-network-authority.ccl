# First launch has declarations but no approval. Second is explicitly approved.
(startup v1
  # ABI-002: services' debug text reaches serial only through logstore's mirror.
  (start "logstore.svc" (test-console approve-declared))
  (start "network-check.app")
  (start "network-check.app" (network approve-declared))
  (start "capability-test.app")
)
