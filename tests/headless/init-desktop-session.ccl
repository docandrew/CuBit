# CuBit desktop session profile
#
# Used by `make run-desktop` for GUI iteration. Unlike the headless
# desktop-display regression profile, this intentionally does not start the
# CLI shell, because shell.app owns legacy framebuffer/input paths and will
# visually take the machine back to the CLI after desktop.svc starts.
(startup v1
  (start "logstore.svc" (priority 5))
  (start "clock.svc" (priority 5))
  (start "display.svc" (priority 5))
  (start "desktop.svc" (priority 4))
)
