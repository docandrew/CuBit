# CuBit desktop session profile
#
# Used by `make run-desktop` for GUI iteration. Unlike the headless
# desktop-display regression profile, this intentionally does not start the
# CLI shell, because shell.app owns legacy framebuffer/input paths and will
# visually take the machine back to the CLI after desktop.svc starts.
(startup v1
  (start "logstore.svc" (test-console approve-declared))
  (start "clock.svc")
  # Typed Config persistence is a real Turso worker, not Workbench-local state.
  (start "config-storage.svc" (role config-storage))
  # HTTPS for NetSurf and other clients. Approves tls.svc's declared scope
  # (outbound TCP with DNS); each client still needs its own tls-scope.
  (start "tls.svc" (network approve-declared))
  (start "display.svc")
  # Dictionary, thesaurus and spelling (docs/lexicon.md).
  (start "lexicon.svc")
  # Collect below applications and Desktop; publishers never wait for it.
  (start "metrics.svc")
  (start "desktop.svc")
)
