# Headless Logs app test: logstore, the desktop and the Logs app, plus
# timesync with its declared network scope approved. Without the approval
# procmgr refused its required "ntp" entry; the test now fails on any
# refusal (check-refusals.py, CAP-003).
(startup v1
  (start "logstore.svc" (priority 5))
  (start "clock.svc" (priority 5))
  (start "timesync.svc" (priority 5) (network approve-declared))
  (start "display.svc" (priority 5))
  (start "desktop.svc" (priority 4))
  (start "logs.app" (priority 3))
)
