# Headless Logs app test: logstore, the desktop and the Logs app, plus
# timesync without network approval, which logs why it exits.
(startup v1
  (start "logstore.svc" (priority 5))
  (start "clock.svc" (priority 5))
  (start "timesync.svc" (priority 5))
  (start "display.svc" (priority 5))
  (start "desktop.svc" (priority 4))
  (start "logs.app" (priority 3))
)
