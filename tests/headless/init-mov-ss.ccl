# Headless mov-ss-debug test (DBG-001, CVE-2018-8897 class): mov-ss-check asks
# a probe kernel (DEBUG_REGISTER_PROBE=1) to watch one of its words, then
# loads SS from it right before SYSCALL and INT3. The kernel must take each
# deferred #DB on its own stack with its own GS base and survive.
(startup v1
  (start "logstore.svc" (priority 5) (test-console approve-declared))
  (start "clock.svc" (priority 5))
  (start "mov-ss-check.app" (priority 5))
)
