# VMM-001 slice 1: the desktop with vmm, which boots the pinned Linux guest
# and shows its serial console in a window (headless --test vm-desktop).
(startup v1
  (start "logstore.svc" (test-console approve-declared))
  (start "clock.svc")
  (start "display.svc")
  (start "desktop.svc")
  (start "vmm.app" (vm-create approve-declared))
)
