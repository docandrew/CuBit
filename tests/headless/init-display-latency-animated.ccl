# LAT-002 input-to-photon fixture with animation: frame-ticker.app, the
# only window, animates every refresh and takes the key presses (swept
# refresh phases) into an area of its own far from the animation. One
# window: it always has the focus and nothing covers it, so every run is
# valid (tests/headless/run.sh --test display-latency --accel kvm,
# CUBIT_DISPLAY_LATENCY_ANIMATION=1).
(startup v1
  (start "logstore.svc" (test-console approve-declared))
  (start "display.svc")
  (start "desktop.svc")
  (start "frame-ticker.app")
)
