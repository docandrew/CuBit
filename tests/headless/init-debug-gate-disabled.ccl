# DBG-001: the image's debugging gate, Disabled (headless --test debug-gate-disabled).
(startup v1
  (policy (System_Policy debugging => Debugging.Disabled))
  # ABI-002: services' debug text reaches serial only through logstore's mirror.
  (start "logstore.svc" (test-console approve-declared))
  (start "clock.svc")
  (start "debug-gate-check.app")
)
