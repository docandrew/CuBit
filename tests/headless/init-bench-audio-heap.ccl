# bench-audio with a growing heap beside it (--load-kind heap, MEM-006):
# bench-heap-load.app commits and releases 64 MiB in a loop, the kernel
# work that once held grantLock with interrupts off for tens of ms.
(startup v1
  (start "logstore.svc" (test-console approve-declared))
  (start "bench-heap-load.app" (trace approve-declared))
  (start "bench-audio.app")
)
