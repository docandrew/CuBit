# CuBit headless desktop photographs (tests/headless/desktop-polish-shots.py
# audit): the desktop-display profile plus the apps that have no launcher on
# the test image. Run with CUBIT_TEST_INIT_PROFILE=<this file> and
# CUBIT_TEST_EXTRA_APPS="logs.app boot-logs.app teapots.app".
(startup v1
  (start "logstore.svc" (priority 5))
  (start "display.svc" (priority 5))
  (start "desktop.svc" (priority 4))
  (start "shell.app" (priority 3))
  (start "boot-logs.app" (priority 3))
  (start "teapots.app" (priority 3))
  # Started here, not from its launcher: its window still takes the Logs
  # entry's icon, colour and label (Desktop matches the program).
  (start "logs.app" (priority 3))
)
