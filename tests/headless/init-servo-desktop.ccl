# Servo on the CuBit desktop (docs/servo-port.md): the display and desktop
# session only; the test launches Servo from the Apps menu (Config-driven,
# desktop.launch.*), so procmgr's launch policy grants its network scope.
(startup v1
  (start "logstore.svc" (test-console approve-declared))
  (start "clock.svc")
  (start "display.svc")
  # As in the real session (init-desktop-session.ccl); a metrics-enabled
  # Desktop requires it.
  (start "metrics.svc")
  (start "desktop.svc")
)
