# Servo on the CuBit desktop (docs/servo-port.md): the display and desktop
# session only; the test launches Servo from the Apps menu (Config-driven,
# desktop.launch.*), so procmgr's launch policy grants its network scope.
(startup v1
  (start "logstore.svc" (priority 5))
  (start "clock.svc" (priority 5))
  (start "display.svc" (priority 5))
  (start "desktop.svc" (priority 4))
)
