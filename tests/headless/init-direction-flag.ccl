# Headless direction-flag test: direction-flag-check runs with RFLAGS.DF set
# while interrupts and page faults enter the kernel; the kernel must clear DF
# on entry and survive, and the process must finish every round.
(startup v1
  (start "logstore.svc" (test-console approve-declared))
  (start "clock.svc")
  (start "direction-flag-check.app")
)
