# Network-dependent lane: wget fetches https://example.com/ through tls.svc
# using the production trust store on the development disk.
(startup v1
  (start "logstore.svc" (test-console approve-declared))
  (start "clock.svc")
  (start "timesync.svc" (network approve-declared))
  (start "tls.svc" (network approve-declared))
  (start "wget.app" (network approve-declared))
)
