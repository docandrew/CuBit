# IPC-010 shared futexes: the server (grantee), the client (owner, runs the
# checks) and an outsider that holds no grant.
(startup v1
  (start "logstore.svc" (test-console approve-declared))
  (start "futex-share-server.app")
  (start "futex-share-client.app")
  (start "futex-share-outsider.app")
)
