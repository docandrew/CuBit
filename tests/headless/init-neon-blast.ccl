# Neon Blast (APP-008) headless profile: the desktop and the game, played
# through QEMU's PS/2 keyboard and mouse (tests/neon-blast/headless_drive.py).
# mixer.svc and hda.drv start by device presence (QEMU's intel-hda).
(startup v1
  (start "logstore.svc" (test-console approve-declared))
  (start "clock.svc")
  (start "display.svc")
  (start "desktop.svc")
  (start "neon-blast.app")
)
