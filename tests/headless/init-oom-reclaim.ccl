# Headless oom-reclaim test: oom-check lends pages to procmgr, exhausts
# memory and is killed for it; the kernel must reclaim it (revoking every
# grant) with no page free, and procmgr must report the exit.
(startup v1
  # ABI-002: services' debug text reaches serial only through logstore's mirror.
  (start "logstore.svc" (priority 5) (test-console approve-declared))
  (start "oom-check.app" (priority 5))
)
