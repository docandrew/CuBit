# CPU-spread benchmark: four identical CPU-bound instances started together.
(startup v1
  (start "logstore.svc" (priority 5) (test-console approve-declared))
  (start "bench-spread.app" (priority 3))
  (start "bench-spread.app" (priority 3))
  (start "bench-spread.app" (priority 3))
  (start "bench-spread.app" (priority 3))
)
