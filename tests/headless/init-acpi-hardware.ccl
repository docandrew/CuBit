# ACPI hardware windows (coordination/acpi-region-boundary.md):
# acpi-hardware-check stands in for acpi.svc's launch (its firmware
# snapshot reader and hardware windows approved on one entry). The same
# image without the hardware approval is refused at launch.
(startup v1
  (start "logstore.svc" (priority 5) (test-console approve-declared))
  (start "acpi-hardware-check.app" (priority 3)
    (firmware-snapshot approve-declared) (acpi-hardware approve-declared))
  (start "acpi-hardware-denied.app" (priority 3)
    (firmware-snapshot approve-declared))
)
