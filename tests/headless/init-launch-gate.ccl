# The launch gate (CAP-012): a program holding procmgr's endpoint starts only
# what its launch table names, each child with at most its launcher's
# authority, rights included (userspace/apps/launch-gate-check).
(startup v1
  (start "logstore.svc" (test-console approve-declared))
  (start "clock.svc")
  (start "launch-gate-check.app")
)
