# LOG-005 (CCL_CONSOLE_DEMO=log-burst): log-burst-probe writes a bring-up's
# worth of records at startup (1000), then more than logs.retention's
# per-source ceiling (system.ccl); after each, (logs.recent "log-burst-probe")
# at the console returns all of them or typed gaps with exact counts
# (tests/log-burst/check_serial.py).
(startup v1
  (start "logstore.svc" (test-console approve-declared))
  (start "log-burst-probe.app")
  (start "clock.svc")
  (start "display.svc")
  (start "desktop.svc")
  (start "ccl-console.app")
)
