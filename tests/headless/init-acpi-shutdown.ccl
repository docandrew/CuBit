# Actual firmware interpreter and power controller, with the same q35/edu
# module-I/O fixture as acpi-one-service. No shutdown-standin is launched.
(startup v1
  (start "logstore.svc" (test-console approve-declared))
  (start "acpi.svc" (stop-stage power-tail)
    (arguments (ACPI_Firmware_Profile kind => ACPI_Profile.Neutral))
    (firmware-snapshot approve-declared) (acpi-hardware approve-declared) (platform-power approve-declared)
    (acpi-firmware-data approve-declared) (acpi-pci-config approve-declared))
  (start "shutdown-cooperative.app" (stop-grace-ms 2000)
    (arguments (Cooperative_Parameters quiesce_ms => 200)))
  (start "shutdown-stubborn.app" (stop-grace-ms 500))
  (start "power.svc"
    (arguments (Power_Parameters undeclared_grace_ms => 300 storage_deadline_ms => 10000
      driver_grace_ms => 1000 button => Button_Policy.Power_Off
      reading_age_ms => 60000)))
)
