# Headless desktop-restart test (BUG-001): this desktop build fails once
# after its first frame (CUBIT_DESKTOP_FAULT=exit-once); procmgr must start
# it again and display.svc must lease the output to the restart.
(startup v1
  (start "logstore.svc" (priority 5))
  (start "display.svc" (priority 5))
  (start "desktop.svc" (priority 4) (restart on-failure))
)
