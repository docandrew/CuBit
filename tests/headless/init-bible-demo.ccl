# The Bible demo (APP-005): the full desktop session, as a user sees it
# (the Apps menu's Reference group holds Dictionary and Bible), with the
# Bible started. tests/bible-app/make-demo.sh builds the disk with it.
(startup v1
  (start "logstore.svc" (test-console approve-declared))
  (start "clock.svc")
  (start "config-storage.svc" (role config-storage))
  (start "tls.svc" (network approve-declared))
  (start "display.svc")
  (start "lexicon.svc")
  (start "metrics.svc")
  (start "desktop.svc")
  (start "bible.app")
)
