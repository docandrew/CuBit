# Neon Blast beside CPU-hungry ordinary programs (SCHED-001, app audio
# threads; run.sh --test neon-blast with CUBIT_NEON_BURN=1): from half a
# minute after boot, four bench-burn.app spin on the guest's four CPUs, so
# the game's frames take longer and drop. The soundtrack's thread holds its
# real-time share, so the music must not underrun
# (tests/neon-blast/check_underruns.py). Four CPUs rather than two: with
# --cpus 2 procmgr asked for desktop.svc before the filesystem service was
# up, and the desktop never started (a start-up race of its own).
(startup v1
  (start "logstore.svc" (test-console approve-declared))
  (start "clock.svc")
  (start "display.svc")
  (start "desktop.svc")
  (start "bench-burn.app" (trace approve-declared))
  (start "bench-burn.app" (trace approve-declared))
  (start "bench-burn.app" (trace approve-declared))
  (start "bench-burn.app" (trace approve-declared))
  (start "neon-blast.app")
)
