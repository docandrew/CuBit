# Neon Blast beside CPU-hungry ordinary programs (SCHED-001, app audio
# threads; run.sh --test neon-blast with CUBIT_NEON_BURN=1, usually with
# --cpus 2): two bench-burn.app spin the whole run, so the game's frames
# take longer and drop. The soundtrack's thread holds its real-time share,
# so the music must not underrun (tests/neon-blast/check_underruns.py).
(startup v1
  (start "logstore.svc" (test-console approve-declared))
  (start "clock.svc")
  (start "display.svc")
  (start "desktop.svc")
  (start "bench-burn.app")
  (start "bench-burn.app")
  (start "neon-blast.app")
)
