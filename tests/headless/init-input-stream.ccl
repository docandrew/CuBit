# Typed input source publication and sequence-recovery regression.
(startup v1
  (start "logstore.svc" (priority 5))
  (start "clock.svc" (priority 5))
  (start "display.svc" (priority 5))
  (start "desktop.svc" (priority 4))
  (start "ccl-workbench.app" (priority 4))
  (start "input-stress.app" (priority 4))
)
