# Headless alignment-flag test: alignment-flag-check runs with RFLAGS.AC set
# while interrupts and page faults enter the kernel; the entry stubs must
# clear AC so that SMAP holds in every interrupt handler (SEC-026).
(startup v1
  (start "logstore.svc" (test-console approve-declared))
  (start "clock.svc")
  (start "alignment-flag-check.app")
)
