# The lexicon from CCL (docs/lexicon.md): lexicon.svc and the CCL console,
# whose (dict ..), (synonym ..), (thesaurus ..) and (spell-check ..) ask it.
(startup v1
  (start "logstore.svc" (test-console approve-declared))
  (start "clock.svc")
  (start "lexicon.svc")
  (start "display.svc")
  (start "desktop.svc")
  (start "ccl-console.app")
)
