project Release is
 for Source_Dirs use (".", "../../userspace/services/acpi/lib", "../../shared/firmware", "../../userspace/services/acpi/resource-consumer");
 for Object_Dir use "build-release/obj";
 for Exec_Dir use "build-release";
 for Main use ("metadata_normalization_tests.adb");
 package Compiler is
  for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnatp", "-gnatwF");
 end Compiler;
end Release;
