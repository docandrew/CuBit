project checked is
 for Source_Dirs use ("../support/acpi-heap", "../acpi-target-heap-model", "../support/acpi-firmware-wire", "../../userspace/services/acpi", "../../userspace/services/acpi/lib", "../../userspace/services/acpi/backend", "../../userspace/services/acpi/snapshot", "../../userspace/services/acpi/ec", "../../userspace/services/acpi/request-driver", "../../userspace/services/acpi/field-client", "../../userspace/services/acpi/field-client/provider", "../../userspace/services/acpi/field-client/provider/startup", "../../userspace/services/acpi/field-client/transport", "../../userspace/services/acpi/field-client/inventory", "../../userspace/services/acpi/region-init", "../../userspace/services/acpi/hid-i2c", "../../userspace/services/acpi/passive", "../../userspace/services/acpi/resource-consumer", "../../userspace/services/acpi/resource-data", "../../userspace/services/acpi/lid", "../../userspace/services/acpi/power", "../../userspace/lib/i2c-admission", "../../userspace/lib/gpio-admission", "../../shared/acpi", "../../shared/firmware", "../../shared/capabilities", "");
