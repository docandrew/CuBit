# KERN-006 layer 1 (tests/image-shares/native): launches ten copies of one
# image and its twin, and measures what the copies cost.
(Executable_Manifest
  identity => "com.cubit.image-share-check"
  version => "0.1.0"
  requests => [(service "process-manager" "process-manager") (service "launch" "launch")
    (service "logstore" "logstore")]
  optional => ["logstore"]
  may_launch => [(Launch "image-share-child.app") (Launch "image-share-twin.app")])
