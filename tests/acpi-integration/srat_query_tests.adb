   Query (Read_SRAT_Fields, 2, 1, 7, Malformed);
   Query (Read_SRAT_Fields, 2, 1, 8, Malformed);
   Query (Read_SRAT_Fields, 2, 1, 9, Malformed);
   Query (Read_SRAT_Fields, 2, 2, 0, OK, [0, 16#87654321#, 16#FEDCBA98#, 16#0#]);
   Query (Read_SRAT_Fields, 2, 2, 1, Malformed);
   Query (Read_SRAT_Fields, 2, 2, 2, OK, [0, 16#76543210#, 16#FEDCBA98#, 16#0#]);
   Query (Read_SRAT_Fields, 2, 2, 3, OK, [0, 16#89ABCDEF#, 16#1234567#, 16#0#]);
