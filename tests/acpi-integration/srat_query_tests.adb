   for I in Codes'Range loop
      SRAT_Data (Offsets (I) + 1) := Byte (Codes (I));
      SRAT_Data (Offsets (I) + 2) := Byte (Lengths (I));
   end loop;
   Put (36, 4, 16#89ABCDEF#); Put (40, 8, 16#F102030405060708#);
