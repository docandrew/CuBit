   Seal (Empty_SRAT, "SRAT");
   for Label in Read_SRAT_Info .. Read_SRAT_Fields loop Query (Label, 1, 0, 0, Wrong_Order); end loop;
   Handle (Server, Snapshot_Provider, (Label => Start_Snapshot, Data => [29, 4, 0, 0], others => <>), Reply);
   Check (Reply.Status = OK);
   Import (11, ACPI_Service.DSDT, DSDT_Data);
   Import (22, ACPI_Service.Description, SRAT_Data);
   Import (33, ACPI_Service.Description, Bad_SRAT);
   Import (44, ACPI_Service.Description, Empty_SRAT);
   Query (Read_SRAT_Info, 2, 0, 0, Wrong_Order);
   Handle (Server, Snapshot_Provider, (Label => Finish_Snapshot, Data => [Revision (Server), 0, 0, 0], others => <>), Reply);
   Check (Reply.Status = OK);
   Query (Read_SRAT_Info, 2, 0, 0, OK, [0, 6, 9, 16#89ABCDEF#]);
   Query (Read_SRAT_Info, 2, 1, 0, OK, [0, 16#05060708#, 16#F1020304#, 0]);
   Query (Read_SRAT_Info, 4, 0, 0, OK, [0, 6, 0, 0]);
   for I in Codes'Range loop
      Query (Read_SRAT_Record, 2, Unsigned_64 (I), 0, OK,
        [0, Unsigned_64 (Codes (I)), Unsigned_64 (Offsets (I)), Unsigned_64 (Lengths (I))]);
   end loop;
   Query (Read_SRAT_Fields, 2, 1, 0, OK, [0, 16#11#, 16#ABCDEF#, 16#22#]);
