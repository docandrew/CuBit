   Query (Read_SRAT_Fields, 2, 3, 1, OK, [0, 16#F0000204#, 16#0#, 16#0#]);
   Query (Read_SRAT_Fields, 2, 3, 2, Malformed);
   Query (Read_SRAT_Fields, 2, 3, 3, Malformed);
   Query (Read_SRAT_Fields, 2, 3, 4, Malformed);
