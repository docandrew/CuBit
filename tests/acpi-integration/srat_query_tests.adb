   Query (Read_SRAT_Fields, 2, 6, 3, Malformed);
   Query (Read_SRAT_Fields, 2, 6, 4, OK, [0, 16#A0#, 16#A1#, 16#A2#]);
   Query (Read_SRAT_Fields, 2, 6, 5, OK, [0, 16#A3#, 16#A4#, 16#A5#]);
   Query (Read_SRAT_Fields, 2, 6, 6, OK, [0, 16#A6#, 16#A7#, 16#A8#]);
   Query (Read_SRAT_Fields, 2, 6, 7, OK, [0, 16#A9#, 16#AA#, 16#AB#]);
   Query (Read_SRAT_Fields, 2, 6, 8, OK, [0, 16#AC#, 16#AD#, 16#AE#]);
   Query (Read_SRAT_Fields, 2, 6, 9, OK, [0, 16#AF#, 16#0#, 16#0#]);
   Query (Read_SRAT_Fields, 2, 7, 0, OK, [0, 16#ABCDEF06#, 16#10#, 16#FEDCBA06#]);
   Query (Read_SRAT_Fields, 2, 7, 1, Malformed);
   Query (Read_SRAT_Fields, 2, 7, 2, Malformed);
   Query (Read_SRAT_Fields, 2, 7, 3, Malformed);
   Query (Read_SRAT_Fields, 2, 7, 4, OK, [0, 16#B0#, 16#B1#, 16#B2#]);
   Query (Read_SRAT_Fields, 2, 7, 5, OK, [0, 16#B3#, 16#B4#, 16#B5#]);
   Query (Read_SRAT_Fields, 2, 7, 6, OK, [0, 16#B6#, 16#B7#, 16#B8#]);
   Query (Read_SRAT_Fields, 2, 7, 7, OK, [0, 16#B9#, 16#BA#, 16#BB#]);
