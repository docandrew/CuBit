project Supplement_release is
 for Source_Dirs use ("../aml-buffer-fields","../aml-references","../aml-core","../acpi-integration/mocks","../../userspace/services/acpi","../acpi-table-import-model","../../userspace/services/acpi/lib","../../shared/firmware", "../../userspace/services/acpi/resource-consumer");
 for Object_Dir use "build-release/obj";
 for Exec_Dir use "build-release";
 for Main use ("copy_initializing_tests.adb","copy_boundary_extended_tests.adb");
 package Compiler is
  for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnatp", "-gnatwF");
 end Compiler;
end Supplement_release;
