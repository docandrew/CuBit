project Journal is
   --  Overridden only to build a private copy of the filesystem sources.
   Fs_Src := external ("FS_SRC", "../../userspace/services/filesystem");
   Fs_Obj := external ("FS_OBJ", "build");
   for Languages use ("Ada");
   --  The file-backed block device from the interop harness: the production
   --  Ext2/JBD2 code runs against Linux-created images.
   for Source_Dirs use
     (".", "../filesystem-interop/fixture", Fs_Src, "../../userspace/runtime/gnat");
   for Source_Files use
     ("replay.adb", "cubit-messages.ads", "cubit-messages.adb", "cubit.ads",
      "ext2.ads", "ext2.adb", "ext2_inodes.ads", "ext2_support.ads", "ext2_support.adb",
      "sector_accounting.ads", "sector_accounting.adb", "inode_mappings.ads",
      "inode_mappings.adb", "volume_admission.ads", "block_paths.ads", "block_paths.adb",
      "block_inventory.ads", "block_inventory.adb",
      "double_mappings.ads", "double_mappings.adb",
      "triple_mappings.ads", "triple_mappings.adb",
      "block_cache_index.ads", "block_cache_index.adb", "dentry_cache.ads", "dentry_cache.adb",
      "jbd2_format.ads", "jbd2_format.adb", "jbd2_revokes.ads", "jbd2_revokes.adb",
      "jbd2_recovery.ads", "jbd2_recovery.adb",
      "directory_blocks.ads", "directory_blocks.adb",
      "directory_commit.ads", "directory_commit.adb", "cubit-memory_grants.ads",
      "cubit-grant_references.ads", "cubit-block_devices.ads", "cubit-block_devices.adb",
      "cubit-filesystems.ads", "cubit-filesystems.adb", "cubit-directory_pages.ads", "cubit-directory_pages.adb", "cubit-file_access.ads",
      "cubit-file_access.adb", "cubit-directory_paths.ads", "cubit-directory_paths.adb");
   for Object_Dir use Fs_Obj;
   for Exec_Dir use Fs_Obj;
   for Main use ("replay.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-I-");
   end Compiler;
end Journal;
