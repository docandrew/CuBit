--  Hosted tests for CuBit.Identity_Tables (tests/identity-tables/run.sh).
project Identity_Tables_Test is
   for Source_Dirs use (".", "../../userspace/runtime/gnat");
   for Source_Files use
     ("main.adb", "cubit.ads", "cubit-process_ids.ads", "cubit-process_ids.adb",
      "cubit-identity_tables.ads", "cubit-identity_tables.adb");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnata", "-gnato", "-gnatwa", "-I-");
   end Compiler;
end Identity_Tables_Test;
