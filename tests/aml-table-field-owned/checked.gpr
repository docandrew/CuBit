project checked is
 for Source_Dirs use (".", "../aml-core", "../../userspace/lib/acpi", "../../userspace/services/acpi", "../../shared/firmware");
 for Object_Dir use "build-checked/obj";
 for Exec_Dir use "build-checked";
 for Main use ("table_field_span_tests.adb", "bit_buffer_initializer_tests.adb", "owned_table_field_tests.adb");
 package Compiler is
  for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnata", "-gnato");
 end Compiler;
end checked;
