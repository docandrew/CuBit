with "../../userspace/lib/ui/fonts_host.gpr";
project Bookmarks is
   for Source_Dirs use (".", "../../userspace/servo/native", "../../userspace/lib/ui", "../../userspace/lib/theme", "../../userspace/ccl/tools/ccl-ui-preview/host", "../../userspace/lib/compositor", "../../userspace/lib/display", "../../userspace/allocator/src");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build";
   for Main use ("bookmark_tests.adb", "bookmark_preview.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-gnato");
   end Compiler;
end Bookmarks;
