--  Hosted tests of system generation records against the CCL checker
--  (tests/service-switch/run.sh).
with "../../../userspace/ccl/cubit_shared.gpr";
project Generation_Records is
   for Source_Dirs use (".", "../../../userspace/ccl/src", "../../../userspace/ccl/remote");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("generation_records_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnatwa", "-g", "-O1");
   end Compiler;
end Generation_Records;
