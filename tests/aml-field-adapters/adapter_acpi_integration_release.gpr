project adapter_acpi_integration_release is
 for Source_Dirs use ("../acpi-integration", "../aml-core", "../acpi-integration/mocks", "../../userspace/services/acpi/lib", "../../userspace/services/acpi", "../acpi-table-import-model", "../../shared/firmware");
 for Object_Dir use "build-acpi_integration-release";
 package Compiler is
  for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnatp", "-gnatwF");
 end Compiler;
end adapter_acpi_integration_release;
