project adapter_aml_references_checked is
 for Source_Dirs use ("../aml-references", "../aml-core", "../acpi-integration/mocks", "../../userspace/services/acpi/lib", "../../userspace/services/acpi", "../acpi-table-import-model", "../../shared/firmware");
 for Object_Dir use "build-aml_references-checked";
 package Compiler is
  for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnata", "-gnato");
 end Compiler;
end adapter_aml_references_checked;
