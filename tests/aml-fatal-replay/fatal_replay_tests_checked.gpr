project fatal_replay_tests_checked is
 for Source_Dirs use ("../../shared/firmware", ".", "../../userspace/services/acpi/lib", "../../userspace/services/acpi/resource-consumer");
 Build_Root := external ("SERVICE_MILESTONE_BUILD", "build-checked");
 for Object_Dir use Build_Root & "/obj";
 for Exec_Dir use Build_Root & "/bin";
 for Main use ("fatal_replay_tests.adb");
 package Compiler is
 for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnata", "-gnato");
 end Compiler;
end fatal_replay_tests_checked;
