   use type AML_Interface_Policy.Add_Status;
   function Reference_Policy return AML_Interface_Policy.Policy is
      P : AML_Interface_Policy.Policy := AML_Interface_Policy.Empty;
      S : AML_Interface_Policy.Add_Status;
      Name : constant String := "Windows 2001";
      Data : Bytes (1 .. Name'Length);
   begin
      for I in Name'Range loop Data (I) := Byte (Character'Pos (Name (I))); end loop;
      AML_Interface_Policy.Add (P, Data, S);
      if S /= AML_Interface_Policy.Added then raise Program_Error; end if;
      return P;
   end Reference_Policy;
   package E renames AML_Execute;
   package N is new AML_Namespace (Capacity => 32,
     Perform_Delay => AML_Delays.Unavailable_Provider,
