   use type C.Access_Status;
   use type C.Module_Outcome;
   use type C.Preparation_Outcome;
   A : C.Arena;
   Status : C.Access_Status;
   Checks : Natural := 0;
   procedure Check (Good : Boolean; Label : String) is
   begin
      Checks := Checks + 1;
      if not Good then raise Program_Error with Label; end if;
