   procedure Replay (Data : Bytes; Label : String; Argument : Integer_Value;
      Hook_Argument : Interfaces.Unsigned_32; Counted, Nested, OSI : Boolean) is
      Input : aliased AML_Table_Backing.State (1, Data'Length);
      Report : C.Module_Report;
      Prepared : C.Preparation_Outcome;
      Init : N.Initialization_Report;
      Result : C.Result;
      Node : N.Node_ID;
      Width : constant Integer_Width := (if Data (Data'First + 8) = 1 then Bits_32 else Bits_64);
      Sum : Byte := 0;
      procedure Invoke (Name : String) is
      begin
         C.Find_Child (A, N.Root, Name, Node, Status);
         Check (Status = C.Available and then Node /= N.Root, Label & " find " & Name);
         C.Invoke (A, Input, Node, [others => (C.Immediate_Argument, 0)], 0, 10000, Result, Status);
         Check (Status = C.Available, Label & " admission " & Name);
         Check (Result.Charged <= 10000, Label & " fuel");
         Check (C.Retained_Count (A) = 0, Label & " no retained value roots");
      end Invoke;
   begin
      for B of Data loop Sum := Sum + B; end loop;
      Check (Sum = 0, Label & " checksum");
      Check (Data (Data'First + 8) in 1 .. 2, Label & " revision");
      Input.Count := 1; Input.Tables (1) := (0, Data'Length); Input.Data.Bytes := Data;
      C.Reset (A, Status); Check (Status = C.Available, Label & " reset");
      C.Prepare_Firmware_Namespace (A, Prepared, Status);
      Check (Status = C.Available and then Prepared = C.Firmware_Prepared, Label & " firmware namespace");
      C.Execute_Modules (A, Input, 10000, Report, Status);
      Check (Status = C.Available and then Report.Outcome = C.Modules_Completed, Label & " module");
      C.Seal (A, Init, Status); Check (Status = C.Available, Label & " seal");
      if OSI then
         Invoke ("RAWV"); Check (Result.Status = E.Returned, Label & " raw status " & Result.Status'Image);
         if Result.Status = E.Returned then Check (Result.Number = Integer_Value'Last, Label & " observed raw64"); end if;
      end if;
      for Repeat in 1 .. 2 loop
         Invoke ("TEST"); Check (Result.Status = E.Fatal_Requested, Label & " reference AE_ERROR -> typedFatal");
         if Result.Status = E.Fatal_Requested then
            Check (Result.Fatal.Literal.Kind = (if Nested then 16#B6# else 16#A5#), Label & " type");
            Check (Result.Fatal.Literal.Code = (if Nested then 16#11223344# else 16#12345678#), Label & " code");
            Check (Result.Fatal.Evaluated_Argument = Argument, Label & " full argument");
            Check (Result.Fatal.Width = Width, Label & " width");
