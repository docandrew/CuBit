with "fixture.gpr";
project Reclamation is
   for Source_Dirs use (".", "../../kernel/src");
   for Source_Files use ("main.adb", "quiescent_reclamation.ads",
                         "quiescent_reclamation.adb");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Reclamation;
