pragma Ada_2022;
with Interfaces;
package HID_Offer_Payload with Pure, SPARK_Mode is
   subtype Byte is Interfaces.Unsigned_8;
   subtype Half is Interfaces.Unsigned_16;
   subtype Small_Word is Interfaces.Unsigned_32;
   subtype Word is Interfaces.Unsigned_64;
   use type Word;
   Format_Version : constant := 1;
   Max_Path_Segments : constant := 32;
   Name_Segment_Bytes : constant := 4;
   Path_Bytes : constant := Max_Path_Segments * Name_Segment_Bytes;
   Max_Span_Bytes : constant := 256;
   Span_Kinds : constant := 4;
   Fixed_Fields_Bytes : constant := 168;
   Header_Bytes : constant := Fixed_Fields_Bytes + 3 * Path_Bytes;
   Max_Payload_Bytes : constant := Header_Bytes + Span_Kinds * Max_Span_Bytes;
   subtype Payload_Length is Natural range 0 .. Max_Payload_Bytes;
   subtype Payload_Offset is Natural range 0 .. Max_Payload_Bytes;
   subtype Path_Count is Natural range 0 .. Max_Path_Segments;
   subtype Path_Index is Positive range 1 .. Max_Path_Segments;
   subtype Span_Length is Natural range 0 .. Max_Span_Bytes;
   type Byte_Array is array (Natural range <>) of Byte;
   NUL : constant Character := Character'Val(0);
   subtype Name_Segment is String(1 .. Name_Segment_Bytes);
   type Name_Path is array(Path_Index) of Name_Segment;
   type Canonical_Path is record
      Count : Path_Count := 0;
      Names : Name_Path := [others=>[others=>NUL]];
   end record;
   type Owned_Span is record
      Length : Span_Length := 0;
      Data : Byte_Array(1 .. Max_Span_Bytes) := [others=>0];
   end record;
   subtype Text_8 is String(1 .. 8);
   subtype Text_4 is String(1 .. 4);
   Compatible_ID : constant Text_8 := "PNP0C50" & NUL;
   type UID_Kind is(No_UID,Integer_UID,String_UID);
   for UID_Kind use(No_UID=>0,Integer_UID=>1,String_UID=>2);
   type Resource_Role is(Consumer,Producer);
   for Resource_Role use(Consumer=>0,Producer=>1);
   type Initiator is(Controller_Initiated,Device_Initiated);
   for Initiator use(Controller_Initiated=>0,Device_Initiated=>1);
   type Address_Mode is(Seven_Bit,Ten_Bit);
   for Address_Mode use(Seven_Bit=>0,Ten_Bit=>1);
   type Trigger is(Level,Edge);
   for Trigger use(Level=>0,Edge=>1);
   type Polarity is(Active_High,Active_Low,Active_Both);
   for Polarity use(Active_High=>0,Active_Low=>1,Active_Both=>2);
   type Phase is(After_Device_Initialization);
   for Phase use(After_Device_Initialization=>3);
   type PCI_Observation is record
      Has_SEG,Has_BBN,Has_ADR : Boolean := False;
      SEG,BBN,ADR : Word := 0;
   end record;
   Seven_Bit_Last : constant Half := 127;
   Ten_Bit_Last : constant Half := 1023;
   PCI_Segment_Last : constant Word := 65_535;
   PCI_Bus_Last : constant Word := 255;
   PCI_Device_Last : constant Word := 31;
   PCI_Function_Last : constant Word := 7;
   PCI_ADR_Function_Base : constant Word := 65_536;
   subtype PCI_Device_Number is Byte range 0 .. 31;
   subtype PCI_Function_Number is Byte range 0 .. 7;
   type PCI_Location is record
      Segment : Half := 0;
      Bus : Byte := 0;
      Device : PCI_Device_Number := 0;
      Func : PCI_Function_Number := 0;
   end record;
   type Request is record
      Epoch,Catalog_Revision,Observation_Sequence : Word := 0;
      PCI : PCI_Observation;
      Maximum_Hz : Small_Word := 0;
      Address,Descriptor_Register,Pin : Half := 0;
      I2C_Revision : Byte := 1;
      I2C_Type_Revision,I2C_Source_Index : Byte := 0;
      I2C_Specific_Flags : Half := 0;
      I2C_Role : Resource_Role := Consumer;
      Initiated_By : Initiator := Controller_Initiated;
      I2C_Shared : Boolean := False;
      Addressing : Address_Mode := Seven_Bit;
      IRQ_Trigger : Trigger := Level;
      IRQ_Polarity : Polarity := Active_High;
      IRQ_Shared,Wake_Capable : Boolean := False;
      GPIO_Role : Resource_Role := Consumer;
      Pin_Configuration : Byte := 0;
      Drive,Debounce : Half := 0;
      GPIO_UID_Kind : UID_Kind := No_UID;
      GPIO_UID : Word := 0;
      GPIO_HID : Text_8 := [others=>NUL];
      Table : Text_4 := [others=>NUL];
      Table_ID : Text_8 := [others=>NUL];
      Table_Digest : Word := 0;
      Initializer_Count : Small_Word := 0;
      Observed : Phase := After_Device_Initialization;
      Initializer_Digest,Resource_Digest : Word := 0;
      Device_Path,I2C_Path,GPIO_Path : Canonical_Path;
      I2C_Source,I2C_Vendor,GPIO_Source,GPIO_Vendor : Owned_Span;
   end record;
   Empty_Request : constant Request := (others=><>);
   Version_Offset : constant := 0;
   Length_Offset : constant := 4;
   Epoch_Offset : constant := 8;
   Catalog_Offset : constant := 16;
   Observation_Offset : constant := 24;
   SEG_Offset : constant := 32;
   BBN_Offset : constant := 40;
   ADR_Offset : constant := 48;
   Hertz_Offset : constant := 56;
   Address_Offset : constant := 60;
   Descriptor_Offset : constant := 62;
   Pin_Offset : constant := 64;
   I2C_Revision_Offset : constant := 66;
   I2C_Type_Offset : constant := 67;
   I2C_Index_Offset : constant := 68;
   PCI_Known_Offset : constant := 69;
   I2C_Flags_Offset : constant := 70;
   I2C_Role_Offset : constant := 72;
   Initiator_Offset : constant := 73;
   I2C_Shared_Offset : constant := 74;
   Addressing_Offset : constant := 75;
   Trigger_Offset : constant := 76;
   Polarity_Offset : constant := 77;
   IRQ_Shared_Offset : constant := 78;
   Wake_Offset : constant := 79;
   GPIO_Role_Offset : constant := 80;
   Pin_Configuration_Offset : constant := 81;
   Drive_Offset : constant := 82;
   Debounce_Offset : constant := 84;
   UID_Kind_Offset : constant := 86;
   Device_Count_Offset : constant := 87;
   I2C_Count_Offset : constant := 88;
   GPIO_Count_Offset : constant := 89;
   I2C_Source_Length_Offset : constant := 90;
   I2C_Vendor_Length_Offset : constant := 92;
   GPIO_Source_Length_Offset : constant := 94;
   GPIO_Vendor_Length_Offset : constant := 96;
   Reserved_Offset : constant := 98;
   UID_Offset : constant := 100;
   HID_Offset : constant := 108;
   Table_Offset : constant := 116;
   Table_ID_Offset : constant := 120;
   Table_Digest_Offset : constant := 128;
   Initializer_Count_Offset : constant := 136;
   Phase_Offset : constant := 140;
   Reserved_Tail_Offset : constant := 141;
   Initializer_Digest_Offset : constant := 144;
   Resource_Digest_Offset : constant := 152;
   Compatible_Offset : constant := 160;
   Device_Path_Offset : constant := Fixed_Fields_Bytes;
   I2C_Path_Offset : constant := Device_Path_Offset + Path_Bytes;
   GPIO_Path_Offset : constant := I2C_Path_Offset + Path_Bytes;
   function Encoded_Length(Item:Request) return Payload_Length is
     (Header_Bytes+Item.I2C_Source.Length+Item.I2C_Vendor.Length+
      Item.GPIO_Source.Length+Item.GPIO_Vendor.Length);
   function Fully_Resolved(Item:PCI_Observation) return Boolean is
     (Item.Has_SEG and then Item.Has_BBN and then Item.Has_ADR);
   function Valid_PCI(Item:PCI_Observation) return Boolean;
   function Location(Item:PCI_Observation) return PCI_Location
     with Pre=>Fully_Resolved(Item) and then Valid_PCI(Item);
   function Valid(Item:Request) return Boolean;
   procedure Encode(Item:Request;Data:out Byte_Array)
     with Pre=>Valid(Item) and then Data'Length=Encoded_Length(Item);
   type Decode_Status is(Decoded,Malformed);
   type Decode_Result is record
      Status : Decode_Status := Malformed;
      At_Byte : Payload_Offset := 0;
   end record;
   -- Data only. No partial row escapes a refusal. Caller-provided byte bounds
   -- may be nonzero; offsets are always relative to the payload, not its index.
   procedure Decode(Data:Byte_Array;Item:out Request;Result:out Decode_Result)
     with Post=>(if Result.Status=Decoded then Valid(Item) else Item=Empty_Request);
end HID_Offer_Payload;
