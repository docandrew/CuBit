--  Hosted test and proof of who keeps the system's time on a timer
--  interrupt and what msTicks becomes (kernel/src/timekeeping_turns).
project Timekeeping_Turns_Tests is
   for Source_Dirs use (".", "../../kernel/src");
   for Source_Files use ("main.adb", "timekeeping_turns.ads");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-O2", "-gnata", "-gnato", "-gnatwa", "-gnatwe");
   end Compiler;
end Timekeeping_Turns_Tests;
