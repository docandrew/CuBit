--  VMM-001 slice 1: hosted tests and proofs of the kernel's proved VM units
--  (Guest_Tables: nested-table encodings; VM_Admission: Add_RAM ranges
--  and event injection; Guest_Speculation: a guest's SPEC_CTRL).
project VM_Units_Tests is
   for Source_Dirs use (".", "../../kernel/src", "../../shared/capabilities");
   for Source_Files use
     ("main.adb", "guest_tables.ads",
      "vm_admission.ads", "vm_admission.adb", "vm_abi.ads",
      "guest_speculation.ads", "guest_speculation.adb");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-O2", "-gnata", "-gnato", "-gnatwa", "-gnatwe");
   end Compiler;
   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--checks-as-errors=on");
   end Prove;
end VM_Units_Tests;
