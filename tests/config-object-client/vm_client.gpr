project VM_Client extends "client.gpr" is
   for Source_Dirs use Client'Source_Dirs & ("native-app");
   for Source_Files use Client'Source_Files &
     ("vm_tests.adb", "vm_fixture.ads", "vm_fixture.adb",
      "config_object_client-vm.ads", "config_object_client-vm.adb",
      "ccl-objects-values.ads", "ccl-objects-values.adb",
      "ccl-objects-catalog.ads", "ccl-objects-catalog.adb",
      "ccl-host_values.ads", "ccl-host_values.adb",
      "ccl-handler_references.ads", "ccl-handler_references.adb",
      "ccl-vm.ads", "ccl-vm.adb",
      "ccl-vm-machine.ads", "ccl-vm-machine.adb", "ccl-vm-operations.ads", "ccl-vm-operations.adb", "ccl-vm-scalar_ops.ads", "ccl-vm-scalar_ops.adb", "ccl-vm-text_ops.ads", "ccl-vm-text_ops.adb",
      "ccl-vm-data_ops.ads", "ccl-vm-data_ops.adb", "ccl-vm-list_ops.ads", "ccl-vm-list_ops.adb", "ccl-vm-call_ops.ads", "ccl-vm-call_ops.adb", "ccl-vm-local_ops.ads", "ccl-vm-local_ops.adb",
      "ccl-vm-results.ads", "ccl-vm-results.adb", "ccl-vm-verifier_state.ads", "ccl-vm-verifier_state.adb", "ccl-vm-verifier_values.ads", "ccl-vm-verifier_values.adb", "ccl-vm-verifier_texts.ads", "ccl-vm-verifier_texts.adb",
      "ccl-vm-verifier_flow.ads", "ccl-vm-verifier_flow.adb", "ccl-vm-verifier_tables.ads", "ccl-vm-verifier_tables.adb", "ccl-vm-verifier_sweep.ads", "ccl-vm-verifier_sweep.adb",
      "ccl-streams.ads", "ccl-types-shapes.ads", "ccl-types-shapes.adb", "ccl-ownership.ads", "ccl-ownership.adb",
      "ccl-resources.ads", "ccl-resources.adb",
      "ccl-resource_policies.ads", "ccl-resource_policies.adb",
      "ccl-vm-resource_values.ads", "ccl-vm-resource_values.adb",
      "ccl-ownership-bytecode.ads", "ccl-ownership-bytecode.adb",
      "ccl-imports.ads", "ccl-imports.adb",
      "ccl-execution_budgets.ads", "ccl-execution_budgets.adb",
      "ccl-checked_arithmetic.ads", "ccl-checked_arithmetic.adb",
      "ccl-language.ads", "ccl-language.adb", "ccl-compiler.ads", "ccl-compiler.adb",
      "ccl-objects-views.ads", "ccl-objects-views.adb",
      "ccl-catalog.ads", "ccl-catalog.adb", "ccl-debug_maps.ads", "ccl-debug_maps.adb",
      "ccl-secondary_stacks.ads", "ccl-secondary_stacks.adb", "ccl-text_operations.ads", "ccl-text_operations.adb",
      "ccl-list_operations.ads", "ccl-list_operations.adb",
      "ccl-secondary_arrays.ads", "ccl-secondary_arrays.adb");
   for Object_Dir use "build/vm";
   for Exec_Dir use "build/vm";
   for Main use ("vm_tests.adb");
end VM_Client;
