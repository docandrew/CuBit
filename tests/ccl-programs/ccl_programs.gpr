--  Hosted tests for program interfaces generated from descriptions (run.sh).
with "../../userspace/ccl/cubit_shared.gpr";
with "../../userspace/lib/tls/sparktls_host.gpr";
project CCL_Programs is
   for Source_Dirs use (".", "../../userspace/ccl/src", "../../userspace/ccl/modules",
                        "../ccl-module-support", external ("CBOR_ADA_SRC") & "/src");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnata", "-gnato", "-gnatwa", "-gnatwe");
      for Switches ("cbor-decoding.adb") use ("-O2", "-gnat2022", "-gnata", "-gnato", "-gnatwa");
      for Switches ("cbor-encoding.adb") use ("-O2", "-gnat2022", "-gnata", "-gnato", "-gnatwa");
      for Switches ("cbor-properties.adb") use ("-O2", "-gnat2022", "-gnata", "-gnato", "-gnatwa");
   end Compiler;
end CCL_Programs;
