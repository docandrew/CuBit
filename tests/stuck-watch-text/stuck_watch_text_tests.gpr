project Stuck_Watch_Text_Tests is
   for Source_Dirs use (".", "../../kernel/src");
   for Source_Files use ("main.adb", "stuck_watch_text.ads");
   for Object_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-gnatwa", "-gnatwe", "-O2", "-g");
   end Compiler;
end Stuck_Watch_Text_Tests;
