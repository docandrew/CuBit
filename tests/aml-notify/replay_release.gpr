project Release is
 for Source_Dirs use (".","../../userspace/lib/acpi","../../userspace/services/acpi","../../shared/firmware");
 for Object_Dir use "build-replay-release/obj";
 for Exec_Dir use "build-replay-release";
 for Main use ("notify_replay.adb");
 package Compiler is
  for Default_Switches ("Ada") use ("-O1","-gnat2022","-gnatwa","-gnatwe","-gnatp", "-gnatwF");
 end Compiler;
end Release;
