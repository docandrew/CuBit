project Provisional_release is
 for Source_Dirs use (".", "../../userspace/lib/acpi", "../../userspace/services/acpi", "../../shared/firmware");
 for Object_Dir use "build-provisional-release/obj";
 for Exec_Dir use "build-provisional-release";
 for Main use ("provisional_write_tests.adb", "name_reservation_tests.adb", "copy_compound_quota_tests.adb", "copy_boundary_extended_tests.adb");
 package Compiler is
 for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnatwa", "-gnatwe", "-gnatwF", "-gnatp");
 end Compiler;
end Provisional_release;
