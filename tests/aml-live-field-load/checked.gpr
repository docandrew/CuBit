project Field_Load_checked is
 for Source_Dirs use (".","../../userspace/services/acpi","../../userspace/services/acpi/lib","../../shared/firmware","../../shared/capabilities","../../userspace/services/acpi/resource-consumer");
 Build_Root := external("ACPI_FIELD_BUILD", "build-checked");
 for Object_Dir use Build_Root & "/obj";for Exec_Dir use Build_Root & "/bin";for Main use("aslts_corpus_runner.adb");
 package Compiler is for Default_Switches("Ada")use("-O1","-gnat2022","-gnata","-gnato");end Compiler;
end Field_Load_checked;
