--  VMM-001: hosted test and proof of VMX control-register access exits
--  (kernel/src/vmx_cr_access).
project VMX_CR_Access_Tests is
   for Source_Dirs use (".", "../../kernel/src");
   for Source_Files use ("main.adb", "vmx_cr_access.ads", "vmx_cr_access.adb");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-O2", "-gnata", "-gnato", "-gnatwa", "-gnatwe");
   end Compiler;
end VMX_CR_Access_Tests;
