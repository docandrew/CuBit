-- Kernel geometry (32768 slots) without run-time assertion checks: the
-- ghost invariant is quadratic in the capacity, too slow to execute there.
-- Results are checked against the reference model instead.
project Geometry is
   for Source_Dirs use (".", "../../kernel/src");
   for Source_Files use
     ("geometry.adb", "checks.ads", "checks.adb",
      "differential.ads", "differential.adb", "test_tables.ads", "fake_pages.ads", "fake_pages.adb",
      "capabilities.ads",
      "capability_tables.ads", "capability_tables.adb");
   for Object_Dir use "build/geometry-obj";
   for Exec_Dir use "build";
   for Main use ("geometry.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnato", "-O2", "-gnatwa", "-gnatwJ");
   end Compiler;
end Geometry;
