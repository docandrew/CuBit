project package_retained_independence_tests_release is
 for Source_Dirs use ("../../shared/firmware", ".", "../../userspace/services/acpi", "../../userspace/services/acpi/lib");
 Build_Root := external ("PACKAGE_STORE_BUILD", "build-package_retained_independence_tests-release");
 for Object_Dir use Build_Root & "/obj";
 for Exec_Dir use Build_Root & "/bin";
 for Main use ("package_retained_independence_tests.adb");
 package Compiler is
 for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnatp");
 end Compiler;
end package_retained_independence_tests_release;
