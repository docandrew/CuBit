project Test is
   for Source_Dirs use (".", "../../userspace/lib/display", "../../userspace/runtime/gnat");
   for Source_Files use ("cubit.ads", "cubit-desktop_protocol.ads", "cubit-desktop_protocol.adb",
     "cubit-grant_references.ads",
     "cubit-display_frame_damage.ads", "cubit-display_frame_damage.adb",
     "cubit-display_frame_damage-shared.ads", "cubit-display_frame_damage-shared.adb",
     "cubit-display_box_copy.ads", "cubit-display_box_copy.adb", "frame_damage_tests.adb");
   for Object_Dir use external ("FRAME_DAMAGE_OBJECT_DIR", "build");
   for Exec_Dir use external ("FRAME_DAMAGE_OBJECT_DIR", "build");
   for Main use ("frame_damage_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato");
   end Compiler;
end Test;
