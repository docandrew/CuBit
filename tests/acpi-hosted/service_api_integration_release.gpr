project Service_API_Integration_release is
 for Source_Dirs use ("../acpi-integration", "../../userspace/services/acpi/lib", "../../userspace/services/acpi", "../../shared/firmware", "../../userspace/services/acpi/resource-consumer");
 for Object_Dir use "service-api-integration-release/obj";
 for Exec_Dir use "service-api-integration-release";
 for Main use ("bootstrap_owned_tests.adb");
 package Compiler is
 for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnatp", "-gnatwF");
 end Compiler;
end Service_API_Integration_release;
