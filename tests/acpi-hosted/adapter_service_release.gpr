project Adapter_service_release is
 for Source_Dirs use ("../../tests/acpi-integration", "../../userspace/lib/acpi", "../../userspace/services/acpi", "../../shared/firmware");
 for Object_Dir use "adapter-service-release";
 package Compiler is
 for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnatp", "-gnatwF");
 end Compiler;
end Adapter_service_release;
