with Admission_Probe; package body ACPI_Native_Passive_Queries is procedure Dispatch (Server : in out ACPI_Requests.State; From : CuBit.Messages.Process_ID; Request : CuBit.Messages.Message; Admission_Open : Boolean; Reply : out CuBit.Messages.Message; Handled, Reply_Now : out Boolean) is pragma Unreferenced (Server, From, Request); begin Admission_Probe.Seen(4):=True;Admission_Probe.Gates(4):=Admission_Open;Reply:=CuBit.Messages.NULL_MESSAGE;Handled:=Admission_Probe.Handle_At=4;Reply_Now:=not Handled;end Dispatch;procedure Advance (Server : in out ACPI_Requests.State; Worked : out Boolean) is pragma Unreferenced (Server); begin Worked := False; end Advance; procedure Maintain (Deadline : out Interfaces.Unsigned_64; Healthy : out Boolean) is begin Deadline := CuBit.Messages.Wait_Forever; Healthy := True; end Maintain; end ACPI_Native_Passive_Queries;