with SCI_Probe;package body CuBit.Handles.Lines is function Acknowledge(Line:Interrupt;Vector:Interrupt_Line_ABI.Line_Vector) return Acknowledgement is pragma Unreferenced(Line,Vector);begin SCI_Probe.Acks:=SCI_Probe.Acks+1;return (if SCI_Probe.Ack_OK then (Accepted=>True,Delivered=>Interrupt_Line_ABI.Delivery_Count(SCI_Probe.Acks)) else (Accepted=>False,Why=>Interrupt_Line_ABI.No_Line_Authority));end;end CuBit.Handles.Lines;