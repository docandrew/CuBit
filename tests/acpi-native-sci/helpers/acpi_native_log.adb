with SCI_Probe;package body ACPI_Native_Log is procedure Info(Text:String) is pragma Unreferenced(Text);begin SCI_Probe.Logs:=SCI_Probe.Logs+1;SCI_Probe.Opening_Logs:=SCI_Probe.Opening_Logs+1;end;procedure Warning(Text:String) is begin Info(Text);end;procedure Critical(Text:String) is begin Info(Text);end;procedure Copied(Text:String;Peer_Quiet:Boolean;Success:Boolean:=False) is pragma Unreferenced(Text,Success);begin SCI_Probe.Copied_Logs:=SCI_Probe.Copied_Logs+1;SCI_Probe.Last_Quiet:=Peer_Quiet;end;end ACPI_Native_Log;