pragma Ada_2022;
with Ada.Text_IO;
with Interfaces;
with ACPI_SCI_Events;
with ACPI_SCI_Quiesce;
with SCI_Probe;
with CuBit.ACPI_Windows;
with CuBit.Firmware_Snapshot;
with CuBit.Messages;
with CuBit.Device_Interrupts;
procedure SCI_Tests is
   package E renames ACPI_SCI_Events;
   package Q renames ACPI_SCI_Quiesce;
   package P renames SCI_Probe;
   use type E.Arm_Outcome, E.R.Fixed_Event, Q.Acknowledgement, Q.Outcome, Q.Pending_Reason;
   use type Interfaces.Unsigned_64;
   Checks : Natural := 0;
   procedure Check (OK : Boolean; Why : String) is
   begin Checks := Checks + 1; if not OK then raise Program_Error with Why; end if; end Check;
   procedure Fixed (Event : E.R.Fixed_Event; Result : out E.Disposition) is
   begin
      Check (Event = E.R.Power_Button, "latched power event delivered");
      P.Fixed_Calls := P.Fixed_Calls + 1; Result := E.Handled;
   end Fixed;
   procedure GPE (Number : E.R.GPE_Number; Result : out E.Disposition) is
      pragma Unreferenced (Number);
   begin P.GPE_Calls := P.GPE_Calls + 1; Result := E.Unbound; end GPE;
   package Consumer is new E.With_Consumer (Fixed, GPE);
   Grant : CuBit.ACPI_Windows.Grant;
   Tables : CuBit.Firmware_Snapshot.Authority;
   Doorbell : CuBit.Messages.Message := CuBit.Messages.NULL_MESSAGE;
   Other : constant CuBit.Messages.Message := CuBit.Messages.NULL_MESSAGE;
   Ack : Q.Acknowledgement;
   Arm : E.Arm_Outcome;
   Why : E.R.Refusal;
   Stop, Handled : Boolean;
   Quiesce : Q.Result;
   Before_Reads, Before_Writes, Before_Acks, Before_Logs : Natural;
   procedure Baseline is
   begin Before_Reads := P.Reads; Before_Writes := P.Writes; Before_Acks := P.Acks; Before_Logs := P.Logs; end Baseline;
begin
   Doorbell.tag.label := CuBit.Device_Interrupts.EVENT_IRQ;
   Consumer.Defer_Event (CuBit.Messages.No_Process, Doorbell, Ack);
   Check (Ack = Q.No_SCI_Line and not Consumer.Deferred, "unadmitted SCI never becomes pending");
   E.Arm (Grant, Tables, Arm, Why);
   Check (Arm = E.No_SCI_Line, "missing startup line refused");
   Grant.SCI.Present := True;
   Grant.IO_Used := 1; Grant.IO (1).First := 16#400#; Grant.IO (1).Count := 4;
   E.Arm (Grant, Tables, Arm, Why);
   Check (Arm = E.Armed and E.Is_Armed, "real FADT decode and port-window admission");
   Check ((P.PM_Enable and 16#300#) = 16#300#, "fixed buttons enabled");
   Baseline;
   Consumer.Defer_Event (CuBit.Messages.From_Word (16#A123_4567_ABCD_0123#), Doorbell, Ack);
   Check (Ack = Q.Not_SCI_Doorbell and not Consumer.Deferred and P.Acks = Before_Acks, "non-kernel publisher cannot defer or acknowledge SCI");
   Consumer.Defer_Event (CuBit.Messages.No_Process, Other, Ack);
   Check (Ack = Q.Not_SCI_Doorbell and not Consumer.Deferred, "foreign label never becomes pending");
   Consumer.Service_Deferred;
   Check (P.Reads = Before_Reads and P.Writes = Before_Writes, "empty deferred service does no I/O");
   P.PM_Status := 16#100#;
   for Delivery in 1 .. 12 loop
      Consumer.Defer_Event (CuBit.Messages.No_Process, Doorbell, Ack);
      Check (Ack = Q.Acknowledged and Consumer.Deferred, "authenticated SCI acknowledged and coalesced");
      Check (P.Reads = Before_Reads and P.Writes = Before_Writes, "retained owner path performs no register I/O");
      Check (P.Logs = Before_Logs and P.Fixed_Calls = 0 and P.GPE_Calls = 0, "retained owner path has no consumer or logging work");
      Check (P.Acks = Before_Acks + Delivery, "each kernel delivery acknowledged once");
   end loop;
   Check (P.PM_Status = 16#100#, "event remains latched while deferred");
   Baseline; Consumer.Service_Deferred;
   Check (not Consumer.Deferred and P.Fixed_Calls = 1, "quiet boundary services coalesced event once");
   Check (P.PM_Status = 0 and P.Reads > Before_Reads and P.Writes > Before_Writes, "status cleared during quiet service");
   Check (P.Acks = Before_Acks, "deferred service does not double acknowledge");
   Baseline; Consumer.Service_Deferred;
   Check (P.Reads = Before_Reads and P.Fixed_Calls = 1, "repeated quiet boundary does not replay service");
   P.Ack_OK := False;
   Consumer.Defer_Event (CuBit.Messages.No_Process, Doorbell, Ack);
   Check (Ack = Q.Acknowledge_Refused and Consumer.Deferred, "ack refusal retains pending register work");
   P.Ack_OK := True;
   P.PM_Status := 16#100#; Baseline;
   Consumer.Handle_Event (CuBit.Messages.No_Process, Doorbell, Stop, Handled);
   Check (Handled and not Stop and not Consumer.Deferred and P.Fixed_Calls = 2, "normal dispatch consumes deferred marker before servicing");
   Check (P.Acks = Before_Acks + 1, "normal dispatch acknowledges once after service");
   Consumer.Handle_Event (CuBit.Messages.No_Process, Other, Stop, Handled);
   Check (P.Other_Events = 1, "non-SCI event forwarded");
   P.PM_Status := 16#100#;
   Consumer.Defer_Event (CuBit.Messages.No_Process, Doorbell, Ack);
   P.Write_OK := False; Baseline;
   E.Disarm_At_Boundary (Quiesce, False);
   Check (Quiesce.State = Q.Pending and then Quiesce.Why = Q.Fixed_Disable_Refused, "failed disable is pending retirement barrier");
   Check (not E.Is_Armed and not P.Last_Quiet, "stop suppresses consumers and carries closed diagnostic admission");
   Check (P.Logs = Before_Logs and P.Copied_Logs = 1, "disarm uses copied diagnostic path only");
   P.Write_OK := True; Baseline;
   E.Disarm_At_Boundary (Quiesce, True);
   Check (Quiesce.State = Q.Quiesced and P.PM_Enable = 0, "retry completes physical disable barrier");
   Check (P.PM_Status = 16#100#, "disarm preserves status for next owner");
   Check (P.Last_Quiet and P.Logs = Before_Logs, "quiet admission forwarded only to copied logger");
   Baseline; Consumer.Service_Deferred;
   Check (not Consumer.Deferred and P.Reads = Before_Reads and P.Writes = Before_Writes and P.Fixed_Calls = 2, "disarm discards deferred dispatch without touching status");
   Consumer.Handle_Event (CuBit.Messages.No_Process, Doorbell, Stop, Handled);
   Check (P.Acks = Before_Acks + 1 and P.Reads = Before_Reads and P.Fixed_Calls = 2, "late IRQ after disarm is acknowledge only");
   Ada.Text_IO.Put_Line ("Native SCI execution checks" & Checks'Image);
end SCI_Tests;
