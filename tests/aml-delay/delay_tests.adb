with Ada.Text_IO;
with AML_Decode; use AML_Decode;
with AML_Execute; use AML_Execute;
with AML_Delays;
with AML_Namespace;
with AML_Table_Backing;
procedure Delay_Tests is
   use type Integer_Value;
   use type AML_Delays.Outcome;
   use type AML_Delays.Normalization_Status;
   use type AML_Delays.Request;
   use type AML_Delays.Stall_Microseconds;
   use type AML_Delays.Sleep_Milliseconds;
   procedure Provider (Item : AML_Delays.Request; Result : out AML_Delays.Outcome);
   package N is new AML_Namespace (512, Provider);
   use N; use N.Owned;
   A : Arena;
   Input : aliased AML_Table_Backing.State (1, 32);
   Calls, Checks : Natural := 0;
   Clock : Integer_Value := 0;
   Selected : AML_Delays.Outcome := AML_Delays.Completed;
   Last_Request : AML_Delays.Request;
   procedure Check (Good : Boolean) is
   begin
      Checks := Checks + 1;
      if not Good then raise Program_Error with "delay check" & Checks'Image; end if;
   end Check;
   procedure Provider (Item : AML_Delays.Request; Result : out AML_Delays.Outcome) is
   begin
      Check (Frame_Root_Count (A) > 0);
      Last_Request := Item; Calls := Calls + 1;
      -- Deterministic hosted clock only; not a production timing provider.
      case Item.Kind is
         when AML_Delays.Sleep_Delay => Clock := Clock + Integer_Value (Item.Milliseconds) * 1_000;
         when AML_Delays.Stall_Delay => Clock := Clock + Integer_Value (Item.Microseconds);
      end case;
      Result := Selected;
   end Provider;
   function Method (Code : Bytes) return Bytes is
     (Bytes'[16#14#, Byte (Code'Length + 6), 16#54#,16#45#,16#53#,16#54#,0] & Code);
   procedure Test (Code : Bytes; Expected : Execution_Status; Count : Natural;
                   Width : Integer_Width; Budget : Natural := 100) is
      OK : Boolean; Loaded_Status : Load_Status;
      Result : Execution_Result; Pin : Retained_Root;
      Retention : Invocation_Retention_Status;
   begin
      Reset (A, OK); Check (OK); Calls := 0; Clock := 0;
      Load (A, Method (Code), Width, Loaded_Status); Check (Loaded_Status = Loaded);
      Invoke_Retained (A, Input, 1, [others => (Integer_Datum, 0, Ordinary_Integer)],
        0, Budget, Result, Pin, Retention);
      Check (Result.Status = Expected); Check (Calls = Count);
      Check (Pin = No_Retained_Root and Retention = No_Root_Required);
      Check (Frame_Root_Count (A) = 0 and Retained_Count (A) = 0);
      if Result.Status = Returned then Check (Result.Value = 7); end if;
   end Test;
   procedure Oracle_Test (Data : Bytes; Node : N.Node_ID; Expected : Execution_Status;
                          Number : Integer_Value; Width : Integer_Width) is
      OK : Boolean; Loaded_Status : Load_Status;
      Result : Execution_Result; Pin : Retained_Root;
      Retention : Invocation_Retention_Status;
   begin
      Reset (A, OK); Check (OK); Calls := 0; Clock := 0;
      Load (A, Data, Width, Loaded_Status); Check (Loaded_Status = Loaded);
      Invoke_Retained (A, Input, Node, [others => (Integer_Datum, 0, Ordinary_Integer)],
        0, 100, Result, Pin, Retention);
      Check (Result.Status = Expected);
      if Expected = Returned then Check (Result.Value = Number and Calls = 1);
      else Check (Calls = 0); end if;
      Check (Frame_Root_Count (A) = 0 and Retained_Count (A) = 0);
   end Oracle_Test;
   procedure Effect_Test (Choice : AML_Delays.Outcome; Budget : Natural;
                          Expected : Execution_Status; Charge : Natural;
                          Width : Integer_Width) is
      Data : constant Bytes := Bytes'[16#08#,16#4D#,16#41#,16#52#,16#4B#,0] &
        Method ([16#5B#,16#22#,16#75#,16#4D#,16#41#,16#52#,16#4B#,16#A4#,16#0A#,7]);
      OK : Boolean; Loaded_Status : Load_Status;
      Result : Execution_Result; Pin : Retained_Root;
      Retention : Invocation_Retention_Status;
   begin
      Reset (A, OK); Check (OK); Calls := 0; Clock := 0; Selected := Choice;
      Load (A, Data, Width, Loaded_Status); Check (Loaded_Status = Loaded);
      Invoke_Retained (A, Input, 2, [others => (Integer_Datum, 0, Ordinary_Integer)],
        0, Budget, Result, Pin, Retention);
      Ada.Text_IO.Put_Line ("EFFECT " & Result.Status'Image & Result.Charged'Image & " expected " & Expected'Image & Charge'Image);
      Check (Result.Status = Expected and Result.Charged = Charge);
      Check (Integer_Data (Snapshot (A), 1) = 1 and Calls = 1);
      Check (Last_Request = (AML_Delays.Sleep_Delay, 1));
      Check (Frame_Root_Count (A) = 0 and Retained_Count (A) = 0);
   end Effect_Test;
   R : AML_Delays.Normalization_Result;
begin
   for Width in Integer_Width loop
      for I in 0 .. 256 loop
         R := AML_Delays.Normalize (AML_Delays.Stall_Delay, Width, Integer_Value (I));
         Check ((R.Status = AML_Delays.Accepted) = (I <= 255));
         if R.Status = AML_Delays.Accepted then Check (R.Item.Microseconds = AML_Delays.Stall_Microseconds (I)); end if;
      end loop;
      R := AML_Delays.Normalize (AML_Delays.Sleep_Delay, Width, Integer_Value'Last);
      Check (R.Item.Milliseconds = 2_000);
      R := AML_Delays.Normalize (AML_Delays.Stall_Delay, Width, 16#1_0000_0001#);
      Check (R.Item.Microseconds = 1);
      R := AML_Delays.Normalize (AML_Delays.Sleep_Delay, Width, 16#1_0000_0001#);
      Check (R.Item.Milliseconds = (if Width = Bits_32 then 1 else 2_000));
      for Choice in AML_Delays.Outcome loop
         Selected := Choice;
         Test ([16#5B#,16#22#,1,16#A4#,16#0A#,7],
           (case Choice is when AML_Delays.Completed => Returned,
            when AML_Delays.Unavailable => Unsupported, when AML_Delays.Failed => Delay_Failed), 1, Width);
         Check (Clock = 1_000);
         Check (Last_Request = (AML_Delays.Sleep_Delay, 1));
      end loop;
      Selected := AML_Delays.Completed;
      Test ([16#5B#,16#21#,16#0B#,0,1,16#A4#,16#0A#,7], Invalid_Delay, 0, Width);
      Test ([16#5B#,16#21#,1,16#A4#,16#0A#,7], Returned, 1, Width);
      Check (Clock = 1);
      Test ([16#5B#,16#22#], Truncated, 0, Width);
      Test ([16#5B#,16#22#,1], Budget_Exceeded, 0, Width, 1);
      Test ([16#5B#,16#22#,16#60#], Uninitialized, 0, Width);
      Test ([16#5B#,16#22#,16#0D#,16#30#,0,16#A4#,16#0A#,7], Returned, 1, Width);
      Test ([16#5B#,16#22#,16#11#,3,1,0,16#A4#,16#0A#,7], Returned, 1, Width);
      Test ([16#5B#,16#22#,16#11#,2,0], Empty_Buffer, 0, Width);
   end loop;
   Oracle_Test ([16#08#,16#4E#,16#56#,16#41#,16#4C#,16#00#,16#08#,16#42#,16#56#,16#41#,16#4C#,16#11#,16#03#,16#01#,16#00#,16#08#,16#50#,16#56#,16#41#,16#4C#,16#12#,16#03#,16#01#,16#00#,16#08#,16#45#,16#4D#,16#50#,16#30#,16#12#,16#02#,16#01#,16#14#,16#0C#,16#54#,16#45#,16#53#,16#54#,16#00#,16#5B#,16#22#,16#01#,16#A4#,16#0A#,16#55#,16#14#,16#0C#,16#54#,16#53#,16#54#,16#31#,16#00#,16#5B#,16#21#,16#01#,16#A4#,16#0A#,16#66#], 5, Returned, 85, Bits_32);
   Oracle_Test ([16#08#,16#4E#,16#56#,16#41#,16#4C#,16#00#,16#08#,16#42#,16#56#,16#41#,16#4C#,16#11#,16#03#,16#01#,16#00#,16#08#,16#50#,16#56#,16#41#,16#4C#,16#12#,16#03#,16#01#,16#00#,16#08#,16#45#,16#4D#,16#50#,16#30#,16#12#,16#02#,16#01#,16#14#,16#0C#,16#54#,16#45#,16#53#,16#54#,16#00#,16#5B#,16#22#,16#01#,16#A4#,16#0A#,16#55#,16#14#,16#0C#,16#54#,16#53#,16#54#,16#31#,16#00#,16#5B#,16#21#,16#01#,16#A4#,16#0A#,16#66#], 6, Returned, 102, Bits_32);
