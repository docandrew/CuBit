project Connections is
   for Source_Dirs use (".", "build/source");
   for Source_Files use
     ("main.adb", "lifecycle.adb", "proof_cases.ads", "proof_cases.adb", "cubit.ads",
      "cubit-authority_policy.ads", "cubit-protocols.ads",
      "cubit-protocols-stream_policies.ads",
      "cubit-protocols-stream_connections.ads",
      "cubit-protocols-stream_bindings.ads",
      "cubit-protocols-stream_bindings.adb");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build";
   for Main use ("main.adb", "lifecycle.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnata", "-gnato", "-gnatwa", "-gnatwe");
   end Compiler;
end Connections;
