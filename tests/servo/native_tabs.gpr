with "../../userspace/lib/ui/fonts_host.gpr";
project Native_Tabs is
   for Source_Dirs use (".", external ("WIDGET_SOURCE", "../../userspace/lib/ui"),
     "../../userspace/lib/ui", "../../userspace/lib/theme",
     "../../userspace/ccl/tools/ccl-ui-preview/host",
     "../../userspace/lib/compositor", "../../userspace/lib/display",
     "../../userspace/allocator/src");
   for Object_Dir use "build/native-tabs/obj";
   for Exec_Dir use "build/native-tabs";
   for Main use ("native_tabs_tests.adb", "tab_style_preview.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnata", "-gnato", "-gnatwa");
   end Compiler;
end Native_Tabs;
