project Timing is
   for Source_Dirs use (".", "../../kernel/src");
   for Source_Files use ("main.adb", "scheduler_timing.ads", "scheduler_timing.adb");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      -- Hosted assertions only; never imported by the kernel build.
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2");
   end Compiler;
end Timing;
