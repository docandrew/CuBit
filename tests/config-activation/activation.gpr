project Activation is
   for Source_Dirs use
     (".", "build/source", "../../userspace/services/config", "../../userspace/ccl/src");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build";
   for Main use ("activation_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnata", "-gnato", "-gnatwa", "-gnatwe");
   end Compiler;
end Activation;
