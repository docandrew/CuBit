project Metadata_Tests is
   for Source_Dirs use (".", "../../kernel/src");
   for Source_Files use ("main.adb", "buddy_metadata.ads", "buddy_metadata.adb",
     "buddy_blocks.ads", "buddy_blocks.adb", "buddy_geometry.ads", "buddy_geometry.adb");
   for Object_Dir use "build";
   for Exec_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-O2", "-g");
   end Compiler;
end Metadata_Tests;
