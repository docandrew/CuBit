project Observer_Policy is
 for Source_Dirs use ("../../userspace/services/acpi", "../../userspace/services/acpi/lib", "../../userspace/services/acpi/request-driver", "../../userspace/services/acpi/region-init", "../../shared/firmware", "../../shared/acpi");
 for Object_Dir use external ("OBSERVER_PROOF_BUILD") & "/obj";
 package Compiler is
