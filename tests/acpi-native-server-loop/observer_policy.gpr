project Observer_Policy is
 for Source_Dirs use ("../../userspace/services/acpi/field-client/provider", "../acpi-target-heap-model", "../../userspace/services/acpi", "../../userspace/services/acpi/lib", "../../userspace/services/acpi/request-driver", "../../userspace/services/acpi/region-init", "../../shared/firmware", "../../shared/acpi");
 for Excluded_Source_Files use("acpi_target_heap.adb");
 package Naming is for Body("ACPI_Target_Heap") use "acpi_target_heap_host.adb";end Naming;
 for Object_Dir use external ("OBSERVER_PROOF_BUILD") & "/obj";
 package Compiler is
  for Default_Switches ("Ada") use ("-gnat2022");
 end Compiler;
end Observer_Policy;
