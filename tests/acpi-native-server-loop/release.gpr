project Release is
 for Source_Dirs use ("models", "boundary", "../../userspace/services/acpi", "../../userspace/services/acpi/lib", "../../userspace/services/acpi/request-driver", "../../userspace/services/acpi/region-init", "../../shared/firmware", "../../shared/acpi", "../../userspace/services/acpi/resource-consumer");
 for Main use ("observer_tests.adb");
 for Object_Dir use external ("OBSERVER_BUILD") & "/obj";
 for Exec_Dir use external ("OBSERVER_BUILD") & "/bin";
 package Compiler is
  for Default_Switches ("Ada") use ("-O1", "-gnat2022", "-gnatwa", "-gnatwe", "-gnatp");
 end Compiler;
end Release;
