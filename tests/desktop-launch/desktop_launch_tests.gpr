project Desktop_Launch_Tests is
   for Source_Dirs use (".", "../../userspace/services/desktop/");
   for Source_Files use ("main.adb", "desktop_launch.ads", "desktop_launch.adb",
                         "desktop_icons.ads");
   for Object_Dir use "build";
   for Main use ("main.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnatwa", "-g");
   end Compiler;
end Desktop_Launch_Tests;
