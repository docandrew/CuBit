# Every SPARK proof target in the repository, one per line, for
# tests/prove-all.sh. Format (fields separated by " | "):
#
#   name | group | directory (relative to the repository root) | command
#
# The command runs with `bash -c` in that directory inside the Nix shell.
# Groups let a checkpoint run a subset: tests/prove-all.sh --group desktop.
# A target's level is read from its --level flag (gnatprove's default is 0).
# Add a line here whenever a new proof project or prove-* target lands.

# --- Kernel (kernel/Makefile) ---------------------------------------------
kernel                  | kcore    | kernel | make prove
kernel-spark-boundaries | kcore    | kernel | make check-spark-boundaries
interrupt-state         | kernel   | kernel | make prove-interrupt-state
lock-ownership          | kernel   | kernel | make prove-lock-ownership
process-lifetime        | kernel   | kernel | make prove-process-lifetime
frame-pins              | kernel   | kernel | make prove-frame-pins
tlb-reclamation         | kernel   | kernel | make prove-tlb-reclamation
capability-policy       | kernel   | kernel | make prove-capability-policy
capability-derive       | kernel   | kernel | make prove-capability-derive
memory-grants           | kernel   | kernel | make prove-memory-grants
grant-loans             | kernel   | kernel | make prove-grant-loans
ipc-request-ids         | kernel   | kernel | make prove-ipc-request-ids
boot-panel              | boot     | kernel | make prove-boot-panel
boot-framebuffer        | boot     | kernel | make prove-boot-framebuffer
deadline-ownership      | sched    | kernel | make prove-deadline-ownership
