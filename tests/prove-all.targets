# --- Proof projects documented in READMEs and design notes ------------------
# The AML proofs (tests/aml-core/run.sh --prove) and the libc's Ada proofs
# (tests/libc-ada/run.sh --prove) are listed one by one so they do not wait
# on those scripts' hosted tests and musl headers.
allocation-failures     | kernel   | kernel | alr exec -- gnatprove -P ../tests/allocation-failures/allocation_tests.gpr -u page_admission.adb allocation_proof.adb elf_admission.adb heap_growth_proof.adb --mode=all --level=2 --checks-as-errors=on -j2
aml-hardware-capabilities | acpi   | kernel | alr exec -- gnatprove -P ../tests/aml-core/hardware-capabilities/capabilities.gpr -u capabilities.ads --mode=all --level=2 --prover=cvc5,z3 --checks-as-errors=on -j2
aml-hardware-catalog    | acpi     | kernel | alr exec -- gnatprove -P ../tests/aml-core/hardware-catalog/catalog.gpr -u hardware_catalog.adb hardware_authority.ads --mode=all --level=2 --prover=cvc5,z3 --checks-as-errors=on -j2
aml-hardware-cspace     | acpi     | kernel | alr exec -- gnatprove -P ../tests/aml-core/hardware-cspace/hardware_cspace.gpr -u hardware_grants-cspace.adb hardware_grants.adb hardware_catalog.adb hardware_authority.ads capabilities.ads --mode=all --level=2 --prover=cvc5,z3 --checks-as-errors=on -j2
aml-hardware-grants     | acpi     | kernel | alr exec -- gnatprove -P ../tests/aml-core/hardware-grants/grants.gpr -u hardware_grants.adb hardware_catalog.adb hardware_authority.ads --mode=all --level=2 --prover=cvc5,z3 --checks-as-errors=on -j2
aml-provisioning        | acpi     | . | gnatprove -P tests/aml-core/provisioning/provisioning.gpr -u firmware_tables-provisioning.adb --mode=all --level=2 --timeout=30 --memlimit=2000 --prover=cvc5,z3 --checks-as-errors=on -j2
aml-snapshots           | acpi     | kernel | ulimit -S -s 65536; alr exec -- gnatprove -P ../tests/aml-core/snapshots/snapshots.gpr -u firmware_tables-snapshots.adb --mode=all --level=2 --prover=cvc5,z3 --checks-as-errors=on -j2
# --no-inlining: gnat2why's contextual inlining of local subprograms passed
# as generic actuals (aml_namespace.adb Execute instances) hits a GNAT bug
# box (inline.adb:3290). Without it the proofs rely on declared contracts.
aml-native-loop         | acpi     | kernel | alr exec -- gnatprove -P ../tests/aml-core/native-loop/acpi_loop.gpr -u acpi_launch.adb --mode=all --no-inlining --level=2 --prover=cvc5,z3 --checks-as-errors=on -j2
aml-regions             | acpi     | kernel | alr exec -- gnatprove -P ../tests/aml-core/regions/regions.gpr -u hardware_authority.ads acpi_region_policy.adb region_mock.adb region_io_instance.ads --mode=all --level=2 --prover=cvc5,z3 --checks-as-errors=on -j2
aml-transactions        | acpi     | kernel | alr exec -- gnatprove -P ../tests/aml-core/transactions/transactions.gpr -u acpi_fadt-transactions.adb --mode=all --level=2 --timeout=30 --steps=0 --prover=cvc5,z3 --checks-as-errors=on -j2
aml-interpreter         | acpi     | kernel | alr exec -- gnatprove -P ../tests/aml-core/aml.gpr -u aml_coercions-strings.adb aml_table_backing.adb firmware_tables-identifiers.adb firmware_tables-copies.adb firmware_tables-exposure.adb firmware_tables-catalog.adb acpi_fadt-registers.adb acpi_fadt.adb aml_decode.adb aml_fields.adb aml_field_data.adb aml_names.adb aml_execute.adb aml_integers.adb aml_coercions.adb aml_logic.adb aml_objects.adb aml_objects-byte_references.adb aml_objects-package_references.adb aml_data.adb namespace_instance.ads acpi_service.ads aml_clock.adb timer_verification.adb timer_service_verification.adb acpi_bootstrap.adb acpi_requests.adb acpi_endpoint.adb --mode=all --no-inlining --level=2 --timeout=30 --memlimit=2000 --prover=cvc5,z3 --checks-as-errors=on -j2
aml-backing             | acpi     | kernel | alr exec -- gnatprove -P ../tests/aml-core/backing.gpr -u multiboot_memory_map-reclaim.adb --mode=all --level=2 --prover=cvc5,z3 --checks-as-errors=on -j2
aml-delay               | acpi     | . | gnatprove -P tests/aml-delay/proof.gpr -u aml_delays.adb --mode=all --level=1 --timeout=5 --prover=cvc5,z3 -j1 --checks-as-errors=on --report=all
boot-hpet               | boot     | kernel | alr exec -- gnatprove -P ../tests/boot-hpet/hpet.gpr -u firmware_tables-hpet.adb --mode=all --level=2 --prover=cvc5,z3 --checks-as-errors=on -j2
boot-timer-rates        | boot     | kernel | alr exec -- gnatprove -P ../tests/boot-timer-rates/rates.gpr -u boot_timer_rates.adb --level=1 --report=all --checks-as-errors=on -j2
ccl-callbacks-queue     | ccl      | kernel | alr exec -- gnatprove -P ../tests/ccl-callbacks/callbacks_tests.gpr --subdirs=queue-proof -u queue_model.ads --mode=all --level=1 --timeout=5 -j2
ccl-callbacks-flow      | ccl      | kernel | alr exec -- gnatprove -P ../tests/ccl-callbacks/callbacks_tests.gpr --subdirs=handler-flow -u ccl-language-handlers.adb ccl-callbacks.adb --mode=flow -j2
ccl-callbacks-button    | ccl      | kernel | alr exec -- gnatprove -P ../tests/ccl-callbacks/callbacks_tests.gpr --subdirs=button-proof -u ccl-handler_references.adb ccl-host_values.adb queue_model.ads --mode=all --level=1 --timeout=5 -j2
ccl-file-dialog         | ccl      | kernel | alr exec -- gnatprove -P ../tests/ccl-file-dialog/dialog_tests.gpr -u cubit-file_selection.adb --level=2 --report=all --checks-as-errors=on -j2
ccl-host-results        | ccl      | kernel | alr exec -- gnatprove -P ../tests/ccl-host-results/results.gpr -u result_fixture.adb --level=2 -j2 --report=all --checks-as-errors=on
ccl-input-budget        | desktop  | . | gnatprove -P tests/compositor/input_budget.gpr -u client_input_budget.adb --level=2 -j1
ccl-sessions-flow       | ccl      | kernel | alr exec -- gnatprove -P ../tests/ccl-sessions/sessions_tests.gpr --subdirs=functions-flow -u ccl-language.adb --mode=flow -j2
ccl-native-objects      | ccl      | kernel | ulimit -v 8388608; alr exec -- gnatprove -P ../tests/ccl-type-discovery/native_objects.gpr -u ccl-vm.adb ccl-vm-native_objects.adb ccl-host_values.adb --subdirs=object-projection-proof --level=2 -j2
ccl-import-results      | ccl      | kernel | alr exec -- gnatprove -P ../tests/ccl-type-discovery/import_results.gpr --subdirs=proof -u ccl-vm.adb --level=2 -j2 --report=all --checks-as-errors=on
ccl-typed-object-host   | ccl      | kernel | alr exec -- gnatprove -P ../tests/ccl-remote/remote.gpr --subdirs=typed-object-host-proof -u interpreter_host.adb --limit-region=ccl-language.adb:1660:1798 --level=2 -j2 --report=all --checks-as-errors=on
# The CCL VM, split per opcode family and verifier check family (CODE-002):
# each unit proves alone within the per-unit budget (prove-all.sh --budget).
# These prove at level 1; the dispatch loop and the families whose frame
# postcondition (fuel limit kept) needs level 2 are the next line.
ccl-vm-units            | ccl      | kernel | alr exec -- gnatprove -P ../tests/ccl-owned-locals/owned_locals.gpr --subdirs=vm-units-proof -u ccl-vm-machine.adb ccl-vm-operations.adb ccl-vm-scalar_ops.adb ccl-vm-data_ops.adb ccl-vm-results.adb ccl-vm-verifier_state.adb ccl-vm-verifier_values.adb ccl-vm-verifier_texts.adb ccl-vm-verifier_flow.adb ccl-vm-verifier_tables.adb ccl-vm-verifier_sweep.adb ccl-host_values.adb --level=1 -j2 --checks-as-errors=on
ccl-vm-loop             | ccl      | kernel | alr exec -- gnatprove -P ../tests/ccl-owned-locals/owned_locals.gpr --subdirs=vm-loop-proof -u ccl-vm.adb ccl-vm-text_ops.adb ccl-vm-list_ops.adb ccl-vm-call_ops.adb ccl-vm-local_ops.adb --level=2 -j2 --checks-as-errors=on
ccl-vm-discovery        | ccl      | kernel | alr exec -- gnatprove -P ../tests/ccl-type-discovery/discovery.gpr --subdirs=vm-proof -u ccl-vm.adb --level=2 --checks-as-errors=on -j2
ccl-root-export         | ccl      | kernel | alr exec -- gnatprove -P ../tests/ccl-remote/remote.gpr --subdirs=root-export-proof -u ccl-language.adb --limit-region=ccl-language.adb:1247:1266 --level=2 --report=all --checks-as-errors=on -j2
ccl-types               | ccl      | kernel | alr exec -- gnatprove -P ../tests/ccl-types/types_tests.gpr --subdirs=types-proof -u ccl-types.adb --level=2 --report=all --checks-as-errors=on -j2
ccl-types-resources     | ccl      | kernel | alr exec -- gnatprove -P ../tests/ccl-types/types_tests.gpr -u ccl-types.adb ccl-types-encoding.adb ccl-types-correspondence.adb ccl-objects.adb ccl-objects-schemas.adb ccl-objects-views.adb --subdirs=resource-proof --level=2 -j2 --checks-as-errors=on
ccl-types-variants      | ccl      | kernel | alr exec -- gnatprove -P ../tests/ccl-types/types_tests.gpr --subdirs=variant-final-proof -u ccl-types.adb ccl-types-encoding.adb ccl-vm.adb ccl-ownership-bytecode.adb --level=2 --report=all --checks-as-errors=on -j2
ccl-views               | ccl      | kernel | alr exec -- gnatprove -P ../tests/ccl-views/views_tests.gpr -u ccl-language-views.adb --mode=all --level=1 --timeout=5 -j2
ccl-config-review       | ccl      | kernel | alr exec -- gnatprove -P ../userspace/ccl/ccl_config_review.gpr --level=2 -j2 --report=fail
compositor-backend-selection | desktop | . | gnatprove -P tests/compositor/backend-selection/test.gpr -u compositor_backend_selection.adb --level=2 --report=all -j2
compositor-startup-layout | desktop | kernel | alr exec -- gnatprove -P ../tests/compositor/startup-layout/test.gpr -u desktop_startup_layout.adb --mode=all --level=2 --report=all -j2
compositor-trace-archive  | desktop | kernel | alr exec -- gnatprove -P ../tests/compositor/trace-archive/trace_archive.gpr -u compositor_trace_archive.adb compositor_trace_framing.adb --level=2 --timeout=30 -j2 --report=all
compositor-affine       | desktop  | . | gnatprove -P tests/compositor/affine.gpr -U --level=2 -j2 --report=fail
