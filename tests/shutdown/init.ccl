# PWR-003 slice 1 (tests/headless shutdown): the power button turns the
# machine off. shutdown-standin is a TEST STAND-IN for acpi.svc's side of
# CuBit.Power_Event_Exchange (q35: \_S5 is 0). procmgr keeps power.svc and
# the stand-in, and stops the rest in reverse order: shutdown-stubborn
# (hangs: forced after 500 ms), shutdown-cooperative (obeys Stop), logstore
# (undeclared: power.svc's grace). Every grace is written here.
(startup v1
  (start "logstore.svc" (priority 5))
  (start "shutdown-standin.app" (priority 5) (stop-stage power-tail)
    (firmware-snapshot approve-declared) (acpi-hardware approve-declared) (platform-power approve-declared)
    (arguments (Standin_Parameters s5_sleep_type => 0)))
  (start "shutdown-cooperative.app" (priority 3) (stop-grace-ms 2000)
    (arguments (Cooperative_Parameters quiesce_ms => 200)))
  (start "shutdown-stubborn.app" (priority 3) (stop-grace-ms 500))
  (start "power.svc" (priority 5)
    (arguments (Power_Parameters undeclared_grace_ms => 300 storage_deadline_ms => 10000
                                 driver_grace_ms => 1000 button => Button_Policy.Power_Off)))
)
