# PWR-003 (tests/headless shutdown-text): apps close safely. Text has
# unsaved edits when the power button is pressed; procmgr's Stop reaches it
# as a System_Shutdown close (CuBit.UI.App), it writes a recovery copy to
# @system/Recovery/com.cubit.text/ (never over notes.txt) and exits within
# its grace. shutdown-standin is the TEST STAND-IN for acpi.svc's S5.
(startup v1
  (start "logstore.svc" (priority 5) (test-console approve-declared))
  (start "shutdown-standin.app" (priority 5) (stop-stage power-tail)
    (firmware-snapshot approve-declared) (acpi-hardware approve-declared) (platform-power approve-declared)
    (arguments (Standin_Parameters s5_sleep_type => 0)))
  (start "display.svc" (priority 5) (stop-grace-ms 500))
  (start "desktop.svc" (priority 4) (stop-grace-ms 2000))
  (start "text.app" (priority 3) (stop-grace-ms 3000))
  (start "power.svc" (priority 5)
    (arguments (Power_Parameters undeclared_grace_ms => 300 storage_deadline_ms => 10000
                                 driver_grace_ms => 1000 button => Button_Policy.Power_Off
                                 reading_age_ms => 60000)))
)
