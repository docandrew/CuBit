# shutdown-stubborn (tests/headless shutdown, PWR-003): a service that
# hangs: it sees Stop and does not end, so procmgr ends it after its grace
# and reports it FORCED.
(Executable_Manifest
  identity => "com.cubit.test.shutdown-stubborn"
  version => "1"
  # ABI-002: its debug text (CuBit.Console_Route).
  requests => [(service "logstore" "logstore")]
  optional => ["logstore"])
