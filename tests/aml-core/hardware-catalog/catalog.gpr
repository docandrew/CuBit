project Catalog is
   for Source_Dirs use (".", "../../../kernel/src", "../../../shared/hardware");
   for Object_Dir use "../build/hardware-catalog/obj";
   for Exec_Dir use "../build/hardware-catalog";
   for Main use ("hardware_catalog_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnata", "-gnato", "-gnatwa", "-gnatwe");
   end Compiler;
end Catalog;
