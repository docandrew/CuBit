project Regions is
   for Source_Dirs use (".", "../../../userspace/lib/acpi", "../../../userspace/services/acpi-backend", "../../../shared/firmware", "../../../shared/hardware");
   for Object_Dir use "../build/regions/obj";
   for Exec_Dir use "../build/regions";
   for Main use ("region_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnata", "-gnato", "-gnatwa", "-gnatwe");
   end Compiler;
end Regions;
