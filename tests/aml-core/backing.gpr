project Backing is
   for Source_Dirs use (".", "../../kernel/src");
   for Object_Dir use "build/backing/obj";
   for Exec_Dir use "build/backing";
   for Main use ("backing_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnata", "-gnato", "-gnatwa", "-gnatwe");
   end Compiler;
end Backing;
