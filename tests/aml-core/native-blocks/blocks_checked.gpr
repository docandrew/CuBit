project Blocks_checked is
   for Source_Dirs use (".", "../../../userspace/services/acpi",
     "../../acpi-table-import-model", "../../../userspace/services/acpi/lib",
     "../../../shared/firmware", "../../../shared/capabilities", "../build/handles", "../../../userspace/services/acpi/resource-consumer");
   for Object_Dir use "../build/blocks-checked/obj";
   for Exec_Dir use "../build/blocks-checked";
   for Main use ("block_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnata", "-gnato", "-gnatwa", "-gnatwe");
   end Compiler;
end Blocks_checked;
