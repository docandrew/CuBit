project ACPI_Loop is
 for Source_Dirs use (".", "../build/native-loop/abi", "../../../userspace/services/acpi", "../../../userspace/services/acpi/native", "../../../userspace/lib/acpi", "../../../shared/firmware");
 for Object_Dir use "../build/native-loop/obj";
 for Exec_Dir use "../build/native-loop";
 for Main use ("loop_tests.adb");
 package Compiler is
  for Default_Switches ("Ada") use ("-O2", "-gnat2022", "-gnata", "-gnato");
 end Compiler;
end ACPI_Loop;
