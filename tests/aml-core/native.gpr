library project Native is
   for Languages use ("Ada");
   for Source_Dirs use
     ("../../userspace/lib/acpi", "../../userspace/services/acpi", "../../userspace/services/acpi/native", "../../shared/firmware");
   for Object_Dir use "build/native/obj";
   for Library_Dir use "build/native/lib";
   for Library_Name use "acpi_core";
   for Library_Kind use "static";
   for Runtime ("Ada") use "../../userspace/runtime";
   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-gnat2022", "-gnata", "-gnato", "-fstack-usage",
         "-mno-red-zone", "-fno-pic", "-mno-sse", "-mno-sse2");
   end Compiler;
end Native;
