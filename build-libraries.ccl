# The libraries native programs use (docs/ccl-build.md): one Library_Catalog
# value, read with build-params.ccl. A program names the ones it uses.
(Library_Catalog [
    # The font library, built by userspace/rust (make ui-fonts-native).
    (Library name => "fonts-native" archives => ["userspace/rust/build/font-native/libcubit_fonts.a"])
    # The UI toolkit's pixel loops (formerly toolkit_flags.gpr).
    (Library name => "toolkit-flags"
      units => [(Unit_Switches ["client_raster.adb" "client_glyph_blend.adb"]
                 ["-O3" "-gnat2022" "-gnatwa" "-fstack-usage" "-fomit-frame-pointer"
                  "-mno-red-zone" "-fno-pic" "-fno-tree-vrp"])])])
