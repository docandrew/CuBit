# Only the services needed to reach USB ISO9660 belong in bootstrap.
# Membership is not launch approval or a capability grant.
(system-image v1
  (catalog "cubit-native-v1")
  (layout optical)
  (provider "usb-optical")
  (kernel "kernel")
  (boot-menu "grub-usb-live")
  (settings "system-live")
  (startup "init-usb-live")
  (file bootstrap "devmgr" "devmgr.svc")
  (file bootstrap "filesystem" "filesystem.svc")
  (file bootstrap "ramdisk" "ramdisk.drv")
  (file bootstrap "ps2" "ps2.drv")
  (file bootstrap "xhci" "xhci.drv")
  (file bootstrap "live-rw" "live-rw.ext2")
  (file optical "netstack" "apps/netstack.svc")
  (file optical "virtio-net" "apps/virtio-net.drv")
  (file optical "virtio-gpu" "apps/virtio-gpu.drv")
  (file optical "hda" "apps/hda.drv")
  (file optical "mixer" "apps/mixer.svc")
  (file optical "config" "apps/config.svc")
  (file optical "netmgr" "apps/netmgr.svc")
  (file optical "procmgr" "apps/procmgr.svc")
  (file optical "logstore" "apps/logstore.svc")
  (file optical "clock" "apps/clock.svc")
  (file optical "display" "apps/display.svc")
  (file optical "desktop" "apps/desktop.svc")
  (file optical "ccl-workbench" "apps/ccl-workbench.app")
  (file optical "devices" "apps/devices.app")
  (file optical "config-inspector" "apps/config-inspector.app")
  (file optical "files" "apps/files.app")
  (file optical "doom" "apps/doom.elf")
  (file optical "sameboy" "apps/sameboy.app")
  (file optical "doom-wad" "apps/doom1.wad")
  (file optical "sameboy-test" "apps/sameboy/00.gb")
  # Read-only originals; editable copies also seed live-rw.ext2's /work.
  (file optical "ccl-button-clock" "samples/ccl/button-clock.ccl")
  (file optical "ccl-button-output" "samples/ccl/button-output.ccl")
  (file optical "ccl-config-inspector" "samples/ccl/config-inspector.ccl")
  (file optical "ccl-enums" "samples/ccl/enums.ccl")
  (file optical "ccl-variants" "samples/ccl/variants.ccl")
  (file optical "ccl-clock-label" "samples/ccl/clock-label.ccl")
  (file optical "ccl-function-clock-label" "samples/ccl/function-clock-label.ccl")
  (file optical "ccl-monotonic-clock" "samples/ccl/monotonic-clock.ccl")
  (file optical "sameboy-license" "licenses/SameBoy.txt")
  (file optical "openlibm-notices" "licenses/openlibm")
)
