# Existing all-in-initrd laptop fallback; preserve current membership.
(system-image v1
  (catalog "cubit-native-v1")
  (layout bootstrap-only)
  (provider "resident")
  (settings "system-live")
  (startup "init-laptop-live")
  (file bootstrap "devmgr" "devmgr.svc")
  (file bootstrap "filesystem" "filesystem.svc")
  (file bootstrap "ata" "ata.drv")
  (file bootstrap "nvme" "nvme.drv")
  (file bootstrap "netstack" "netstack.svc")
  (file bootstrap "virtio-net" "virtio-net.drv")
  (file bootstrap "virtio-gpu" "virtio-gpu.drv")
  (file bootstrap "hda" "hda.drv")
  (file bootstrap "mixer" "mixer.svc")
  (file bootstrap "ps2" "ps2.drv")
  (file bootstrap "xhci" "xhci.drv")
  (file bootstrap "config" "config.svc")
  (file bootstrap "netmgr" "netmgr.svc")
  (file bootstrap "procmgr" "procmgr.svc")
  (file bootstrap "logstore" "logstore.svc")
  (file bootstrap "clock" "clock.svc")
  (file bootstrap "display" "display.svc")
  (file bootstrap "desktop" "desktop.svc")
  (file bootstrap "ccl-workbench" "ccl-workbench.app")
  (file bootstrap "devices" "devices.app")
  (file bootstrap "files" "files.app")
  (file bootstrap "storage-check" "storage-check.app")
  (file bootstrap "doom" "doom.elf")
  (file bootstrap "doom-wad" "doom1.wad")
  (file bootstrap "live-rw" "live-rw.ext2")
)
