# The all-in-initrd laptop fallback. Every driver is in every image; devmgr
# starts those whose declared devices are present (docs/device-matching.md).
(system-image v1
  (catalog "cubit-native-v1")
  (layout bootstrap-only)
  (provider "resident")
  # The image's trust list (SIGN-001): every executable placed must verify
  # against it. The host development CA comes from ccl-image's --import
  # (make: $(CUBIT_SIGNING)/builder-ca.der), never from a path in the tree.
  (builder host-development (import "cubit-signing-ca") (identities "*") (ceiling hardware-and-system))
  (settings "system-live")
  (startup "init-laptop-live")
  (file bootstrap "devmgr" "devmgr.svc")
  (file bootstrap "filesystem" "filesystem.svc")
  (file bootstrap "ramdisk" "ramdisk.drv")
  (file bootstrap "ata" "ata.drv")
  (file bootstrap "nvme" "nvme.drv")
  (file bootstrap "netstack" "netstack.svc")
  (file bootstrap "virtio-net" "virtio-net.drv")
  (file bootstrap "virtio-gpu" "virtio-gpu.drv")
  (file bootstrap "hda" "hda.drv")
  (file bootstrap "rtw89" "rtw89.drv")
  # The touchpad (SUP-001): the GPIO controller driver (ACPI launch), the
  # I2C controller driver (one per controller, generic PCI launch) and the
  # HID-over-I2C driver devmgr starts through Start_Child. hid-i2c.drv is
  # this image's only PNP0C50 driver (never with hid-launch-check.drv).
  (file bootstrap "gpio" "gpio.drv")
  (file bootstrap "i2c-dw" "i2c-dw.drv")
  (file bootstrap "hid-i2c" "hid-i2c.drv")
  (file bootstrap "mixer" "mixer.svc")
  (file bootstrap "ps2" "ps2.drv")
  (file bootstrap "xhci" "xhci.drv")
  (file bootstrap "virtio-input" "virtio-input.drv")
  (file bootstrap "intel-gpu" "intel-gpu.drv")
  (file bootstrap "ufs" "ufs.drv")
  (file bootstrap "config" "config.svc")
  (file bootstrap "netmgr" "netmgr.svc")
  (file bootstrap "wifi" "wifi.svc")
  (file bootstrap "procmgr" "procmgr.svc")
  (file bootstrap "logstore" "logstore.svc")
  (file bootstrap "clock" "clock.svc")
  (file bootstrap "display" "display.svc")
  (file bootstrap "desktop" "desktop.svc")
  # The power manager (PWR-003): shutdown from Desktop.
  (file bootstrap "power" "power.svc")
  # The metrics store (MET-002).
  (file bootstrap "metrics" "metrics.svc")
  (file bootstrap "ccl-workbench" "ccl-workbench.app")
  (file bootstrap "devices" "devices.app")
  (file bootstrap "config-inspector" "config-inspector.app")
  (file bootstrap "files" "files.app")
  (file bootstrap "storage-check" "storage-check.app")
  (file bootstrap "doom" "doom.elf")
  (file bootstrap "doom-wad" "doom1.wad")
  (file bootstrap "live-rw" "live-rw.ext2")
)
