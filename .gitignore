# Kernel and live-image build artifacts
/kernel/*.iso.plan.json
/kernel/*.img.plan.json
/kernel/isodir/boot/*.img.plan.json
/kernel/src/build.ads
/kernel/isodir/licenses/cbor_ada.txt

# Local third-party source/build trees used by port experiments
/userspace/c/doom_src/
/userspace/c/netsurf/
/userspace/c/netsurf_deps/
/userspace/c/netsurf_src/
/userspace/c/sameboy_src/
/userspace/c/sameboy_build/
# Private cartridges are build inputs, never source artifacts.
/local-roms/
*.[gG][bB]
*.[gG][bB][cC]
userspace/services/virtio-gpu/build-delayed/
userspace/apps/display-check/build-gpu-delayed/
userspace/services/virtio-gpu/build-clear-failure/
userspace/apps/display-check/build-gpu-clear-failure/

# Advisory cross-session build/test lock; never delete a live lock file.
/coordination/*.lock
/.build-workspaces/
# Local source backup; not an input to isolated source snapshots.
/cubit_092826.zip

# Networking scratch: proof/test build variants, runner temp files, logs.
/tests/net-tcp/build-*/
/tests/net-tcp/build*.log
# Local A/B backups of built images (never committed).
/kernel/*.pre-*
/tests/intel-gpu/build-*/
/tests/mesa-software/target/
/tests/mesa-anv/target/
/tests/region-transition/build-pte/
/tests/region-transition/build-registry/
