# Rules are general by kind, not per directory: a new test or service gets
# the same treatment without editing this file. Before adding a general rule,
# check `git ls-files | grep` for tracked paths it would shadow, and add an
# exception (!) for those.

# --- Build output: gprbuild object/exec directories, proofs, binder files ---
build
build-*/
*-build/
obj/
gnatprove/
# A tracked test directory, not output.
!/tests/build-workspace/
b~*
*.ali
*.o
*.a
*.elf
*.bexch
# GNAT compiler/binder output captures and stack-usage reports.
*.stdout
*.stderr
*.cswi
*.su
__pycache__/
# Nix shells started with TMPDIR inside a test directory.
nix-tmp.*/

# --- Kernel and image products ---
cubit_kernel
cubit_kernel.iso
cubit_kernel.map
runtime/adalib
src/build.ads
/kernel/src/build.ads
/kernel/*.iso.plan.json
/kernel/*.img.plan.json
/kernel/isodir/boot/*.img.plan.json
/kernel/isodir/licenses/cbor_ada.txt
# Local A/B backups of built images.
/kernel/*.pre-*
/kernel/desktop-logs/
# Userspace binaries and images.
*.svc
*.drv
*.app
*.img
*.iso

# --- Logs, captures, archives ---
*.log
*.pcap
*.zip
/tests/performance/results/

# --- Third-party source and build trees for ports ---
/userspace/c/doom_src/
/userspace/c/netsurf/
/userspace/c/netsurf_deps/
/userspace/c/netsurf_src/
/userspace/c/sameboy_src/
/userspace/c/sameboy_build/
/tests/mesa-software/target/
/tests/mesa-anv/target/

# --- Private inputs: never committed ---
# Cartridges are build inputs, never source artifacts.
/local-roms/
*.[gG][bB]
*.[gG][bB][cC]

# --- Coordination and isolated workspaces ---
# Session coordination notes and the advisory build lock are local working
# state, not repository content.
/coordination/
/.build-workspaces/

# --- Scratch from isolated regression and proof runs ---
/tests/intel-gpu/budget-accounting.*/
/tests/intel-gpu/prefix-geometry.*/
/tests/intel-gpu/prefix-proof.*/
/tests/intel-gpu/prefix-transport.*/
/tests/intel-gpu/transport-proof-tmp.*/
/tests/intel-gpu/demand-backing.*/
/.gpu-status-test.*/
/.vm-intel-*/
